# Secrets / local config
config/JARVIS_CONFIG.json
config/JARVIS_SECRETS.json
.env

# Node
app/node_modules/
node_modules/

# Database backups
backups/*.sql

# OS / editor
.DS_Store
.vscode/
.idea/

# Scheduler task/notification state
data/*.json
data/sessions/

# Shared file-exchange folders (ignore the user's files, but keep the READMEs
# and the shipped self-help guides so JARVIS can read them at runtime).
LLM_READ_WRITE_FILES/*
!LLM_READ_WRITE_FILES/.gitkeep
!LLM_READ_WRITE_FILES/README.txt
LLM_READ_ONLY_FILES/*
!LLM_READ_ONLY_FILES/.gitkeep
!LLM_READ_ONLY_FILES/README.txt
!LLM_READ_ONLY_FILES/JARVIS_Guides/

# local config backup (contains a real key)
config/JARVIS_CONFIG.*backup*.json

# Debug logs (JARVIS_AI/Logs/), keep the dir
Logs/*
!Logs/.gitkeep

# MLX local-LLM runtime (created by ./ACTIVATE.sh — venv + downloaded models + server logs)
mlx/venv/
mlx/models/
mlx/*.log
mlx/serving.json

# LiteLLM gateway live config — regenerated by JARVIS_LOCAL_LLM.sh (start/gateway-sync) from the live
# backend, so it constantly changes. The committed seed is litellm/config_template.yaml.
litellm/config.yaml

# LLM workspace — the AI’s live working area (host-visible); ignore its churn, keep the dir
LLM_WORKSPACE/*
!LLM_WORKSPACE/.gitkeep
