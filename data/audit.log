{"t":"2026-07-28T04:09:45.125Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3, os, hashlib\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nBID = 2\n\n# Step 10: Recurring Invoices (fix with next_run_date)\nrecurring = [\n    ('SleepyStudy Co.', 'SS-M', 95000, 8075, 'Monthly retainer for short-form content (12 videos/mo). Auto-generates on the 20th.'),\n    ('Crypto Brief Daily', 'CBD-M', 95000, 8075, 'Monthly retainer for faceless crypto news shorts + AI avatar segments. Auto-generates on the 10th.'),\n]\n\nfor cust_name, prefix, amount_cents, tax_cents, notes in recurring:\n    cur.execute('''INSERT INTO recurring_invoices \n        (business_id, customer_name, number_prefix, amount_cents, tax_cents, next_run_date) VALUES (?, ?, ?, ?, ?, ?)''',\n       (BID, cust_name, prefix, amount_cents, tax_cents, '2026-08-10'))\n\n# Step 14: Recurring Bills — column is bill_number_prefix not number_prefix\nbills = [\n    ('BILL-R', 'ElevenLabs Inc.', 20000, 'Monthly AI voiceover subscription. Auto-generated on the 1st.'),\n    ('BILL-R-002', 'Pictory AI (Veed)', 4900, 'Video automation platform monthly plan.'),\n]\n\nfor prefix, vendor_name, amount_cents, notes in bills:\n    cur.execute('''INSERT INTO recurring_bills \n        (business_id, vendor_name, bill_number_prefix, amount_cents, next_run_date) VALUES (?, ?, ?, ?, ?)''',\n       (BID, vendor_name, prefix, amount_cents, '2026-08-01'))\n\n# Step 15: Business Logos — placeholder reference\ncur.execute('''INSERT INTO business_logos \n    (business_id, name, file_path, mime_type) VALUES (?, ?, ?, ?)''',\n   (BID, 'Primary Logo', '/uploads/summit-logo.png', 'image/png'))\n\n# Step 13: Documents — insert into DB if not already done\nrw = '/READ_WRITE_FILES/summit-docs'\ndocs_to_create = [\n    ('business-plan.md', 'Business Planning'),\n    ('client-contract-template.md', 'Contracts'),\n]\n\nfor fname, category in docs_to_create:\n    full_path = os.path.join(rw, fname)\n    rel_path = f'summit-docs/{fname}'\n    if not os.path.exists(full_path):\n        continue\n    with open(full_path, 'rb') as f:\n        data = f.read()\n    h = hashlib.sha256(data).hexdigest()[:16]\n    title_map = {'business-plan.md': 'Business Plan', 'client-contract-template.md': 'Client Contract Template'}\n    cur.execute('''INSERT OR REPLACE INTO documents \n        (business_id, category, title, notes, original_filename, stored_filename, file_path, mime_type, byte_size, content_hash) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',\n       (BID, category, title_map[fname], f'{fname} — Summit Digital Agency internal document.', fname, h + '.md', rel_path, 'text/markdown', len(data), h))\n\nconn.commit()\n\n# Verify all counts now\nfor table in ['business_company', 'business_owners', 'business_phones', 'business_addresses', \n              'business_emails', 'business_banking_accounts', 'business_credit_cards',\n              'business_products_services', 'business_customers', 'business_vendors',\n              'business_recurring_expenses', 'budget_entries', 'invoices', 'recurring_invoices',\n              'project_lists', 'project_list_items', 'business_contacts', 'documents', 'recurring_bills']:\n    try:\n        cur.execute(f'SELECT COUNT(*) FROM {table} WHERE business_id = ?', (BID,))\n        print(f'{table}: {cur.fetchone()[0]} records')\n    except Exception as e:\n        print(f'{table}: ERROR - {e}')\n\nconn.close()\nprint('\\n✅ All remaining data inserted successfully!')\n\" 2>&1\n","timeout_s":15},"status":"ok","ms":138}
{"t":"2026-07-28T04:09:49.887Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\ncur.execute(\\\"SELECT sql FROM sqlite_master WHERE name='business_logos'\\\")\nprint(cur.fetchone()[0])\n\n# Also check business_social_links and other tables I might have missed\nfor t in ['business_social_links', 'business_milestones']:\n    cur.execute(f\\\"SELECT sql FROM sqlite_master WHERE name='{t}'\\\")\n    r = cur.fetchone()\n    if r: print(f'\\n=== {t} ===\\n{r[0]}')\n\nconn.close()\n\" 2>&1\n","timeout_s":10},"status":"ok","ms":142}
{"t":"2026-07-28T04:10:31.893Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3, os, hashlib\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nBID = 2\n\n# === Recurring Invoices (need next_run_date) ===\nrecurring_inv = [\n    ('SleepyStudy Co.', 'SS-M', 95000, 8075, 'Monthly retainer for short-form content (12 videos/mo). Auto-generates on the 20th.'),\n    ('Crypto Brief Daily', 'CBD-M', 95000, 8075, 'Monthly retainer for faceless crypto news shorts + AI avatar segments. Auto-generates on the 10th.'),\n]\n\nfor cust_name, prefix, amount_cents, tax_cents, notes in recurring_inv:\n    cur.execute('''INSERT INTO recurring_invoices \n        (business_id, customer_name, number_prefix, amount_cents, tax_cents, next_run_date) VALUES (?, ?, ?, ?, ?, ?)''',\n       (BID, cust_name, prefix, amount_cents, tax_cents, '2026-08-10'))\n\n# === Projects — KPI & Growth Tracking ===\ncur.execute('''INSERT INTO project_lists \n    (business_id, title, description) VALUES (?, ?, ?)''',\n   (BID, 'Q3 2026 Revenue Push', 'Target \\$75K MRR by end of Q3. Key initiatives: onboard 4+ new retainer clients, launch affiliate program, optimize YouTube RPM on client channels.'))\n\nproj_id = cur.lastrowid\n\ncur.execute('''INSERT INTO project_list_items \n    (project_id, title) VALUES (?, ?)''',\n   (proj_id, 'Onboard FitLife Shorts to Premium Retainer'))\ncur.execute('''UPDATE project_list_items SET description=? WHERE item_id=last_insert_rowid() OR title=? AND project_id=?''', ('Complete onboarding call and deliver first batch of 30 shorts by July 31.', 'Onboard FitLife Shorts...', proj_id))\n\n# Check if that update worked, or try direct insert with all fields\ncur.execute('''INSERT INTO project_list_items \n    (project_id, title) VALUES (?, ?)''',\n   (proj_id, 'Launch Affiliate Partnership Program'))\n\nprint(f'Projects created: list={1}, items=2')\n\n# === Documents into DB (files already exist on disk from original seed run) ===\nrw = '/READ_WRITE_FILES/summit-docs'\ndocs_info = [\n    ('business-plan.md', 'Business Planning', 'Business Plan'),\n    ('client-contract-template.md', 'Contracts', 'Client Contract Template'),\n    ('kpi-dashboard-guide.md', 'Operations', 'KPI Dashboard Guide'),\n    ('pricing-sheet.md', 'Sales', 'Pricing Sheet 2026'),\n]\n\nfor fname, category, title in docs_info:\n    full_path = os.path.join(rw, fname)\n    if not os.path.exists(full_path):\n        print(f'  Skipping {fname} — file missing')\n        continue\n    with open(full_path, 'rb') as f:\n        data = f.read()\n    h = hashlib.sha256(data).hexdigest()[:16]\n    rel_path = f'summit-docs/{fname}'\n    \n    # Check if already exists to avoid duplicates\n    cur.execute('SELECT COUNT(*) FROM documents WHERE business_id=? AND original_filename=?', (BID, fname))\n    if cur.fetchone()[0] > 0:\n        print(f'  Skipping {fname} — already in DB')\n        continue\n    \n    cur.execute('''INSERT INTO documents \n        (business_id, category, title, notes, original_filename, stored_filename, file_path, mime_type, byte_size, content_hash) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',\n       (BID, category, title, f'{fname} — Summit Digital Agency internal document.', fname, h + '.md', rel_path, 'text/markdown', len(data), h))\n\n# === Recurring Bills for vendors ===\nbills = [\n    ('BILL-R-01', 'ElevenLabs Inc.', 20000, 'Monthly AI voiceover subscription. Auto-generated on the 1st.'),\n    ('BILL-R-02', 'Pictory AI (Veed)', 4900, 'Video automation platform monthly plan.'),\n]\n\nfor prefix, vendor_name, amount_cents, notes in bills:\n    cur.execute('''INSERT INTO recurring_bills \n        (business_id, vendor_name, bill_number_prefix, amount_cents, next_run_date) VALUES (?, ?, ?, ?, ?)''',\n       (BID, vendor_name, prefix, amount_cents, '2026-08-01'))\n\n# === Business Logos — use \"label\" not \"name\", and include required columns ===\ncur.execute('''INSERT INTO business_logos \n    (business_id, file_path, original_filename, mime_type, label) VALUES (?, ?, ?, ?, ?)''',\n   (BID, '/uploads/summit-logo.png', 'summit-logo.png', 'image/png', 'Primary Logo'))\n\n# === Social Media Links for the agency ===\nsocials = [\n    ('YouTube', '@SummitDigitalAgency', 'https://youtube.com/@SummitDigitalAgency'),\n    ('Instagram', '@summitdigitalagency.io', 'https://instagram.com/summitdigitalagency.io'),\n    ('Twitter/X', '@SummitDigAgcy', 'https://x.com/SummitDigAgcy'),\n]\n\nfor platform, handle, url in socials:\n    cur.execute('''INSERT INTO business_social_links \n        (business_id, platform, handle, url) VALUES (?, ?, ?, ?)''',\n       (BID, platform, handle, url))\n\n# === Business Milestones ===\nmilestones = [\n    ('LLC Formation & Registration', '2025-03-15', 'Completed'),\n    ('First Client Onboarded (TechVault Reviews)', '2026-03-15', 'Completed'),\n    ('$10K MRR Milestone', '2026-04-01', 'Completed'),\n    ('$50K MRR Target', '2026-09-01', 'In Progress'),\n    ('Launch Self-Serve Booking Platform', '2027-01-01', 'Planned'),\n]\n\nfor name, date, status in milestones:\n    cur.execute('''INSERT INTO business_milestones \n        (business_id, name, target_date, status) VALUES (?, ?, ?, ?)''',\n       (BID, name, date, status))\n\nconn.commit()\n\n# === Final Verification — ALL tables for Summit Digital Agency LLC ===\nprint('\\n=== FINAL DATA VERIFICATION ===')\ntables_to_check = [\n    'business_company', 'business_owners', 'business_phones', \n    'business_addresses', 'business_emails', 'business_banking_accounts',\n    'business_credit_cards', 'business_products_services', 'business_customers',\n    'business_vendors', 'business_recurring_expenses', 'budget_entries',\n    'invoices', 'recurring_invoices', 'project_lists', 'project_list_items',\n    'business_contacts', 'documents', 'recurring_bills', 'business_logos',\n    'business_social_links', 'business_milestones'\n]\n\ntotal_records = 0\nfor table in tables_to_check:\n    try:\n        cur.execute(f'SELECT COUNT(*) FROM {table} WHERE business_id = ?', (BID,))\n        count = cur.fetchone()[0]\n        total_records += count\n        status_icon = '✅' if count > 0 else '❌ EMPTY'\n        print(f'  {status_icon} {table}: {count} records')\n    except Exception as e:\n        print(f'  ❓ {table}: ERROR - {e}')\n\nprint(f'\\n📊 TOTAL RECORDS ACROSS ALL TABLES: {total_records}')\n\n# Quick sample queries to verify data quality\nprint('\\n=== SAMPLE DATA CHECK ===')\n\n# Check products/services prices are reasonable (in cents)\ncur.execute('SELECT name, price_cents FROM business_products_services WHERE kind=\\\"service\\\" ORDER BY price_cents DESC LIMIT 3')\nfor row in cur.fetchall():\n    print(f'  Service: {row[0]} — \\${row[1]/100:.2f}')\n\n# Check invoice totals\ncur.execute('SELECT COUNT(*), SUM(total_cents) FROM invoices WHERE business_id=? AND status=\\\"paid\\\"', (BID,))\npaid = cur.fetchone()\nprint(f'  Paid invoices: {paid[0]} — Total revenue collected: \\${paid[1]/100:.2f}')\n\n# Check monthly recurring expenses\ncur.execute('SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE frequency=\\\"monthly\\\" AND business_id=?', (BID,))\nmonthly_cost = cur.fetchone()[0] or 0\nprint(f'  Monthly operational costs: \\${monthly_cost/100:.2f}/mo')\n\nconn.close()\nprint('\\n✅ ALL DATA INSERTED & VERIFIED SUCCESSFULLY!')\n\" 2>&1\n","timeout_s":30},"status":"ok","ms":139}
{"t":"2026-07-28T04:10:37.471Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nfor t in ['project_lists', 'project_list_items']:\n    cur.execute(f'SELECT sql FROM sqlite_master WHERE name=\\\"{t}\\\"')\n    r = cur.fetchone()\n    if r: print(f'\\n=== {t} ===\\n{r[0]}')\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":134}
{"t":"2026-07-28T04:11:08.945Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3, os, hashlib\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nBID = 2\n\n# === Recurring Invoices (need next_run_date) ===\nrecurring_inv = [\n    ('SleepyStudy Co.', 'SS-M', 95000, 8075, 'Monthly retainer for short-form content. Auto-generates on the 20th.'),\n    ('Crypto Brief Daily', 'CBD-M', 95000, 8075, 'Monthly retainer for faceless crypto news shorts + AI avatar segments. Auto-generates on the 10th.'),\n]\n\nfor cust_name, prefix, amount_cents, tax_cents, notes in recurring_inv:\n    cur.execute('''INSERT INTO recurring_invoices \n        (business_id, customer_name, number_prefix, amount_cents, tax_cents, next_run_date) VALUES (?, ?, ?, ?, ?, ?)''',\n       (BID, cust_name, prefix, amount_cents, tax_cents, '2026-08-10'))\n\n# === Projects — KPI & Growth Tracking (correct schema: no description col on project_lists; items use list_id + text field) ===\ncur.execute('''INSERT INTO project_lists \n    (business_id, title) VALUES (?, ?)''',\n   (BID, 'Q3 2026 Revenue Push'))\n\nlist_id = cur.lastrowid\n\nitems = [\n    ('Onboard FitLife Shorts to Premium Retainer — deliver first batch of 30 shorts by July 31'),\n    ('Launch Affiliate Partnership Program for existing clients'),\n    ('Optimize YouTube RPM on top-performing client channels'),\n    ('Build self-serve booking platform (Q4 target)'),\n]\n\nfor item_text in items:\n    cur.execute('''INSERT INTO project_list_items \n        (list_id, business_id, text) VALUES (?, ?, ?)''',\n       (list_id, BID, item_text))\n\n# === Documents into DB (files already exist on disk from original seed run) ===\nrw = '/READ_WRITE_FILES/summit-docs'\ndocs_info = [\n    ('business-plan.md', 'Business Planning', 'Business Plan'),\n    ('client-contract-template.md', 'Contracts', 'Client Contract Template'),\n    ('kpi-dashboard-guide.md', 'Operations', 'KPI Dashboard Guide'),\n    ('pricing-sheet.md', 'Sales', 'Pricing Sheet 2026'),\n]\n\nfor fname, category, title in docs_info:\n    full_path = os.path.join(rw, fname)\n    if not os.path.exists(full_path):\n        print(f'  Skipping {fname} — file missing')\n        continue\n    with open(full_path, 'rb') as f:\n        data = f.read()\n    h = hashlib.sha256(data).hexdigest()[:16]\n    rel_path = f'summit-docs/{fname}'\n    \n    # Check if already exists to avoid duplicates\n    cur.execute('SELECT COUNT(*) FROM documents WHERE business_id=? AND original_filename=?', (BID, fname))\n    if cur.fetchone()[0] > 0:\n        print(f'  Skipping {fname} — already in DB')\n        continue\n    \n    cur.execute('''INSERT INTO documents \n        (business_id, category, title, notes, original_filename, stored_filename, file_path, mime_type, byte_size, content_hash) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',\n       (BID, category, title, f'{fname} — Summit Digital Agency internal document.', fname, h + '.md', rel_path, 'text/markdown', len(data), h))\n\n# === Recurring Bills for vendors ===\nbills = [\n    ('BILL-R-01', 'ElevenLabs Inc.', 20000, 'Monthly AI voiceover subscription. Auto-generated on the 1st.'),\n    ('BILL-R-02', 'Pictory AI (Veed)', 4900, 'Video automation platform monthly plan.'),\n]\n\nfor prefix, vendor_name, amount_cents, notes in bills:\n    cur.execute('''INSERT INTO recurring_bills \n        (business_id, vendor_name, bill_number_prefix, amount_cents, next_run_date) VALUES (?, ?, ?, ?, ?)''',\n       (BID, vendor_name, prefix, amount_cents, '2026-08-01'))\n\n# === Business Logos — use correct column names: label not name ===\ncur.execute('''INSERT INTO business_logos \n    (business_id, file_path, original_filename, mime_type, label) VALUES (?, ?, ?, ?, ?)''',\n   (BID, '/uploads/summit-logo.png', 'summit-logo.png', 'image/png', 'Primary Logo'))\n\n# === Social Media Links for the agency ===\nsocials = [\n    ('YouTube', '@SummitDigitalAgency', 'https://youtube.com/@SummitDigitalAgency'),\n    ('Instagram', '@summitdigitalagency.io', 'https://instagram.com/summitdigitalagency.io'),\n    ('Twitter/X', '@SummitDigAgcy', 'https://x.com/SummitDigAgcy'),\n]\n\nfor platform, handle, url in socials:\n    cur.execute('''INSERT INTO business_social_links \n        (business_id, platform, handle, url) VALUES (?, ?, ?, ?)''',\n       (BID, platform, handle, url))\n\n# === Business Milestones ===\nmilestones = [\n    ('LLC Formation & Registration', '2025-03-15', 'Completed'),\n    ('First Client Onboarded — TechVault Reviews', '2026-03-15', 'Completed'),\n    ('$10K MRR Milestone Reached', '2026-04-01', 'Completed'),\n    ('$75K MRR Target (Q3 2026)', '2026-09-01', 'In Progress'),\n    ('Launch Self-Serve Booking Platform', '2027-01-01', 'Planned'),\n]\n\nfor name, date, status in milestones:\n    cur.execute('''INSERT INTO business_milestones \n        (business_id, name, target_date, status) VALUES (?, ?, ?, ?)''',\n       (BID, name, date, status))\n\nconn.commit()\n\n# === Final Verification — ALL tables for Summit Digital Agency LLC ===\nprint('\\n=== FINAL DATA VERIFICATION ===')\ntables_to_check = [\n    'business_company', 'business_owners', 'business_phones', \n    'business_addresses', 'business_emails', 'business_banking_accounts',\n    'business_credit_cards', 'business_products_services', 'business_customers',\n    'business_vendors', 'business_recurring_expenses', 'budget_entries',\n    'invoices', 'recurring_invoices', 'project_lists', 'project_list_items',\n    'business_contacts', 'documents', 'recurring_bills', 'business_logos',\n    'business_social_links', 'business_milestones'\n]\n\ntotal_records = 0\nfor table in tables_to_check:\n    try:\n        cur.execute(f'SELECT COUNT(*) FROM {table} WHERE business_id = ?', (BID,))\n        count = cur.fetchone()[0]\n        total_records += count\n        status_icon = '✅' if count > 0 else '❌ EMPTY'\n        print(f'  {status_icon} {table}: {count} records')\n    except Exception as e:\n        print(f'  ❓ {table}: ERROR - {e}')\n\nprint(f'\\n📊 TOTAL RECORDS ACROSS ALL TABLES: {total_records}')\n\n# Quick sample queries to verify data quality\nprint('\\n=== SAMPLE DATA CHECK ===')\n\ncur.execute('SELECT name, price_cents FROM business_products_services WHERE kind=\\\"service\\\" ORDER BY price_cents DESC LIMIT 3')\nfor row in cur.fetchall():\n    print(f'  Service: {row[0]} — \\${row[1]/100:.2f}')\n\ncur.execute('SELECT COUNT(*), SUM(total_cents) FROM invoices WHERE business_id=? AND status=\\\"paid\\\"', (BID,))\npaid = cur.fetchone()\nprint(f'  Paid invoices: {paid[0]} — Total revenue collected: \\${paid[1]/100:.2f}')\n\ncur.execute('SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE frequency=\\\"monthly\\\" AND business_id=?', (BID,))\nmonthly_cost = cur.fetchone()[0] or 0\nprint(f'  Monthly operational costs: \\${monthly_cost/100:.2f}/mo')\n\nconn.close()\nprint('\\n✅ ALL DATA INSERTED & VERIFIED SUCCESSFULLY!')\n\" 2>&1\n","timeout_s":30},"status":"ok","ms":136}
{"t":"2026-07-28T04:12:15.387Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nBID = 2\n\n# Clean slate for Summit Digital Agency LLC (business_id=2) across all tables\ntables_to_clear = [\n    'recurring_bills', 'project_list_items', 'project_lists', \n    'documents', 'invoices', 'budget_entries', 'business_recurring_expenses',\n    'business_vendors', 'business_customers', 'business_products_services',\n    'business_credit_cards', 'business_banking_accounts', 'business_emails',\n    'business_addresses', 'business_phones', 'business_owners', \n    'business_company', 'recurring_invoices', 'project_lists',\n    'business_contacts', 'business_logos', 'business_social_links',\n    'business_milestones'\n]\n\nfor t in tables_to_clear:\n    cur.execute(f'DELETE FROM {t} WHERE business_id = ?', (BID,))\n\nconn.commit()\nprint('Clean slate ready for Summit Digital Agency LLC')\nconn.close()\n\" 2>&1\n","timeout_s":10},"status":"ok","ms":135}
