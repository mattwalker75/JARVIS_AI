{"t":"2026-07-27T03:14:00.994Z","tool":"write_workbench_file","args":{"path":"/workspace/test_workflow.js","content":"const { chromium } = require('playwright');\n\n(async () => {\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext();\n  const page = await context.newPage();\n  \n  let passed = 0;\n  let failed = 0;\n  \n  function assert(condition, msg) {\n    if (condition) {\n      console.log(`✅ PASS: ${msg}`);\n      passed++;\n    } else {\n      console.error(`❌ FAIL: ${msg}`);\n      failed++;\n    }\n  }\n\n  try {\n    // ===== TEST 1: Dashboard loads and shows stats grid =====\n    await page.goto('http://localhost:9106/');\n    \n    const dashStats = await page.locator('#dash-stats').count();\n    assert(dashStats === 1, 'Dashboard renders with #dash-stats element');\n\n    // Check stat cards exist (4 total)\n    const statCards = await page.locator('.stat-card').all();\n    assert(statCards.length >= 3, `At least 3 stat cards visible (found ${statCards.length})`);\n\n    // Verify dashboard has actual data loaded (seeded clients count > 0)\n    const dashText = await page.textContent('#dash-stats');\n    assert(parseInt(dashText.replace(/\\D/g,'')) >= 1, 'Dashboard shows client count from seeded data');\n\n    console.log('\\n--- TEST 1: Dashboard loads correctly ---\\n');\n\n    // ===== TEST 2: Add a new client via modal form =====\n    await page.click('[data-page=\"clients\"]');\n    \n    const clientsSection = await page.locator('#page-clients').isVisible();\n    assert(clientsSection, 'Clients page is accessible and renders');\n\n    // Count existing rows before adding\n    const preRows = await page.locator('#clients-table tr').count();\n    console.log(`  Pre-add client table row count: ${preRows}`);\n    \n    // Click \"Add New Client\" button\n    await page.click('button.btn-primary', { hasText: 'Add' });\n    \n    // Wait for modal to show (give it a moment)\n    await page.waitForTimeout(800);\n\n    const clientModal = await page.locator('#client-modal.show').isVisible();\n    assert(clientModal, 'Client modal opens when clicking Add New Client');\n\n    if (clientModal) {\n      // Fill in the form with unique data\n      await page.fill('#cf-first', 'TestAlice');\n      await page.fill('#cf-last', 'Johnson99');\n      await page.fill('#cf-email', 'alice.test.99@email.com');\n      await page.fill('#cf-phone', '(555) 867-0099');\n      \n      // Check status options exist and select one\n      const statusOptions = await page.locator('#cf-status option').all();\n      assert(statusOptions.length >= 1, 'Status dropdown has at least 1 option');\n\n      if (statusOptions.length > 0) {\n        await page.selectOption('#cf-status', 'registered');\n        \n        // Submit the form - use specific submit button\n        const submitBtn = page.locator('button[type=\"submit\"]');\n        await submitBtn.click();\n\n        // Wait for modal to close and table to update\n        await page.waitForTimeout(1500);\n\n        // Verify client appears in table (should be preRows + 1)\n        const postRows = await page.locator('#clients-table tr').count();\n        assert(postRows === preRows + 1, `Client count increased by 1 (${preRows} → ${postRows})`);\n\n        // Check the new client name is visible anywhere in table\n        const allTableText = await page.textContent('#clients-table');\n        assert(allTableText.includes('TestAlice'), 'New client \"TestAlice\" appears in clients table');\n      } else {\n        console.log('\\n--- TEST 2: Status dropdown empty, skipping form fill ---\\n');\n      }\n    }\n\n    // ===== TEST 3: Register a new policy for the test client =====\n    await page.click('[data-page=\"policies\"]');\n    \n    const policiesSection = await page.locator('#page-policies').isVisible();\n    assert(policiesSection, 'Policies page is accessible and renders');\n\n    const prePolRows = await page.locator('#policies-table tr').count();\n    console.log(`  Pre-add policy table row count: ${prePolRows}`);\n\n    // Click \"Register New Policy\" button  \n    await page.click('button.btn-primary', { hasText: 'Register' });\n    \n    // Wait for modal to open and populate selects\n    await page.waitForTimeout(800);\n    \n    const policyModal = await page.locator('#policy-modal.show').isVisible();\n    assert(policyModal, 'Policy registration modal opens');\n\n    if (policyModal) {\n      // Check client select has options\n      const clientsInSelect = await page.locator('#pf-client option[value]').all();\n      console.log(`  Client select options: ${clientsInSelect.length}`);\n      \n      assert(clientsInSelect.length >= 1, `Client dropdown populated with ${clientsInSelect.length} options`);\n\n      if (clientsInSelect.length > 0) {\n        // Select the first client (TestAlice should be there now or any seeded one)\n        await page.selectOption('#pf-client', clientsInSelect[0].evaluate(el => el.value));\n\n        // Fill coverage and premium - check current values first\n        const covInput = await page.locator('#pf-coverage');\n        const covVal = await covInput.inputValue();\n        \n        if (!covVal || isNaN(parseFloat(covVal))) {\n          await covInput.fill('500000');\n        } else {\n          await covInput.click({ clickCount: 3 }); // triple-click to select all\n          await page.type('#pf-coverage', '500000');\n        }\n\n        const premInput = await page.locator('#pf-premium');\n        const premVal = await premInput.inputValue();\n        \n        if (!premVal || isNaN(parseFloat(premVal))) {\n          await premInput.fill('2400');\n        } else {\n          await premInput.click({ clickCount: 3 });\n          await page.type('#pf-premium', '2400');\n        }\n\n        // Select policy type and other fields\n        const typeOptions = await page.locator('#pf-type option').all();\n        if (typeOptions.length > 1) {\n          await page.selectOption('#pf-type', 'term_life');\n        } else {\n          console.log('  Policy types available:', await Promise.all(typeOptions.map(o => o.textContent())));\n        }\n\n        // Fill start date - check current value\n        const startDateInput = await page.locator('#pf-start').inputValue();\n        if (!startDateInput) {\n          await page.fill('#pf-start', '2026-01-15');\n        } else {\n          await page.click('#pf-start');\n          await page.keyboard.press('Control+a');\n          await page.type('#pf-start', '2026-01-15');\n        }\n\n        // Select status - check options first  \n        const statusOptions = await page.locator('#pf-status option').all();\n        if (statusOptions.length > 0) {\n          await page.selectOption('#pf-status', 'active');\n        } else {\n          console.log('  Policy statuses available:', await Promise.all(statusOptions.map(o => o.textContent())));\n        }\n\n        // Submit the policy form\n        const policySubmit = page.locator('button[type=\"submit\"]');\n        await policySubmit.click();\n\n        // Wait for modal to close and table to update\n        await page.waitForTimeout(1500);\n\n        // Check policy appears in table (should be prePolRows + 1)\n        const postPolRows = await page.locator('#policies-table tr').count();\n        assert(postPolRows === prePolRows + 1, `Policy count increased by 1 (${prePolRows} → ${postPolRows})`);\n\n        // Verify policy type shows in table\n        if (postPolRows > 0) {\n          const allPolText = await page.textContent('#policies-table');\n          assert(allPolText.includes('term_life') || allPolText.includes('Term Life'), 'Policy type appears in policies table');\n        }\n      } else {\n        console.log('\\n--- TEST 3: No clients available for policy, skipping ---\\n');\n      }\n    }\n\n    // ===== TEST 4: Record a payment for the newly created policy =====\n    await page.click('[data-page=\"payments\"]');\n    \n    const paymentsSection = await page.locator('#page-payments').isVisible();\n    assert(paymentsSection, 'Payments page is accessible and renders');\n\n    const prePayRows = await page.locator('#payments-table tr').count();\n    console.log(`  Pre-add payment table row count: ${prePayRows}`);\n\n    // Click \"Record Payment\" button  \n    await page.click('button.btn-success', { hasText: 'Record' });\n    \n    // Wait for modal to open and populate selects\n    await page.waitForTimeout(800);\n    \n    const payModal = await page.locator('#payment-modal.show').isVisible();\n    assert(payModal, 'Payment recording modal opens');\n\n    if (payModal) {\n      // Check policy select has options  \n      const policiesInSelect = await page.locator('#pm-policy option[value]').all();\n      console.log(`  Policy select options: ${policiesInSelect.length}`);\n      \n      assert(policiesInSelect.length >= 1, `Policy dropdown populated with ${policiesInSelect.length} options`);\n\n      if (policiesInSelect.length > 0) {\n        // Select the first policy\n        await page.selectOption('#pm-policy', policiesInSelect[0].evaluate(el => el.value));\n\n        // Fill payment amount - check current value  \n        const amtInput = await page.locator('#pm-amount');\n        const amtVal = await amtInput.inputValue();\n        \n        if (!amtVal || isNaN(parseFloat(amtVal))) {\n          await amtInput.fill('2400');\n        } else {\n          await amtInput.click({ clickCount: 3 });\n          await page.type('#pm-amount', '2400');\n        }\n\n        // Fill date - check current value\n        const dateInput = await page.locator('#pm-date').inputValue();\n        if (!dateInput) {\n          await page.fill('#pm-date', '2026-07-15');\n        } else {\n          await page.click('#pm-date');\n          await page.keyboard.press('Control+a');\n          await page.type('#pm-date', '2026-07-15');\n        }\n\n        // Select payment method - check options first\n        const methodOptions = await page.locator('#pm-method option').all();\n        if (methodOptions.length > 0) {\n          await page.selectOption('#pm-method', 'check');\n        } else {\n          console.log('  Payment methods available:', await Promise.all(methodOptions.map(o => o.textContent())));\n        }\n\n        // Submit the payment form\n        const paySubmit = page.locator('button[type=\"submit\"]');\n        await paySubmit.click();\n\n        // Wait for modal to close and table to update  \n        await page.waitForTimeout(1500);\n\n        // Check payment appears in table (should be prePayRows + 1)\n        const postPayRows = await page.locator('#payments-table tr').count();\n        assert(postPayRows === prePayRows + 1, `Payment count increased by 1 (${prePayRows} → ${postPayRows})`);\n\n        // Verify payment shows \"Received\" status badge  \n        if (postPayRows > 0) {\n          const allPayText = await page.textContent('#payments-table');\n          assert(allPayText.includes('Received'), 'Payment shows Received status in payments table');\n          \n          // Check for dollar amount display\n          assert(/\\$[\\d,]+/.test(allPayText), `Dollar amounts displayed correctly: ${allPayText.match(/\\$[\\d,]+/)?.[0]}`);\n        }\n      } else {\n        console.log('\\n--- TEST 4: No policies available for payment, skipping ---\\n');\n      }\n    }\n\n    // ===== TEST 5: Dashboard reflects all data (stats updated) =====\n    await page.click('[data-page=\"dashboard\"]');\n    \n    const dashSection = await page.locator('#page-dashboard').isVisible();\n    assert(dashSection, 'Dashboard page is accessible after navigation from payments');\n\n    await page.waitForTimeout(1000);\n\n    // Check dashboard stats reflect the new data\n    const statTexts = [];\n    for (const card of await page.locator('.stat-card').all()) {\n      statTexts.push(await card.textContent());\n    }\n    \n    console.log('  Dashboard stat texts:', JSON.stringify(statTexts));\n\n    // Should show at least the seeded client count + our new test client  \n    const totalClientsStat = statTexts.find(t => t.includes('Total Clients'));\n    assert(totalClientsStat, 'Dashboard shows \"Total Clients\" stat');\n    \n    if (totalClientsStat) {\n      const numMatch = totalClientsStat.match(/(\\d+)/);\n      if (numMatch) {\n        assert(parseInt(numMatch[1]) >= 2, `Client count is at least 2 (${numMatch[1]} found)`);\n      }\n    }\n\n    // Check recent activity section renders with entries  \n    const actRows = await page.locator('#recent-activity tr').count();\n    console.log(`  Recent activity rows: ${actRows}`);\n    assert(actRows >= 1, 'Recent Activity shows at least one entry');\n\n    // Check pending actions section exists and has content or \"no pending\" message  \n    const pendingSection = await page.locator('#pending-actions').isVisible();\n    assert(pendingSection, 'Pending Actions section renders on dashboard');\n\n    console.log('\\n--- TEST 5: Dashboard reflects data correctly ---\\n');\n\n    // ===== SUMMARY =====\n    console.log('='.repeat(60));\n    console.log(`RESULTS: ${passed} passed, ${failed} failed out of ${passed + failed} tests`);\n    \n    if (failed === 0) {\n      console.log('\\n🎉 ALL TESTS PASSED! Core workflows verified.');\n    } else {\n      console.log(`\\n⚠️ ${failed} test(s) need attention.`);\n    }\n\n  } catch (err) {\n    console.error('Test error:', err.message);\n    failed++;\n  } finally {\n    await browser.close();\n    \n    // Write results to a file for the plan update  \n    const fs = require('fs');\n    fs.writeFileSync('/workspace/test_results.txt', \n      `Tests: ${passed} passed, ${failed} failed\\n` +\n      (failed === 0 ? 'ALL TESTS PASSED' : `${failed} test(s) need attention`)\n    );\n    \n    process.exit(failed > 0 ? 1 : 0);\n  }\n})();\n"},"status":"ok","ms":140}
