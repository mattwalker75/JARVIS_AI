{"t":"2026-07-27T02:59:49.850Z","tool":"write_file","args":{"path":"/workspace/public/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LifeShield Agent Dashboard</title>\n<style>\n:root {\n  --primary: #1a5276;\n  --primary-light: #2980b9;\n  --accent: #27ae60;\n  --warning: #f39c12;\n  --danger: #e74c3c;\n  --bg: #ecf0f1;\n  --card-bg: #ffffff;\n  --text: #2c3e50;\n  --text-light: #7f8c8d;\n  --border: #bdc3c7;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }\n\n/* Sidebar */\n.sidebar { width: 260px; background: linear-gradient(180deg, #0d3b5e 0%, #1a5276 100%); color: white; padding: 0; position: fixed; height: 100vh; overflow-y: auto; z-index: 100; }\n.sidebar-header { padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); text-align: center; }\n.sidebar-header h1 { font-size: 18px; font-weight: 700; letter-spacing: 0.5px; }\n.sidebar-header p { font-size: 11px; opacity: 0.7; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }\n.nav-menu { padding: 12px 0; }\n.nav-item { display: flex; align-items: center; gap: 12px; padding: 13px 24px; cursor: pointer; transition: all 0.2s; font-size: 14px; border-left: 3px solid transparent; color: rgba(255,255,255,0.7); }\n.nav-item:hover { background: rgba(255,255,255,0.08); color: white; }\n.nav-item.active { background: rgba(255,255,255,0.12); border-left-color: var(--accent); color: white; font-weight: 600; }\n.nav-icon { width: 20px; text-align: center; font-size: 16px; }\n\n/* Main */\n.main { margin-left: 260px; flex: 1; min-height: 100vh; padding: 30px; }\n\n.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }\n.page-title h2 { font-size: 24px; color: var(--primary); font-weight: 700; }\n.page-title p { font-size: 13px; color: var(--text-light); margin-top: 4px; }\n\n/* Cards */\n.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }\n.stat-card { background: var(--card-bg); border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: flex; align-items: center; gap: 16px; }\n.stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: white; flex-shrink: 0; }\n.stat-info h3 { font-size: 26px; font-weight: 700; line-height: 1.1; }\n.stat-info p { font-size: 12px; color: var(--text-light); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }\n\n/* Table */\n.card { background: var(--card-bg); border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden; margin-bottom: 24px; }\n.card-header { padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }\n.card-header h3 { font-size: 16px; color: var(--primary); }\n\ntable { width: 100%; border-collapse: collapse; }\nth, td { padding: 14px 20px; text-align: left; font-size: 13px; }\nth { background: #f8f9fa; color: var(--text-light); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px; border-bottom: 2px solid var(--border); }\ntd { border-bottom: 1px solid #eee; }\ntr:hover td { background: #f8fbff; }\n\n/* Badges */\n.badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }\n.badge-active { background: #d5f5e3; color: #196f3d; }\n.badge-pending { background: #fef9e7; color: #b7950b; }\n.badge-expired { background: #fadbd8; color: #a94442; }\n.badge-draft { background: #eaecee; color: #6c757d; }\n\n/* Buttons */\n.btn { padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; border: none; display: inline-flex; align-items: center; gap: 6px; }\n.btn-primary { background: var(--primary); color: white; }\n.btn-primary:hover { background: #154360; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(26,82,118,0.3); }\n.btn-success { background: var(--accent); color: white; }\n.btn-success:hover { background: #1e8449; }\n.btn-danger { background: var(--danger); color: white; padding: 6px 12px; font-size: 12px; }\n.btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }\n\n/* Modal */\n.modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 200; justify-content: center; align-items: flex-start; padding-top: 60px; overflow-y: auto; }\n.modal-overlay.show { display: flex; }\n.modal { background: var(--card-bg); border-radius: 14px; width: 95%; max-width: 620px; box-shadow: 0 8px 32px rgba(0,0,0,0.2); margin-bottom: 40px; }\n.modal-header { padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }\n.modal-header h3 { font-size: 18px; color: var(--primary); }\n.modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-light); padding: 0 4px; line-height: 1; }\n.modal-body { padding: 24px; max-height: 65vh; overflow-y: auto; }\n\n/* Form */\n.form-group { margin-bottom: 18px; }\n.form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }\n.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\ninput, select, textarea { width: 100%; padding: 10px 14px; border: 2px solid var(--border); border-radius: 8px; font-size: 13px; transition: border-color 0.2s; outline: none; }\ninput:focus, select:focus, textarea:focus { border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(41,128,185,0.1); }\n\n/* Section */\n.section { display: none; }\n.section.active { display: block; }\n\n/* Search bar */\n.search-bar { padding: 6px 14px; border: 2px solid var(--border); border-radius: 8px; font-size: 13px; width: 250px; outline: none; transition: all 0.2s; }\n.search-bar:focus { border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(41,128,185,0.1); width: 300px; }\n\n/* Actions bar */\n.actions-row { display: flex; gap: 6px; align-items: center; }\n\n.empty-state { text-align: center; padding: 60px 20px; color: var(--text-light); }\n.empty-state .icon { font-size: 48px; margin-bottom: 12px; opacity: 0.5; }\n.empty-state p { font-size: 14px; }\n\n/* Payment amount */\n.payment-amount { font-weight: 700; color: var(--accent); }\n.overdue { color: var(--danger) !important; }\n\n/* Responsive */\n@media (max-width: 900px) {\n  .sidebar { width: 220px; }\n  .main { margin-left: 220px; padding: 16px; }\n}\n</style>\n</head>\n<body>\n\n<aside class=\"sidebar\">\n<div class=\"sidebar-header\">\n<h1>&#9783; LifeShield</h1>\n<p>Agent Dashboard</p>\n</div>\n<nav class=\"nav-menu\">\n<div class=\"nav-item active\" data-page=\"dashboard\"><span class=\"nav-icon\">&#9642;</span>Dashboard</div>\n<div class=\"nav-item\" data-page=\"clients\"><span class=\"nav-icon\">&#128101;</span>Clients</div>\n<div class=\"nav-item\" data-page=\"policies\"><span class=\"nav-icon\">&#127896;</span>Policies</div>\n<div class=\"nav-item\" data-page=\"payments\"><span class=\"nav-icon\">&#128176;</span>Payments</div>\n</nav>\n</aside>\n\n<main class=\"main\">\n\n<!-- DASHBOARD -->\n<section id=\"page-dashboard\" class=\"section active\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#9642; Dashboard Overview</h2><p>Your agency at a glance</p></div>\n</div>\n<div class=\"stats-grid\" id=\"dash-stats\"></div>\n\n<div class=\"card\">\n<div class=\"card-header\"><h3>Pending Actions</h3></div>\n<table><thead><tr><th>Type</th><th>Name / Policy</th><th>Detail</th><th>Action</th></tr></thead>\n<tbody id=\"pending-actions\"></tbody></table>\n</div>\n\n<div class=\"card\">\n<div class=\"card-header\"><h3>Recent Activity</h3></div>\n<table><thead><tr><th>Date</th><th>Type</th><th>Description</th></tr></thead>\n<tbody id=\"recent-activity\"></tbody></table>\n</div>\n</section>\n\n<!-- CLIENTS -->\n<section id=\"page-clients\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#128101; Client Management</h2><p>All registered clients and their registration status</p></div>\n<button class=\"btn btn-primary\" onclick=\"openModal('client-modal')\">&#43; Add New Client</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Policies</th><th>Last Payment</th><th>Actions</th></tr></thead>\n<tbody id=\"clients-table\"></tbody></table>\n<div class=\"empty-state\" id=\"clients-empty\"><div class=\"icon\">&#128101;</div><p>No clients yet. Add your first client to get started.</p></div>\n</div>\n</section>\n\n<!-- POLICIES -->\n<section id=\"page-policies\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#127896; Policy Registry</h2><p>All policies and their current status</p></div>\n<button class=\"btn btn-primary\" onclick=\"openModal('policy-modal')\">&#43; Register New Policy</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Policy #</th><th>Client</th><th>Type</th><th>Coverage Amount</th><th>Premium</th><th>Status</th><th>Actions</th></tr></thead>\n<tbody id=\"policies-table\"></tbody></table>\n<div class=\"empty-state\" id=\"policies-empty\"><div class=\"icon\">&#127896;</div><p>No policies registered yet.</p></div>\n</div>\n</section>\n\n<!-- PAYMENTS -->\n<section id=\"page-payments\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#128176; Payment Tracker</h2><p>Premium payments and collection status</p></div>\n<button class=\"btn btn-success\" onclick=\"openModal('payment-modal')\">&#43; Record Payment</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Date</th><th>Client</th><th>Policy</th><th>Type</th><th>Amount Due</th><th>Paid</th><th>Status</th></tr></thead>\n<tbody id=\"payments-table\"></tbody></table>\n<div class=\"empty-state\" id=\"payments-empty\"><div class=\"icon\">&#128176;</div><p>No payments recorded yet.</p></div>\n</div>\n</section>\n\n</main>\n\n<!-- CLIENT MODAL -->\n<div class=\"modal-overlay\" id=\"client-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Add New Client</h3><button class=\"modal-close\" onclick=\"closeModal('client-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"saveClient(event)\">\n<div class=\"form-row\">\n<div class=\"form-group\"><label>First Name *</label><input id=\"cf-first\" required placeholder=\"John\"></div>\n<div class=\"form-group\"><label>Last Name *</label><input id=\"cf-last\" required placeholder=\"Doe\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Email Address *</label><input type=\"email\" id=\"cf-email\" required placeholder=\"john@example.com\"></div>\n<div class=\"form-group\"><label>Phone Number *</label><input id=\"cf-phone\" required placeholder=\"(555) 123-4567\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Date of Birth</label><input type=\"date\" id=\"cf-dob\"></div>\n<div class=\"form-group\"><label>Registration Status</label>\n<select id=\"cf-status\"><option value=\"registered\">Registered</option><option value=\"pending\">Pending Verification</option></select></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Occupation</label><input id=\"cf-occupation\" placeholder=\"Engineer\"></div>\n<div class=\"form-group\"><label>Annual Income</label><input type=\"number\" id=\"cf-income\" placeholder=\"75000\"></div>\n</div>\n<button type=\"submit\" class=\"btn btn-primary\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#128994; Save Client</button>\n</form>\n</div></div></div>\n\n<!-- POLICY MODAL -->\n<div class=\"modal-overlay\" id=\"policy-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Register New Policy</h3><button class=\"modal-close\" onclick=\"closeModal('policy-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"savePolicy(event)\">\n<div class=\"form-group\"><label>Select Client *</label><select id=\"pf-client\" required></select></div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Policy Type</label>\n<select id=\"pf-type\">\n<option value=\"Term Life - 10yr\">Term Life - 10yr</option>\n<option value=\"Term Life - 20yr\" selected>Term Life - 20yr</option>\n<option value=\"Whole Life Premium\">Whole Life Premium</option>\n<option value=\"Universal Life Gold\">Universal Life Gold</option>\n<option value=\"Final Expense Basic\">Final Expense Basic</option>\n</select></div>\n<div class=\"form-group\"><label>Coverage Amount (Face Value) *</label><input type=\"number\" id=\"pf-coverage\" required placeholder=\"250000\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Premium Amount ($) *</label><input type=\"number\" step=\"0.01\" id=\"pf-premium\" required placeholder=\"45.99\"></div>\n<div class=\"form-group\"><label>Payment Frequency</label>\n<select id=\"pf-freq\"><option value=\"monthly\">Monthly</option><option value=\"quarterly\">Quarterly</option><option value=\"annually\">Annually</option></select></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Start Date *</label><input type=\"date\" id=\"pf-start\" required></div>\n<div class=\"form-group\"><label>Maturity/End Date</label><input type=\"date\" id=\"pf-maturity\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Status</label>\n<select id=\"pf-status\"><option value=\"active\">Active</option><option value=\"pending\">Pending Approval</option><option value=\"expired\">Expired</option></select></div>\n<div class=\"form-group\"><label>Beneficiary Name *</label><input id=\"pf-beneficiary\" required placeholder=\"Jane Doe\"></div>\n</div>\n<button type=\"submit\" class=\"btn btn-primary\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#127943; Register Policy</button>\n</form>\n</div></div></div>\n\n<!-- PAYMENT MODAL -->\n<div class=\"modal-overlay\" id=\"payment-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Record Payment</h3><button class=\"modal-close\" onclick=\"closeModal('payment-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"savePayment(event)\">\n<div class=\"form-group\"><label>Select Client *</label><select id=\"pm-client\" required onchange=\"updatePolicySelect()\"></select></div>\n<div class=\"form-group\"><label>Select Policy *</label><select id=\"pm-policy\" required></select></div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Premium Amount ($) *</label><input type=\"number\" step=\"0.01\" id=\"pm-amount\" required placeholder=\"45.99\"></div>\n<div class=\"form-group\"><label>Due Date</label><input type=\"date\" id=\"pm-due\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Paid Date (if paid)</label><input type=\"date\" id=\"pm-paid-date\"></div>\n<div class=\"form-group\"><label>Payment Method</label>\n<select id=\"pm-method\"><option value=\"bank_transfer\">Bank Transfer</option><option value=\"credit_card\">Credit Card</option><option value=\"check\">Check</option></select></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Status</label>\n<select id=\"pm-status\"><option value=\"pending\">Pending</option><option value=\"paid\" selected>Paid</option><option value=\"overdue\">Overdue</option></select></div>\n<div class=\"form-group\"><label>Reference # (optional)</label><input id=\"pm-ref\" placeholder=\"TXN-12345\"></div>\n</div>\n<button type=\"submit\" class=\"btn btn-success\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#9989; Record Payment</button>\n</form>\n</div></div></div>\n\n<script>\n// ==================== DATA STORE ====================\nlet clients = [];\nlet policies = [];\nlet payments = [];\nlet idCounter = 100;\n\nfunction nextId() { return ++idCounter; }\n\n// Load from API on startup (or use seed data)\nasync function loadData() {\n  try {\n    const [cRes, pRes] = await Promise.all([fetch('/api/clients'), fetch('/api/policies')]);\n    clients = cRes.ok ? await cRes.json() : [];\n    policies = pRes.ok ? await pRes.json() : [];\n\n    // Seed demo data if empty\n    if (!clients.length) {\n      const seedClients = [\n        { firstName: 'James', lastName: 'Anderson', email: 'james.anderson@email.com', phone: '(555) 123-4567', dateOfBirth: '1980-03-15', address: '123 Oak Street, Springfield, IL 62701', registrationDate: new Date().toISOString().split('T')[0], status: 'active' },\n        { firstName: 'Maria', lastName: 'Garcia', email: 'maria.garcia@email.com', phone: '(555) 234-5678', dateOfBirth: '1975-07-22', address: '456 Elm Ave, Austin, TX 73301', registrationDate: new Date().toISOString().split('T')[0], status: 'active' },\n        { firstName: 'Robert', lastName: 'Chen', email: 'robert.chen@email.com', phone: '(555) 345-6789', dateOfBirth: '1990-11-08', address: '789 Pine Rd, Seattle, WA 98101', registrationDate: new Date().toISOString().split('T')[0], status: 'pending' },\n        { firstName: 'Sarah', lastName: 'Johnson', email: 'sarah.johnson@email.com', phone: '(555) 456-7890', dateOfBirth: '1985-02-28', address: \"321 Maple Dr, Denver, CO 80201\", registrationDate: new Date().toISOString().split('T')[0], status: 'active' },\n        { firstName: 'David', lastName: 'Williams', email: 'david.williams@email.com', phone: '(555) 567-8901', dateOfBirth: '1968-09-14', address: '654 Cedar Ln, Miami, FL 33101', registrationDate: new Date().toISOString().split('T')[0], status: 'inactive' },\n        { firstName: 'Emily', lastName: 'Thompson', email: 'emily.thompson@email.com', phone: '(555) 678-9012', dateOfBirth: '1992-04-30', address: '987 Birch St, Portland, OR 97201', registrationDate: new Date().toISOString().split('T')[0], status: 'active' },\n        { firstName: 'Michael', lastName: 'Brown', email: 'michael.brown@email.com', phone: '(555) 789-0123', dateOfBirth: '1978-12-01', address: '147 Walnut Ave, Chicago, IL 60601', registrationDate: new Date().toISOString().split('T')[0], status: 'pending' },\n        { firstName: 'Lisa', lastName: 'Martinez', email: 'lisa.martinez@email.com', phone: '(555) 890-1234', dateOfBirth: '1983-06-17', address: '258 Spruce Ct, Phoenix, AZ 85001', registrationDate: new Date().toISOString().split('T')[0], status: 'active' },\n      ];\n\n      seedClients.forEach(c => {\n        const id = nextId();\n        clients.push({ ...c, id });\n      });\n\n      // Seed policies linked to some clients\n      const policyTypes = ['Term Life - 20yr', 'Whole Life Premium', 'Universal Life Gold', 'Term Life - 10yr', 'Final Expense Basic'];\n      seedClients.slice(0, 6).forEach((c, i) => {\n        policies.push({\n          id: nextId(), clientId: c.id, policyNumber: `POL-${String(nextId()).padStart(5,'0')}`, type: policyTypes[i], faceValue: [250000, 500000, 750000, 100000, 300000][i],\n          premiumAmount: [45.99, 89.50, 120.00, 28.75, 35.00][i], frequency: 'monthly', startDate: ['2024-02-01','2024-04-01','2024-07-01','2023-12-01','2024-09-01'][i],\n          maturityDate: ['2044-02-01','2054-04-01','2064-07-01','2034-12-01','2044-09-01'][i], status: 'active', beneficiary: ['Jane Anderson','Carlos Garcia','Lily Chen','Tom Johnson','Karen Williams'][i]\n        });\n      });\n\n      // Seed payments linked to policies\n      const statuses = ['paid','pending','overdue'];\n      for (let i = 0; i < Math.min(policies.length, 4); i++) {\n        [1,2].forEach(m => {\n          payments.push({\n            id: nextId(), policyId: policies[i].id, clientId: policies[i].clientId, amount: policies[i].premiumAmount, dueDate: `2025-${String(3+m).padStart(2,'0')}-15`, paidDate: null, status: statuses[Math.floor(Math.random()*statuses.length)],\n            paymentMethod: ['bank_transfer','credit_card','check'][Math.floor(Math.random()*3)]\n          });\n        });\n      }\n\n      for (let i = Math.min(policies.length,4); i < policies.length; i++) {\n        [1,2].forEach(m => {\n          payments.push({\n            id: nextId(), policyId: policies[i].id, clientId: policies[i].clientId, amount: policies[i].premiumAmount, dueDate: `2025-${String(3+m).padStart(2,'0')}-15`, paidDate: null, status: statuses[Math.floor(Math.random()*statuses.length)],\n            paymentMethod: ['bank_transfer','credit_card','check'][Math.floor(Math.random()*3)]\n          });\n        });\n      }\n\n      // Save seed data to API backend\n      await Promise.all([\n        fetch('/api/clients', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(clients.map(c=>({...c}))) }),\n        ...policies.map(p => fetch('/api/policies', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(p)}))\n      ]);\n\n    } else if (!payments.length) {\n      // Seed payments for existing clients with policies\n      const statuses = ['paid','pending','overdue'];\n      for (let i = 0; i < Math.min(policies.length, 4); i++) {\n        [1,2].forEach(m => {\n          payments.push({\n            id: nextId(), policyId: policies[i].id, clientId: policies[i].clientId, amount: policies[i].premiumAmount, dueDate: `2025-${String(3+m).padStart(2,'0')}-15`, paidDate: null, status: statuses[Math.floor(Math.random()*statuses.length)],\n            paymentMethod: ['bank_transfer','credit_card','check'][Math.floor(Math.random()*3)]\n          });\n        });\n      }\n    }\n\n  } catch(e) { console.error('Load error:', e); }\n}\n\n// ==================== NAVIGATION ====================\ndocument.querySelectorAll('.nav-item').forEach(item => {\n  item.addEventListener('click', () => {\n    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));\n    item.classList.add('active');\n    const page = item.dataset.page;\n    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));\n    document.getElementById(`page-${page}`).classList.add('active');\n\n    if (page === 'dashboard') refreshDashboard();\n    else if (page === 'clients') renderClients();\n    else if (page === 'policies') renderPolicies();\n    else if (page === 'payments') renderPayments();\n  });\n});\n\n// ==================== MODAL HELPERS ====================\nfunction openModal(id) { document.getElementById(id).classList.add('show'); }\nfunction closeModal(id) { document.getElementById(id).classList.remove('show'); }\n\n// Close modal on overlay click\ndocument.querySelectorAll('.modal-overlay').forEach(overlay => {\n  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });\n});\n\n// ==================== HELPERS ====================\nfunction getFullName(c) { return c ? `${c.firstName} ${c.lastName}` : 'Unknown'; }\nfunction getStatusBadge(status, type='client') {\n  const map = { active: ['active','badge-active'], pending: ['pending','badge-pending'], expired: ['expired','badge-expired'], draft: ['draft','badge-draft'], registered: ['registered','badge-active'] };\n  if (type === 'policy') {\n    return `<span class=\"badge badge-${status==='active'?'active':status==='pending'?'pending':'expired'}\">${status}</span>`;\n  }\n  const [label, cls] = map[status] || ['unknown',''];\n  return label ? `<span class=\"badge ${cls}\">${label}</span>` : status;\n}\n\nfunction getPaymentStatusBadge(status) {\n  if (status === 'paid') return '<span class=\"badge badge-active\">Received</span>';\n  if (status === 'overdue') return '<span class=\"badge\" style=\"background:#fadbd8;color:#a94442;\">Overdue</span>';\n  return '<span class=\"badge badge-pending\">Pending</span>';\n}\n\nfunction countClientPolicies(clientId) { return policies.filter(p => p.clientId === clientId).length; }\nfunction getLastPaymentDate(clientId) {\n  const clientPayments = payments.filter(p => p.clientId === clientId);\n  if (!clientPayments.length) return '—';\n  return new Date(Math.max(...clientPayments.map(p => new Date(p.dueDate)))).toLocaleDateString();\n}\n\n// ==================== DASHBOARD ====================\nasync function refreshDashboard() {\n  try {\n    const res = await fetch('/api/dashboard');\n    if (!res.ok) throw 'API error';\n    const data = await res.json();\n\n    // Stats cards\n    document.getElementById('dash-stats').innerHTML = `\n      <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:var(--primary-light)\">👥</div><div class=\"stat-info\"><h3>${data.stats.totalClients}</h3><p>Total Clients</p></div></div>\n      <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:var(--accent)\">✅</div><div class=\"stat-info\"><h3>${data.stats.activePolicies}</h3><p>Active Policies</p></div></div>\n      <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:var(--warning)\">⏳</div><div class=\"stat-info\"><h3>${data.stats.pendingPayments}</h3><p>Pending Payments</p></div></div>\n      <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:#8e44ad\">💰</div><div class=\"stat-info\"><h3>$${data.stats.totalRevenue.toLocaleString()}</h3><p>Total Revenue Collected</p></div></div>`;\n\n    // Pending actions\n    let pendingHtml = '';\n    clients.filter(c => c.status === 'pending').forEach(c => {\n      pendingHtml += `<tr><td>👤 Registration</td><td>${getFullName(c)}</td><td>Pending verification since ${c.registrationDate}</td><td><button class=\"btn btn-sm btn-primary\" onclick=\"approveClient(${c.id})\">Approve</button></td></tr>`;\n    });\n    payments.filter(p => p.status === 'overdue').forEach(p => {\n      const client = clients.find(c => c.id === p.clientId);\n      pendingHtml += `<tr><td>💳 Overdue Payment</td><td>${client ? getFullName(client) : 'Unknown'}</td><td>$${p.amount} due ${new Date(p.dueDate).toLocaleDateString()}</td><td><button class=\"btn btn-sm btn-success\" onclick=\"markPaid(${p.id})\">Mark Paid</button></td></tr>`;\n    });\n    document.getElementById('pending-actions').innerHTML = pendingHtml || '<tr><td colspan=\"4\" style=\"text-align:center;color:var(--text-light);padding:30px;\">All caught up! No pending actions.</td></tr>';\n\n    // Recent activity (from payments)\n    let actHtml = '';\n    [...payments].sort((a,b) => new Date(b.dueDate) - new Date(a.dueDate)).slice(0, 5).forEach(p => {\n      const client = clients.find(c => c.id === p.clientId);\n      actHtml += `<tr><td>${new Date(p.dueDate).toLocaleDateString()}</td><td>💳 Payment</td><td>$${p.amount} from ${client ? getFullName(client) : 'Unknown'} — <strong style=\"color:${p.status==='paid'?'var(--accent)':p.status==='overdue'?'var(--danger)':'var(--warning)'}\">${p.status}</strong></td></tr>`;\n    });\n    document.getElementById('recent-activity').innerHTML = actHtml || '<tr><td colspan=\"3\" style=\"text-align:center;color:var(--text-light);padding:30px;\">No recent activity.</td></tr>';\n\n  } catch(e) { console.error('Dashboard load error:', e); }\n}\n\nasync function approveClient(id) {\n  await fetch(`/api/clients/${id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status:'active'}) });\n  refreshDashboard(); renderClients();\n}\n\nasync function markPaid(paymentId) {\n  const payment = payments.find(p => p.id === paymentId);\n  if (payment) await fetch(`/api/payments/${paymentId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status:'paid', paidDate:new Date().toISOString().split('T')[0]}) });\n  refreshDashboard(); renderPayments();\n}\n\n// ==================== CLIENTS TABLE ====================\nfunction renderClients() {\n  let html = '';\n  clients.forEach(c => {\n    const polCount = countClientPolicies(c.id);\n    const lastPay = getLastPaymentDate(c.id);\n    html += `<tr>\n      <td><strong>${getFullName(c)}</strong></td>\n      <td>${c.email}</td>\n      <td>${c.phone}</td>\n      <td>${getStatusBadge(c.status, 'client')}</td>\n      <td>${polCount || '<span style=\"color:var(--text-light)\">—</span>'}</td>\n      <td>${lastPay}</td>\n      <td class=\"actions-row\">\n        <button class=\"btn btn-sm\" onclick=\"navigateToPage('policies')\" title=\"View Policies\" style=\"background:#3498db;color:white;\">📋</button>\n        <button class=\"btn btn-danger\" onclick=\"deleteClient(${c.id})\" title=\"Delete\">✕</button>\n      </td></tr>`;\n  });\n\n  document.getElementById('clients-table').innerHTML = html || '';\n  document.getElementById('clients-empty').style.display = clients.length ? 'none' : 'block';\n}\n\nasync function saveClient(e) {\n  e.preventDefault();\n  const clientData = {\n    firstName: document.getElementById('cf-first').value,\n    lastName: document.getElementById('cf-last').value,\n    email: document.getElementById('cf-email').value,\n    phone: document.getElementById('cf-phone').value,\n    dateOfBirth: document.getElementById('cf-dob').value || null,\n    address: '', occupation: document.getElementById('cf-occupation').value,\n    annualIncome: parseInt(document.getElementById('cf-income').value) || 0,\n    registrationDate: new Date().toISOString().split('T')[0],\n    status: document.getElementById('cf-status').value === 'registered' ? 'active' : 'pending'\n  };\n\n  try {\n    const res = await fetch('/api/clients', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(clientData) });\n    if (res.ok) {\n      closeModal('client-modal');\n      e.target.reset();\n      loadData().then(() => renderClients()); // refresh from server\n    } else {\n      alert('Failed to save client. Check console.');\n    }\n  } catch(err) {\n    console.error('Save client error:', err);\n    alert('Network error saving client.');\n  }\n}\n\nasync function deleteClient(id) {\n  if (!confirm('Delete this client and all associated policies/payments?')) return;\n  await fetch(`/api/clients/${id}`, { method:'DELETE' });\n  loadData().then(() => renderClients());\n}\n\n// ==================== POLICIES TABLE ====================\nfunction populateClientSelect(selectId) {\n  const sel = document.getElementById(selectId);\n  sel.innerHTML = '<option value=\"\">— Select Client —</option>' + clients.map(c => `<option value=\"${c.id}\">${getFullName(c)}</option>`).join('');\n}\n\nasync function updatePolicySelect() {\n  const clientId = parseInt(document.getElementById('pm-client').value);\n  if (!clientId) return;\n  const clientPolicies = policies.filter(p => p.clientId === clientId);\n  document.getElementById('pm-policy').innerHTML = '<option value=\"\">— Select Policy —</option>' +\n    clientPolicies.map(p => `<option value=\"${p.id}\">${p.policyNumber} (${p.type}) - $${p.premiumAmount}/mo</option>`).join('');\n\n  // Auto-fill premium if policy selected\n  document.getElementById('pm-policy').onchange = function() {\n    const polId = parseInt(this.value);\n    const pol = policies.find(p => p.id === polId);\n    if (pol) document.getElementById('pm-amount').value = pol.premiumAmount;\n  };\n}\n\nfunction renderPolicies() {\n  let html = '';\n  policies.forEach(p => {\n    const client = clients.find(c => c.id === p.clientId);\n    html += `<tr>\n      <td><code>${p.policyNumber}</code></td>\n      <td>${client ? getFullName(client) : 'Unknown'}</td>\n      <td>${p.type}</td>\n      <td>$${p.faceValue.toLocaleString()}</td>\n      <td>$${parseFloat(p.premiumAmount).toLocaleString()}<br><small style=\"color:var(--text-light)\">${p.frequency}</small></td>\n      <td>${getStatusBadge(p.status, 'policy')}</td>\n      <td class=\"actions-row\">\n        <button class=\"btn btn-sm\" onclick=\"navigateToPage('payments')\" title=\"View Payments\" style=\"background:#3498db;color:white;\">💳</button>\n        <button class=\"btn btn-danger\" onclick=\"deletePolicy(${p.id})\" title=\"Delete\">✕</button>\n      </td></tr>`;\n  });\n\n  document.getElementById('policies-table').innerHTML = html || '';\n  document.getElementById('policies-empty').style.display = policies.length ? 'none' : 'block';\n}\n\nasync function savePolicy(e) {\n  e.preventDefault();\n  const policyData = {\n    clientId: parseInt(document.getElementById('pf-client').value),\n    type: document.getElementById('pf-type').value,\n    faceValue: parseFloat(document.getElementById('pf-coverage').value),\n    premiumAmount: parseFloat(document.getElementById('pf-premium').value),\n    frequency: document.getElementById('pf-freq').value,\n    startDate: document.getElementById('pf-start').value || new Date().toISOString().split('T')[0],\n    maturityDate: document.getElementById('pf-maturity').value || null,\n    status: document.getElementById('pf-status').value,\n    beneficiary: document.getElementById('pf-beneficiary').value\n  };\n\n  try {\n    const res = await fetch('/api/policies', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(policyData) });\n    if (res.ok) {\n      closeModal('policy-modal');\n      e.target.reset();\n      loadData().then(() => renderPolicies()); // refresh from server\n    } else {\n      alert('Failed to register policy. Check console.');\n    }\n  } catch(err) {\n    console.error('Save policy error:', err);\n    alert('Network error saving policy.');\n  }\n}\n\nasync function deletePolicy(id) {\n  if (!confirm('Delete this policy?')) return;\n  await fetch(`/api/policies/${id}`, { method:'DELETE' });\n  loadData().then(() => renderPolicies());\n}\n\n// ==================== PAYMENTS TABLE ====================\nfunction isRecentPayment(dateStr) {\n  const due = new Date(dateStr);\n  const now = new Date();\n  return (now - due) < (30 * 24 * 60 * 60 * 1000); // within last 30 days\n}\n\nfunction renderPayments() {\n  let html = '';\n  payments.forEach(p => {\n    const client = clients.find(c => c.id === p.clientId);\n    const policy = policies.find(pol => pol.id === p.policyId);\n    const statusBadge = getPaymentStatusBadge(p.status);\n    let dueAmount = '';\n\n    if (p.status !== 'paid') {\n      dueAmount = `<span class=\"overdue\">$${parseFloat(p.amount).toLocaleString()}</span>`;\n    } else {\n      dueAmount = '<span style=\"color:var(--accent)\">Received</span>';\n    }\n\n    html += `<tr>\n      <td>${new Date(p.dueDate).toLocaleDateString()}</td>\n      <td>${client ? getFullName(client) : 'Unknown'}</td>\n      <td><code>${policy ? policy.policyNumber.split(' - ')[0] : '?'}</code></td>\n      <td>${p.paymentMethod.replace('_',' ')}</td>\n      <td class=\"${isRecentPayment(p.dueDate)?'':'overdue'}\">${dueAmount||'<em style=\"color:var(--text-light);\">—</em>'}</td>\n      <td><span class=\"payment-amount\">$${parseFloat(p.amount).toLocaleString()}</span></td>\n      <td>${statusBadge}${p.reference?'<br><small style=\"color:var(--text-light)\">Ref:'+p.reference+'</small>':''}</td>\n    </tr>`;\n  });\n\n  document.getElementById('payments-table').innerHTML = html || '';\n  document.getElementById('payments-empty').style.display = payments.length ? 'none' : 'block';\n}\n\nasync function savePayment(e) {\n  e.preventDefault();\n  const paymentData = {\n    policyId: parseInt(document.getElementById('pm-policy').value),\n    clientId: parseInt(document.getElementById('pm-client').value),\n    amount: parseFloat(document.getElementById('pm-amount').value),\n    dueDate: document.getElementById('pm-due').value || new Date().toISOString().split('T')[0],\n    paidDate: document.getElementById('pm-paid-date').value,\n    paymentMethod: document.getElementById('pm-method').value,\n    status: document.getElementById('pm-status').value,\n    reference: document.getElementById('pm-ref').value || null\n  };\n\n  try {\n    const res = await fetch('/api/payments', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(paymentData) });\n    if (res.ok) {\n      closeModal('payment-modal');\n      e.target.reset();\n      loadData().then(() => renderPayments()); // refresh from server\n    } else {\n      alert('Failed to record payment. Check console.');\n    }\n  } catch(err) {\n    console.error('Save payment error:', err);\n    alert('Network error saving payment.');\n  }\n}\n\n// ==================== INIT ====================\nrenderAll();\n\nasync function renderAll() {\n  await loadData();\n  refreshDashboard();\n  populateClientSelect('pf-client');\n  populateClientSelect('pm-client');\n  renderClients();\n  renderPolicies();\n  renderPayments();\n}\n\nfunction navigateToPage(page) {\n  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));\n  const navItem = document.querySelector(`.nav-item[data-page=\"${page}\"]`);\n  if (navItem) navItem.click();\n}\n</script>\n</body>\n</html>\n"},"status":"ok","ms":1}
