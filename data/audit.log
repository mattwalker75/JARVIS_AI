{"t":"2026-07-25T23:15:13.343Z","tool":"run_shell","args":{"command":"python3 -c \"\nfrom playwright.sync_api import sync_playwright\nimport sys, time\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page()\n    \n    errors = []\n    console_msgs = []\n    page.on('console', lambda msg: console_msgs.append(f'[{msg.type}] {msg.text}'))\n    page.on('pageerror', lambda err: errors.append(str(err)))\n    \n    print('Navigating to doom game...')\n    try:\n        page.goto('http://localhost:9142/', timeout=10000)\n    except Exception as e:\n        print(f'Navigation error: {e}')\n        browser.close()\n        sys.exit(1)\n    \n    time.sleep(3)  # Let it render\n    \n    if errors:\n        print('JS ERRORS:')\n        for e in errors:\n            print(f'  ERROR: {e}')\n    \n    console_msgs = [m for m in console_msgs]\n    if console_msgs:\n        print('CONSOLE MESSAGES:')\n        for m in console_msgs[:20]:\n            print(f'  {m}')\n    \n    # Get the full page text to see what's displayed\n    body_text = page.inner_text('body', timeout=3000).strip()\n    print(f'\\n=== BODY TEXT ({len(body_text)} chars) ===')\n    print(body_text[:2000])\n    \n    # Find all interactive elements\n    buttons = page.query_selector_all('button, input[type=\\\"submit\\\"], [onclick]')\n    links = page.query_selector_all('a[href=\\\"#\\\"]')\n    canvases = page.query_selector_all('canvas')\n    \n    print(f'\\n=== INTERACTIVE ELEMENTS ===')\n    print(f'Buttons: {len(buttons)}')\n    for b in buttons:\n        try:\n            text = b.inner_text(timeout=100)\n            onclick = b.get_attribute('onclick') or 'none'\n            print(f'  Button: \\\"{text}\\\" (onclick={onclick})')\n        except:\n            pass\n    \n    print(f'Links (#): {len(links)}')\n    \n    # Check if there's a title/heading with DOOM text\n    doom_elements = page.query_selector_all('h1, h2, h3, .title, [class*=\\\"doom\\\"], [id*=\\\"doom\\\"]')\n    print(f'DOOM-related elements: {len(doom_elements)}')\n    \n    # Check the canvas content - is it rendering?\n    if canvases:\n        for i, c in enumerate(canvases):\n            width = c.get_attribute('width') or '?'\n            height = c.get_attribute('height') or '?'\n            print(f'Canvas {i}: {width}x{height}')\n    \n    # Now try clicking the DOOM button/link if found\n    doom_target = page.query_selector('#doom-btn, .start-game, [class*=\\\"start\\\"], text=DOOM')\n    if not doom_target:\n        # Try any clickable element that says DOOM or similar\n        all_elements = page.evaluate('''() => {\n            const els = document.querySelectorAll('*');\n            for (const el of els) {\n                if (el.textContent.includes('DOOM')) return el;\n            }\n            return null;\n        }''')\n        \n    print(f'\\n=== ATTEMPTING CLICK ===')\n    \n    # Get all text content to find DOOM button\n    doom_btn = page.evaluate('''() => {\n        // Look for any element containing \"DOOM\" that could be clicked\n        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_ELEMENT);\n        let node;\n        while (node = walker.nextNode()) {\n            if (node.textContent.includes('DOOM') && \n                (node.tagName === 'BUTTON' || node.tagName === 'A' || \n                 node.onclick !== null || node.style.cursor === 'pointer')) {\n                return { tag: node.tagName, text: node.textContent.trim(), id: node.id, class: node.className };\n            }\n        }\n        // Also check all buttons and links\n        for (const btn of document.querySelectorAll('button,a,[role=\\\"button\\\"]')) {\n            if (btn.textContent.includes('DOOM') || btn.innerText.includes('DOOM')) {\n                return { tag: btn.tagName, text: btn.textContent.trim(), id: btn.id };\n            }\n        }\n        return null;\n    }''')\n    \n    print(f'DOOM button found: {doom_btn}')\n    \n    if doom_btn:\n        # Click it via JS since selector might be tricky\n        click_result = page.evaluate('''() => {\n            const els = document.querySelectorAll('*');\n            for (const el of els) {\n                if (el.textContent.includes('DOOM') && \n                    (el.tagName === 'BUTTON' || el.tagName === 'A')) {\n                    el.click();\n                    return true;\n                }\n            }\n            return false;\n        }''')\n        print(f'Click result: {click_result}')\n        \n        time.sleep(3)  # Wait for game to start\n        \n        if errors:\n            print('JS ERRORS AFTER CLICK:')\n            for e in errors[-5:]:\n                print(f'  ERROR: {e}')\n    \n    browser.close()\n\" 2>&1","timeout_s":30},"status":"ok","ms":333}
