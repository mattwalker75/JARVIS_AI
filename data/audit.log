{"t":"2026-07-28T04:23:24.955Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# === CAPITAL ACCOUNT ENTRY for Marcus Chen's $25K investment (fixed kind) ===\ntry:\n    cur.execute(\"\"\"INSERT INTO business_capital_accounts \n        (business_id, owner_id, year, entry_date, kind, amount_cents, notes)\n        VALUES (2, 1, 2025, '2025-03-15', 'contribution', 2500000, \n                'Initial capital: $25K for LLC formation, domain registration, first month software stack')\"\"\")\n    print('Capital account inserted.')\nexcept Exception as e:\n    print(f'Capital account skipped (exists): {e}')\n\n# === RECURRING BUSINESS EXPENSES (monthly) - correct columns: label, amount_cents, frequency, next_due_date, notes ===\nexpenses = [\n    ('Pictory AI Enterprise Plan', 12900),\n    ('ElevenLabs Premium Voiceover', 2833),\n    ('Google Workspace Business', 7200),\n    ('Canva Pro Team Design', 1500),\n    ('TubeBuddy YouTube SEO', 4900),\n    ('Notion Business+ PM', 1000),\n    ('Slack Pro Communication', 1500),\n    ('VidIQ Pro Suite Analytics', 7900),\n    ('Adobe Creative Cloud (2 seats)', 6000),\n    ('Upwork Freelance Editor Retainer', 80000),\n    ('Freelance Scriptwriter Projects', 80000),\n    ('LLM API Credits GPT-4/Claude', 15000),\n    ('Stock Footage Storyblocks+Envato', 6979),\n]\n\nfor label, amount_cents in expenses:\n    cur.execute(\"\"\"INSERT INTO business_recurring_expenses \n        (business_id, label, amount_cents, frequency, next_due_date, notes)\n        VALUES (?, ?, ?, 'monthly', date('now', '+1 month'), ?)\"\"\",\n        (2, label, amount_cents, f'{label} — monthly recurring expense'))\n\n# === RECURRING BILLS - correct columns: vendor_name, bill_number_prefix, amount_cents, notes, frequency, interval_count, next_run_date, active ===\nfor i, (label, amount_cents) in enumerate(expenses):\n    cur.execute(\"\"\"INSERT INTO recurring_bills \n        (business_id, vendor_name, bill_number_prefix, amount_cents, notes, frequency, interval_count, next_run_date, active)\n        VALUES (?, ?, 'SDA-BILL', ?, ?, 'monthly', 1, date('now', '+7 days'), 1)\"\"\",\n        (2, label.split()[0], amount_cents, f'Monthly bill for {label}'))\n\n# === ADDITIONAL LEDGER TRANSACTIONS for realistic monthly history ===\nledger_entries = [\n    ('2025-04-15', 'client_payment', 'FitFuel Nutrition — Invoice #SDA-2025-002', 399700),\n    ('2025-05-01', 'software_expense', 'Pictory AI Enterprise (May)', -12900),\n    ('2025-05-01', 'software_expense', 'ElevenLabs Premium (May)', -3400),\n    ('2025-05-01', 'software_expense', 'Google Workspace (May)', -7200),\n    ('2025-06-01', 'client_payment', 'Zenith Wealth Partners — Invoice #SDA-2025-003', 300000),\n    ('2025-06-01', 'software_expense', 'Pictory AI Enterprise (June)', -12900),\n    ('2025-07-01', 'client_payment', 'Lumina Skincare — Invoice #SDA-2025-004', 450000),\n    ('2025-08-01', 'software_expense', 'Pictory AI Enterprise (Aug)', -12900),\n    ('2025-08-01', 'client_payment', 'TechVault Reviews — Invoice #SDA-2025-005', 250000),\n    ('2025-09-01', 'software_expense', 'Pictory AI Enterprise (Sep)', -12900),\n    ('2026-01-01', 'client_payment', 'NovaMind AI — Jan Retainer', 350000),\n    ('2026-01-01', 'software_expense', 'Pictory AI Enterprise (Jan)', -12900),\n    ('2026-02-01', 'client_payment', 'NovaMind AI — Feb Retainer', 350000),\n    ('2026-02-01', 'software_expense', 'Pictory AI Enterprise (Feb)', -12900),\n]\n\nfor txn_date, txn_type, counterparty, amount_cents in ledger_entries:\n    cur.execute(\"\"\"INSERT INTO ledger_transactions \n        (business_id, txn_date, txn_year, txn_type, counterparty, amount_cents, notes)\n        VALUES (?, ?, CAST(strftime('%Y', ?) AS INTEGER), ?, ?, ?, 'Auto-generated historical entry')\"\"\",\n        (2, txn_date[:4], txn_date, txn_type, counterparty, amount_cents))\n\n# === UPDATE BUDGET for 2026 with realistic projections ===\nbudget_2026 = [\n    ('Revenue', 'YouTube Faceless Services', 5987000),\n    ('Revenue', 'TikTok/Shorts Automation', 1499000),\n    ('Revenue', 'One-Time Setup Fees', 340000),\n    ('Operating Expense', 'Pictory AI Enterprise', 154800),\n    ('Operating Expense', 'ElevenLabs Premium', 69600),\n    ('Operating Expense', 'Google Workspace', 86400),\n    ('Operating Expense', 'Contract Editors & Writers', 2376000),\n]\n\nfor type_key, category, planned_cents in budget_2026:\n    cur.execute(\"\"\"INSERT INTO budget_entries \n        (business_id, year, type_key, category, planned_cents)\n        VALUES (?, 2026, ?, ?, ?)\"\"\",\n        (2, type_key, category, planned_cents))\n\nconn.commit()\n\n# === VERIFICATION ===\nprint('\\n=== VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_capital_accounts WHERE business_id = 2\")\nprint(f'Capital accounts: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE is_active != 0 AND business_id = 2\")\ntotal_monthly = cur.fetchone()[0] or 0\nprint(f'Total monthly recurring expenses (cents): {total_monthly} (${total_monthly/100:.2f})')\n\ncur.execute(\"SELECT COUNT(*) FROM recurring_bills WHERE business_id = 2 AND active = 1\")\nprint(f'Recurring bills: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT COUNT(*) FROM ledger_transactions WHERE business_id = 2\")\nprint(f'Ledger transactions total: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT COUNT(*) FROM budget_entries WHERE business_id = 2 AND year = 2026\")\nprint(f'Budget entries for 2026: {cur.fetchone()[0]}')\n\n# Calculate projected annual revenue vs expenses\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Revenue', 'Income')\"\"\")\nrev = cur.fetchone()[0] or 0\nprint(f'\\nProjected 2026 Revenue: ${rev/100:.2f}')\n\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Operating Expense', 'Expense')\"\"\")\nexp = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Expenses: ${exp/100:.2f}')\n\nnet = rev - exp\nmargin = (net * 100) // rev if rev else 0\nprint(f'Projected 2026 Net Income: ${net/100:.2f} ({margin}% margin)')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":136}
{"t":"2026-07-28T04:23:37.018Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# === VERIFICATION ===\nprint('\\n=== VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_capital_accounts WHERE business_id = 2\")\nprint(f'Capital accounts: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE business_id = 2\")\ntotal_monthly = cur.fetchone()[0] or 0\nprint(f'Total monthly recurring expenses (cents): {total_monthly} (${total_monthly/100:.2f})')\n\ncur.execute(\"SELECT COUNT(*) FROM recurring_bills WHERE business_id = 2 AND active = 1\")\nprint(f'Recurring bills: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT COUNT(*) FROM ledger_transactions WHERE business_id = 2\")\nprint(f'Ledger transactions total: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT COUNT(*) FROM budget_entries WHERE business_id = 2 AND year = 2026\")\nprint(f'Budget entries for 2026: {cur.fetchone()[0]}')\n\n# Calculate projected annual revenue vs expenses\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Revenue', 'Income')\"\"\")\nrev = cur.fetchone()[0] or 0\nprint(f'\\nProjected 2026 Revenue: ${rev/100:.2f}')\n\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Operating Expense', 'Expense')\"\"\")\nexp = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Expenses: ${exp/100:.2f}')\n\nnet = rev - exp\nmargin = (net * 100) // rev if rev else 0\nprint(f'Projected 2026 Net Income: ${net/100:.2f} ({margin}% margin)')\n\n# Show recurring expenses summary\ncur.execute(\"SELECT label, amount_cents FROM business_recurring_expenses WHERE business_id = 2 ORDER BY amount_cents DESC\")\nrows = cur.fetchall()\nprint(f'\\nMonthly Expense Breakdown:')\nfor label, amt in rows:\n    print(f'  {label}: ${amt/100:.2f}/mo')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":141}
{"t":"2026-07-28T04:23:52.032Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check existing contacts for biz=2\nprint('=== CONTACTS SCHEMA ===')\ncols_c = cur.execute('PRAGMA table_info(contacts)').fetchall()\ncol_names_c = [r[1] for r in cols_c]\nfor c in col_names_c: print(c)\n\ncur.execute(\\\"SELECT * FROM contacts WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'\\nExisting contacts (biz=2): {len(rows)}')\nif rows:\n    for row in rows[:10]: \n        d = dict(zip(col_names_c, row))\n        print(d)\n\n# Check business_contacts schema  \ncols_bc = cur.execute('PRAGMA table_info(business_contacts)').fetchall()\ncol_names_bc = [r[1] for r in cols_bc]\nprint(f'\\n=== BUSINESS_CONTACTS COLUMNS ===')\nfor c in col_names_bc: print(c)\n\ncur.execute(\\\"SELECT * FROM business_contacts WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Business contacts (biz=2): {len(rows)}')\n\n# Check business_customers schema\ncols_cust = cur.execute('PRAGMA table_info(business_customers)').fetchall()\ncol_names_cust = [r[1] for r in cols_cust]\nprint(f'\\n=== BUSINESS_CUSTOMERS COLUMNS ===')\nfor c in col_names_cust: print(c)\n\ncur.execute(\\\"SELECT * FROM business_customers WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Customers (biz=2): {len(rows)}')\nif rows:\n    for row in rows[:5]: \n        d = dict(zip(col_names_cust, row))\n        print(d)\n\n# Check business_vendors schema  \ncols_vendor = cur.execute('PRAGMA table_info(business_vendors)').fetchall()\ncol_names_vendor = [r[1] for r in cols_vendor]\nprint(f'\\n=== BUSINESS_VENDORS COLUMNS ===')\nfor c in col_names_vendor: print(c)\n\ncur.execute(\\\"SELECT * FROM business_vendors WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Vendors (biz=2): {len(rows)}')\n\n# Check phones, addresses, emails for biz=2\ncols_phone = cur.execute('PRAGMA table_info(business_phones)').fetchall()\ncol_names_phone = [r[1] for r in cols_phone]\ncur.execute(\\\"SELECT * FROM business_phones WHERE business_id = 2\\\")\nrows_p = cur.fetchall()\nprint(f'\\nPhones (biz=2): {len(rows_p)}')\n\ncols_addr = cur.execute('PRAGMA table_info(business_addresses)').fetchall()\ncol_names_addr = [r[1] for r in cols_addr]\ncur.execute(\\\"SELECT * FROM business_addresses WHERE business_id = 2\\\")\nrows_a = cur.fetchall()\nprint(f'Addresses (biz=2): {len(rows_a)}')\n\ncols_email = cur.execute('PRAGMA table_info(business_emails)').fetchall()\ncol_names_email = [r[1] for r in cols_email]\ncur.execute(\\\"SELECT * FROM business_emails WHERE business_id = 2\\\")\nrows_e = cur.fetchall()\nprint(f'Emails (biz=2): {len(rows_e)}')\n\n# Check social links  \ncols_social = cur.execute('PRAGMA table_info(business_social_links)').fetchall()\ncol_names_social = [r[1] for r in cols_social]\ncur.execute(\\\"SELECT * FROM business_social_links WHERE business_id = 2\\\")\nrows_s = cur.fetchall()\nprint(f'Social links (biz=2): {len(rows_s)}')\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":141}
{"t":"2026-07-28T04:24:31.968Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# === BUSINESS CONTACTS (internal team) for Summit Digital Agency ===\nteam_members = [\n    ('Marcus Chen', 'Managing Member & CEO', 'marcus@summitdigitalagency.com', '+1-512-893-7462', 'Founder, handles strategy and client relations'),\n    ('Sarah Kim', 'Head of Content Operations', 'sarah.kim@summitdigitalagency.io', '+1-512-893-7463', 'Oversees all content production workflows and quality control'),\n    ('James Rivera', 'Lead Video Editor (Contractor)', 'james.r@freelance.com', '+1-305-555-0198', 'Senior editor specializing in faceless YouTube format, 6+ years exp'),\n    ('Priya Sharma', 'Scriptwriter & Researcher (Contractor)', 'priya.s@scriptpro.io', '+1-469-555-0273', 'Specializes in AI narration scripts for history/finance niches'),\n    ('Alex Novak', 'Thumbnail Designer (Contractor)', 'alex.novak@design.co', '+1-214-555-0847', 'CTR-focused thumbnail artist, A/B testing specialist'),\n    ('David Okonkwo', 'SEO & Analytics Manager (Part-time)', 'david.o@seoanalytics.com', '+1-617-555-0392', 'YouTube SEO expert with 8 years channel growth experience'),\n]\n\nfor name, role, email, phone, notes in team_members:\n    cur.execute(\"\"\"INSERT INTO business_contacts \n        (business_id, name, organization, role, email, phone, notes)\n        VALUES (?, ?, 'Summit Digital Agency LLC', ?, ?, ?, ?)\"\"\",\n        (2, name, role, email, phone, notes))\n\n# === ADD MORE VENDORS for the agency's supply chain ===\nvendors = [\n    ('Namecheap Inc.', 'Domain & Hosting', 'enterprise@namecheap.com', '+1-866-590-7431', 1, 'Primary domain registrar and hosting provider'),\n    ('Google LLC (Workspace)', 'Business Email/Cloud', 'workspace@google.com', '', 1, 'G Suite Business Plus for email, Drive, Calendar'),\n    ('Adobe Inc.', 'Creative Software', 'enterprise@adobe.com', '+1-800-537-6492', 1, 'CC subscription — Premiere Pro + Photoshop licenses'),\n    ('Storyblocks LLC', 'Stock Footage/Music', 'support@storyblocks.com', '', 1, 'Unlimited stock footage and music licensing'),\n    ('Envato Market (GraphicRiver)', 'Graphics/Assets', 'support@envato.com', '+61-3-9824-0756', 0, 'One-off graphics templates and overlays'),\n]\n\nfor name, cat, email, phone, w9, notes in vendors:\n    cur.execute(\"\"\"INSERT INTO business_vendors \n        (business_id, name, category, email, phone, w9_on_file, notes)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n        (2, name, cat, email, phone, 1 if w9 else 0, notes))\n\n# === BUSINESS PHONES for Summit Digital Agency ===\nphones = [\n    ('+1-512-893-7462', 'primary', '+1-512-893-7462', '', 'Main office line — Marcus Chen'),\n    ('hello@summitdigitalagency.com', 'email_primary', '', 'hello@summitdigitalagency.io', 'General inquiries email'),\n]\n\n# === BUSINESS ADDRESSES for Summit Digital Agency ===\ncur.execute(\"\"\"INSERT INTO business_addresses \n    (business_id, address_line1, city, state_province, postal_code, country, type)\n    VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n    (2, '4500 S MoPac Expy Suite 600', 'Austin', 'TX', '78735', 'United States', 'business'))\n\n# === BUSINESS EMAILS for Summit Digital Agency ===\nemails = [\n    ('hello@summitdigitalagency.io', 'primary'),\n    ('billing@summitdigitalagency.io', 'billing'),\n    ('support@summitdigitalagency.io', 'support'),\n]\n\nfor email, type_ in emails:\n    cur.execute(\"\"\"INSERT INTO business_emails \n        (business_id, address, label) VALUES (?, ?, ?)\"\"\",\n        (2, email, type_))\n\n# === BUSINESS SOCIAL LINKS for Summit Digital Agency ===\nsocials = [\n    ('LinkedIn', 'https://linkedin.com/company/summit-digital-agency-llc'),\n    ('Twitter/X', 'https://x.com/SummitDigitalAI'),\n    ('YouTube (Our Channel)', 'https://youtube.com/@SummitDigitalAgency'),\n]\n\nfor platform, url in socials:\n    cur.execute(\"\"\"INSERT INTO business_social_links \n        (business_id, name, url) VALUES (?, ?, ?)\"\"\",\n        (2, platform, url))\n\n# === ADD MORE CUSTOMERS for the agency's client base ===\ncustomers = [\n    ('NovaMind AI', 'contact@novamindai.com', '+1-408-555-0673', '', 'Faceless YouTube Automation — Full Package. Premium tier ($3,500/mo). Client since March 2025.'),\n    ('FitFuel Nutrition', 'hello@fitfuelnutrition.com', '+1-949-555-0821', '', 'YouTube Shorts Faceless Series — Daily uploads. Enterprise tier ($4,999/mo). Client since May 2025.'),\n    ('TechVault Reviews', 'info@techvaultreviews.net', '+1-650-555-0892', '', 'TikTok + YouTube Shorts Product Reviews. Standard tier ($2,500/mo). Upgraded from Starter in Jan 2025.'),\n    ('Zenith Wealth Partners', 'content@zenithwealth.com', '+1-312-555-0447', '', 'Faceless Finance Channel — Weekly videos. Premium tier ($3,000/mo). Client since July 2025.'),\n    ('Lumina Skincare', 'social@luminaskincare.co', '+1-310-555-0998', '', 'TikTok + IG Reels Faceless Beauty Content. Enterprise tier ($4,500/mo). Client since Sept 2025.'),\n    ('DeepSpace Facts', 'admin@deepspacefacts.com', '+1-720-555-0334', '', 'Astronomy/Science faceless channel. Growth Bundle client since April 2025.'),\n]\n\nfor name, email, phone, address, notes in customers:\n    cur.execute(\"\"\"INSERT INTO business_customers \n        (business_id, name, email, phone, billing_address, notes)\n        VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (2, name, email, phone, 'United States', notes))\n\n# === ADD BUSINESS CONTACTS for key client POCs ===\nclient_pocs = [\n    ('NovaMind AI — Alex Torres', 'content@novamindai.com', '+1-408-555-0673', 'Content Director at NovaMind AI. Primary contact for YouTube automation retainer.'),\n    ('FitFuel Nutrition — Rachel Park', 'hello@fitfuelnutrition.com', '+1-949-555-0821', 'Social Media Manager at FitFuel. Manages daily Shorts content delivery.'),\n    ('Zenith Wealth Partners — Mark Sullivan', 'content@zenithwealth.com', '+1-312-555-0447', 'Marketing VP at Zenith Wealth. Oversees faceless finance channel production.'),\n]\n\nfor name, email, phone, notes in client_pocs:\n    cur.execute(\"\"\"INSERT INTO business_contacts \n        (business_id, name, organization, role, email, phone, notes)\n        VALUES (?, ?, 'Client', 'POC', ?, ?, ?)\"\"\",\n        (2, name.split(' — ')[0], email, phone, notes))\n\n# === BUSINESS BANKING ACCOUNTS ===\ncur.execute(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, bank_name, account_type, account_number_last4, routing_number, status)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Mercury Treasury Services', 'Business Checking', '8471', '026009593', 'active'))\n\ncur.execute(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, bank_name, account_type, account_number_last4, routing_number, status)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Mercury Treasury Services', 'Business Savings', '3912', '026009593', 'active'))\n\n# === BUSINESS INSURANCE ===\ncur.execute(\"\"\"INSERT INTO business_insurance \n    (business_id, provider, policy_type, policy_number, coverage_amount_cents, premium_cents, renewal_date)\n    VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Hiscox', 'Professional Liability / E&O', 'POL-SDA-2025-8471', 100000000, 39900, '2026-12-15'))\n\n# === BUSINESS LICENSES ===\ncur.execute(\"\"\"INSERT INTO business_licenses \n    (business_id, license_type, license_number, issuing_authority, issue_date, expiry_date)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Business Operation License', 'BOL-TX-78735-SDA', 'Travis County Clerk', '2024-01-20', '2026-01-20'))\n\n# === BUSINESS DOMAINS ===\ndomains = [\n    ('summitdigitalagency.io', 'primary'),\n    ('summitdigital.com', 'redirect_to_primary'),\n]\n\nfor domain, type_ in domains:\n    cur.execute(\"\"\"INSERT INTO business_domains \n        (business_id, domain_name, status) VALUES (?, ?, ?)\"\"\",\n        (2, domain, type_))\n\nconn.commit()\n\n# === VERIFICATION ===\nprint('=== CONTACTS & TEAM VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_contacts WHERE business_id = 2\")\nprint(f'Business contacts: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT name, role FROM business_contacts WHERE business_id = 2 ORDER BY id DESC LIMIT 10\")\nfor row in cur.fetchall(): print(f'  Contact: {row[0]} — {row[1]}')\n\ncur.execute(\"SELECT COUNT(*) FROM business_customers WHERE business_id = 2\")\nprint(f'\\nCustomers total: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT name, email FROM business_vendors WHERE business_id = 2\")\nfor row in cur.fetchall(): print(f'  Vendor: {row[0]} — {row[1]}')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":133}
{"t":"2026-07-28T04:24:38.105Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nfor tbl in ['business_addresses', 'business_emails', 'business_social_links', 'business_banking_accounts', 'business_insurance', 'business_licenses', 'business_domains']:\n    cols = cur.execute(f'PRAGMA table_info({tbl})').fetchall()\n    print(f'\\n=== {tbl} ===')\n    for r in cols: print(r)\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":137}
{"t":"2026-07-28T04:25:16.171Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# === BUSINESS CONTACTS (internal team) for Summit Digital Agency ===\nteam_members = [\n    ('Marcus Chen', 'Managing Member & CEO', 'marcus@summitdigitalagency.com', '+1-512-893-7462', 'Founder, handles strategy and client relations'),\n    ('Sarah Kim', 'Head of Content Operations', 'sarah.kim@summitdigitalagency.io', '+1-512-893-7463', 'Oversees all content production workflows and quality control'),\n    ('James Rivera', 'Lead Video Editor (Contractor)', 'james.r@freelance.com', '+1-305-555-0198', 'Senior editor specializing in faceless YouTube format, 6+ years exp'),\n    ('Priya Sharma', 'Scriptwriter & Researcher (Contractor)', 'priya.s@scriptpro.io', '+1-469-555-0273', 'Specializes in AI narration scripts for history/finance niches'),\n    ('Alex Novak', 'Thumbnail Designer (Contractor)', 'alex.novak@design.co', '+1-214-555-0847', 'CTR-focused thumbnail artist, A/B testing specialist'),\n    ('David Okonkwo', 'SEO & Analytics Manager (Part-time)', 'david.o@seoanalytics.com', '+1-617-555-0392', 'YouTube SEO expert with 8 years channel growth experience'),\n]\n\nfor name, role, email, phone, notes in team_members:\n    cur.execute(\"\"\"INSERT INTO business_contacts \n        (business_id, name, organization, role, email, phone, notes)\n        VALUES (?, ?, 'Summit Digital Agency LLC', ?, ?, ?, ?)\"\"\",\n        (2, name, role, email, phone, notes))\n\n# === ADD MORE VENDORS for the agency's supply chain ===\nvendors = [\n    ('Namecheap Inc.', 'Domain & Hosting', 'enterprise@namecheap.com', '+1-866-590-7431', 1, 'Primary domain registrar and hosting provider'),\n    ('Google LLC (Workspace)', 'Business Email/Cloud', 'workspace@google.com', '', 1, 'G Suite Business Plus for email, Drive, Calendar'),\n    ('Adobe Inc.', 'Creative Software', 'enterprise@adobe.com', '+1-800-537-6492', 1, 'CC subscription — Premiere Pro + Photoshop licenses'),\n    ('Storyblocks LLC', 'Stock Footage/Music', 'support@storyblocks.com', '', 1, 'Unlimited stock footage and music licensing'),\n    ('Envato Market (GraphicRiver)', 'Graphics/Assets', 'support@envato.com', '+61-3-9824-0756', 0, 'One-off graphics templates and overlays'),\n]\n\nfor name, cat, email, phone, w9, notes in vendors:\n    cur.execute(\"\"\"INSERT INTO business_vendors \n        (business_id, name, category, email, phone, w9_on_file, notes)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n        (2, name, cat, email, phone, 1 if w9 else 0, notes))\n\n# === BUSINESS ADDRESSES for Summit Digital Agency ===\ncur.execute(\"\"\"INSERT INTO business_addresses \n    (business_id, label, line1, city, state, postal_code, country, is_primary)\n    VALUES (?, ?, ?, ?, ?, ?, ?, 1)\"\"\",\n    (2, 'Office', '4500 S MoPac Expy Suite 600', 'Austin', 'TX', '78735', 'United States'))\n\n# === BUSINESS EMAILS for Summit Digital Agency ===\nemails = [\n    ('hello@summitdigitalagency.io', 'primary'),\n    ('billing@summitdigitalagency.io', 'billing'),\n    ('support@summitdigitalagency.io', 'support'),\n]\n\nfor email, label in emails:\n    cur.execute(\"\"\"INSERT INTO business_emails \n        (business_id, label, email, is_primary) VALUES (?, ?, ?, ?)\"\"\",\n        (2, label, email, 1 if label == 'primary' else 0))\n\n# === BUSINESS SOCIAL LINKS for Summit Digital Agency ===\nsocials = [\n    ('LinkedIn', 'SummitDigitalAgency', 'https://linkedin.com/company/summit-digital-agency-llc'),\n    ('Twitter/X', '@SummitDigitalAI', 'https://x.com/SummitDigitalAI'),\n    ('YouTube (Our Channel)', '@SummitDigitalAgency', 'https://youtube.com/@SummitDigitalAgency'),\n]\n\nfor platform, handle, url in socials:\n    cur.execute(\"\"\"INSERT INTO business_social_links \n        (business_id, platform, handle, url) VALUES (?, ?, ?, ?)\"\"\",\n        (2, platform, handle, url))\n\n# === ADD MORE CUSTOMERS for the agency's client base ===\ncustomers = [\n    ('NovaMind AI', 'contact@novamindai.com', '+1-408-555-0673', '', 'Faceless YouTube Automation — Full Package. Premium tier ($3,500/mo). Client since March 2025.'),\n    ('FitFuel Nutrition', 'hello@fitfuelnutrition.com', '+1-949-555-0821', '', 'YouTube Shorts Faceless Series — Daily uploads. Enterprise tier ($4,999/mo). Client since May 2025.'),\n    ('TechVault Reviews', 'info@techvaultreviews.net', '+1-650-555-0892', '', 'TikTok + YouTube Shorts Product Reviews. Standard tier ($2,500/mo). Upgraded from Starter in Jan 2025.'),\n    ('Zenith Wealth Partners', 'content@zenithwealth.com', '+1-312-555-0447', '', 'Faceless Finance Channel — Weekly videos. Premium tier ($3,000/mo). Client since July 2025.'),\n    ('Lumina Skincare', 'social@luminaskincare.co', '+1-310-555-0998', '', 'TikTok + IG Reels Faceless Beauty Content. Enterprise tier ($4,500/mo). Client since Sept 2025.'),\n    ('DeepSpace Facts', 'admin@deepspacefacts.com', '+1-720-555-0334', '', 'Astronomy/Science faceless channel. Growth Bundle client since April 2025.'),\n]\n\nfor name, email, phone, address, notes in customers:\n    cur.execute(\"\"\"INSERT INTO business_customers \n        (business_id, name, email, phone, billing_address, notes)\n        VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (2, name, email, phone, 'United States', notes))\n\n# === ADD BUSINESS CONTACTS for key client POCs ===\nclient_pocs = [\n    ('NovaMind AI — Alex Torres', 'content@novamindai.com', '+1-408-555-0673', 'Content Director at NovaMind AI. Primary contact for YouTube automation retainer.'),\n    ('FitFuel Nutrition — Rachel Park', 'hello@fitfuelnutrition.com', '+1-949-555-0821', 'Social Media Manager at FitFuel. Manages daily Shorts content delivery.'),\n    ('Zenith Wealth Partners — Mark Sullivan', 'content@zenithwealth.com', '+1-312-555-0447', 'Marketing VP at Zenith Wealth. Oversees faceless finance channel production.'),\n]\n\nfor name, email, phone, notes in client_pocs:\n    cur.execute(\"\"\"INSERT INTO business_contacts \n        (business_id, name, organization, role, email, phone, notes)\n        VALUES (?, ?, 'Client', 'POC', ?, ?, ?)\"\"\",\n        (2, name.split(' — ')[0], email, phone, notes))\n\n# === BUSINESS BANKING ACCOUNTS ===\ncur.execute(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, institution, account_label, account_number, routing_number, account_type)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Mercury Treasury Services', 'Business Checking — Primary Operations', '****8471', '026009593', 'checking'))\n\ncur.execute(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, institution, account_label, account_number, routing_number, account_type)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Mercury Treasury Services', 'Business Savings — Reserve Fund', '****3912', '026009593', 'savings'))\n\n# === BUSINESS INSURANCE ===\ncur.execute(\"\"\"INSERT INTO business_insurance \n    (business_id, carrier, policy_number, coverage_type, premium_cents, renewal_date)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Hiscox', 'POL-SDA-2025-8471', 'Professional Liability / Errors & Omissions ($1M)', 39900, '2026-12-15'))\n\n# === BUSINESS LICENSES ===\ncur.execute(\"\"\"INSERT INTO business_licenses \n    (business_id, jurisdiction, license_type, license_number, issued_date, expires_date)\n    VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n    (2, 'Texas', 'Business Operation License', 'BOL-TX-78735-SDA', '2024-01-20', '2026-01-20'))\n\n# === BUSINESS DOMAINS ===\ndomains = [\n    ('summitdigitalagency.io', 'Namecheap'),\n    ('summitdigital.com', 'Namecheap'),\n]\n\nfor domain, registrar in domains:\n    cur.execute(\"\"\"INSERT INTO business_domains \n        (business_id, domain, registrar) VALUES (?, ?, ?)\"\"\",\n        (2, domain, registrar))\n\nconn.commit()\n\n# === VERIFICATION ===\nprint('=== CONTACTS & TEAM VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_contacts WHERE business_id = 2\")\nprint(f'Business contacts: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT name, role FROM business_contacts WHERE business_id = 2 ORDER BY contact_id DESC LIMIT 15\")\nfor row in cur.fetchall(): print(f'  Contact: {row[0]} — {row[1]}')\n\nprint()\ncur.execute(\"SELECT COUNT(*) FROM business_customers WHERE business_id = 2\")\nprint(f'Customers total: {cur.fetchone()[0]}')\n\ncur.execute(\"SELECT name, email FROM business_vendors WHERE business_id = 2\")\nfor row in cur.fetchall(): print(f'  Vendor: {row[0]} — {row[1]}')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":140}
{"t":"2026-07-28T04:25:28.796Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check documents schema and existing docs for biz=2\ncols_d = cur.execute('PRAGMA table_info(documents)').fetchall()\ncol_names_d = [r[1] for r in cols_d]\nprint(f'=== DOCUMENTS COLUMNS ===')\nfor c in col_names_d: print(c)\n\ncur.execute(\\\"SELECT * FROM documents WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'\\nExisting docs (biz=2): {len(rows)}')\nif rows:\n    for row in rows[:5]: \n        d = dict(zip(col_names_d, row))\n        print(d)\n\n# Check document_folders schema  \ncols_df = cur.execute('PRAGMA table_info(document_folders)').fetchall()\ncol_names_df = [r[1] for r in cols_df]\nprint(f'\\n=== DOCUMENT_FOLDERS COLUMNS ===')\nfor c in col_names_df: print(c)\n\ncur.execute(\\\"SELECT * FROM document_folders WHERE business_id = 2\\\")\nrows_f = cur.fetchall()\nprint(f'Folders (biz=2): {len(rows_f)}')\n\n# Check document_tags schema  \ncols_dt = cur.execute('PRAGMA table_info(document_tags)').fetchall()\ncol_names_dt = [r[1] for r in cols_dt]\nprint(f'\\n=== DOCUMENT_TAGS COLUMNS ===')\nfor c in col_names_dt: print(c)\n\ncur.execute(\\\"SELECT * FROM document_tags WHERE business_id = 2\\\")\nrows_t = cur.fetchall()\nprint(f'Tags (biz=2): {len(rows_t)}')\n\n# Check document_categories schema  \ncols_dc = cur.execute('PRAGMA table_info(business_document_categories)').fetchall()\ncol_names_dc = [r[1] for r in cols_dc]\nprint(f'\\n=== BUSINESS_DOCUMENT_CATEGORIES COLUMNS ===')\nfor c in col_names_dc: print(c)\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":141}
