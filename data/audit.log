{"t":"2026-07-26T18:28:54.621Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom.py","content":"\"\"\"Comprehensive Playwright test for the DOOM-like raycasting FPS game.\"\"\"\nimport sys, time\nfrom playwright.sync_api import sync_playwright\n\ndef run_tests():\n    errors = []\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n\n        # Collect console messages\n        console_msgs = []\n        def on_console(msg):\n            console_msgs.append({\"level\": msg.type, \"text\": msg.text})\n        page.on(\"console\", on_console)\n\n        # Navigate to the game\n        print(\"[TEST] Navigating to http://localhost:9101 ...\")\n        try:\n            page.goto(\"http://localhost:9101\", timeout=15000)\n        except Exception as e:\n            errors.append(f\"Navigation failed: {e}\")\n            browser.close()\n            return errors\n\n        # Wait for canvas to appear\n        print(\"[TEST] Waiting for canvas...\")\n        try:\n            page.wait_for_selector(\"canvas\", timeout=5000)\n        except Exception as e:\n            errors.append(f\"Canvas not found after 5s: {e}\")\n        \n        # Check the game title/header\n        print(\"[TEST] Checking page content...\")\n        body_text = page.inner_text(\"body\").strip()[:200] if len(page.inner_text(\"body\")) > 0 else \"(empty)\"\n        print(f\"  Body preview: {body_text}\")\n\n        # Simulate key presses (WASD movement + space for shoot)\n        print(\"[TEST] Simulating gameplay — pressing keys...\")\n        page.keyboard.press(\"KeyW\")\n        time.sleep(0.15)\n        page.keyboard.press(\"KeyA\")\n        time.sleep(0.15)\n        page.keyboard.press(\"KeyS\")\n        time.sleep(0.15)\n        page.keyboard.press(\"KeyD\")\n        time.sleep(0.15)\n        page.keyboard.press(\"Space\")  # shoot\n        time.sleep(0.2)\n\n        # Press arrow keys (strafe/look)\n        print(\"[TEST] Arrow key inputs...\")\n        for _ in range(3):\n            page.keyboard.press(\"ArrowLeft\")\n            time.sleep(0.1)\n            page.keyboard.press(\"ArrowRight\")\n            time.sleep(0.1)\n\n        # Check that canvas still exists and has content (non-zero dimensions)\n        print(\"[TEST] Verifying canvas state...\")\n        try:\n            canvas = page.query_selector(\"canvas\")\n            if not canvas:\n                errors.append(\"Canvas disappeared after gameplay\")\n            else:\n                w = int(canvas.evaluate(\"el => el.width\"))\n                h = int(canvas.evaluate(\"el => el.height\"))\n                print(f\"  Canvas dimensions: {w}x{h}\")\n                if w == 0 or h == 0:\n                    errors.append(f\"Canvas has zero dimension: {w}x{h}\")\n\n                # Check canvas pixel data — should have non-white pixels (game rendering)\n                pixel_data = page.evaluate(\"\"\"() => {\n                    const c = document.querySelector('canvas');\n                    if (!c || !c.width || !c.height) return null;\n                    const ctx = c.getContext('2d');\n                    const imgData = ctx.getImageData(0, 0, Math.min(c.width,4), Math.min(c.height,4));\n                    // Check for non-white pixels (game content)\n                    let hasContent = false;\n                    for(let i=0;i<imgData.data.length;i+=4){\n                        if(imgData.data[i]<250 || imgData.data[i+1]<250 || imgData.data[i+2]<250){\n                            hasContent=true;break;\n                        }\n                    }\n                    return {width:c.width, height:c.height, hasContent};\n                }\"\"\")\n                if pixel_data:\n                    print(f\"  Canvas content check: width={pixel_data.get('width')}, height={pixel_data.get('height')}, has_content={pixel_data.get('hasContent')}\")\n                    if not pixel_data.get(\"hasContent\"):\n                        errors.append(\"Canvas appears blank — no game rendering detected\")\n\n        except Exception as e:\n            errors.append(f\"Canvas verification error: {e}\")\n\n        # Check for JS console errors/warnings\n        print(\"[TEST] Checking console messages...\")\n        js_errors = [m for m in console_msgs if m[\"level\"] == \"error\"]\n        js_warnings = [m for m in console_msgs if m[\"level\"] == \"warning\"]\n        \n        error_texts = []\n        for msg in js_errors:\n            print(f\"  ERROR: {msg['text']}\")\n            error_texts.append(msg[\"text\"])\n\n        warn_texts = []\n        for msg in js_warnings:\n            print(f\"  WARNING: {msg['text']}\")\n            warn_texts.append(msg[\"text\"])\n\n        if not js_errors and not js_warnings:\n            print(\"  No JS errors or warnings detected.\")\n\n        # Additional check: ensure no 'undefined' references to W/H/dist in console\n        undef_msgs = [m for m in console_msgs if \"undefined\" in m.get(\"text\", \"\").lower() \n                      or \"w is not defined\" in m.get(\"text\",\"\").lower()\n                      or \"h is not defined\" in m.get(\"text\",\"\").lower()]\n        \n        if undef_msgs:\n            print(f\"  UNDEFINED references found:\")\n            for msg in undef_msgs:\n                errors.append(msg[\"text\"])\n\n    browser.close()\n    \n    # Summary\n    total_errors = len(errors) + len(js_errors) + len(undef_msgs)\n    if total_errors == 0:\n        print(\"\\n=== ALL TESTS PASSED ===\")\n    else:\n        print(f\"\\n=== {total_errors} ISSUE(S) FOUND ===\")\n    \n    return errors\n\nif __name__ == \"__main__\":\n    errs = run_tests()\n    if errs:\n        for e in errs:\n            print(f\"  - {e}\")\n        sys.exit(1)\n    else:\n        print(\"Game is working correctly!\")\n        sys.exit(0)\n"},"status":"ok","ms":140}
