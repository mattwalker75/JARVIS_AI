{"t":"2026-07-28T18:27:49.503Z","tool":"edit_workbench_file","args":{"path":"/workspace/public/game.js","old_string":"window.onload = init;\n","new_string":"// --- Weapon overlay rendering ---\nlet weaponImg = new Image();\nweaponImg.src = 'weapon.png';\nlet weaponFiring = false;\nlet weaponFireFrame = 0;\nconst weaponFireMax = 5;\n\n// Create overlay canvas for weapon sprite\nlet overlayCanvas = document.createElement('canvas');\noverlayCanvas.style.position = 'absolute';\noverlayCanvas.style.left = '0';\noverlayCanvas.style.top = '0';\noverlayCanvas.style.pointerEvents = 'none';\noverlayCanvas.style.zIndex = '20';\ndocument.body.appendChild(overlayCanvas);\n\nfunction resizeOverlay() {\n  overlayCanvas.width = window.innerWidth;\n  overlayCanvas.height = window.innerHeight;\n}\nresizeOverlay();\nwindow.addEventListener('resize', resizeOverlay);\n\nfunction drawWeaponOverlay() {\n  let ctx = overlayCanvas.getContext('2d');\n  ctx.clearRect(0,0,overlayCanvas.width,overlayCanvas.height);\n  let w = 160, h = 80;\n  let x = (overlayCanvas.width - w) / 2;\n  let y = overlayCanvas.height - h - 20;\n  if (weaponFiring && weaponFireFrame < weaponFireMax) {\n    ctx.save();\n    ctx.globalAlpha = 0.7;\n    ctx.fillStyle = '#fff';\n    ctx.fillRect(x, y, w, h);\n    ctx.restore();\n  }\n  ctx.drawImage(weaponImg, x, y, w, h);\n}\n\nfunction updateWeaponOverlay() {\n  if (weaponFiring) {\n    weaponFireFrame++;\n    if (weaponFireFrame >= weaponFireMax) {\n      weaponFiring = false;\n      weaponFireFrame = 0;\n    }\n  }\n  drawWeaponOverlay();\n}\n\n// Hook into animation loop\nconst oldAnimate = animate;\nanimate = function() {\n  oldAnimate();\n  updateWeaponOverlay();\n};\n\n// Shooting input for overlay\nfunction fireWeaponOverlay() {\n  if (!weaponFiring) {\n    weaponFiring = true;\n    weaponFireFrame = 0;\n  }\n}\ndocument.addEventListener('mousedown', function(event) {\n  if (event.button === 0 && controls.enabled) fireWeaponOverlay();\n});\ndocument.addEventListener('keydown', function(event) {\n  if ((event.code === 'Space' || event.code === 'KeyF') && controls.enabled) fireWeaponOverlay();\n});\n\nwindow.onload = init;\n"},"status":"ok","ms":152}
