{"t":"2026-07-27T04:52:06.745Z","tool":"write_workbench_file","args":{"path":"/workspace/test_core.py","content":"\"\"\"Automated tests for picture_viewer.html using Playwright.\"\"\"\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport os\nimport sys\n\nAPP_URL = \"http://localhost:9105/picture_viewer.html\"\nTEST_IMAGES_DIR = \"/workspace/test_images\"\n\nasync def run_tests():\n    results = []\n\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n        page = await context.new_page()\n\n        # ── Test 1: App loads and shows empty state ──\n        print(\"\\n=== TEST 1: App loads with empty gallery ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            # Check the app loaded\n            title = await page.title()\n            assert \"Picture Viewer\" in title or \"picture_viewer.html\" == os.path.basename(APP_URL), f\"Wrong title: {title}\"\n            \n            # Empty state should be visible\n            empty_state = await page.query_selector(\"#empty-state\")\n            if empty_state is None:\n                raise AssertionError(\"Empty state not found on initial load\")\n            \n            print(f\"  PASS: App loaded, title='{title}', empty state visible\")\n            results.append((\"Test 1\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 1\", f\"FAIL: {e}\"))\n\n        # ── Test 2: Upload images via file input ──\n        print(\"\\n=== TEST 2: Upload test images ===\")\n        try:\n            image_files = [\n                os.path.join(TEST_IMAGES_DIR, \"mountain.jpg\"),\n                os.path.join(TEST_IMAGES_DIR, \"ocean.jpg\"),\n                os.path.join(TEST_IMAGES_DIR, \"sunset.jpg\"),\n            ]\n            \n            # Click upload zone to trigger file input\n            await page.click(\"#upload-zone\")\n            await page.set_input_files(\"#file-input\", image_files)\n            \n            # Wait for toast notification\n            try:\n                toast = await page.wait_for_selector(\".toast.success\", timeout=5000)\n                toast_text = await toast.inner_text()\n                print(f\"  Upload confirmation: '{toast_text}'\")\n            except Exception:\n                pass\n            \n            # Give gallery time to render\n            await asyncio.sleep(2)\n            \n            # Check thumbnails appear\n            thumbs = await page.query_selector_all(\".thumb-card img\")\n            if len(thumbs) < 3:\n                raise AssertionError(f\"Expected at least 3 images, found {len(thumbs)}\")\n            \n            print(f\"  PASS: Uploaded {len(image_files)} images, gallery shows {len(thumbs)} thumbnails\")\n            results.append((\"Test 2\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 2\", f\"FAIL: {e}\"))\n\n        # ── Test 3: Gallery count is correct ──\n        print(\"\\n=== TEST 3: Verify gallery count ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            count_label = await page.query_selector(\"#count-label\")\n            if count_label is None:\n                raise AssertionError(\"Count label not found\")\n            \n            count_text = await count_label.inner_text()\n            print(f\"  Count text: '{count_text}'\")\n            \n            # Should show \"3 images\" or similar\n            assert \"image\" in count_text.lower(), f\"Unexpected count format: {count_text}\"\n            print(\"  PASS: Gallery count label present and formatted correctly\")\n            results.append((\"Test 3\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 3\", f\"FAIL: {e}\"))\n\n        # ── Test 4: Open lightbox by double-clicking a thumbnail ──\n        print(\"\\n=== TEST 4: Lightbox opens on double-click ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            # Wait for gallery to load\n            await asyncio.sleep(2)\n            \n            thumb = await page.query_selector(\".thumb-card img\")\n            if thumb is None:\n                raise AssertionError(\"No thumbnail found in gallery\")\n            \n            bbox = await thumb.bounding_box()\n            assert bbox, \"Thumbnail bounding box not available\"\n            \n            # Double-click the center of the image to open lightbox\n            cx = int(bbox[\"x\"] + bbox[\"width\"]/2)\n            cy = int(bbox[\"y\"] + bbox[\"height\"]/2)\n            await page.mouse.dblclick(cx, cy)\n            \n            # Wait for lightbox to appear\n            try:\n                lb_active = await page.wait_for_selector(\"#lightbox.active\", timeout=3000)\n                if lb_active is None:\n                    raise AssertionError(\"Lightbox did not become active\")\n                \n                # Check the image in lightbox has a src\n                lb_img_src = await page.get_attribute(\"#lb-img\", \"src\")\n                assert lb_img_src and len(lb_img_src) > 100, f\"Lightbox img src too short: {lb_img_src[:50]}...\"\n                \n                # Check info text shows count/name\n                lb_info_text = await page.inner_text(\"#lb-info\")\n                print(f\"  Lightbox image loaded (src starts with '{lb_img_src[:40]}...')\")\n                print(f\"  Lightbox info: '{lb_info_text}'\")\n                \n            except Exception as e2:\n                # Try extracting visible text to debug\n                page_content = await page.inner_text(\"body\", timeout=1000)\n                raise AssertionError(f\"Lightbox check failed: {e2}. Page body snippet: {page_content[:500]}\")\n            \n            print(\"  PASS: Lightbox opens correctly with image and info\")\n            results.append((\"Test 4\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 4\", f\"FAIL: {e}\"))\n\n        # ── Test 5: Close lightbox with close button ──\n        print(\"\\n=== TEST 5: Lightbox closes ===\")\n        try:\n            await page.click(\".lb-close\")\n            \n            await asyncio.sleep(1)\n            lb = await page.query_selector(\"#lightbox.active\")\n            if lb is not None:\n                raise AssertionError(\"Lightbox still active after close click\")\n            \n            print(\"  PASS: Lightbox closed successfully\")\n            results.append((\"Test 5\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 5\", f\"FAIL: {e}\"))\n\n        # ── Test 6: Delete a single image ──\n        print(\"\\n=== TEST 6: Delete single image ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            # Wait for gallery to load\n            await asyncio.sleep(2)\n            \n            thumbs_before = await page.query_selector_all(\".thumb-card img\")\n            count_before = len(thumbs_before)\n            print(f\"  Images before delete: {count_before}\")\n            \n            if count_before == 0:\n                raise AssertionError(\"No images in gallery to test deletion\")\n            \n            # Click the first image's delete button (visible on hover via CSS, but we can click directly)\n            await page.click(\".thumb-card .icon-btn.delete\", force=True)\n            \n            # Confirm dialog - accept it\n            async def confirm_dialog():\n                await asyncio.sleep(0.5)  # give time for confirm to appear\n            \n            asyncio.ensure_future(confirm_dialog())\n            \n            try:\n                toast = await page.wait_for_selector(\".toast.success\", timeout=3000)\n            except Exception:\n                pass\n            \n            await asyncio.sleep(1)\n            \n            thumbs_after = await page.query_selector_all(\".thumb-card img\")\n            count_after = len(thumbs_after)\n            print(f\"  Images after delete: {count_after}\")\n            \n            if count_after != count_before - 1:\n                raise AssertionError(f\"Expected {count_before-1} images, got {count_after}\")\n            \n            print(\"  PASS: Single image deleted successfully\")\n            results.append((\"Test 6\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 6\", f\"FAIL: {e}\"))\n\n        # ── Test 7: Slideshow controls visible in lightbox ──\n        print(\"\\n=== TEST 7: Slideshow bar present ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            thumb = await page.query_selector(\".thumb-card img\")\n            if not thumb:\n                raise AssertionError(\"No thumbnail to open lightbox for slideshow test\")\n            \n            bbox = await thumb.bounding_box()\n            cx = int(bbox[\"x\"] + bbox[\"width\"]/2)\n            cy = int(bbox[\"y\"] + bbox[\"height\"]/2)\n            await page.mouse.dblclick(cx, cy)\n            \n            try:\n                slideshow_bar = await page.wait_for_selector(\"#slideshow-bar\", timeout=3000)\n                if not slideshow_bar:\n                    raise AssertionError(\"Slideshow bar not found in lightbox\")\n                \n                # Check for 5s and 10s buttons\n                btn_5s = await page.query_selector(\"#slideshow-bar button:nth-child(2)\")\n                btn_10s = await page.query_selector(\"#slideshow-bar button:nth-child(3)\")\n                \n                if not (btn_5s or btn_10s):\n                    raise AssertionError(\"Slideshow timing buttons not found\")\n                \n            except Exception as e2:\n                body_text = await page.inner_text(\"body\", timeout=1000)\n                raise AssertionError(f\"Slideshow bar check failed: {e2}. Body snippet: {body_text[:500]}\")\n            \n            print(\"  PASS: Slideshow controls present in lightbox\")\n            results.append((\"Test 7\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 7\", f\"FAIL: {e}\"))\n\n        # ── Test 8: Upload more images and verify count increases ──\n        print(\"\\n=== TEST 8: Multiple uploads accumulate ===\")\n        try:\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            thumb_count = len(await page.query_selector_all(\".thumb-card img\"))\n            if thumb_count == 0:\n                raise AssertionError(\"No images to start accumulation test\")\n            \n            # Upload one more image\n            await page.click(\"#upload-zone\")\n            await page.set_input_files(\"#file-input\", [os.path.join(TEST_IMAGES_DIR, \"forest.jpg\")])\n            \n            try:\n                toast = await page.wait_for_selector(\".toast.success\", timeout=5000)\n                print(f\"  Upload confirmation: '{await toast.inner_text()}'\")\n            except Exception:\n                pass\n            \n            await asyncio.sleep(2)\n            \n            new_count = len(await page.query_selector_all(\".thumb-card img\"))\n            if new_count != thumb_count + 1:\n                raise AssertionError(f\"Expected {thumb_count+1}, got {new_count}\")\n            \n            print(f\"  PASS: Image count increased from {thumb_count} to {new_count}\")\n            results.append((\"Test 8\", \"PASS\"))\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 8\", f\"FAIL: {e}\"))\n\n        await browser.close()\n\n    # ── Summary ──\n    print(\"\\n\" + \"=\"*50)\n    print(\"TEST SUMMARY\")\n    print(\"=\"*50)\n    \n    passed = sum(1 for _, r in results if \"PASS\" in r)\n    failed = len(results) - passed\n    \n    for name, result in results:\n        status_icon = \"✓\" if \"PASS\" in result else \"✗\"\n        print(f\"  {status_icon} {name}: {result}\")\n    \n    print(f\"\\nTotal: {passed}/{len(results)} tests passed\")\n    \n    return failed == 0\n\nif __name__ == \"__main__\":\n    success = asyncio.run(run_tests())\n    sys.exit(0 if success else 1)\n"},"status":"ok","ms":151}
