{"t":"2026-07-27T03:57:21.944Z","tool":"run_shell","args":{"command":"python3 -c \"\nfrom playwright.sync_api import sync_playwright\nimport time\n\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True)\n    page = b.new_page()\n    \n    # Capture console messages and JS errors\n    msgs = []\n    def on_console(msg):\n        msgs.append(f'{msg.type}: {msg.text}')\n    page.on('console', on_console)\n    \n    page.goto('http://localhost:9101/')\n    time.sleep(3)  # Let Three.js initialize\n    \n    # Check if canvas exists (Three.js rendered something)\n    has_canvas = page.evaluate('''() => document.querySelector(\\\"canvas\\\") !== null''')\n    print(f'Canvas present: {has_canvas}')\n    \n    # Get any console errors/warnings\n    js_errors = [m for m in msgs if 'error' in m.lower()]\n    if js_errors:\n        print('JS Errors/Warnings:')\n        for e in js_errors[:10]:\n            print(f'  {e}')\n    else:\n        print('No JS errors detected.')\n    \n    # Verify page title\n    title = page.title()\n    print(f'Title: {title}')\n    \n    b.close()\n\nprint('Test complete!')\n\"\n","timeout_s":30},"status":"ok","ms":3644}
