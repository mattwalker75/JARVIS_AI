{"t":"2026-07-28T04:09:26.324Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3, os, hashlib\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\nBID = 2\n\n# Step 10: Recurring Invoices (fix with next_run_date)\nrecurring = [\n    ('SleepyStudy Co.', 'SS-M', 95000, 8075, 'Monthly retainer for short-form content (12 videos/mo). Auto-generates on the 20th.'),\n    ('Crypto Brief Daily', 'CBD-M', 95000, 8075, 'Monthly retainer for faceless crypto news shorts + AI avatar segments. Auto-generates on the 10th.'),\n]\n\nfor cust_name, prefix, amount_cents, tax_cents, notes in recurring:\n    cur.execute('''INSERT INTO recurring_invoices \n        (business_id, customer_name, number_prefix, amount_cents, tax_cents, next_run_date) VALUES (?, ?, ?, ?, ?, ?)''',\n       (BID, cust_name, prefix, amount_cents, tax_cents, '2026-08-10'))\n\n# Step 14: Recurring Bills\nbills = [\n    ('BILL-R', 'ElevenLabs Inc.', 20000, 'Monthly AI voiceover subscription. Auto-generated on the 1st.'),\n]\n\nfor prefix, vendor_name, amount_cents, notes in bills:\n    cur.execute('''INSERT INTO recurring_bills \n        (business_id, number_prefix, name, amount_cents, next_run_date) VALUES (?, ?, ?, ?, ?)''',\n       (BID, prefix, vendor_name, amount_cents, '2026-08-01'))\n\n# Step 15: Business Logos — placeholder reference\ncur.execute('''INSERT INTO business_logos \n    (business_id, name, file_path, mime_type) VALUES (?, ?, ?, ?)''',\n   (BID, 'Primary Logo', '/uploads/summit-logo.png', 'image/png'))\n\n# Step 14 continued: Recurring bills for other vendors too\nbills2 = [\n    ('BILL-R-002', 'Pictory AI (Veed)', 4900, 'Video automation platform monthly plan.'),\n]\nfor prefix, vendor_name, amount_cents, notes in bills2:\n    cur.execute('''INSERT INTO recurring_bills \n        (business_id, number_prefix, name, amount_cents, next_run_date) VALUES (?, ?, ?, ?, ?)''',\n       (BID, prefix, vendor_name, amount_cents, '2026-08-01'))\n\n# Step 13: Documents — insert into DB if not already done\nrw = '/READ_WRITE_FILES/summit-docs'\ndocs_to_create = [\n    ('business-plan.md', 'Business Planning'),\n    ('client-contract-template.md', 'Contracts'),\n]\n\nfor fname, category in docs_to_create:\n    full_path = os.path.join(rw, fname)\n    rel_path = f'summit-docs/{fname}'\n    if not os.path.exists(full_path):\n        continue\n    with open(full_path, 'rb') as f:\n        data = f.read()\n    h = hashlib.sha256(data).hexdigest()[:16]\n    title_map = {'business-plan.md': 'Business Plan', 'client-contract-template.md': 'Client Contract Template'}\n    cur.execute('''INSERT OR REPLACE INTO documents \n        (business_id, category, title, notes, original_filename, stored_filename, file_path, mime_type, byte_size, content_hash) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',\n       (BID, category, title_map[fname], f'{fname} — Summit Digital Agency internal document.', fname, h + '.md', rel_path, 'text/markdown', len(data), h))\n\nconn.commit()\n\n# Verify all counts now\nfor table in ['business_company', 'business_owners', 'business_phones', 'business_addresses', \n              'business_emails', 'business_banking_accounts', 'business_credit_cards',\n              'business_products_services', 'business_customers', 'business_vendors',\n              'business_recurring_expenses', 'budget_entries', 'invoices', 'recurring_invoices',\n              'project_lists', 'project_list_items', 'business_contacts', 'documents', 'recurring_bills']:\n    try:\n        cur.execute(f'SELECT COUNT(*) FROM {table} WHERE business_id = ?', (BID,))\n        print(f'{table}: {cur.fetchone()[0]} records')\n    except Exception as e:\n        print(f'{table}: ERROR - {e}')\n\nconn.close()\nprint('\\n✅ All remaining data inserted successfully!')\n\" 2>&1\n","timeout_s":15},"status":"ok","ms":140}
