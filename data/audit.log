{"t":"2026-07-28T04:14:49.070Z","tool":"run_shell","args":{"command":"sqlite3 /workspace/mbm.db <<'SQL'\n-- YouTube Automation Packages (core revenue drivers)\nINSERT INTO business_products_services (business_id, kind, name, sku, price_cents, description, status, created_date, notes) VALUES\n(2, 'service', 'YouTube Starter Package', 'SDA-YT-STARTER', 149900, '3 faceless videos/month + thumbnail design + SEO optimization. Perfect for new channels testing the waters.', 'active', '2026-07-01', 'Entry-tier package'),\n(2, 'service', 'YouTube Growth Package', 'SDA-YT-GROWTH', 299900, '8 faceless videos/month + custom thumbnails + keyword research + channel audit. For channels ready to scale.', 'active', '2026-07-01', 'Mid-tier package'),\n(2, 'service', 'YouTube Domination Package', 'SDA-YT-DOMINATE', 499900, '15 faceless videos/month + full branding kit + SEO strategy + analytics dashboard + weekly reporting. For serious operators.', 'active', '2026-07-01', 'Premium package'),\n(2, 'service', 'YouTube Enterprise Package', 'SDA-YT-ENTERPRISE', 849900, '30 faceless videos/month + multi-channel management + dedicated editor + A/B thumbnail testing + full funnel strategy.', 'active', '2026-07-01', 'Top-tier enterprise'),\n\n-- TikTok/Shorts Packages\n(2, 'service', 'TikTok Starter Package', 'SDA-TK-STARTER', 99900, '5 short-form videos/month + trending audio curation + hashtag strategy. Quick entry into viral content.', 'active', '2026-07-01', ''),\n(2, 'service', 'TikTok Growth Package', 'SDA-TK-GROWTH', 199900, '15 short-form videos/month + trend analysis + posting schedule optimization + comment management.', 'active', '2026-07-01', ''),\n(2, 'service', 'Shorts Automation Pack', 'SDA-SR-AUTO', 149900, '10 YouTube Shorts/month repurposed from long-form content. Cross-platform optimization included.', 'active', '2026-07-01', ''),\n\n-- One-off Services\n(2, 'service', 'Channel Audit & Strategy', 'SDA-AUDIT', 49900, 'Comprehensive channel analysis: niche validation, competitor breakdown, content gap analysis, and roadmap.', 'active', '2026-07-01', ''),\n(2, 'service', 'Thumbnail Design (per pack)', 'SDA-THUMB-PACK', 4900, 'Set of 5 custom thumbnails with A/B testing recommendations. High CTR optimized designs.', 'active', '2026-07-01', ''),\n(2, 'service', 'Video Script Writing (per script)', 'SDA-SCRIPT', 7900, 'Engaging faceless video script: hook, body, call-to-action. Optimized for retention and watch time.', 'active', '2026-07-01', ''),\n(2, 'service', 'Voiceover Recording (per minute)', 'SDA-VO-MIN', 3500, 'Professional AI or human voiceover recording. Multiple styles available: energetic, calm, dramatic.', 'active', '2026-07-01', ''),\n(2, 'service', 'Full Channel Launch Package', 'SDA-LAUNCH', 99900, 'Complete channel setup: branding, first 5 videos, banner/channel art, SEO profile optimization, content calendar.', 'active', '2026-07-01', ''),\n\n-- Add-ons\n(2, 'service', 'SEO Optimization (per video)', 'SDA-SEO-PV', 900, 'Title optimization, description with keywords, tags strategy, and end-screen planning per video.', 'active', '2026-07-01', ''),\n(2, 'service', 'Analytics & Reporting (monthly)', 'SDA-MONITOR', 49900, 'Monthly performance report: views, retention graphs, revenue analysis, competitor benchmarking.', 'active', '2026-07-01', '');\n\nSELECT count(*) || ' products/services inserted' FROM business_products_services WHERE business_id=2;\nSQL"},"status":"ok","ms":139}
