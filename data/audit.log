nvoice #SDA-2026-017', 250000, 'Fifth TechVault payment'),\n(2, '2026-05-15', 2026, 'client_payment', 'Zenith Wealth Partners — Invoice #SDA-2026-010', 300000, 'Third Zenith payment'),\n(2, '2026-05-15', 2026, 'client_payment', 'Lumina Skincare — Invoice #SDA-2026-013', 450000, 'Second Lumina payment'),\n(2, '2026-05-15', 2026, 'client_payment', 'CloudSync Solutions — Invoice #SDA-2026-016', 200000, 'First CloudSync payment');\n\n-- June payments (all active clients)\n(2, '2026-06-01', 2026, 'software_expense', 'Pictory.ai + ChatGPT Team + Canva Pro', -45600, 'Monthly software stack'),\n(2, '2026-06-01', 2026, 'freelance_payment', 'J. Rivera — Scriptwriter (NovaMind)', -60000, 'Retainer payment'),\n(2, '2026-06-01', 2026, 'freelance_payment', 'M. Okonkwo — FitFuel scripts', -75000, 'Monthly retainer'),\n\n-- June payments (all active clients)\n(2, '2026-06-15', 2026, 'client_payment', 'NovaMind AI — Invoice #SDA-2026-016', 350000, 'Month 12 retainer'),\n(2, '2026-06-15', 2026, 'client_payment', 'FitFuel Nutrition — Invoice #SDA-2026-017', 499900, 'Ninth FitFuel payment'),\n(2, '2026-06-15', 2026, 'client_payment', 'TechVault Reviews — Invoice #SDA-2026-020', 250000, 'Sixth TechVault payment'),\n(2, '2026-06-15', 2026, 'client_payment', 'Zenith Wealth Partners — Invoice #SDA-2026-013', 300000, 'Fourth Zenith payment'),\n(2, '2026-06-15', 2026, 'client_payment', 'Lumina Skincare — Invoice #SDA-2026-016', 450000, 'Third Lumina payment'),\n(2, '2026-06-15', 2026, 'client_payment', 'CloudSync Solutions — Invoice #SDA-2026-019', 200000, 'Second CloudSync payment');\n\nSQL\necho \"ledger_transactions complete. Exit code: $?\""},"status":"ok","ms":153}
