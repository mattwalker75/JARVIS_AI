{"t":"2026-07-27T12:56:19.517Z","tool":"run_shell","args":{"command":"cat << 'PYEOF' > /workspace/test_viewer.py\nimport subprocess, json, time\n\n# Use Playwright to inject images and verify gallery/lightbox/delete/search\nfrom playwright.sync_api import sync_playwright\n\ndef run():\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n        page.goto(\"http://localhost:9101/picture_viewer.html\")\n        \n        # Wait for app to load\n        page.wait_for_selector(\"#gallery-grid\", timeout=5000)\n        time.sleep(1)  # let IndexedDB settle\n        \n        # Check initial state - should be empty\n        count = page.text_content(\"#image-count\")\n        print(f\"Initial: {count}\")\n        \n        # Inject test images via the addImage function (data URIs of colored squares)\n        import base64, io\n        from PIL import Image\n        \n        colors = [\"#ff0000\", \"#00ff00\", \"#0000ff\", \"#ffff00\"]  # red, green, blue, yellow\n        injected_ids = []\n        \n        for i, color in enumerate(colors):\n            img = Image.new(\"RGB\", (200, 200), color)\n            buf = io.BytesIO()\n            img.save(buf, format=\"JPEG\")\n            b64 = base64.b64encode(buf.getvalue()).decode()\n            \n            result = page.evaluate(f\"\"\"\n                (() => {{\n                    return new Promise((resolve, reject) => {{\n                        const req = indexedDB.open('PictureViewerDB', 1);\n                        req.onsuccess = e => {{\n                            const db = e.target.result;\n                            const tx = db.transaction('images', 'readwrite');\n                            const store = tx.objectStore('images');\n                            const dataUrl = 'data:image/jpeg;base64,{b64}';\n                            store.add({{ id: crypto.randomUUID(), data: dataUrl, name: 'test_{color}.jpg', type: 'image/jpeg', timestamp: Date.now() }});\n                            tx.oncomplete = () => resolve();\n                        }};\n                    }})\n                }})()\n            \"\"\")\n            \n        # Re-render gallery by calling renderGallery via page.evaluate\n        time.sleep(1)\n        \n        # Now check if images appear in DOM\n        thumbs = page.query_selector_all(\".thumb-card img\")\n        print(f\"Injected {len(thumbs)} thumbnail(s)\")\n        \n        for i, thumb in enumerate(thumbs):\n            src = thumb.get_attribute(\"src\")[:80] + \"...\"\n            alt = thumb.get_attribute(\"alt\") or \"\"\n            name_el = page.query_selector_all(\".thumb-name\")[i].text_content() if len(page.query_selector_all(\".thumb-name\")) > i else \"?\"\n            print(f\"  Thumb {i}: src={src}, name={name_el}\")\n        \n        # Test lightbox: double-click first image\n        if thumbs:\n            page.click(\".thumb-card\", force=True)\n            \n            lb = page.wait_for_selector(\"#lightbox.active\", timeout=3000, state=\"visible\")\n            print(f\"Lightbox opened: {lb is not None}\")\n            \n            # Check counter\n            counter_text = page.text_content(\"#lb-counter\") if page.query_selector(\"#lb-counter\") else \"N/A\"\n            print(f\"Counter text: '{counter_text}'\")\n            \n            # Close lightbox by clicking overlay (outside img) or pressing Escape\n            page.keyboard.press(\"Escape\")\n            time.sleep(0.5)\n            lb_closed = not page.is_visible(\"#lightbox.active\") if page.query_selector(\"#lightbox\") else True\n            print(f\"Lightbox closed: {lb_closed}\")\n        \n        # Test search - filter to show only red images\n        page.fill(\"#search-box\", \"red\")\n        time.sleep(0.5)\n        filtered_count = len(page.query_selector_all(\".thumb-card\"))\n        print(f\"After searching 'red': {filtered_count} image(s)\")\n        \n        # Clear search\n        page.fill(\"#search-box\", \"\")\n        time.sleep(0.3)\n        full_count = len(page.query_selector_all(\".thumb-card\"))\n        print(f\"After clearing search: {full_count} image(s)\")\n        \n        # Test delete - remove first thumbnail\n        if thumbs:\n            del_btn = page.query_selector(\".thumb-delete\")\n            if del_btn:\n                del_btn.click()\n                time.sleep(0.5)\n                remaining = len(page.query_selector_all(\".thumb-card\"))\n                print(f\"After deleting 1 image: {remaining} image(s)\")\n        \n        # Test persistence - reload page and check count again\n        page.reload(wait_until=\"domcontentloaded\")\n        page.wait_for_timeout(2000)\n        thumbs_after = len(page.query_selector_all(\".thumb-card\")) if page.is_visible(\"#gallery-grid\") else 0\n        \n        # Need to re-render after reload since IndexedDB is async\n        render_result = page.evaluate(\"renderGallery()\")\n        time.sleep(1)\n        thumbs_persisted = len(page.query_selector_all(\".thumb-card\"))\n        print(f\"After reload: {thumbs_persisted} image(s)\")\n        \n        # Verify clear all works\n        clear_count = page.evaluate(\"clearAll()\")\n        time.sleep(0.5)\n        after_clear = len(page.query_selector_all(\".thumb-card\"))\n        empty_visible = page.is_visible(\"#empty-state\") if page.query_selector(\"#empty-state\") else False\n        print(f\"After clearing all: {after_clear} image(s), empty state visible: {empty_visible}\")\n        \n        browser.close()\n        print(\"\\n=== ALL TESTS PASSED ===\" if thumbs_persisted == 3 and after_clear == 0 else \"\\n=== SOME ISSUES DETECTED ===\")\n\nrun()\nPYEOF\npython3 -c \"import PIL; print('PIL OK')\" && python3 /workspace/test_viewer.py","timeout_s":60},"status":"ok","ms":5367}
