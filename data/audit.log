{"t":"2026-07-28T12:53:01.003Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, json, sys\n\ndb = \"/workspace/data/mbm.db\"\nconn = sqlite3.connect(db)\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nprint(\"=\" * 70)\nprint(\"SUMMIT DIGITAL AGENCY LLC — FULL DATA VERIFICATION\")\nprint(\"=\" * 70)\n\n# 1. Business Profile\nprint(\"\\n[1] BUSINESS PROFILE (business_id=2)\")\nrows = cur.execute(\"SELECT * FROM businesses WHERE id=2\").fetchall()\nif rows:\n    r = dict(rows[0])\n    print(f\"  Name: {r.get('legal_name','?')}\")\n    print(f\"  Type: {r.get('business_type','?')}\")\n    print(f\"  Status: {r.get('status','?')}\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# 2. Company Details (EIN, address)\nprint(\"\\n[2] COMPANY DETAILS / LEGAL INFO\")\nrows = cur.execute(\"SELECT * FROM company_details WHERE business_id=2\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  {dict(r)}\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# 3. Owner/Team Members (contacts with role)\nprint(\"\\n[3] TEAM MEMBERS & CONTACTS\")\nrows = cur.execute(\"\"\"SELECT c.id, c.full_name, c.role, c.email, c.phone, \n                      CASE WHEN ct.contact_type='client' THEN 'CLIENT' ELSE '' END as type_flag\n                      FROM contacts c LEFT JOIN contact_types ct ON c.id=ct.contact_id \n                      WHERE c.business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  {d['full_name']} | Role: {d.get('role','')} | Email: {d.get('email','?')} | Phone: {d.get('phone','?')}\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# Count contacts by type\nfor ctype in ['client', 'vendor', 'team_member']:\n    cnt = cur.execute(f\"SELECT COUNT(*) as c FROM contact_types WHERE business_id=2 AND contact_type='{ctype}'\").fetchone()\n    if cnt and cnt[0] > 0:\n        print(f\"\\n  → {ctype.title()}s: {cnt[0]}\")\n\n# 4. Products/Services\nprint(\"\\n[4] PRODUCTS / SERVICES CATALOG\")\nrows = cur.execute(\"SELECT id, name, description FROM products WHERE business_id=2\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r['name']} — {r.get('description','')[:80]}...\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# 5. Financials - Recurring Invoices\nprint(\"\\n[5] RECURRING INVOICES (Active)\")\nrows = cur.execute(\"\"\"SELECT i.id, c.full_name as client, i.amount, i.frequency, \n                      i.status, i.due_date FROM invoices i\n                      JOIN contacts c ON i.client_id=c.id WHERE i.business_id=2 AND i.status='active'\"\"\").fetchall()\nif rows:\n    total = 0\n    for r in rows:\n        d = dict(r)\n        print(f\"  Invoice #{d['id']} → {d['client']}: ${d['amount']}/{d.get('frequency','?')} (due: {d.get('due_date','')})\")\n        total += float(d['amount'])\n    print(f\"\\n  TOTAL ACTIVE RETAINERS: ${total:,.2f}/mo equivalent\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# Budget entries\nbudget_count = cur.execute(\"SELECT COUNT(*) as c FROM budgets WHERE business_id=2\").fetchone()\nprint(f\"  Budget entries: {budget_count[0]}\")\n\n# 6. Documents/Notes\nprint(\"\\n[6] DOCUMENTS / NOTES\")\nrows = cur.execute(\"SELECT id, title, content_preview FROM notes WHERE business_id=2\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('title','?')} — preview: {str(r.get('content_preview',''))[:100]}...\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\n# 7. Projects/KPIs\nprint(\"\\n[7] PROJECTS & KPI TARGETS\")\nrows = cur.execute(\"\"\"SELECT id, name, status FROM projects WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('name','?')} — Status: {r.get('status','?')}\")\nelse:\n    print(\"  ❌ NOT FOUND\")\n\nkpi_count = cur.execute(\"\"\"SELECT COUNT(*) as c FROM kpis WHERE business_id=2\"\"\").fetchone()\nprint(f\"  KPIs tracked: {kpi_count[0]}\")\n\n# 8. SOPs / Content Pipeline docs\nprint(\"\\n[8] CONTENT PRODUCTION PIPELINE (SOPs)\")\nrows = cur.execute(\"\"\"SELECT id, name FROM project_documents \n                      WHERE business_id=2 AND category='sop'\"\"\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('name','?')}\")\nelse:\n    print(\"  (No SOP docs found — checking project_documents generally)\")\n\n# Check all project documents for business_id=2\nall_pd = cur.execute(\"\"\"SELECT id, name, category FROM project_documents WHERE business_id=2\"\"\").fetchall()\nif all_pd:\n    for r in all_pd:\n        print(f\"  [{r['id']}] {r.get('name','?')} (category: {r.get('category','')})\")\n\n# Summary counts\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SUMMARY COUNTS FOR business_id=2:\")\nfor table in ['contacts', 'products', 'invoices', 'budgets', 'notes', \n              'project_documents', 'kpis', 'business_profiles']:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {table} WHERE business_id=2\").fetchone()\n        print(f\"  {table}: {cnt[0]}\")\n    except Exception as e:\n        print(f\"  {table}: ERROR ({e})\")\n\nconn.close()\nprint(\"\\n✅ VERIFICATION COMPLETE\\n\")\nPYEOF","timeout_s":30},"status":"ok","ms":142}
