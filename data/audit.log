{"t":"2026-07-27T04:17:22.598Z","tool":"edit_workbench_file","args":{"path":"/workspace/index.html","old_string":"const fragmentShader = `\n  uniform float uTime;\n  varying vec3 vNormal;\n  varying vec3 vPosition;\n\n  // Simplex-like noise helper\n  vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\n  vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\n  vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }\n\n  float snoise(vec3 v) {\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g  = step(x0.yzx, x0.xyz);\n    vec3 l  = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n      i.z + vec4(0.0, i1.z, i2.z, 1.0))\n      + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n      + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j  = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x  = x_ * ns.x + ns.yyyy;\n    vec4 y  = y_ * ns.x + ns.yyyy;\n    vec4 h  = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy,h.x);\n    vec3 p1 = vec3(a0.zw,h.y);\n    vec3 p2 = vec3(a1.xy,h.z);\n    vec3 p3 = vec3(a1.zw,h.w);\n    vec4 norm = 1.79284291400159 - 0.85373472095314 *\n      vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));\n  }\n\n  void main() {\n    float t = uTime * 0.3;\n    // Shift hue over time using noise-based color fields\n    float n1 = snoise(vPosition * 2.0 + vec3(t, 0.0, 0.0)) * 0.5 + 0.5;\n    float n2 = snoise(vPosition * 2.0 + vec3(0.0, t, 0.0)) * 0.5 + 0.5;\n    float n3 = snoise(vPosition * 2.0 + vec3(0.0, 0.0, t)) * 0.5 + 0.5;\n\n    // Map noise values to RGB with hue rotation over time\n    float hue = uTime * 0.1;\n    vec3 colA = 0.5 + 0.5 * cos(6.28318 * (vec3(n1) + hue));\n    vec3 colB = 0.5 + 0.5 * cos(6.28318 * (vec3(n2, n3, n1) + hue + 0.33));\n\n    // Combine: use normal-based lighting with colored noise overlay\n    float diff = max(dot(vNormal, normalize(vec3(1.0, 1.0, 2.0))), 0.0);\n    vec3 ambient = colA * 0.4;\n    vec3 lit     = colB * diff * 0.8 + ambient;\n\n    gl_FragColor = vec4(lit, 1.0);\n  }\n`;","new_string":"const fragmentShader = `\n  uniform float uTime;\n  varying vec3 vNormal;\n  varying vec3 vPosition;\n\n  void main() {\n    // Use position + time to create shifting colors per pixel\n    float t = uTime * 0.25;\n\n    // Hue rotation based on surface normal and position\n    float hue1 = fract(dot(vNormal, vec3(0.299, 0.587, 0.114)) + t);\n    float hue2 = fract(length(vPosition) * 0.5 + t * 1.5);\n\n    // HSL-like to RGB conversion for channel R\n    vec3 colR;\n    colR.r = smoothstep(0.0, 1.0, sin(hue1 * 6.28318));\n    colR.g = smoothstep(0.0, 1.0, sin(hue1 * 6.28318 + 2.094));\n    colR.b = smoothstep(0.0, 1.0, sin(hue1 * 6.28318 + 4.189));\n\n    // HSL-like to RGB conversion for channel G\n    vec3 colG;\n    colG.r = smoothstep(0.0, 1.0, sin(hue2 * 6.28318));\n    colG.g = smoothstep(0.0, 1.0, sin(hue2 * 6.28318 + 2.094));\n    colG.b = smoothstep(0.0, 1.0, sin(hue2 * 6.28318 + 4.189));\n\n    // Blend between the two color palettes based on normal direction\n    float blendFactor = vNormal.y * 0.5 + 0.5;\n    vec3 baseColor = mix(colR, colG, blendFactor);\n\n    // Simple directional lighting for depth\n    vec3 lightDir = normalize(vec3(1.0, 1.0, 2.0));\n    float diff = max(dot(vNormal, lightDir), 0.0);\n    vec3 litColor = baseColor * (diff * 0.7 + 0.3);\n\n    gl_FragColor = vec4(litColor, 1.0);\n  }\n`;"},"status":"ok","ms":140}
