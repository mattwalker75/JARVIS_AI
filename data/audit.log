{"t":"2026-07-28T18:18:56.134Z","tool":"write_workbench_file","args":{"path":"/workspace/engine.js","content":"// --- Weapon rendering and shooting mechanic additions ---\n// (Append to bottom of engine.js)\n\n// Weapon sprite (simple rectangle for now; replace with image if desired)\nconst weapon = {\n  width: 120,\n  height: 60,\n  x: null, // Will be set based on canvas size\n  y: null,\n  firing: false,\n  fireFrame: 0,\n  maxFireFrame: 5,\n};\n\n// Draw weapon (called after 3D scene)\nfunction drawWeapon(ctx) {\n  weapon.x = (canvas.width - weapon.width) / 2;\n  weapon.y = canvas.height - weapon.height - 10;\n  ctx.save();\n  if (weapon.firing && weapon.fireFrame < weapon.maxFireFrame) {\n    ctx.fillStyle = '#fff'; // Flash effect\n    ctx.fillRect(weapon.x, weapon.y, weapon.width, weapon.height);\n  } else {\n    ctx.fillStyle = '#333';\n    ctx.fillRect(weapon.x, weapon.y, weapon.width, weapon.height);\n    ctx.strokeStyle = '#999';\n    ctx.lineWidth = 6;\n    ctx.strokeRect(weapon.x + 20, weapon.y + 10, weapon.width - 40, weapon.height - 20);\n  }\n  ctx.restore();\n}\n\n// Update weapon firing animation\nfunction updateWeapon() {\n  if (weapon.firing) {\n    weapon.fireFrame++;\n    if (weapon.fireFrame >= weapon.maxFireFrame) {\n      weapon.firing = false;\n      weapon.fireFrame = 0;\n    }\n  }\n}\n\n// Shooting input\nwindow.addEventListener('mousedown', () => {\n  if (!weapon.firing) {\n    weapon.firing = true;\n    weapon.fireFrame = 0;\n    // TODO: handle shooting logic (monster hit) in next step\n  }\n});\nwindow.addEventListener('keydown', (e) => {\n  if ((e.code === 'Space' || e.code === 'KeyF') && !weapon.firing) {\n    weapon.firing = true;\n    weapon.fireFrame = 0;\n    // TODO: handle shooting logic (monster hit) in next step\n  }\n});\n\n// In main render loop, after drawing 3D scene:\n// updateWeapon();\n// drawWeapon(ctx);\n"},"status":"ok","ms":138}
