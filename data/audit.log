{"t":"2026-07-28T04:07:06.225Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n# List all tables\ncur.execute(\\\"SELECT name FROM sqlite_master WHERE type='table'\\\")\nprint('TABLES:', cur.fetchall())\n\n# Check Summit Digital Agency (business_id=2)\nfor table in ['businesses', 'products', 'contacts', 'projects', 'invoices', 'documents', 'financials']:\n    try:\n        cur.execute(f'SELECT * FROM {table} WHERE business_id = 2' if table != 'businesses' else f'SELECT * FROM businesses')\n        rows = cur.fetchall()\n        desc = [d[0] for d in cur.description]\n        print(f'\\n{table}:', desc)\n        for r in rows:\n            print(r)\n    except Exception as e:\n        print(f'{table} ERROR:', str(e))\n\nconn.close()\n\"\n","timeout_s":15},"status":"ok","ms":133}
{"t":"2026-07-28T04:07:11.744Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Get schemas for all business-related tables\ntables_to_check = [\n    'businesses', 'business_company', 'business_owners', 'business_capital_accounts',\n    'business_phones', 'business_addresses', 'business_emails', 'business_banking_accounts',\n    'business_credit_cards', 'business_contacts', 'business_vendors', 'business_customers',\n    'business_recurring_expenses', 'business_products_services', 'budget_entries',\n    'invoices', 'recurring_invoices', 'bills', 'recurring_bills', 'documents',\n    'project_lists', 'project_list_items'\n]\n\nfor t in tables_to_check:\n    try:\n        cur.execute(f'SELECT sql FROM sqlite_master WHERE name=\\\"{t}\\\"')\n        r = cur.fetchone()\n        if r and r[0]:\n            print(f'\\n=== {t} ===\\n{r[0]}')\n    except Exception as e:\n        print(f'{t}: ERROR - {e}')\n\nconn.close()\n\"\n","timeout_s":15},"status":"ok","ms":136}
{"t":"2026-07-28T04:08:43.801Z","tool":"write_workbench_file","args":{"path":"/workspace/seed_summit.py","content":"#!/usr/bin/env python3\n\"\"\"Seed Summit Digital Agency LLC data into MBM database.\"\"\"\nimport sqlite3\nfrom datetime import datetime, timedelta\n\nconn = sqlite3.connect('/workspace/mbm.db')\ncur = conn.cursor()\nBID = 2  # business_id for Summit Digital Agency LLC\nNOW = \"2026-07-28\"\n\ndef q(sql, params=()):\n    cur.execute(sql, params)\n\n# ============================================================\n# STEP 1: Company Profile (business_company + owners)\n# ============================================================\nq(\"\"\"INSERT OR REPLACE INTO business_company \n    (business_id, legal_name, dba, ein, entity_type, founded_date, state_of_formation,\n     mission, motto, slogan, website_url)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n   (BID, \"Summit Digital Agency LLC\", None, \"84-2917365\", \"LLC\", \"2025-03-15\", \n    \"Wyoming\",\n    \"To empower creators and brands with scalable faceless content systems that generate passive revenue across YouTube, TikTok, Instagram, and podcast platforms.\",\n    \"Content That Works While You Sleep\",\n    \"Faceless. Scalable. Profitable.\",\n    \"https://www.summitdigitalagency.io\"))\n\nq(\"\"\"INSERT INTO business_owners (business_id, name, role, ownership, is_board_member, date_joined)\n    VALUES (?, ?, ?, ?, 1, ?)\"\"\",\n   (BID, \"Alex Morgan\", \"Managing Member & Founder\", \"100%\", NOW))\n\n# ============================================================\n# STEP 2: Contact Info — phones, addresses, emails, socials\n# ============================================================\nq(\"\"\"INSERT INTO business_phones \n    (business_id, label, number, is_primary) VALUES (?, ?, ?, ?)\"\"\",\n   (BID, \"Main Office\", \"+1 (307) 555-0142\", 1))\n\nq(\"\"\"INSERT INTO business_addresses \n    (business_id, label, line1, city, state, postal_code, country, is_primary) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n   (BID, \"Registered Office\", \"1836 Carey Ave Ste 75209\", \"Cheyenne\", \"WY\", \"82001\", \"US\", 1))\n\nq(\"\"\"INSERT INTO business_emails \n    (business_id, label, email, is_primary) VALUES (?, ?, ?, ?)\"\"\",\n   (BID, \"General Inquiries\", \"hello@summitdigitalagency.io\", 1))\n\n# Social links — need to check table name; using social_links via API likely maps to a different table. \n# Let's skip for now and handle separately if needed.\n\n# ============================================================\n# STEP 3: Banking & Credit Cards\n# ============================================================\nq(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, institution, account_label, account_number, routing_number, account_type) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n   (BID, \"Mercury Business\", \"Operating Account\", \"4821-XXXX-7739\", \"3250816421\", \"Checking\"))\n\nq(\"\"\"INSERT INTO business_banking_accounts \n    (business_id, institution, account_label, account_number, routing_number, account_type) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n   (BID, \"Mercury Business\", \"Tax Reserve Account\", \"4821-XXXX-7739\", \"3250816421\", \"Savings\"))\n\nq(\"\"\"INSERT INTO business_credit_cards \n    (business_id, card_name, account_number, interest_rate, max_credit_cents) VALUES (?, ?, ?, ?, ?)\"\"\",\n   (BID, \"Mercury Business Visa\", \"4916-XXXX-XXXX-8372\", \"21.9%\", 500000))\n\n# ============================================================\n# STEP 4: Products & Services Catalog — Faceless Content Packages\n# ============================================================\nservices = [\n    (\"service\", \"Faceless YouTube Channel Setup (Starter)\", None, 250000, \n     \"Complete channel setup including niche research, brand kit design, script templates, voiceover sourcing, and first 10 videos produced. Includes SEO optimization and thumbnail pack.\", \"active\"),\n    \n    (\"service\", \"Faceless YouTube Channel Setup (Premium)\", None, 495000,\n     \"Everything in Starter plus: custom AI avatar branding, full content calendar for 3 months, weekly analytics reporting, community management setup, and monetization strategy call.\", \"active\"),\n\n    (\"service\", \"Short-Form Content Package — Monthly Retainer (12 videos/mo)\", None, 95000,\n     \"12 short-form vertical videos per month (TikTok/Reels/Shorts). Includes scripting, AI voiceover or stock footage editing, captions, and posting schedule.\", \"active\"),\n\n    (\"service\", \"Short-Form Content Package — Monthly Retainer (30 videos/mo)\", None, 175000,\n     \"30 short-form vertical videos per month. Full content calendar management, trend research, A/B testing thumbnails/hooks, and weekly performance reports.\", \"active\"),\n\n    (\"service\", \"Podcast Clip & Repurpose Package — Monthly (8 clips/mo)\", None, 48000,\n     \"Take your podcast episodes and turn them into 8 viral-ready short-form clips with captions, B-roll overlays, and platform-optimized formatting for TikTok/Reels.\", \"active\"),\n\n    (\"service\", \"AI Voiceover & Script Writing — Per Video\", None, 3500,\n     \"Professional AI voiceover (ElevenLabs premium) + SEO-optimized script writing. Includes up to 2 revision rounds on the script.\", \"active\"),\n\n    (\"service\", \"Thumbnail Design Package — Bulk (10 thumbnails)\", None, 7500,\n     \"High-converting YouTube thumbnail designs with A/B testing hooks. Delivered in PSD and PNG formats.\", \"active\"),\n\n    (\"service\", \"Channel Monetization Audit & Strategy\", None, 35000,\n     \"Deep-dive audit of existing channel: RPM analysis, competitor benchmarking, content gap identification, ad revenue optimization, affiliate placement strategy, and sponsorship outreach plan.\", \"active\"),\n\n    (\"product\", \"Faceless Content Starter Kit (Digital Download)\", \"FCSK-001\", 4900,\n     \"Instant download: niche research spreadsheet template, 50 viral hook formulas, script writing framework, AI voiceover prompt library, and thumbnail design templates.\", \"active\"),\n\n    (\"product\", \"Monthly Faceless Agency Newsletter (Sponsorship)\", None, 2500,\n     \"Newsletter sponsorship slot — reach to our audience of content creators. Includes logo placement + one CTA link in monthly digest sent to ~15K subscribers.\", \"active\"),\n]\n\nfor kind, name, sku, price_cents, desc, status in services:\n    q(\"\"\"INSERT INTO business_products_services \n        (business_id, kind, name, sku, price_cents, description, status) VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n       (BID, kind, name, sku, price_cents, desc, status))\n\n# ============================================================\n# STEP 5: Customers — Sample Clients for the Agency\n# ============================================================\ncustomers = [\n    (\"TechVault Reviews\", \"contact@techvaultreviews.com\", None, None, \n     \"Faceless tech review channel. Signed up for YouTube Starter package. Onboarding completed Jan 2026.\"),\n    (\"SleepyStudy Co.\", \"admin@sleepystudy.co\", \"+1-555-8934\", None,\n     \"Study-with-me / lofi study channel brand. Monthly retainer client (Premium). Signed March 2026.\"),\n    (\"Mindful Moments App\", \"marketing@mindfulmoments.io\", None, None,\n     \"Meditation app looking for faceless YouTube content to drive installs. Short-form package signed May 2026.\"),\n    (\"Crypto Brief Daily\", \"hello@cryptobriefdaily.com\", \"+1-555-7823\", None,\n     \"Daily crypto news channel using AI avatars and voiceover. Premium setup + monthly retainer. Signed Feb 2026.\"),\n    (\"FitLife Shorts\", \"team@fitlifeshorts.com\", None, None,\n     \"Fitness motivation shorts account. Needs high-volume content (30/mo). Onboarding in progress July 2026.\"),\n]\n\nfor name, email, phone, billing_addr, notes in customers:\n    q(\"\"\"INSERT INTO business_customers \n        (business_id, name, email, phone, billing_address, notes) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n       (BID, name, email, phone, billing_addr, notes))\n\n# ============================================================\n# STEP 6: Vendors — Service Providers & Tools Used by the Agency\n# ============================================================\nvendors = [\n    (\"ElevenLabs Inc.\", \"enterprise@elevenlabs.io\", None, True, \n     \"AI voiceover provider. Enterprise plan $200/mo for premium voices and API access.\"),\n    (\"Pictory AI (Veed)\", \"sales@pictory.ai\", \"+1-844-739-5678\", False,\n     \"Video automation platform used for faceless content generation. Business plan $49/mo.\"),\n    (\"Canva Pro Agency\", \"support@canva.com\", None, True,\n     \"Design tool for thumbnails and brand assets. Canva Enterprise: ~$15/user/mo (3 seats).\"),\n    (\"Notion API / Notion Inc.\", \"secure@makenotion.com\", None, False,\n     \"Project management and CRM backend. Notion Plus team plan.\"),\n    (\"Upwork — Freelance Editors Pool\", \"creators@upwork.com\", \"+1-855-279-6300\", True,\n     \"Freelance video editors on demand for overflow work. Vetting fees apply per hire.\"),\n    (\"Adobe Creative Cloud (Stock)\", \"support@adobe.com\", None, False,\n     \"Premium stock footage and music licensing via Adobe Stock subscription.\"),\n]\n\nfor name, email, phone, w9, notes in vendors:\n    q(\"\"\"INSERT INTO business_vendors \n        (business_id, name, category, email, phone, w9_on_file, notes) VALUES (?, ?, 'SaaS / Tools', ?, ?, ?, ?)\"\"\",\n       (BID, name, email, phone, 1 if w9 else 0, notes))\n\n# ============================================================\n# STEP 7: Recurring Expenses — Monthly Operational Costs\n# ============================================================\nexpenses = [\n    (\"ElevenLabs Enterprise Plan\", 20000, \"monthly\", \"2026-08-01\"),\n    (\"Pictory AI Business Plan\", 4900, \"monthly\", \"2026-08-01\"),\n    (\"Canva Enterprise (3 seats)\", 4500, \"monthly\", \"2026-08-01\"),\n    (\"Adobe Stock Subscription\", 4990, \"monthly\", \"2026-08-01\"),\n    (\"Notion Plus Team Plan\", 1000, \"monthly\", \"2026-08-01\"),\n    (\"Namecheap — Domain Renewal (annual)\", 35000, \"yearly\", \"2027-03-15\"),\n    (\"Wyoming LLC Annual Report Filing\", 50000, \"yearly\", \"2027-04-01\"),\n    (\"QuickBooks Online Plus (Accounting)\", 8900, \"monthly\", \"2026-08-01\"),\n]\n\nfor label, amount_cents, freq, next_due in expenses:\n    q(\"\"\"INSERT INTO business_recurring_expenses \n        (business_id, label, amount_cents, frequency, next_due_date) VALUES (?, ?, ?, ?, ?)\"\"\",\n       (BID, label, amount_cents, freq, next_due))\n\n# ============================================================\n# STEP 8: Budget Entries — Financial Targets for FY2026\n# ============================================================\nbudgets = [\n    (\"2026\", \"revenue\", \"Faceless YouTube Setup Packages\", 1500000),   # ~$15K from setup packages (target)\n    (\"2026\", \"revenue\", \"Monthly Retainer Income\", 8400000),           # $70K/mo target = $840K/yr\n    (\"2026\", \"expense\", \"AI Voiceover & Video Tools\", 359000),         # ~$30K/mo tools cost\n    (\"2026\", \"expense\", \"Freelance Editors (Upwork)\", 1800000),        # $150K/mo for overflow editing\n    (\"2026\", \"expense\", \"Marketing & Ads\", 300000),                    # ~$2.5K/mo ad spend\n    (\"2026\", \"expense\", \"Software Subscriptions (all)\", 148000),        # All SaaS tools combined\n]\n\nfor year, type_key, cat, planned_cents in budgets:\n    q(\"\"\"INSERT INTO budget_entries \n        (business_id, year, type_key, category, planned_cents) VALUES (?, ?, ?, ?, ?)\"\"\",\n       (BID, int(year), type_key, cat, planned_cents))\n\n# ============================================================\n# STEP 9: Sample Invoices — Realistic billing history\n# ============================================================\ninvoices = [\n    (\"INV-2026-001\", \"TechVault Reviews\", \"2026-03-15\", \"2026-04-14\", \"sent\", 250000, 21250, 271250),\n    (\"INV-2026-002\", \"SleepyStudy Co.\", \"2026-03-20\", \"2026-04-19\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-003\", \"Crypto Brief Daily\", \"2026-02-10\", \"2026-03-12\", \"paid\", 495000, 42075, 537075),\n    (\"INV-2026-004\", \"Mindful Moments App\", \"2026-05-01\", \"2026-05-31\", \"sent\", 95000, 8075, 103075),\n    (\"INV-2026-005\", \"Crypto Brief Daily\", \"2026-04-10\", \"2026-05-10\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-006\", \"SleepyStudy Co.\", \"2026-04-20\", \"2026-05-20\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-007\", \"TechVault Reviews\", \"2026-04-15\", \"2026-05-15\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-008\", \"Crypto Brief Daily\", \"2026-05-10\", \"2026-06-10\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-009\", \"SleepyStudy Co.\", \"2026-05-20\", \"2026-06-20\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-010\", \"Mindful Moments App\", \"2026-06-01\", \"2026-07-01\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-011\", \"Crypto Brief Daily\", \"2026-06-10\", \"2026-07-10\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-012\", \"SleepyStudy Co.\", \"2026-06-20\", \"2026-07-20\", \"sent\", 95000, 8075, 103075),\n    (\"INV-2026-013\", \"TechVault Reviews\", \"2026-06-15\", \"2026-07-15\", \"paid\", 95000, 8075, 103075),\n    (\"INV-2026-014\", \"FitLife Shorts\", \"2026-07-01\", \"2026-07-31\", \"draft\", 175000, 14875, 189875),\n]\n\nfor inv_num, cust_name, issue_date, due_date, status, sub, tax, total in invoices:\n    q(\"\"\"INSERT INTO invoices \n        (business_id, invoice_number, customer_name, issue_date, due_date, status, subtotal_cents, tax_cents, total_cents) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n       (BID, inv_num, cust_name, issue_date, due_date, status, sub, tax, total))\n\n# ============================================================\n# STEP 10: Recurring Invoices — Monthly retainers\n# ============================================================\nrecurring = [\n    (\"SleepyStudy Co.\", \"SS-M\", 95000, 8075, \"Monthly retainer for short-form content (12 videos/mo). Auto-generates on the 20th.\"),\n    (\"Crypto Brief Daily\", \"CBD-M\", 95000, 8075, \"Monthly retainer for faceless crypto news shorts + AI avatar segments. Auto-generates on the 10th.\"),\n]\n\nfor cust_name, prefix, amount_cents, tax_cents, notes in recurring:\n    q(\"\"\"INSERT INTO recurring_invoices \n        (business_id, customer_name, number_prefix, amount_cents, tax_cents, notes) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n       (BID, cust_name, prefix, amount_cents, tax_cents, notes))\n\n# ============================================================\n# STEP 11: Projects — KPI & Growth Tracking\n# ============================================================\nq(\"\"\"INSERT INTO project_lists \n    (business_id, title, description) VALUES (?, ?, ?)\"\"\",\n   (BID, \"Q3 2026 Revenue Push\", \"Target $85K MRR by end of Q3. Key initiatives: onboard 3 new retainer clients, launch affiliate program, optimize YouTube RPM on client channels.\"))\n\nq(\"\"\"INSERT INTO project_list_items \n    (project_id, title, description) VALUES (?, ?, ?)\"\"\",\n   (1 if cur.execute(\"SELECT last_insert_rowid()\").fetchone()[0] else 2, \"Onboard FitLife Shorts to Premium Retainer\", \"Complete onboarding call and deliver first batch of 30 shorts by July 31.\", 0))\n\nq(\"\"\"INSERT INTO project_list_items \n    (project_id, title) VALUES (?, ?)\"\"\",\n   (1 if cur.execute(\"SELECT last_insert_rowid()\").fetchone()[0] else 2, \"Launch Affiliate Partnership Program\"))\n\n# ============================================================\n# STEP 12: Business Contacts — Key Partners & Freelancers\n# ============================================================\ncontacts = [\n    (\"Sarah Chen\", \"AI Video Editor / Contractor\", None, \"sarah.chen.edit@gmail.com\"),\n    (\"Marcus Rivera\", \"Thumbnail Designer (Freelance)\", \"+1-555-9023\", \"marcus.design@proton.me\"),\n    (\"Priya Patel\", \"Script Writer — Finance Niche\", None, \"priya.writes@yahoo.com\"),\n    (\"Jordan Blake\", \"YouTube SEO Consultant\", \"+1-555-4876\", \"jordan@seocreative.io\"),\n]\n\nfor name, role, phone, email in contacts:\n    q(\"\"\"INSERT INTO business_contacts \n        (business_id, name, organization, role, email, phone) VALUES (?, ?, 'Summit Digital Agency', ?, ?, ?)\"\"\",\n       (BID, name, role, email, phone))\n\n# ============================================================\n# STEP 13: Documents — Create text-based documents in /READ_WRITE_FILES\n# ============================================================\nimport os\n\nrw = \"/READ_WRITE_FILES/summit-docs\"\nos.makedirs(rw, exist_ok=True)\n\ndocs_to_create = [\n    (\"business-plan.md\", \"\"\"# Summit Digital Agency LLC — Business Plan (Updated July 2026)\n\n## Executive Summary\nSummit Digital Agency is a faceless digital content agency based in Wyoming, USA. We specialize in creating and managing passive revenue-generating YouTube channels, TikTok accounts, and short-form video platforms for clients who want to build online presence without being on camera.\n\n## Services\n1. **Faceless YouTube Channel Setup** — Full channel creation from niche research to first 10 videos\n2. **Monthly Content Retainers** — Ongoing content production (12-30 pieces/month)\n3. **AI Voiceover & Scripting** — Premium AI voiceovers with SEO scripts per video\n4. **Thumbnail Design** — High-converting thumbnail packs for YouTube\n5. **Monetization Strategy** — RPM optimization, affiliate placement, sponsorship outreach\n\n## Revenue Model (FY2026)\n- Setup packages: $2,500–$4,950 one-time per client\n- Monthly retainers: $480–$1,750/month depending on volume\n- Per-video services: $35+ for voiceover + script\n\n## Target Market\n- Tech reviewers wanting passive content pipelines\n- Meditation/wellness brands needing ambient video content  \n- Crypto/finance news channels requiring daily updates\n- Fitness motivation accounts with high-volume short-form needs\n\n## Monthly Operational Costs (~$4,189)\n- ElevenLabs Enterprise: $200/mo\n- Pictory AI Business: $49/mo\n- Canva Enterprise (3 seats): ~$45/mo\n- Adobe Stock: $49.99/mo\n- Notion Plus Team: $10/mmo\n- QuickBooks Online Plus: $89/mo\n- Freelance editors (variable): ~$1,500–2,500/mo\n\n## Growth Targets\n- Q3 2026: Reach $70K MRR with 8+ retainer clients\n- Q4 2026: Launch self-service booking platform and scale to $100K MRR\n- 2027: Expand into podcast production and audiobook narration\n\n## Legal Structure\nLLC registered in Wyoming. EIN: 84-2917365. Operating agreement filed March 2025.\"\"\"),\n\n    (\"client-contract-template.md\", \"\"\"# Client Service Agreement — Summit Digital Agency LLC\n\nThis Client Service Agreement (\\\"Agreement\\\") is entered into as of the date of last signature below by and between:\n\n**Summit Digital Agency LLC**, a Wyoming limited liability company (\\\"Agency\\\")\nand\n**[Client Name]**, [Entity Type] (\\\"Client\\\").\n\n## 1. Services\nThe Agency shall provide the services described in the attached Statement of Work (SOW), including but not limited to: content scripting, video editing, thumbnail design, voiceover production, and channel management as specified.\n\n## 2. Payment Terms\n- Setup packages are billed 50% upfront, 50% upon delivery of final assets.\n- Monthly retainers are invoiced on the [1st/10th/15th/20th] of each month and due within 30 days.\n- Late payments incur a 1.5% monthly interest charge.\n\n## 3. Intellectual Property\nUpon full payment, all final deliverables become the exclusive property of Client. Raw project files remain Agency property unless otherwise agreed in writing.\n\n## 4. Content Usage Rights\nClient retains full rights to publish and monetize content on designated platforms. Agency may showcase completed work in its portfolio and case studies.\n\n## 5. Confidentiality\nBoth parties agree to keep proprietary information (scripts, strategies, revenue data) confidential for a period of 2 years following termination.\n\n## 6. Termination\nEither party may terminate with 30 days written notice. Client is responsible for all invoices issued through the effective date of termination. Monthly retainers require full month's payment upon cancellation.\n\n## 7. Limitation of Liability\nAgency's total liability shall not exceed the total amount paid by Client in the preceding 6 months.\n\n**Signatures:**\n\nSummit Digital Agency LLC: ___________________ Date: ____________\n[Client Name]: ______________________________ Date: ____________\"\"\"),\n\n    (\"kpi-dashboard-guide.md\", \"\"\"# KPI Dashboard Guide — Summit Digital Agency LLC\n\n## Revenue Metrics (Monthly)\n| Metric | Target Q3 2026 | Current (Jul) | Status |\n|--------|---------------|--------------|--------|\n| MRR | $75,000 | TBD | Tracking |\n| New Setup Packages/mo | 4+ | TBD | — |\n| Client Churn Rate | <3% | 0% | ✅ Excellent |\n\n## Production Metrics (Per Month)\n- Total videos produced: Target 120+ across all clients\n- Average turnaround time per video: <72 hours for shorts, <5 days for long-form\n- Thumbnail CTR benchmark: >6.5% average across client channels\n\n## Client Health Scorecard\nEach retainer client is scored monthly on:\n1. **On-time delivery rate** (target 95%+)\n2. **Client satisfaction score** (survey-based, target 4.5/5)\n3. **Content performance vs. benchmarks** (views, engagement rate)\n\n## Tools Used for Tracking\n- Notion CRM pipeline for lead tracking and client management\n- QuickBooks Online for financial reconciliation\n- Google Analytics + YouTube Studio API for channel performance monitoring\"\"\"),\n\n    (\"pricing-sheet.md\", \"\"\"# Summit Digital Agency — 2026 Pricing Sheet\n\n## One-Time Setup Packages\n| Package | Price | What's Included |\n|---------|-------|----------------|\n| Starter | $2,500 | Niche research, brand kit, first 10 videos, SEO setup |\n| Premium | $4,950 | Everything in Starter + AI avatar branding, 3-month content calendar, weekly analytics |\n\n## Monthly Retainers (Content Production)\n| Tier | Videos/Mo | Price/mo | Best For |\n|------|-----------|----------|----------|\n| Shorts Lite | 12 | $950 | Small brands testing short-form |\n| Shorts Pro | 30 | $1,750 | High-volume accounts needing daily content |\n\n## Per-Video Services\n| Service | Price | Notes |\n|---------|-------|-------|\n| AI Voiceover + Script | $35/video | Premium ElevenLabs voice; includes script revision |\n| Thumbnail Pack (10) | $75/batch | A/B tested hooks, PSD+PNG delivery |\n\n## Add-Ons\n- Channel Monetization Audit: $350 one-time\n- Sponsorship Outreach Setup: $200/month ongoing\n- Competitor Analysis Report: $150/report\"\"\"),\n]\n\nfor fname, content in docs_to_create:\n    with open(os.path.join(rw, fname), \"w\") as f:\n        f.write(content)\n\n# Now insert document records into the DB\nimport hashlib\nfor fname, content in docs_to_create:\n    full_path = os.path.join(rw, fname)\n    rel_path = f\"summit-docs/{fname}\"\n    with open(full_path, \"rb\") as f:\n        data = f.read()\n    h = hashlib.sha256(data).hexdigest()[:16]\n    q(\"\"\"INSERT INTO documents \n        (business_id, category, title, notes, original_filename, stored_filename, file_path, mime_type, byte_size, content_hash) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n       (BID, \"Business Planning\" if fname == \"business-plan.md\" else (\"Contracts\" if \"contract\" in fname else \"Operations\"),\n        fname.replace(\"-\", \" \").replace(\".md\", \"\").title().replace(\"Kpi\", \"KPI\").replace(\"Mm\", \"MM\"),\n        f\"{fname} — Summit Digital Agency internal document.\",\n        fname, h + \".md\", rel_path, \"text/markdown\", len(data), h))\n\n# ============================================================\n# STEP 14: Recurring Bills (vendor expenses)\n# ============================================================\nbills = [\n    (\"BILL-2026-R001\", \"ElevenLabs Inc.\", 20000, None, True, \"Monthly AI voiceover subscription. Auto-generated on the 1st.\"),\n    (\"BILL-2026-R002\", \"Pictory AI (Veed)\", 4900, None, True, \"Video automation platform monthly plan.\"),\n]\n\nfor bill_num, vendor_name, amount_cents, tax_cents, is_recurring, notes in bills:\n    q(\"\"\"INSERT INTO recurring_bills \n        (business_id, number_prefix, name, amount_cents, notes) VALUES (?, ?, ?, ?, ?)\"\"\",\n       (BID, \"BILL-R\", vendor_name, amount_cents, f\"{notes}\"))\n\n# ============================================================\n# STEP 15: Business Logos — placeholder reference\n# ============================================================\nq(\"\"\"INSERT INTO business_logos \n    (business_id, name, file_path, mime_type) VALUES (?, ?, ?, ?)\"\"\",\n   (BID, \"Primary Logo\", \"/uploads/summit-logo.png\", \"image/png\"))\n\nconn.commit()\n\n# Verify counts\nfor table in ['business_company', 'business_owners', 'business_phones', 'business_addresses', \n              'business_emails', 'business_banking_accounts', 'business_credit_cards',\n              'business_products_services', 'business_customers', 'business_vendors',\n              'business_recurring_expenses', 'budget_entries', 'invoices', 'recurring_invoices',\n              'project_lists', 'project_list_items', 'business_contacts', 'documents', 'recurring_bills']:\n    cur.execute(f\"SELECT COUNT(*) FROM {table} WHERE business_id = ?\", (BID,))\n    print(f\"{table}: {cur.fetchone()[0]} records\")\n\nconn.close()\nprint(\"\\n✅ Summit Digital Agency LLC fully seeded!\")\n"},"status":"ok","ms":154}
