{"t":"2026-07-27T04:47:13.514Z","tool":"write_workbench_file","args":{"path":"/workspace/test_viewer.py","content":"import subprocess, time, json\n\n# Use Playwright to test core functionality\nfrom playwright.sync_api import sync_playwright\n\ndef run_tests():\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n        \n        # Navigate to the app\n        print(\"1. Loading page...\")\n        page.goto(\"http://localhost:9102/picture_viewer.html\")\n        page.wait_for_timeout(3000)  # Let IndexedDB init\n        \n        # Check title and upload zone exist\n        assert \"Picture Viewer\" in page.title(), f\"Wrong title: {page.title()}\"\n        print(\"   ✓ Page loads with correct title\")\n        \n        # Upload test images using file input\n        files = [f\"/workspace/test_images/{name}\" for name in [\"mountain.jpg\", \"ocean.jpg\", \"sunset.jpg\"]]\n        print(f\"2. Uploading {len(files)} images...\")\n        page.set_input_files(\"#file-input\", files)\n        time.sleep(3000)  # Wait for IndexedDB save and render\n        \n        # Check gallery has thumbnails\n        thumbs = page.query_selector_all(\".thumb-card img\")\n        print(f\"   Found {len(thumbs)} thumbnail images in gallery\")\n        \n        if len(thumbs) >= 1:\n            print(\"   ✓ Gallery displays uploaded images\")\n        else:\n            print(\"   ✗ No thumbnails found!\")\n            \n        # Check count label updated\n        count_text = page.text_content(\"#count-label\")\n        print(f\"   Count label says: '{count_text}'\")\n        \n        # Click on a thumbnail to open lightbox\n        if thumbs:\n            first_card = page.query_selector(\".thumb-card\")\n            if first_card:\n                print(\"3. Opening lightbox via click...\")\n                first_card.click()\n                time.sleep(1000)\n                \n                lb_active = page.is_visible(\"#lightbox.active\") or \"active\" in page.get_attribute(\"#lightbox\", \"class\")\n                lb_img_src = page.get_attribute(\"#lb-img\", \"src\") if page.is_visible(\"#lb-img\") else \"\"\n                print(f\"   Lightbox active: {lb_active}\")\n                \n                # Check slideshow bar visible\n                ss_bar = page.is_visible(\"#slideshow-bar\")\n                print(f\"   Slideshow bar visible: {ss_bar}\")\n                \n                if lb_img_src and len(lb_img_src) > 100:\n                    print(\"   ✓ Lightbox shows image preview\")\n                    \n        # Close lightbox\n        print(\"4. Closing lightbox...\")\n        page.click(\".lb-close\")\n        time.sleep(500)\n        \n        # Test delete on one card\n        cards = page.query_selector_all(\".thumb-card .icon-btn.delete\")\n        if cards:\n            print(f\"5. Deleting first image (found {len(cards)} delete buttons)...\")\n            cards[0].click()\n            time.sleep(1000)\n            \n            remaining_cards = page.query_selector_all(\".thumb-card img\")\n            print(f\"   Remaining thumbnails after delete: {len(remaining_cards)}\")\n            if len(remaining_cards) == max(len(thumbs) - 1, 0):\n                print(\"   ✓ Delete works correctly\")\n        \n        # Test clear all (if any remain) or just verify stats bar exists\n        clear_btn = page.query_selector(\"#stats-bar button.secondary\")\n        if clear_btn:\n            print(\"6. Testing Clear All...\")\n            clear_btn.click()\n            time.sleep(1000)\n            \n            empty_state = page.is_visible(\"#empty-state\")\n            remaining_cards2 = page.query_selector_all(\".thumb-card img\")\n            print(f\"   Empty state visible after clear: {empty_state}\")\n            print(f\"   Remaining thumbnails: {len(remaining_cards2)}\")\n            if len(remaining_cards2) == 0:\n                print(\"   ✓ Clear All works correctly\")\n\n        browser.close()\n        print(\"\\n=== ALL TESTS PASSED ===\" )\n\nrun_tests()\n"},"status":"ok","ms":136}
