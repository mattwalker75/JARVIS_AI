mmitfinance.com or similar\", 30),\n    (\"Design channel branding (banner, logo)\", 90),\n    (\"Script first 5 videos for launch week\", 180),\n]\n\nwith db() as conn:\n    for i, (task_name, duration) in enumerate(tasks):\n        conn.execute(\n            \"\"\"INSERT INTO business_time_entries \n               (business_id, project_name, description, duration_minutes, entry_date) VALUES (?, ?, ?, ?, ?)\"\"\",\n            (BUSINESS_ID, \"Q3 2026 Growth Initiative\", task_name, duration,\n             (datetime.now() - timedelta(days=i)).strftime(\"%Y-%m-%d\"))\n        )\n\nprint(\"  ✓ Project created with time entries\\n\")"},"status":"error: old_string not found in /workspace/populate_summit.py. It must match EXACTLY (including whitespace/indentation) — read the file first and copy the snippet verbatim.","ms":1}
