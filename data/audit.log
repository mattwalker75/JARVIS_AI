{"t":"2026-07-26T18:20:11.842Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom.py","content":"\"\"\"Playwright test for DOOM raycasting game — verify canvas renders, no JS errors.\"\"\"\nimport sys\nfrom playwright.sync_api import sync_playwright\n\ndef run_test():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={\"width\": 1024, \"height\": 768})\n        \n        # Capture console messages\n        page = context.new_page()\n        console_messages = []\n        \n        def on_console(msg):\n            console_messages.append({\"type\": msg.type(), \"text\": msg.text()})\n        \n        page.on(\"console\", on_console)\n        \n        try:\n            print(\"[TEST] Loading game at http://localhost:9101...\")\n            page.goto(\"http://localhost:9101/\", timeout=30000)\n            \n            # Wait a bit for the game to initialize\n            import time\n            time.sleep(2)\n            \n            print(\"[TEST] Checking console messages...\")\n            js_errors = [m for m in console_messages if m[\"type\"] == \"error\"]\n            \n            if js_errors:\n                results.append(f\"FAIL — {len(js_errors)} JS error(s) found:\")\n                for e in js_errors:\n                    results.append(f\"  Error: {e['text'][:200]}\")\n            else:\n                results.append(\"PASS — No JavaScript errors in console.\")\n            \n            # Check canvas exists and has dimensions\n            print(\"[TEST] Checking canvas element...\")\n            canvas = page.query_selector(\"canvas\")\n            if not canvas:\n                results.append(\"FAIL — No <canvas> element found on the page.\")\n            else:\n                bbox = canvas.bounding_box()\n                width, height = bbox.get(\"width\", 0), bbox.get(\"height\", 0)\n                print(f\"[TEST] Canvas dimensions: {width}x{height}\")\n                \n                if width > 0 and height > 0:\n                    results.append(f\"PASS — Canvas exists with valid dimensions ({width}x{height}).\")\n                    \n                    # Check canvas has content (pixel sampling)\n                    print(\"[TEST] Sampling canvas pixels...\")\n                    pixel_data = page.evaluate(\"\"\"() => {\n                        const c = document.querySelector('canvas');\n                        if (!c || !c.width || !c.height) return null;\n                        try {\n                            const ctx = c.getContext('2d');\n                            const imgData = ctx.getImageData(0, 0, 1, 1);\n                            // Check a few pixels from center area\n                            const cx = Math.floor(c.width / 2), cy = Math.floor(c.height / 3);\n                            return {\n                                width: c.width, height: c.height,\n                                pixelCenter: Array.from(ctx.getImageData(cx-1, cy-1, 3, 3).data.slice(0, 9)),\n                                hasNonZeroPixels: imgData.data.some(v => v > 0)\n                            };\n                        } catch(e) { return 'error'; }\n                    }\"\"\")\n                    \n                    if pixel_data and isinstance(pixel_data, dict):\n                        results.append(f\"PASS — Canvas rendered with content (width={pixel_data['width']}, height={pixel_data['height']}, hasNonZeroPixels={pixel_data.get('hasNonZeroPixels')}).\")\n                        \n                        # Check that the floor/ceiling are visible (different colors)\n                        w, h = pixel_data[\"width\"], pixel_data[\"height\"]\n                        if w > 0 and h > 0:\n                            ceiling_color = page.evaluate(f\"\"\"() => {{\n                                const c = document.querySelector('canvas');\n                                const ctx = c.getContext('2d');\n                                return Array.from(ctx.getImageData(Math.floor({w}/2), Math.floor({h}/6), 1, 1).data);\n                            }}\"\"\")\n                            floor_color = page.evaluate(f\"\"\"() => {{\n                                const c = document.querySelector('canvas');\n                                const ctx = c.getContext('2d');\n                                return Array.from(ctx.getImageData(Math.floor({w}/2), Math.floor(5*{h}/6), 1, 1).data);\n                            }}\"\"\")\n                            \n                            if ceiling_color and floor_color:\n                                print(f\"[TEST] Ceiling pixel (center-top): {ceiling_color}\")\n                                print(f\"[TEST] Floor pixel (center-bottom): {floor_color}\")\n                                \n                                # They should be different colors (sky vs ground)\n                                diff = sum(abs(a - b) for a, b in zip(ceiling_color[:3], floor_color[:3]))\n                                if diff > 50:\n                                    results.append(f\"PASS — Ceiling and floor render with distinct colors (difference={diff}).\")\n                                else:\n                                    results.append(f\"WARN — Ceiling ({ceiling_color}) vs Floor ({floor_color}) differ by only {diff}. Game may not be rendering correctly.\")\n                            else:\n                                results.append(\"WARN — Could not read pixel data from canvas regions.\")\n                    elif isinstance(pixel_data, str):\n                        results.append(f\"FAIL — Canvas getPixel error: {pixel_data}\")\n                else:\n                    results.append(f\"FAIL — Canvas has zero or negative dimensions ({width}x{height}).\")\n            \n            # Test keyboard input (move forward) and check game state changes\n            print(\"[TEST] Testing keyboard interaction...\")\n            page.keyboard.press(\"KeyW\")\n            time.sleep(0.5)\n            player_state = page.evaluate(\"\"\"() => {\n                try {\n                    return {\n                        px: typeof gPlayer !== 'undefined' ? gPlayer.x : (typeof x != 'undefined' ? x : null),\n                        py: typeof gPlayer !== 'undefined' ? gPlayer.y : (typeof y != 'undefined' ? y : null)\n                    };\n                } catch(e) { return {error: e.message}; }\n            }\"\"\")\n            print(f\"[TEST] Player state after W keypress: {player_state}\")\n            \n            if \"error\" not in str(player_state):\n                results.append(\"PASS — Game responds to keyboard input without JS error.\")\n            else:\n                results.append(f\"WARN — Could not read player state (may use different variable names).\")\n            \n        except Exception as e:\n            results.append(f\"FAIL — Test exception: {e}\")\n        \n        finally:\n            browser.close()\n    \n    print(\"\\n=== TEST RESULTS ===\")\n    for r in results:\n        print(r)\n    \n    failures = [r for r in results if r.startswith(\"FAIL\")]\n    return 0 if not failures else 1\n\nif __name__ == \"__main__\":\n    sys.exit(run_test())\n"},"status":"ok","ms":153}
