{"t":"2026-07-27T04:50:54.050Z","tool":"edit_workbench_file","args":{"path":"/workspace/picture_viewer.html","old_string":"function getAllImages() {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readonly');\n    const s = tx.objectStore(STORE);\n    const idx = s.index('timestamp');\n    const req = idx.getAll(); // get all sorted by timestamp desc (we'll reverse in JS if needed)\n    // Actually getAll() on index returns everything; we need to sort. Let's use openCursor for descending.\n    resolve(req.result);\n  });\n}","new_string":"function getAllImages() {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readonly');\n    const s = tx.objectStore(STORE);\n    const req = s.getAll();\n    req.onsuccess = () => resolve(req.result || []);\n    req.onerror = () => reject(req.error);\n  });\n}"},"status":"ok","ms":135}
