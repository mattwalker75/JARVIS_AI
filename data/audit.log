{"t":"2026-07-26T18:27:15.647Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom.py","content":"\"\"\"Playwright E2E tests for the DOOM-like raycasting FPS game.\"\"\"\nimport sys, re\nfrom playwright.sync_api import sync_playwright\n\nPASS = 0\nFAIL = 0\n\ndef report(name, passed, detail=\"\"):\n    global PASS, FAIL\n    if passed:\n        print(f\"  ✅ {name}\")\n        PASS += 1\n    else:\n        print(f\"  ❌ {name}\" + (f\" — {detail}\" if detail else \"\"))\n        FAIL += 1\n\ndef run_tests():\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n\n        console_errors = []\n        def on_console(msg):\n            if msg.type == \"error\":\n                console_errors.append(msg.text)\n\n        page.on(\"console\", on_console)\n\n        print(\"\\n=== DOOM Game Playwright Tests ===\\n\")\n\n        # --- Test 1: Page loads and returns HTTP 200 ---\n        try:\n            resp = page.goto(\"http://localhost:9101/\", timeout=15000)\n            report(\"Page loads (HTTP status)\", resp.status == 200, f\"status={resp.status}\")\n        except Exception as e:\n            report(\"Page loads\", False, str(e))\n\n        # --- Test 2: Canvas element exists in DOM ---\n        canvas = page.query_selector(\"#game\")\n        report(\"Canvas #game exists in DOM\", bool(canvas), \"canvas not found\")\n\n        if canvas:\n            style = canvas.evaluate(\"el => window.getComputedStyle(el).display\")\n            rect = canvas.bounding_box()\n            report(\"Canvas is rendered and has dimensions\",\n                   bool(rect and rect[\"width\"] > 0 and rect[\"height\"] > 0),\n                   f\"display={style}, bbox={rect}\")\n\n        # --- Test 3: No JS errors in console after initial load ---\n        page.wait_for_timeout(2000)\n        report(\"No JS errors on startup\", len(console_errors) == 0,\n               \"; \".join(console_errors[:3]) if console_errors else \"\")\n\n        initial_error_count = len(console_errors)\n\n        # --- Test 4: Move mouse — no JS errors from movement handler ---\n        page.mouse.move(512, 384)\n        page.wait_for_timeout(500)\n        new_errs_after_move = len(console_errors) - initial_error_count\n        report(\"Mouse move causes no JS errors\", new_errs_after_move == 0, \"check console log\")\n\n        # --- Test 5: Press key (W) — no JS errors from movement handler ---\n        page.keyboard.press(\"w\")\n        page.wait_for_timeout(500)\n        errs_after_w = len(console_errors) - initial_error_count - new_errs_after_move\n        report(\"Key press (W) causes no JS errors\", errs_after_w == 0, \"check console log\")\n\n        # --- Test 6: Press space to shoot — verify HP/ammo elements exist and update ---\n        page.keyboard.press(\" \")\n        page.wait_for_timeout(500)\n        \n        hp_el = page.query_selector(\"#hp\")\n        ammo_el = page.query_selector(\"#ammo\")\n        \n        if hp_el:\n            hp_text = hp_el.inner_text()\n            report(\"HP element exists and has text\", bool(hp_text.strip()), f\"hp={hp_text}\")\n\n        # --- Test 7: Verify Bug Fix 1 — enemy .dist property set via spread in render loop ---\n        page_content = page.content()\n        \n        # The fix spreads {...en, dist: Math.sqrt(...)} so each enemy gets a .dist property\n        has_dist_spread = bool(re.search(r'\\{\\.\\.\\.e?n,\\s*dist:', page_content))\n        report(\"Bug Fix 1: Enemy dist assigned on object (spread syntax)\", has_dist_spread,\n               \"no spread with dist found\")\n\n        # --- Test 8: Verify Bug Fix 2 — W/H defined before death screen uses them ---\n        render_idx = page_content.find(\"function render\")\n        if render_idx > -1:\n            after_render_start = page_content[render_idx:]\n            \n            # Find where death screen references W or H (e.g., \"W /\", \"H/\", etc.)\n            death_match = re.search(r'death|dead', after_render_start)\n            first_w_def = after_render_start.find(\"var W\") if \"var W\" in after_render_start else 99999\n            \n            # Check that var/let/const W appears before any reference to it in the death context\n            has_proper_scope = True\n            for scope_kw in [\"var W\", \"let W\", \"const W\"]:\n                if scope_kw in page_content[:page_content.find(\"death\")]:\n                    has_proper_scope = True\n                    break\n            \n            report(\"Bug Fix 2: W/H defined with proper scope (before death screen)\", \n                   has_proper_scope, \"scope check failed\")\n\n        # --- Test 9: Verify Bug Fix 3 — damageFlash clamped to [0,1] ---\n        has_clamp = bool(re.search(r'damageFlash.*(?:Math\\.max\\(0|\\.clamp\\()', page_content)) or \\\n                    (\"damageFlash\" in page_content and \"Math.min(1,\" in page_content)\n        report(\"Bug Fix 3: damageFlash clamped to [0,1]\", has_clamp,\n               \"no clamp found for damageFlash\")\n\n        # --- Test 10: Verify game renders frames (canvas screenshot works) ---\n        if canvas and rect and rect[\"width\"] > 0:\n            try:\n                full_screenshot = page.screenshot(full_page=False, type=\"png\")\n                report(\"Canvas can be captured as image (rendering works)\", len(full_screenshot) > 1000,\n                       f\"screenshot size={len(full_screenshot)} bytes\")\n                \n                if len(full_screenshot) > 1000:\n                    # Verify the canvas has varied pixel data (not just solid black — walls should be visible)\n                    import base64\n                    from PIL import Image\n                    img = Image.open(__import__('io').BytesIO(base64.b64decode(\"\")))\n            except Exception as e:\n                pass  # non-critical\n\n        # Take a screenshot of the full viewport to verify rendering\n        try:\n            vp_screenshot = page.screenshot(full_page=False, type=\"png\")\n            report(\"Viewport screenshot captured (game renders)\", len(vp_screenshot) > 5000,\n                   f\"screenshot size={len(vp_screenshot)} bytes\")\n            \n            # Verify canvas has non-trivial content by sampling pixel data via JS\n            if canvas:\n                sample_colors = canvas.evaluate(\"\"\"() => {\n                    const c = document.getElementById('game');\n                    if (!c || !c.width) return [];\n                    try {\n                        const ctx = c.getContext('2d');\n                        const imgData = ctx.getImageData(0, 0, Math.min(c.width,16), Math.min(c.height,16));\n                        // Count unique colors in a small sample\n                        const colors = new Set();\n                        for (let i=0; i<imgData.data.length; i+=4) {\n                            if (imgData.data[i+3] > 50) {\n                                colors.add(imgData.data[i]+','+imgData.data[i+1]+','+imgData.data[i+2]);\n                            }\n                        }\n                        return [...colors].slice(0, 20);\n                    } catch(e) { return []; }\n                }\"\"\")\n                \n                report(\"Canvas has varied pixel data (raycasting output)\", \n                       len(sample_colors) >= 3, f\"found {len(sample_colors)} unique colors: {sample_colors[:5]}...\")\n\n        except Exception as e:\n            report(\"Viewport rendering\", False, str(e))\n\n        # --- Test 11: Verify game state elements exist ---\n        ui_el = page.query_selector(\"#ui\")\n        crosshair_el = page.query_selector(\"#crosshair\")\n        report(\"UI overlay (HP/ammo) exists\", bool(ui_el), \"no #ui element\")\n        report(\"Crosshair exists\", bool(crosshair_el), \"no #crosshair element\")\n\n        browser.close()\n\n    print(f\"\\n=== Results: {PASS} passed, {FAIL} failed ===\\n\")\n    return FAIL == 0\n\nif __name__ == \"__main__\":\n    success = run_tests()\n    sys.exit(0 if success else 1)\n"},"status":"ok","ms":135}
