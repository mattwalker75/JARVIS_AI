{"t":"2026-07-27T04:17:48.868Z","tool":"write_workbench_file","args":{"path":"/workspace/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Spinning Color-Shifting Torus</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { overflow: hidden; background: #050510; }\ncanvas { display: block; }\n#info { position:absolute; bottom:12px; left:50%; transform:translateX(-50%); color:rgba(255,255,255,.4); font-family:sans-serif; font-size:12px; pointer-events:none; user-select:none; }\n</style>\n</head>\n<body>\n<div id=\"info\">Spinning Color-Shifting Torus</div>\n\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://unpkg.com/three@0.163.0/build/three.module.js\"}}</script>\n<script type=\"module\">\nimport * as THREE from 'three';\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x050510);\n\nconst camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, 0.1, 100);\ncamera.position.set(0, 0, 4);\n\nconst renderer = new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth, innerHeight);\ndocument.body.appendChild(renderer.domElement);\n\n// Torus geometry\nconst geo = new THREE.TorusGeometry(1.0, 0.4, 64, 128);\n\n// Standard material with emissive color shifting via JS animation\nconst mat = new THREE.MeshStandardMaterial({\n    metalness: 0.7,\n    roughness: 0.3,\n    emissive: new THREE.Color(0x000000),\n});\n\nconst torus = new THREE.Mesh(geo, mat);\nscene.add(torus);\n\n// Lights for nice shading\nconst dirLight = new THREE.DirectionalLight(0xffffff, 1.5);\ndirLight.position.set(2, 3, 4);\nscene.add(dirLight);\n\nconst ambLight = new THREE.AmbientLight(0x222244, 0.8);\nscene.add(ambLight);\n\n// HSL color cycling helper (no vec3 cos issues)\nfunction hslToThreeColor(h, s, l) {\n    const c = new THREE.Color();\n    c.setHSL(h % 1, Math.max(0, s), Math.max(0.25, Math.min(l, 0.75)));\n    return c;\n}\n\nconst clock = new THREE.Clock();\n\nfunction animate() {\n    requestAnimationFrame(animate);\n    const t = clock.getElapsedTime();\n\n    // Slow multi-axis rotation\n    torus.rotation.x += 0.003;\n    torus.rotation.y += 0.005;\n\n    // Shift hue over time for color-changing effect\n    mat.emissive.copy(hslToThreeColor(t * 0.1, 0.8, 0.4));\n    mat.color.setHSL((t * 0.07) % 1, 0.6, 0.5);\n\n    renderer.render(scene, camera);\n}\n\nwindow.addEventListener('resize', () => {\n    camera.aspect = innerWidth / innerHeight;\n    camera.updateProjectionMatrix();\n    renderer.setSize(innerWidth, innerHeight);\n});\n\nanimate();\n</script>\n</body>\n</html>\n"},"status":"ok","ms":135}
