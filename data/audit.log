{"t":"2026-07-27T04:44:15.837Z","tool":"write_workbench_file","args":{"path":"/workspace/picture_viewer.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Picture Viewer</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --bg: #0f0f0f;\n    --surface: #1a1a2e;\n    --surface2: #16213e;\n    --accent: #e94560;\n    --accent-hover: #ff6b81;\n    --text: #eee;\n    --text-dim: #aaa;\n    --radius: 12px;\n  }\n\n  body {\n    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  /* Header */\n  header {\n    background: linear-gradient(135deg, var(--surface), var(--surface2));\n    padding: 20px 32px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    box-shadow: 0 4px 20px rgba(0,0,0,.5);\n    position: sticky; top: 0; z-index: 100;\n  }\n\n  header h1 {\n    font-size: 1.6rem;\n    background: linear-gradient(90deg, var(--accent), #ff9a76);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: .5px;\n  }\n\n  header-actions { display: flex; gap: 12px; align-items: center; }\n\n  button, .btn {\n    background: var(--accent);\n    color: #fff;\n    border: none;\n    padding: 10px 20px;\n    border-radius: var(--radius);\n    cursor: pointer;\n    font-size: .95rem;\n    font-weight: 600;\n    transition: background .2s, transform .1s;\n  }\n\n  button:hover, .btn:hover { background: var(--accent-hover); transform: translateY(-1px); }\n  button:active { transform: scale(.97); }\n\n  button.secondary {\n    background: transparent;\n    border: 2px solid var(--text-dim);\n    color: var(--text);\n  }\n\n  button.secondary:hover { border-color: var(--accent-hover); color: var(--accent-hover); }\n\n  /* Upload zone */\n  #upload-zone {\n    margin: 24px auto;\n    max-width: 700px;\n    padding: 48px 32px;\n    text-align: center;\n    border: 3px dashed var(--text-dim);\n    border-radius: var(--radius);\n    background: rgba(255,255,255,.03);\n    transition: all .2s;\n    cursor: pointer;\n  }\n\n  #upload-zone.drag-over {\n    border-color: var(--accent);\n    background: rgba(233,69,96,.1);\n    transform: scale(1.01);\n  }\n\n  #upload-zone p { font-size: 1.1rem; color: var(--text-dim); margin-top: 8px; }\n  #upload-zone .icon { font-size: 3rem; margin-bottom: 12px; }\n\n  /* Gallery */\n  #gallery-container { padding: 0 24px 40px; max-width: 1400px; margin: 0 auto; }\n\n  #stats-bar {\n    display: flex; justify-content: space-between; align-items: center;\n    margin-bottom: 16px; color: var(--text-dim); font-size: .9rem;\n  }\n\n  #gallery-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n    gap: 18px;\n  }\n\n  .thumb-card {\n    position: relative;\n    border-radius: var(--radius);\n    overflow: hidden;\n    background: var(--surface);\n    box-shadow: 0 4px 16px rgba(0,0,0,.4);\n    transition: transform .2s, box-shadow .2s;\n    cursor: pointer;\n  }\n\n  .thumb-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(233,69,96,.25); }\n\n  .thumb-card img {\n    width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block;\n  }\n\n  .thumb-overlay {\n    position: absolute; inset: 0;\n    background: linear-gradient(transparent 50%, rgba(0,0,0,.8));\n    opacity: 0; transition: opacity .2s;\n    display: flex; align-items: end; padding: 12px;\n  }\n\n  .thumb-card:hover .thumb-overlay { opacity: 1; }\n\n  .thumb-name { font-size: .8rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex:1; }\n\n  .thumb-actions { display: flex; gap: 6px; position: absolute; top: 8px; right: 8px; opacity:0; transition:opacity .2s;}\n  .thumb-card:hover .thumb-actions { opacity:1; }\n\n  .icon-btn {\n    width:34px;height:34px;border-radius:50%;border:none;cursor:pointer;\n    display:flex;align-items:center;justify-content:center;font-size:.9rem;\n    transition: background .2s, transform .1s; color:#fff;\n  }\n\n  .icon-btn:hover { transform:scale(1.1); }\n  .icon-btn.delete { background: rgba(233,69,96,.85); }\n  .icon-btn.info   { background: rgba(0,0,0,.7); }\n\n  /* Lightbox */\n  #lightbox {\n    position: fixed; inset: 0; z-index: 1000;\n    background: rgba(0,0,0,.92);\n    display: none; align-items:center; justify-content:center;\n    flex-direction: column;\n  }\n\n  #lightbox.active { display:flex; }\n\n  #lightbox img {\n    max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: 8px;\n    box-shadow: 0 10px 60px rgba(0,0,0,.7);\n  }\n\n  .lb-close { position:absolute;top:16px;right:24px;font-size:2rem;color:#fff;background:none;border:none;cursor:pointer;z-index:1001;}\n  .lb-nav { position:absolute;top:50%;transform:translateY(-50%);font-size:2.5rem;color:#fff;background:rgba(0,0,0,.6);border:none;padding:12px 18px;cursor:pointer;border-radius:var(--radius);}\n  .lb-nav:hover { background: var(--accent); }\n  #lb-prev { left:16px; }\n  #lb-next { right:16px; }\n\n  .lb-info { margin-top:14px;color:var(--text-dim);font-size:.9rem;text-align:center;}\n\n  /* Slideshow */\n  #slideshow-bar {\n    position:absolute; bottom:20px; left:50%; transform:translateX(-50%);\n    display:flex;gap:10px;align-items:center;background:rgba(0,0,0,.7);\n    padding:10px 24px;border-radius:30px; z-index:1001;\n  }\n\n  #slideshow-bar button { background:none;border:2px solid var(--text-dim);padding:8px 16px;font-size:.85rem;}\n  #slideshow-bar button:hover { border-color:var(--accent-hover);color:var(--accent-hover);}\n  .slide-active-btn { border-color:var(--accent)!important; color:var(--accent)!important;background:none!important;}\n\n  /* Empty state */\n  #empty-state { text-align:center;padding:80px 24px;color:var(--text-dim); }\n  #empty-state .icon { font-size:5rem;margin-bottom:16px;opacity:.3; }\n  #empty-state h2 { margin-bottom:8px;font-weight:400;}\n\n  /* Toast */\n  #toast-container { position:fixed;top:80px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px;}\n  .toast { padding:14px 22px;border-radius:var(--radius);color:#fff;font-size:.9rem;animation:slideIn .3s ease-out,fadeOut .4s ease-in 2.6s forwards;box-shadow:0 6px 20px rgba(0,0,0,.5);}\n  .toast.success { background:#1db954; }\n  .toast.error   { background:var(--accent); }\n\n  @keyframes slideIn { from{transform:translateX(100%);opacity:0} to{transform:translateX(0);opacity:1} }\n  @keyframes fadeOut { to{opacity:0;transform:translateY(-20px)} }\n\n  /* Responsive */\n  @media(max-width:600px){\n    header { flex-direction:column;gap:12px;text-align:center;}\n    #gallery-grid { grid-template-columns: repeat(auto-fill,minmax(150px,1fr)); gap:10px; }\n  }\n\n  /* Hidden file input */\n  #file-input { display:none; }\n</style>\n</head>\n<body>\n\n<header>\n  <h1>&#9733; Picture Viewer</h1>\n  <div id=\"header-actions\">\n    <button class=\"secondary\" onclick=\"document.getElementById('upload-zone').scrollIntoView({behavior:'smooth'})\">&#43; Add Images</button>\n  </div>\n</header>\n\n<div id=\"upload-zone\" tabindex=\"0\" role=\"button\" aria-label=\"Drop images here or click to upload\">\n  <div class=\"icon\">&#128247;</div>\n  <strong>Drag &amp; drop images here</strong>\n  <p>or click to browse files</p>\n  <input type=\"file\" id=\"file-input\" multiple accept=\"image/*\">\n</div>\n\n<div id=\"gallery-container\">\n  <div id=\"stats-bar\"><span id=\"count-label\"></span><button class=\"secondary\" onclick=\"clearAll()\" style=\"padding:6px 14px;font-size:.8rem;\">Clear All</button></div>\n  <div id=\"empty-state\">\n    <div class=\"icon\">&#127753;</div>\n    <h2>No images yet</h2>\n    <p>Add some photos to get started!</p>\n  </div>\n  <div id=\"gallery-grid\"></div>\n</div>\n\n<!-- Lightbox -->\n<div id=\"lightbox\">\n  <button class=\"lb-close\" onclick=\"closeLightbox()\">&times;</button>\n  <button class=\"lb-nav\" id=\"lb-prev\" onclick=\"navLightbox(-1)\">&#8249;</button>\n  <img id=\"lb-img\" src=\"\" alt=\"\">\n  <button class=\"lb-nav\" id=\"lb-next\" onclick=\"navLightbox(1)\">&#8250;</button>\n  <div class=\"lb-info\" id=\"lb-info\"></div>\n  <div id=\"slideshow-bar\">\n    <span style=\"color:var(--text-dim);font-size:.8rem;\">Slideshow:</span>\n    <button onclick=\"startSlide(5)\">5s</button>\n    <button onclick=\"startSlide(10)\">10s</button>\n    <button class=\"secondary\" id=\"stop-slide-btn\" onclick=\"stopSlide()\" style=\"display:none\">&#9642; Stop</button>\n  </div>\n</div>\n\n<div id=\"toast-container\"></div>\n\n<script>\n// ─── IndexedDB Setup ──────────────────────────────\nconst DB_NAME = 'PictureViewerDB';\nconst STORE   = 'images';\nlet db = null;\n\nfunction openDB() {\n  return new Promise((resolve, reject) => {\n    const req = indexedDB.open(DB_NAME, 1);\n    req.onupgradeneeded = e => {\n      const d = e.target.result;\n      if (!d.objectStoreNames.contains(STORE)) {\n        const s = d.createObjectStore(STORE, { keyPath: 'id' });\n        s.createIndex('timestamp', 'timestamp');\n      }\n    };\n    req.onsuccess = () => { db = e.target.result; resolve(db); };\n    req.onerror = () => reject(req.error);\n  });\n}\n\nfunction getAllImages() {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readonly');\n    const s = tx.objectStore(STORE);\n    const idx = s.index('timestamp');\n    const req = idx.getAll(); // get all sorted by timestamp desc (we'll reverse in JS if needed)\n    // Actually getAll() on index returns everything; we need to sort. Let's use openCursor for descending.\n    resolve(req.result);\n  });\n}\n\nfunction getImage(id) {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readonly');\n    const req = tx.objectStore(STORE).get(id);\n    req.onsuccess = () => resolve(req.result);\n    req.onerror = () => reject(req.error);\n  });\n}\n\nfunction saveImage(name, dataUrl) {\n  return new Promise((resolve, reject) => {\n    const id = Date.now().toString(36) + Math.random().toString(36).slice(2,8);\n    const tx = db.transaction(STORE, 'readwrite');\n    tx.objectStore(STORE).add({ id, name, dataUrl, timestamp: Date.now() });\n    tx.oncomplete = () => resolve(id);\n    tx.onerror = () => reject(tx.error);\n  });\n}\n\nfunction deleteImage(id) {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readwrite');\n    tx.objectStore(STORE).delete(id);\n    tx.oncomplete = () => resolve();\n    tx.onerror = () => reject(tx.error);\n  });\n}\n\nfunction clearAllImages() {\n  return new Promise((resolve, reject) => {\n    const tx = db.transaction(STORE, 'readwrite');\n    tx.objectStore(STORE).clear();\n    tx.oncomplete = () => resolve();\n    tx.onerror = () => reject(tx.error);\n  });\n}\n\n// ─── Gallery Rendering ──────────────────────────────\nlet allImages = []; // sorted newest first\n\nasync function loadGallery() {\n  const results = await getAllImages();\n  allImages = results.sort((a,b) => b.timestamp - a.timestamp);\n  renderGallery();\n}\n\nfunction renderGallery() {\n  const grid   = document.getElementById('gallery-grid');\n  const empty  = document.getElementById('empty-state');\n  const countL = document.getElementById('count-label');\n\n  if (allImages.length === 0) {\n    grid.innerHTML = '';\n    empty.style.display = 'block';\n    countL.textContent = 'No images stored';\n    return;\n  }\n\n  empty.style.display = 'none';\n  countL.textContent = `${allImages.length} image${allImages.length>1?'s':''}`;\n\n  grid.innerHTML = allImages.map(img => `\n    <div class=\"thumb-card\" ondblclick=\"openLightbox('${img.id}')\">\n      <img src=\"${img.dataUrl}\" alt=\"${escHtml(img.name)}\" loading=\"lazy\">\n      <div class=\"thumb-overlay\">\n        <span class=\"thumb-name\">${escHtml(img.name)}</span>\n      </div>\n      <div class=\"thumb-actions\">\n        <button class=\"icon-btn info\" title=\"Info\" onclick=\"event.stopPropagation();showImageInfo('${img.id}')\">&#8505;</button>\n        <button class=\"icon-btn delete\" title=\"Delete\" onclick=\"event.stopPropagation();removeImage('${img.id}')\">&#128465;</button>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction escHtml(s) { const d=document.createElement('div');d.textContent=s;return d.innerHTML; }\n\n// ─── Upload / Drag-drop ──────────────────────\nconst uploadZone = document.getElementById('upload-zone');\nconst fileInput  = document.getElementById('file-input');\n\nuploadZone.addEventListener('click', () => fileInput.click());\nuploadZone.addEventListener('keydown', e => { if(e.key==='Enter'||e.key===' ') fileInput.click(); });\n\n['dragenter','dragover'].forEach(ev => uploadZone.addEventListener(ev, e => { e.preventDefault(); uploadZone.classList.add('drag-over'); }));\n['dragleave','drop'].forEach(ev => uploadZone.addEventListener(ev, () => uploadZone.classList.remove('drag-over')));\n\nuploadZone.addEventListener('drop', async e => {\n  e.preventDefault();\n  await handleFiles(e.dataTransfer.files);\n});\n\nfileInput.addEventListener('change', async () => {\n  if (fileInput.files.length) { await handleFiles(fileInput.files); fileInput.value = ''; }\n});\n\nasync function handleFiles(files) {\n  let count = 0;\n  for (const f of files) {\n    if (!f.type.startsWith('image/')) continue;\n    try {\n      const dataUrl = await readFileAsDataURL(f);\n      await saveImage(f.name, dataUrl);\n      count++;\n    } catch(err) { console.error(err); toast(`Failed: ${f.name}`, 'error'); }\n  }\n  if (count > 0) {\n    toast(`${count} image${count>1?'s':''} saved!`, 'success');\n    await loadGallery();\n  } else {\n    toast('No valid images found.', 'error');\n  }\n}\n\nfunction readFileAsDataURL(file) {\n  return new Promise((resolve, reject) => {\n    const r = new FileReader();\n    r.onload = () => resolve(r.result);\n    r.onerror = reject;\n    r.readAsDataURL(file);\n  });\n}\n\n// ─── Delete / Clear ──────────────\nasync function removeImage(id) {\n  if (!confirm('Delete this image?')) return;\n  await deleteImage(id);\n  toast('Image deleted.', 'success');\n  await loadGallery();\n}\n\nasync function clearAll() {\n  if (allImages.length === 0 || !confirm(`Delete all ${allImages.length} images?`)) return;\n  await clearAllImages();\n  toast('All images cleared.', 'success');\n  await loadGallery();\n}\n\n// ─── Lightbox / Slideshow ──────────────\nlet lbIndex = -1;\nlet slideTimer = null;\n\nfunction openLightbox(id) {\n  const idx = allImages.findIndex(i => i.id === id);\n  if (idx < 0) return;\n  lbIndex = idx;\n  showImage(lbIndex);\n  document.getElementById('lightbox').classList.add('active');\n}\n\nfunction closeLightbox() {\n  stopSlide();\n  document.getElementById('lightbox').classList.remove('active');\n  lbIndex = -1;\n}\n\nfunction navLightbox(dir) {\n  let next = lbIndex + dir;\n  if (next < 0) next = allImages.length - 1;\n  if (next >= allImages.length) next = 0;\n  showImage(next);\n}\n\nfunction showImage(idx) {\n  const img = allImages[idx];\n  document.getElementById('lb-img').src = img.dataUrl;\n  document.getElementById('lb-info').textContent = `${idx+1} / ${allImages.length} — ${img.name}`;\n  stopSlide(); // reset slideshow on manual nav\n}\n\nfunction startSlide(seconds) {\n  stopSlide();\n  slideTimer = setInterval(() => navLightbox(1), seconds * 1000);\n  document.getElementById('stop-slide-btn').style.display = '';\n}\n\nfunction stopSlide() {\n  if (slideTimer) { clearInterval(slideTimer); slideTimer = null; }\n  const btn = document.getElementById('stop-slide-btn');\n  if(btn) btn.style.display = 'none';\n}\n\nasync function showImageInfo(id) {\n  const img = await getImage(id);\n  if (!img) return;\n  alert(`Name: ${img.name}\\nSaved: ${new Date(img.timestamp).toLocaleString()}`);\n}\n\n// ─── Keyboard shortcuts ──────────────\ndocument.addEventListener('keydown', e => {\n  if (lbIndex < 0) return; // only in lightbox\n  if (e.key === 'Escape') closeLightbox();\n  if (e.key === 'ArrowLeft') navLightbox(-1);\n  if (e.key === 'ArrowRight') navLightbox(1);\n});\n\n// ─── Toast notifications ──────────────\nfunction toast(msg, type='success') {\n  const c = document.getElementById('toast-container');\n  const t = document.createElement('div');\n  t.className = `toast ${type}`;\n  t.textContent = msg;\n  c.appendChild(t);\n  setTimeout(() => t.remove(), 3200);\n}\n\n// ─── Init ──────────────\n(async () => {\n  try { await openDB(); } catch(e) { console.error('DB error', e); toast('Database init failed.', 'error'); return; }\n  await loadGallery();\n})();\n</script>\n</body>\n</html>\n"},"status":"ok","ms":135}
