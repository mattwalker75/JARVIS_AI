{"t":"2026-07-28T18:44:49.204Z","tool":"write_workbench_file","args":{"path":"/workspace/monsters.js","content":"// monsters.js - Handles monsters behavior in the raycasting game\n\nclass Monster {\n  constructor(x, y) {\n    this.x = x;\n    this.y = y;\n    this.size = 0.3; // radius size for collision\n    this.speed = 0.02;\n    this.health = 3;\n    this.alive = true;\n  }\n\n  distanceToPlayer(player) {\n    const dx = player.x - this.x;\n    const dy = player.y - this.y;\n    return Math.sqrt(dx * dx + dy * dy);\n  }\n\n  moveTowardsPlayer(player, map) {\n    if (!this.alive) return;\n    // Simple chasing AI: move towards player if path is clear\n    const dx = player.x - this.x;\n    const dy = player.y - this.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    if (dist < 0.1) {\n      // close enough to attack\n      return;\n    }\n    const stepX = (dx / dist) * this.speed;\n    const stepY = (dy / dist) * this.speed;\n\n    // Check collisions with walls\n    if (!map.isWall(this.x + stepX, this.y)) {\n      this.x += stepX;\n    }\n    if (!map.isWall(this.x, this.y + stepY)) {\n      this.y += stepY;\n    }\n  }\n\n  takeDamage(amount) {\n    this.health -= amount;\n    if (this.health <= 0) {\n      this.alive = false;\n    }\n  }\n\n  draw(ctx, player, map) {\n    if (!this.alive) return;\n    // Draw the monster as a simple red square in the 3D view\n    // We will use a simple sprite projection based on distance and angle\n    const dx = this.x - player.x;\n    const dy = this.y - player.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Angle between player direction and monster\n    const angleToMonster = Math.atan2(dy, dx) - player.angle;\n    const fov = Math.PI / 3; // 60 degrees FOV\n\n    if (angleToMonster > -fov/2 && angleToMonster < fov/2 && dist > 0.1) {\n      // Project monster size on screen\n      const screenX = (0.5 + angleToMonster / fov) * ctx.canvas.width;\n      const size = Math.min(200 / dist, 100);\n      ctx.fillStyle = 'red';\n      ctx.fillRect(screenX - size/2, ctx.canvas.height/2 - size/2, size, size);\n    }\n  }\n}\n\nexport { Monster };\n"},"status":"ok","ms":133}
