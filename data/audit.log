{"t":"2026-07-25T23:39:27.433Z","tool":"write_workbench_file","args":{"path":"/workspace/gallery/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Image Library Viewer</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background: #1a1a2e;\n    color: #eee;\n    min-height: 100vh;\n  }\n\n  /* Header */\n  .header {\n    background: linear-gradient(135deg, #16213e, #0f3460);\n    padding: 20px 30px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n    position: sticky;\n    top: 0;\n    z-index: 100;\n  }\n\n  .header h1 {\n    font-size: 1.8rem;\n    background: linear-gradient(90deg, #e94560, #ff6b6b);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .header h1::before { content: '🖼️'; font-size: 2rem; }\n\n  /* Toolbar */\n  .toolbar {\n    display: flex;\n    gap: 10px;\n    align-items: center;\n  }\n\n  .search-box {\n    padding: 8px 16px;\n    border-radius: 25px;\n    border: none;\n    background: rgba(255,255,255,0.1);\n    color: #fff;\n    font-size: 0.9rem;\n    width: 220px;\n    outline: none;\n    transition: all 0.3s;\n  }\n\n  .search-box:focus { background: rgba(255,255,255,0.2); width: 280px; }\n  .search-box::placeholder { color: #aaa; }\n\n  .btn {\n    padding: 8px 16px;\n    border-radius: 25px;\n    border: none;\n    cursor: pointer;\n    font-size: 0.9rem;\n    transition: all 0.3s;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .btn-primary { background: #e94560; color: white; }\n  .btn-primary:hover { background: #ff6b6b; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(233,69,96,0.4); }\n\n  .btn-secondary { background: rgba(255,255,255,0.1); color: #ccc; border: 1px solid rgba(255,255,255,0.2); }\n  .btn-secondary:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }\n\n  .stats { color: #888; font-size: 0.85rem; margin-left: auto; }\n\n  /* Gallery Grid */\n  .gallery-container { padding: 30px; max-width: 1600px; margin: 0 auto; }\n\n  .gallery-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n    gap: 20px;\n  }\n\n  /* Image Card */\n  .image-card {\n    position: relative;\n    border-radius: 16px;\n    overflow: hidden;\n    background: #16213e;\n    cursor: pointer;\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    box-shadow: 0 4px 15px rgba(0,0,0,0.3);\n  }\n\n  .image-card:hover { transform: translateY(-8px) scale(1.02); box-shadow: 0 12px 40px rgba(233,69,96,0.3); }\n\n  .image-card img {\n    width: 100%;\n    height: 250px;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.4s;\n  }\n\n  .image-card:hover img { transform: scale(1.08); filter: brightness(1.1); }\n\n  .card-overlay {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    padding: 40px 15px 15px;\n    background: linear-gradient(transparent, rgba(0,0,0,0.9));\n    opacity: 0;\n    transition: opacity 0.3s;\n  }\n\n  .image-card:hover .card-overlay { opacity: 1; }\n\n  .card-info h3 { font-size: 0.95rem; margin-bottom: 4px; color: #fff; }\n  .card-info p { font-size: 0.8rem; color: #aaa; display: flex; align-items: center; gap: 4px; }\n\n  /* Favorite button on card */\n  .fav-btn {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    background: rgba(0,0,0,0.5);\n    border: none;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    cursor: pointer;\n    font-size: 1.2rem;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.3s;\n    opacity: 0;\n  }\n\n  .image-card:hover .fav-btn { opacity: 1; }\n  .fav-btn.active { background: #e94560; opacity: 1; }\n  .fav-btn:hover { transform: scale(1.2); }\n\n  /* Lightbox Modal */\n  .lightbox-overlay {\n    position: fixed;\n    inset: 0;\n    background: rgba(0,0,0,0.95);\n    z-index: 1000;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    animation: fadeIn 0.3s ease;\n  }\n\n  .lightbox-overlay.active { display: flex; }\n\n  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }\n  @keyframes slideUp { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }\n\n  .lightbox-content {\n    position: relative;\n    max-width: 95vw;\n    max-height: 90vh;\n    animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  }\n\n  .lightbox-content img {\n    max-width: 95vw;\n    max-height: 85vh;\n    object-fit: contain;\n    border-radius: 12px;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.5);\n  }\n\n  .lightbox-close {\n    position: fixed;\n    top: 20px;\n    right: 30px;\n    background: none;\n    border: none;\n    color: #fff;\n    font-size: 2rem;\n    cursor: pointer;\n    z-index: 1001;\n    width: 50px;\n    height: 50px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    transition: all 0.3s;\n  }\n\n  .lightbox-close:hover { background: rgba(255,255,255,0.1); transform: rotate(90deg) scale(1.1); }\n\n  /* Navigation arrows */\n  .nav-arrow {\n    position: fixed;\n    top: 50%;\n    transform: translateY(-50%);\n    background: rgba(255,255,255,0.1);\n    border: none;\n    color: #fff;\n    font-size: 2rem;\n    width: 60px;\n    height: 60px;\n    cursor: pointer;\n    z-index: 1001;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    transition: all 0.3s;\n  }\n\n  .nav-arrow:hover { background: #e94560; transform: translateY(-50%) scale(1.1); box-shadow: 0 8px 25px rgba(233,69,96,0.4); }\n  .nav-prev { left: 20px; }\n  .nav-next { right: 20px; }\n\n  /* Image info bar */\n  .lightbox-info-bar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: linear-gradient(transparent, rgba(0,0,0,0.9));\n    padding: 30px 25px 15px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    z-index: 1001;\n  }\n\n  .lightbox-info-bar h3 { font-size: 1rem; color: #fff; }\n  .lightbox-info-bar p { font-size: 0.85rem; color: #aaa; margin-top: 2px; }\n\n  .lightbox-actions { display: flex; gap: 10px; align-items: center; }\n\n  /* Slideshow controls */\n  .slideshow-controls {\n    position: fixed;\n    top: 25px;\n    left: 30px;\n    z-index: 1001;\n    display: flex;\n    gap: 8px;\n  }\n\n  /* Counter badge */\n  .counter-badge {\n    background: rgba(255,255,255,0.1);\n    padding: 6px 14px;\n    border-radius: 20px;\n    font-size: 0.85rem;\n    color: #ccc;\n  }\n\n  /* Upload drop zone */\n  .drop-zone {\n    position: fixed;\n    inset: 0;\n    background: rgba(15,52,96,0.97);\n    z-index: 2000;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    gap: 20px;\n  }\n\n  .drop-zone.active { display: flex; }\n\n  .drop-box {\n    border: 3px dashed #e94560;\n    padding: 80px 120px;\n    border-radius: 30px;\n    text-align: center;\n    transition: all 0.3s;\n  }\n\n  .drop-box:hover { background: rgba(233,69,96,0.1); transform: scale(1.05); }\n  .drop-box p { font-size: 1.3rem; color: #ccc; margin-top: 15px; }\n\n  /* Empty state */\n  .empty-state {\n    text-align: center;\n    padding: 80px 20px;\n    color: #666;\n  }\n\n  .empty-state h2 { font-size: 1.5rem; margin-bottom: 10px; color: #999; }\n  .empty-state p { font-size: 1rem; }\n\n  /* Filter tabs */\n  .filter-tabs { display: flex; gap: 8px; margin-bottom: 25px; justify-content: center; }\n  .filter-tab { padding: 6px 18px; border-radius: 20px; background: rgba(255,255,255,0.05); color: #aaa; cursor: pointer; transition: all 0.3s; font-size: 0.9rem; }\n  .filter-tab:hover { background: rgba(255,255,255,0.1); }\n  .filter-tab.active { background: #e94560; color: white; }\n\n  /* Responsive */\n  @media (max-width: 768px) {\n    .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }\n    .header { flex-direction: column; gap: 15px; padding: 15px; }\n    .toolbar { width: 100%; justify-content: center; flex-wrap: wrap; }\n    .search-box { width: 180px; }\n    .nav-arrow { width: 45px; height: 45px; font-size: 1.5rem; }\n    .lightbox-info-bar { flex-direction: column; gap: 10px; text-align: center; }\n  }\n\n  /* Loading skeleton */\n  .skeleton { background: linear-gradient(90deg, #16213e 25%, #1a1a4e 50%, #16213e 75%); background-size: 200%; animation: shimmer 1.5s infinite; }\n  @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }\n\n  /* Toast notification */\n  .toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: #e94560; color: white; padding: 12px 28px; border-radius: 30px; z-index: 3000; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-size: 0.95rem; box-shadow: 0 6px 25px rgba(233,69,96,0.4); }\n  .toast.show { transform: translateX(-50%) translateY(0); }\n</style>\n</head>\n<body>\n\n<!-- Header -->\n<div class=\"header\">\n  <h1>Image Library Viewer</h1>\n  <div class=\"toolbar\">\n    <input type=\"text\" class=\"search-box\" id=\"searchBox\" placeholder=\"Search images... (Ctrl+K)\">\n    <button class=\"btn btn-secondary\" onclick=\"toggleSlideshow()\" title=\"Slide Show Mode\">▶ Slideshow</button>\n    <button class=\"btn btn-primary\" onclick=\"openUpload()\">📁 Upload Images</button>\n  </div>\n  <span class=\"stats\" id=\"imageCount\"></span>\n</div>\n\n<!-- Filter Tabs -->\n<div style=\"padding: 15px 30px; max-width: 1600px; margin: 0 auto;\">\n  <div class=\"filter-tabs\">\n    <button class=\"filter-tab active\" onclick=\"setFilter('all')\">All Images</button>\n    <button class=\"filter-tab\" onclick=\"setFilter('favorites')\">❤️ Favorites</button>\n  </div>\n</div>\n\n<!-- Gallery -->\n<div class=\"gallery-container\">\n  <div class=\"gallery-grid\" id=\"galleryGrid\"></div>\n  <div class=\"empty-state\" id=\"emptyState\" style=\"display:none;\">\n    <h2>No images found</h2>\n    <p>Upload some images or adjust your search filter.</p>\n  </div>\n</div>\n\n<!-- Lightbox -->\n<div class=\"lightbox-overlay\" id=\"lightbox\">\n  <button class=\"lightbox-close\" onclick=\"closeLightbox()\">✕</button>\n  <button class=\"nav-arrow nav-prev\" onclick=\"navigate(-1)\">‹</button>\n  <button class=\"nav-arrow nav-next\" onclick=\"navigate(1)\">›</button>\n\n  <div class=\"slideshow-controls\">\n    <span class=\"counter-badge\" id=\"imageCounter\"></span>\n  </div>\n\n  <div class=\"lightbox-content\">\n    <img id=\"lightboxImg\" src=\"\" alt=\"\">\n  </div>\n\n  <div class=\"lightbox-info-bar\">\n    <div>\n      <h3 id=\"lightboxTitle\"></h3>\n      <p id=\"lightboxMeta\"></p>\n    </div>\n    <div class=\"lightbox-actions\">\n      <button class=\"btn btn-secondary\" onclick=\"toggleFavoriteLightbox()\" id=\"lbFavBtn\">❤️ Favorite</button>\n      <a class=\"btn btn-primary\" download id=\"downloadLink\">⬇ Download</a>\n    </div>\n  </div>\n</div>\n\n<!-- Upload Drop Zone -->\n<div class=\"drop-zone\" id=\"uploadZone\">\n  <div class=\"drop-box\" id=\"dropBox\">\n    📁 Drag & drop images here<br>or click to browse files\n    <p style=\"margin-top:15px; font-size:0.9rem;\">Supports JPG, PNG, GIF, WebP</p>\n  </div>\n  <input type=\"file\" id=\"fileInput\" multiple accept=\"image/*\" style=\"display:none\">\n  <button class=\"btn btn-secondary\" onclick=\"closeUpload()\" style=\"margin-top:20px;\">Cancel</button>\n</div>\n\n<!-- Toast -->\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n// State\nlet images = [];\nlet filteredImages = [];\nlet currentIndex = 0;\nlet favorites = JSON.parse(localStorage.getItem('gallery_favorites') || '[]');\nlet currentFilter = 'all';\nlet slideshowInterval = null;\nlet isSlideshowPlaying = false;\n\nconst galleryGrid = document.getElementById('galleryGrid');\nconst lightbox = document.getElementById('lightbox');\nconst searchBox = document.getElementById('searchBox');\n\n// Initialize with test images from picsum.photos\nfunction initImages() {\n  for (let i = 1; i <= 49; i++) {\n    const seed = String(i).padStart(3, '0');\n    images.push({\n      id: i,\n      src: `gallery-images/${i}.jpg`,\n      thumbSrc: `gallery-images/${i}.jpg?thumb=1&w=800&h=600`,\n      name: `photo_${seed}`,\n      size: `${Math.floor(Math.random()*5+2)} MB`,\n      dimensions: '800×600',\n      dateAdded: new Date(Date.now() - Math.random()*30*24*60*60*1000).toLocaleDateString(),\n    });\n  }\n\n  // Add some local test images to gallery-images folder if they exist\n  const existing = document.querySelectorAll('.image-card');\n}\n\n// Render gallery\nfunction renderGallery() {\n  let displayImages;\n\n  if (currentFilter === 'favorites') {\n    displayImages = filteredImages.filter(img => favorites.includes(String(img.id)));\n  } else {\n    displayImages = [...filteredImages];\n  }\n\n  // Apply search filter\n  const query = searchBox.value.toLowerCase().trim();\n  if (query) {\n    displayImages = displayImages.filter(img => img.name.toLowerCase().includes(query));\n  }\n\n  filteredImages = displayImages;\n\n  galleryGrid.innerHTML = '';\n\n  if (displayImages.length === 0) {\n    document.getElementById('emptyState').style.display = 'block';\n    return;\n  }\n\n  document.getElementById('emptyState').style.display = 'none';\n\n  displayImages.forEach((img, idx) => {\n    const card = document.createElement('div');\n    card.className = 'image-card';\n    card.innerHTML = `\n      <img src=\"${img.src}\" alt=\"${img.name}\" loading=\"lazy\">\n      <button class=\"fav-btn ${favorites.includes(String(img.id)) ? 'active' : ''}\" onclick=\"event.stopPropagation(); toggleFavorite(${idx}, '${img.id}')\">${favorites.includes(String(img.id)) ? '❤️' : '🤍'}</button>\n      <div class=\"card-overlay\">\n        <div class=\"card-info\">\n          <h3>${img.name}</h3>\n          <p>📐 ${img.dimensions} &nbsp;|&nbsp; 📅 ${img.dateAdded}</p>\n        </div>\n      </div>\n    `;\n    card.onclick = () => openLightbox(idx);\n    galleryGrid.appendChild(card);\n  });\n\n  document.getElementById('imageCount').textContent = `${displayImages.length} image${displayImages.length !== 1 ? 's' : ''}`;\n}\n\n// Open lightbox\nfunction openLightbox(index) {\n  currentIndex = index;\n  const img = filteredImages[index];\n  if (!img) return;\n\n  document.getElementById('lightboxImg').src = img.src;\n  document.getElementById('lightboxTitle').textContent = img.name;\n  document.getElementById('lightboxMeta').textContent = `${img.dimensions} • ${img.size} • Added ${img.dateAdded}`;\n  document.getElementById('imageCounter').textContent = `Image ${index + 1} of ${filteredImages.length}`;\n\n  const favBtn = document.getElementById('lbFavBtn');\n  favBtn.innerHTML = favorites.includes(String(img.id)) ? '❤️ Favorited' : '🤍 Favorite';\n\n  lightbox.classList.add('active');\n  document.body.style.overflow = 'hidden';\n}\n\nfunction closeLightbox() {\n  lightbox.classList.remove('active');\n  if (isSlideshowPlaying) toggleSlideshow();\n  document.body.style.overflow = '';\n}\n\n// Navigate images in lightbox\nfunction navigate(dir) {\n  currentIndex += dir;\n  if (currentIndex < 0) currentIndex = filteredImages.length - 1;\n  if (currentIndex >= filteredImages.length) currentIndex = 0;\n  openLightbox(currentIndex);\n}\n\n// Toggle favorite\nfunction toggleFavorite(idx, id) {\n  const idxInFavs = favorites.indexOf(String(id));\n  if (idxInFavs > -1) {\n    favorites.splice(idxInFavs, 1);\n    showToast('Removed from favorites');\n  } else {\n    favorites.push(String(id));\n    showToast('Added to favorites ❤️');\n  }\n  localStorage.setItem('gallery_favorites', JSON.stringify(favorites));\n  renderGallery();\n\n  // Update lightbox button if open\n  const favBtn = document.getElementById('lbFavBtn');\n  if (favBtn) {\n    favBtn.innerHTML = favorites.includes(String(id)) ? '❤️ Favorited' : '🤍 Favorite';\n  }\n}\n\nfunction toggleFavoriteLightbox() {\n  if (filteredImages[currentIndex]) {\n    const id = String(filteredImages[currentIndex].id);\n    toggleFavorite(currentIndex, id);\n  }\n}\n\n// Slideshow mode\nfunction toggleSlideshow() {\n  if (isSlideshowPlaying) {\n    clearInterval(slideshowInterval);\n    isSlideshowPlaying = false;\n    document.querySelector('.btn-secondary').innerHTML = '▶ Slideshow';\n  } else {\n    openLightbox(0);\n    slideshowInterval = setInterval(() => navigate(1), 3000);\n    isSlideshowPlaying = true;\n    document.querySelector('.btn-secondary').innerHTML = '⏸ Pause';\n  }\n}\n\n// Upload handling\nfunction openUpload() {\n  document.getElementById('uploadZone').classList.add('active');\n  document.getElementById('fileInput').click();\n}\n\nfunction closeUpload() {\n  document.getElementById('uploadZone').classList.remove('active');\n}\n\ndocument.getElementById('dropBox').onclick = () => document.getElementById('fileInput').click();\n\ndocument.getElementById('fileInput').addEventListener('change', function(e) {\n  handleFiles(e.target.files);\n});\n\n// Drag and drop on upload zone\nconst dropBox = document.getElementById('dropBox');\n['dragenter','dragover'].forEach(evt => {\n  dropBox.addEventListener(evt, e => { e.preventDefault(); dropBox.style.background = 'rgba(233,69,96,0.15)'; });\n});\n['dragleave','drop'].forEach(evt => {\n  dropBox.addEventListener(evt, e => { e.preventDefault(); dropBox.style.background = ''; });\n});\n\ndocument.body.addEventListener('dragover', e => e.preventDefault());\ndocument.body.addEventListener('drop', function(e) {\n  if (e.dataTransfer.files.length > 0) {\n    handleFiles(e.dataTransfer.files);\n  }\n});\n\nfunction handleFiles(files) {\n  let count = 0;\n  Array.from(files).forEach(file => {\n    if (!file.type.startsWith('image/')) return;\n    const reader = new FileReader();\n    reader.onload = function(ev) {\n      images.push({\n        id: Date.now() + Math.random(),\n        src: ev.target.result,\n        name: file.name.replace(/\\.[^.]+$/, ''),\n        size: (file.size / 1024 / 1024).toFixed(1) + ' MB',\n        dimensions: `${Math.floor(Math.random()*800+600)}×${Math.floor(Math.random()*600+400)}`,\n        dateAdded: new Date().toLocaleDateString(),\n      });\n      count++;\n      if (count === Array.from(files).filter(f => f.type.startsWith('image/')).length) {\n        renderGallery();\n        showToast(`${count} image${count > 1 ? 's' : ''} uploaded! 📸`);\n        closeUpload();\n      }\n    };\n    reader.readAsDataURL(file);\n  });\n}\n\n// Search with debounce\nlet searchTimeout;\nsearchBox.addEventListener('input', function() {\n  clearTimeout(searchTimeout);\n  searchTimeout = setTimeout(() => renderGallery(), 200);\n});\n\n// Keyboard shortcuts\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') closeLightbox();\n  if (lightbox.classList.contains('active')) {\n    if (e.key === 'ArrowLeft') navigate(-1);\n    if (e.key === 'ArrowRight') navigate(1);\n    if (e.key === ' ') { e.preventDefault(); toggleSlideshow(); }\n  }\n  // Ctrl+K to focus search\n  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {\n    e.preventDefault();\n    document.getElementById('searchBox').focus();\n  }\n});\n\n// Filter tabs\nfunction setFilter(filter) {\n  currentFilter = filter;\n  document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));\n  event.target.classList.add('active');\n  renderGallery();\n}\n\n// Toast notification\nfunction showToast(msg) {\n  const toast = document.getElementById('toast');\n  toast.textContent = msg;\n  toast.classList.add('show');\n  setTimeout(() => toast.classList.remove('show'), 2500);\n}\n\n// Initialize\nrenderGallery();\n</script>\n</body>\n</html>\n"},"status":"ok","ms":139}
