{"t":"2026-07-28T04:17:07.470Z","tool":"run_shell","args":{"command":"sqlite3 mbm.db <<'SQL'\n-- 1. Business Company Profile (legal entity)\nINSERT INTO business_company (business_id, legal_name, dba, ein, entity_type, founded_date, state_of_formation, mission, motto, slogan, website_url)\nVALUES (2, 'Summit Digital Agency LLC', NULL, '84-3927165', 'LLC', '2025-03-15', 'Delaware',\n'Empowering creators and brands to scale their digital presence through done-for-you faceless content automation across YouTube, TikTok, Instagram, and podcast platforms.',\n'Make Every Pixel Work Harder.',\n'Done-for-you faceless content that scales while you sleep.',\n'https://summitdigitalagency.com');\n\n-- 2. Registered Office Address (virtual office — common for online agencies)\nINSERT INTO business_addresses (business_id, label, line1, line2, city, state, postal_code, country, is_primary, notes)\nVALUES (2, 'Registered Office', '1209 Orange Street, Suite 5038', NULL, 'Wilmington', 'DE', '19801', 'United States', 1, 'Virtual registered office — Delaware formation');\n\n-- 3. Operational HQ Address\nINSERT INTO business_addresses (business_id, label, line1, city, state, postal_code, country, is_primary, notes)\nVALUES (2, 'Operational HQ', NULL, 'Austin', 'TX', '78701', 'United States', 0, 'Remote-first team — Austin-based lead');\n\n-- 4. Business Phone\nINSERT INTO business_phones (business_id, label, number, is_primary, notes)\nVALUES (2, 'Main Line', '+1 (512) 893-7462', 1, 'RingCentral VoIP — Austin area code');\n\n-- 5. Business Email\nINSERT INTO business_emails (business_id, label, email, is_primary, notes)\nVALUES (2, 'General Inquiries', 'hello@summitdigitalagency.com', 1, 'Google Workspace primary'),\n       (2, 'Support', 'support@summitdigitalagency.com', 0, 'Client support — auto-forward to Slack');\n\n-- 6. Domain Registration\nINSERT INTO business_domains (business_id, domain, registrar, expiry_date, dns_host)\nVALUES (2, 'summitdigitalagency.com', 'Namecheap', '2027-03-15', 'dns.namecheap.com'),\n       (2, 'getsummit.co', 'Namecheap', '2026-11-20', 'dns.namecheap.com');\n\n-- 7. Social Media Links\nINSERT INTO business_social_links (business_id, platform, handle, url) VALUES\n(2, 'YouTube', '@SummitDigitalAgency', 'https://youtube.com/@SummitDigitalAgency'),\n(2, 'TikTok', '@summitdigital.co', 'https://tiktok.com/@summitdigital.co'),\n(2, 'Instagram', '@summitdigitalagency', 'https://instagram.com/summitdigitalagency'),\n(2, 'LinkedIn', 'summit-digital-agency-llc', 'https://linkedin.com/company/summit-digital-agency-llc'),\n(2, 'Twitter/X', '@SummitDigitalCo', 'https://x.com/SummitDigitalCo');\n\n-- 8. Business Owner / Founder\nINSERT INTO business_owners (business_id, name, role, ownership, email, phone, social_media)\nVALUES (2, 'Marcus Chen', 'Managing Member & CEO', '100%', 'marcus@summitdigitalagency.com', '+1 (512) 893-7462', '@mchen_summit');\n\n-- 9. Registered Agent\nINSERT INTO business_registered_agent (business_id, name, address, phone, email)\nVALUES (2, 'Corporation Service Company', '251 Little Falls Drive, Wilmington, DE 19808', '+1 (302) 467-5400', NULL);\n\n-- Enable all info sections for the business profile\nINSERT INTO business_info_section_visibility (business_id, section_name, enabled) VALUES\n(2, 'company_profile', 1),\n(2, 'addresses', 1),\n(2, 'phones', 1),\n(2, 'emails', 1),\n(2, 'domains', 1),\n(2, 'social_links', 1),\n(2, 'owners', 1),\n(2, 'registered_agent', 1);\n\nSQL\necho \"Company profile setup complete. Exit code: $?\""},"status":"ok","ms":143}
