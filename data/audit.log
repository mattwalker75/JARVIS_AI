{"t":"2026-07-26T00:18:01.013Z","tool":"write_workbench_file","args":{"path":"/workspace/doom/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Doom-like Web Game</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #111; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; font-family: monospace; color: #ccc; }\n#game-container { position: relative; width: 800px; height: 600px; border: 2px solid #333; background: #000; image-rendering: pixelated; cursor: crosshair; }\ncanvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }\n#hud { position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background: linear-gradient(to top, #2a1a1a, #4a2a2a); border-top: 3px solid #666; display: flex; align-items: center; justify-content: space-around; padding: 5px; }\n.hud-item { text-align: center; font-size: 18px; color: #ff0; text-shadow: 2px 2px #000; }\n.hud-label { font-size: 11px; color: #aaa; margin-bottom: 2px; }\n#health-val, #armor-val, #ammo-val, #score-val { font-size: 36px; text-shadow: 0 0 8px rgba(255,0,0,0.5); }\n#weapon-display { position: absolute; bottom: 90px; right: 30px; font-size: 16px; color: #ffaa00; z-index: 2; text-align: center; pointer-events: none; }\n#message-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background: rgba(0,0,0,0.7); z-index: 10; font-size: 32px; color: #f44; text-shadow: 0 0 20px red; }\n#minimap { position: absolute; top: 10px; right: 10px; border: 1px solid #555; opacity: 0.7; z-index: 3; pointer-events: none; }\n#crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: rgba(255,100,100,0.6); font-size: 30px; z-index: 4; pointer-events: none; }\n#damage-flash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,0,0,0); pointer-events: none; transition: background 0.08s; z-index: 5; }\n#start-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(180deg, #1a0000, #330000); z-index: 20; }\n#start-screen h1 { font-size: 72px; color: #cc0000; text-shadow: 0 0 40px red, 0 0 80px darkred; margin-bottom: 20px; letter-spacing: 8px; }\n#start-screen p { font-size: 16px; color: #aaa; margin: 5px; }\n#start-btn { margin-top: 30px; padding: 15px 40px; font-size: 24px; background: #8b0000; color: #fff; border: 2px solid #ff4444; cursor: pointer; font-family: monospace; letter-spacing: 3px; }\n#start-btn:hover { background: #cc0000; box-shadow: 0 0 20px rgba(255,0,0,0.5); }\n</style>\n</head>\n<body>\n\n<div id=\"game-container\">\n<canvas id=\"screen\" width=\"320\" height=\"240\"></canvas>\n<canvas id=\"minimap\" width=\"100\" height=\"100\"></canvas>\n<div id=\"crosshair\">+</div>\n<div id=\"damage-flash\"></div>\n<div id=\"weapon-display\"></div>\n\n<div id=\"hud\">\n  <div class=\"hud-item\"><div class=\"hud-label\">HEALTH</div><span id=\"health-val\" style=\"color:#ff4444;\">100%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">ARMOR</div><span id=\"armor-val\" style=\"color:#4488ff;\">25%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">AMMO</div><span id=\"ammo-val\" style=\"color:#ffaa00;\">50</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">KILLS</div><span id=\"score-val\" style=\"color:#44ff44;\">0</span></div>\n</div>\n\n<div id=\"message-overlay\"></div>\n<div id=\"start-screen\">\n<h1>DOOM-LIKE</h1>\n<p>WASD - Move | Mouse - Look | Click - Shoot</p>\n<p>R - Reload/Change Weapon</p>\n<p>Kill all demons to win!</p>\n<button id=\"start-btn\" onclick=\"startGame()\">ENTER HELL</button>\n</div>\n</div>\n\n<script>\n// ============ MAP DEFINITION ============\nconst TILE = 64;\n// Tile types: #=wall(1), .floor, 0-5 wall variants, T=torch(light source)\nconst mapGrid = [\n  \"####################\",\n  \"#T........#.........#\",\n  \"#........#.T.......#\",\n  \"#...##.....##......#\",\n  \"#...#.#####.#.T....#\",\n  \"#...#.#...#.#......#\",\n  \"#...#.#.0.#.#......#\",\n  \"#...#.#...#.#......#\",\n  \"#...#####.#.#..T...\",\n  \"#.......#..#....###\",\n  \"####.##.....#.##...#\",\n  \"#...#.#1.#..#......#\",\n  \"#...#.#...#..#..T..#\",\n  \"#...#.#2.#..#......#\",\n  \"#...#####..#......#\",\n  \"#...........#....##\",\n  \"###.#########....#.\",\n  \"#.................#.\",\n  \"#.......3..........#\",\n  \"#.......4..........#\",\n  \"#T.....5..........T#\",\n  \"####################\"\n];\n\nconst MAP_H = mapGrid.length;\nconst MAP_W = Math.max(...mapGrid.map(r => r.length));\n\nlet walls = [];\nfor (let y = 0; y < MAP_H; y++) {\n  let row = [];\n  for (let x = 0; x < MAP_W; x++) {\n    const ch = mapGrid[y][x];\n    if (ch === '#') row.push(1); // default wall type 1\n    else if (ch >= '1' && ch <= '5') row.push(parseInt(ch));\n    else if (ch === 'T') row.push(-1); // torch tile marker, but also a wall behind it? No - let's make T = floor with light source above\n    else row.push(0);\n  }\n  walls.push(row);\n}\n\n// Fix: torch tiles should be walkable floor (set to 0) so we can stand near them\nfor (let y = 0; y < MAP_H; y++) {\n  for (let x = 0; x < MAP_W; x++) {\n    if (mapGrid[y][x] === 'T') walls[y][x] = 0; // walkable floor with light above\n  }\n}\n\n// Light sources: positions on the map grid where torches are placed\nconst LIGHTS = [];\nfor (let y = 0; y < MAP_H; y++) {\n  for (let x = 0; x < MAP_W; x++) {\n    if (mapGrid[y][x] === 'T') {\n      LIGHTS.push({ gx: x + 0.5, gy: y + 0.5 }); // world coords center of tile\n    }\n  }\n}\n\n// ============ GAME STATE ============\nlet player = { x: 3.5, y: 2.5, angle: 0, health: 100, armor: 25, ammo: 50, kills: 0 };\nconst weapons = [\n  { name: \"FIST\", damage: 10, fireRate: 400, magSize: Infinity, ammoCost: 0 },\n  { name: \"PISTOL\", damage: 20, fireRate: 350, magSize: Infinity, ammoCost: 1 },\n  { name: \"SHOTGUN\", damage: 60, fireRate: 800, magSize: Infinity, ammoCost: 2 }\n];\nlet currentWeapon = 1; // start with pistol\nlet lastShotTime = 0;\nlet gameState = 'menu'; // menu, playing, dead, won\nlet enemies = [];\nlet pickups = [];\nlet particles = [];\n\n// ============ ENEMY TYPES ============\nconst enemyTypes = {\n  imp:    { name:\"Imp\",     hp:40, speed:1.2, damage:8, color:\"#cc6633\", size:0.35 },\n  demon:  { name:\"Demon\",  hp:70, speed:1.8, damage:15, color:\"#aa2222\", size:0.45 },\n  zombie: { name:\"Zombie\", hp:50, speed:0.9, damage:12, color:\"#6b8e3a\", size:0.4 }\n};\n\n// ============ SPAWN ENEMIES & PICKUPS ============\nfunction spawnEntities() {\n  enemies = [];\n  pickups = [];\n  \n  const enemySpawns = [\n    { x:5, y:3, type:\"zombie\" },\n    { x:14, y:2, type:\"imp\" },\n    { x:8, y:7, type:\"demon\" },\n    { x:16, y:9, type:\"zombie\" },\n    { x:3, y:10, type:\"imp\" },\n    { x:12, y:14, type:\"demon\" },\n    { x:5, y:17, type:\"zombie\" },\n    { x:18, y:16, type:\"imp\" },\n    { x:9, y:18, type:\"demon\" },\n    { x:20, y:3, type:\"zombie\" }\n  ];\n\n  enemySpawns.forEach(s => {\n    enemies.push({\n      ...s,\n      hp: enemyTypes[s.type].hp,\n      maxHp: enemyTypes[s.type].hp,\n      speed: enemyTypes[s.type].speed * TILE / 1000,\n      damage: enemyTypes[s.type].damage,\n      color: enemyTypes[s.type].color,\n      size: enemyTypes[s.type].size,\n      name: enemyTypes[s.type].name,\n      alive: true,\n      attackCooldown: 0,\n      hitFlash: 0\n    });\n  });\n\n  const pickupSpawns = [\n    { x:9.5, y:6.5, type:\"health\" },\n    { x:14.5, y:8.5, type:\"ammo\" },\n    { x:3.5, y:12.5, type:\"armor\" },\n    { x:17.5, y:13.5, type:\"health\" },\n    { x:9.5, y:16.5, type:\"ammo\" }\n  ];\n\n  pickupSpawns.forEach(p => {\n    pickups.push({ ...p, alive: true });\n  });\n}\n\n// ============ CANVAS SETUP ============\nconst canvas = document.getElementById('screen');\nconst ctx = canvas.getContext('2d', { alpha: false });\ncanvas.width = 320;\ncanvas.height = 240;\n\nconst miniCanvas = document.getElementById('minimap');\nconst mctx = miniCanvas.getContext('2d');\n\n// ============ INPUT ============\nlet keys = {};\ndocument.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });\ndocument.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\n\nlet mouseDown = false;\ncanvas.addEventListener('mousedown', () => { if(gameState === 'playing') mouseDown = true; });\ncanvas.addEventListener('mouseup', () => { mouseDown = false; });\ncanvas.addEventListener('click', () => { \n  if (gameState === 'playing') canvas.requestPointerLock();\n});\n\ndocument.addEventListener('mousemove', e => {\n  if (gameState === 'playing' && document.pointerLockElement) {\n    player.angle += e.movementX * 0.003;\n  }\n});\n\n// ============ RAYCASTING ENGINE ============\nconst FOV = Math.PI / 3; // 60 degrees\nconst NUM_RAYS = 128;\nconst MAX_DEPTH = 20;\n\nfunction castRay(ox, oy, angle) {\n  const sinA = Math.sin(angle);\n  const cosA = Math.cos(angle);\n  \n  let dist = 0;\n  let hitX = ox, hitY = oy;\n  let wallType = 0;\n  \n  // DDA raycasting algorithm (simplified)\n  for (let d = 0.01; d < MAX_DEPTH * TILE / 64; d += 0.02) {\n    const testX = ox + cosA * d;\n    const testY = oy + sinA * d;\n    \n    const gridX = Math.floor(testX);\n    const gridY = Math.floor(testY);\n    \n    if (gridX < 0 || gridX >= MAP_W || gridY < 0 || gridY >= MAP_H) break;\n    \n    if (walls[gridY][gridX] > 0) {\n      dist = d * TILE / 64; // convert to world units\n      hitX = testX;\n      hitY = testY;\n      wallType = walls[gridY][gridX];\n      \n      break;\n    }\n  }\n  \n  return { dist: Math.max(dist, 0.1), hitX, hitY, wallType };\n}\n\n// Wall colors by type (brighter palette for visibility)\nconst WALL_COLORS = {\n  0: null,\n  1: [140, 100, 75],   // brown brick - brighter!\n  2: [130, 110, 60],   // dark stone  \n  3: [110, 80, 120],   // purple stone\n  4: [150, 120, 40],   // gold-ish\n  5: [70, 130, 70]     // green slime wall\n};\n\nfunction getWallColor(type) {\n  return WALL_COLORS[type] || [120, 95, 80];\n}\n\n// ============ LIGHTING COMPUTATION ============\n// Compute lighting for a point in world space based on nearest torches + player proximity\nfunction computeLighting(worldX, worldY) {\n  // Base ambient light (not pitch black!)\n  let totalLight = 0.25; \n  \n  const px = player.x;\n  const py = player.y;\n  \n  for (let l = 0; l < LIGHTS.length; l++) {\n    const lx = LIGHTS[l].gx * TILE / 64; // convert grid to world units\n    const ly = LIGHTS[l].gy * TILE / 64;\n    \n    // Distance from light source to point (in tiles)\n    let dx = worldX - lx;\n    let dy = worldY - ly;\n    let distSq = dx*dx + dy*dy;\n    let dist = Math.sqrt(distSq);\n    \n    if (dist < 0.1) continue;\n    \n    // Check if wall blocks light between torch and point\n    const rayAngle = Math.atan2(dy, dx);\n    let blocked = false;\n    for (let d = 0.5; d < dist - 0.3; d += 0.3) {\n      const testX = lx + Math.cos(rayAngle) * d;\n      const testY = ly + Math.sin(rayAngle) * d;\n      const gx = Math.floor(testX);\n      const gy = Math.floor(testY);\n      if (gx >= 0 && gx < MAP_W && gy >= 0 && gy < MAP_H) {\n        if (walls[gy][gx] > 0) { blocked = true; break; }\n      }\n    }\n    \n    if (!blocked) {\n      // Inverse square falloff, clamped to reasonable range\n      const contribution = Math.max(0.15, 3.0 / (distSq + 2));\n      totalLight += contribution * 0.6;\n    }\n  }\n  \n  // Player proximity adds a small \"flashlight\" glow around the player\n  const playerDist = Math.sqrt((worldX - px)*(worldX - px) + (worldY - py)*(worldY - py));\n  totalLight += Math.max(0.1, 2.5 / (playerDist * playerDist + 3)) * 0.4;\n  \n  // Clamp to reasonable range\n  return Math.min(totalLight, 1.8);\n}\n\n// ============ RENDERING ============\nfunction render() {\n  const imgData = ctx.createImageData(320, 240);\n  const buf = imgData.data; // pixel buffer\n  \n  // Clear to brighter ceiling/floor colors\n  for (let y = 0; y < 240; y++) {\n    let color;\n    if (y < 120) {\n      // Ceiling - much brighter gradient, warm brownish tone like Doom's ceilings\n      const t = y / 120;\n      color = [Math.floor(50 * (1-t)), Math.floor(35 * (1-t)), Math.floor(25 * (1-t))];\n    } else {\n      // Floor - much brighter, dark stone/earth tone  \n      const t = (y - 120) / 120;\n      color = [Math.floor(60 * (1-t)), Math.floor(40 * (1-t)), Math.floor(30 * (1-t))];\n    }\n    \n    for (let x = 0; x < 320; x++) {\n      const idx = (y * 320 + x) * 4;\n      buf[idx]     = color[0]; // R\n      buf[idx + 1] = color[1]; // G  \n      buf[idx + 2] = color[2]; // B\n      buf[idx + 3] = 255;       // A\n    }\n  }\n\n  // Cast rays for each column and draw walls with lighting\n  const stripWidth = Math.max(1, Math.floor(320 / NUM_RAYS));\n  \n  for (let i = 0; i < NUM_RAYS; i++) {\n    const rayAngle = player.angle - FOV/2 + (i / NUM_RAYS) * FOV;\n    const result = castRay(player.x, player.y, rayAngle);\n    \n    // Fix fisheye\n    const correctedDist = result.dist * Math.cos(rayAngle - player.angle);\n    \n    if (result.wallType === 0 || correctedDist > MAX_DEPTH) continue;\n    \n    // Wall height on screen\n    const wallHeight = Math.min(240, Math.floor((TILE / correctedDist) * TILE));\n    const wallTop = Math.max(0, Math.floor(120 - wallHeight/2));\n    const wallBottom = Math.min(239, Math.floor(120 + wallHeight/2));\n    \n    // Compute lighting at the hit point on the wall (in world coords)\n    const hitWorldX = result.hitX;\n    const hitWorldY = result.hitY;\n    let lightLevel = computeLighting(hitWorldX, hitWorldY);\n    \n    // Additional distance fog for atmosphere\n    const distFog = Math.max(0.15, 1.0 / (1 + correctedDist * 0.2));\n    lightLevel *= distFog;\n    \n    const [r, g, b] = getWallColor(result.wallType);\n    \n    for (let y = wallTop; y <= wallBottom; y++) {\n      for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n        const idx = (y * 320 + sx) * 4;\n        \n        // Add slight vertical stripe pattern on walls\n        let wallShade = lightLevel;\n        if ((sx % 8 < 4)) wallShade *= 0.97;\n        \n        buf[idx]     = Math.min(255, Math.floor(r * wallShade));\n        buf[idx + 1] = Math.min(255, Math.floor(g * wallShade));\n        buf[idx + 2] = Math.min(255, Math.floor(b * wallShade));\n      }\n    }\n    \n    // Draw floor/ceiling cast from this ray (simplified - just the column) with lighting\n    const playerWorldX = player.x;\n    const playerWorldY = player.y;\n    \n    for (let y = wallBottom + 1; y < 240; y++) {\n      if (y >= 180 && Math.random() > 0.97) continue; // skip some floor pixels for perf\n      \n      const t = (y - wallBottom) / (240 - wallBottom);\n      \n      // Floor point in world space along this ray\n      let fWorldX, fWorldY;\n      if (t < 1) {\n        const rayDist = correctedDist + t * TILE;\n        fWorldX = player.x + Math.cos(rayAngle) * rayDist / (TILE/64); // approximate world coords\n        fWorldY = player.y + Math.sin(rayAngle) * rayDist / (TILE/64);\n      } else {\n        continue;\n      }\n      \n      let floorLight = computeLighting(fWorldX, fWorldY) * distFog;\n      \n      // Floor base color - dark stone with slight variation\n      const checkerX = Math.floor(player.x + (fWorldX - player.x));\n      const checkerY = Math.floor(player.y + (fWorldY - player.y));\n      let floorBaseR, floorBaseG, floorBaseB;\n      \n      if ((checkerX + checkerY) % 2 === 0) {\n        // Darker stone tile\n        floorBaseR = 55 * distFog;\n        floorBaseG = 40 * distFog;\n        floorBaseB = 30 * distFog;\n      } else {\n        // Lighter stone tile  \n        floorBaseR = 65 * distFog;\n        floorBaseG = 48 * distFog;\n        floorBaseB = 35 * distFog;\n      }\n      \n      const idx = (y * 320 + Math.min(Math.max(i * stripWidth, 0), 319)) * 4;\n      buf[idx]     = Math.min(255, Math.floor(floorBaseR * floorLight));\n      buf[idx + 1] = Math.min(255, Math.floor(floorBaseG * floorLight));\n      buf[idx + 2] = Math.min(255, Math.floor(floorBaseB * floorLight));\n    }\n    \n    // Ceiling column (above wall) - already drawn in clear loop with ambient only\n    // Add subtle light contribution to ceiling near torches\n    for (let y = 0; y < wallTop; y++) {\n      const t2 = Math.max(0, 1 - y / 120);\n      let ceilLight = computeLighting(hitWorldX, hitWorldY) * distFog * 0.3; // less light on ceiling\n      \n      for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n        const idx = (y * 320 + sx) * 4;\n        \n        let ceilR = Math.floor(50 * t2 * ceilLight);\n        let ceilG = Math.floor(35 * t2 * ceilLight);\n        let ceilB = Math.floor(25 * t2 * ceilLight);\n        \n        buf[idx]     = Math.min(255, ceilR);\n        buf[idx + 1] = Math.min(255, ceilG);\n        buf[idx + 2] = Math.min(255, ceilB);\n      }\n    }\n    \n    // Draw torch sprite at wall hit position (small flickering light)\n    if (result.wallType === -1 || walls[Math.floor(result.hitY)][Math.floor(result.hitX)] <= 0 && mapGrid[Math.floor(player.y + Math.sin(rayAngle)*result.dist*64/TILE)]?.[Math.floor(player.x + Math.cos(rayAngle)*result.dist*64/TILE)] === 'T') {\n      // Simple torch glow on wall - draw a small bright spot at the hit point center vertically\n      const torchCenterY = 120;\n      for (let ty = Math.max(0, torchCenterY-3); ty <= Math.min(239, torchCenterY+3); ty++) {\n        for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n          const idx = (ty * 320 + sx) * 4;\n          // Flickering orange glow\n          buf[idx]     = Math.min(255, buf[idx] + Math.floor(Math.random() * 60));\n          buf[idx + 1] = Math.min(255, buf[idx+1] + Math.floor(Math.random() * 30));\n        }\n      }\n    }\n  }\n\n  ctx.putImageData(imgData, 0, 0);\n}\n\n// ... rest of the game code (enemies, pickups, particles, HUD update) follows same as before but with brighter rendering above\n</script>\n</body>\n</html>\n"},"status":"ok","ms":133}
