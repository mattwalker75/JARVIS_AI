{"t":"2026-07-26T18:21:04.099Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom_debug.py","content":"\"\"\"Debug test for DOOM raycasting game — inspect page structure and state.\"\"\"\nimport sys\nfrom playwright.sync_api import sync_playwright\n\ndef run_test():\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={\"width\": 1024, \"height\": 768})\n        \n        page = context.new_page()\n        console_messages = []\n        \n        def on_console(msg):\n            try:\n                msg_type = str(getattr(msg, 'type', lambda: 'unknown')()) if callable(getattr(msg, 'type')) else ''\n                msg_text = str(getattr(msg, 'text', lambda: '')()) if callable(getattr(msg, 'text')) else ''\n                console_messages.append({\"type\": msg_type, \"text\": msg_text})\n            except Exception as e:\n                console_messages.append({\"type\": f\"parse_error:{e}\", \"text\": \"\"})\n        \n        page.on(\"console\", on_console)\n        \n        try:\n            print(\"[DEBUG] Loading game...\")\n            page.goto(\"http://localhost:9101/\", timeout=30000)\n            \n            import time\n            \n            # Extract all visible text from the page\n            print(\"\\n=== PAGE TEXT ===\")\n            body_text = page.evaluate(\"\"\"() => document.body.innerText\"\"\")\n            print(body_text[:2000] if body_text else \"(empty)\")\n            \n            # Check for any elements on the page\n            print(\"\\n=== DOM STRUCTURE ===\")\n            dom_info = page.evaluate(\"\"\"() => {\n                const els = [];\n                function walk(node, depth) {\n                    if (depth > 3 || !node.childNodes) return;\n                    try {\n                        let info = '';\n                        for (let i = 0; i < node.attributes.length; i++) {\n                            info += ' ' + node.attributes[i].name + '=' + JSON.stringify(node.attributes[i].value);\n                        }\n                        if (info || ['CANVAS','BUTTON','DIV'].includes(node.tagName)) {\n                            els.push('  '.repeat(depth) + '<' + node.tagName + '>' + info.substring(0,100));\n                        }\n                    } catch(e) {}\n                    for (let i = 0; i < node.childNodes.length && i < 20; i++) {\n                        walk(node.childNodes[i], depth+1);\n                    }\n                }\n                walk(document.documentElement, 0);\n                return els.join('\\\\n');\n            }\"\"\")\n            print(dom_info[:3000])\n            \n            # Check all canvas elements specifically\n            print(\"\\n=== CANVAS DETAILS ===\")\n            canvases = page.evaluate(\"\"\"() => {\n                const result = [];\n                document.querySelectorAll('canvas').forEach((c, i) => {\n                    try {\n                        result.push({\n                            index: i,\n                            width: c.width, height: c.height,\n                            cssWidth: getComputedStyle(c).width,\n                            cssHeight: getComputedStyle(c).height,\n                            visible: !!(c.offsetWidth && c.offsetHeight),\n                            ctxType: null\n                        });\n                    } catch(e) {}\n                });\n                return result;\n            }\"\"\")\n            print(f\"Found {len(canvases)} canvas(es):\")\n            for c in canvases:\n                print(f\"  Canvas {c.get('index','?')}: internal={c.get('width')}x{c.get('height')}, CSS={c.get('cssWidth')}x{c.get('cssHeight')}, visible={c.get('visible')}\")\n            \n            # Try clicking the page to ensure focus, then pressing keys\n            print(\"\\n=== INTERACTION TEST ===\")\n            page.click(\"body\")\n            time.sleep(0.3)\n            page.keyboard.press(\"KeyW\")\n            time.sleep(1)\n            page.keyboard.press(\"Space\")\n            time.sleep(1)\n            \n            # Re-check canvas after interaction\n            print(\"\\n=== POST-INTERACTION CANVAS ===\")\n            post_canvases = page.evaluate(\"\"\"() => {\n                const result = [];\n                document.querySelectorAll('canvas').forEach((c, i) => {\n                    try {\n                        const ctx = c.getContext('2d');\n                        if (ctx && c.width > 0 && c.height > 0) {\n                            // Sample a few pixels from center column\n                            const cx = Math.floor(c.width/2);\n                            const h = c.height;\n                            let samples = {};\n                            try { samples.ceiling = Array.from(ctx.getImageData(cx, Math.max(1,Math.floor(h/8)), 1, 1).data.slice()); } catch(e) {}\n                            try { samples.horizon = Array.from(ctx.getImageData(cx, Math.floor(h/2), 1, 1).data.slice()); } catch(e) {}\n                            try { samples.floor = Array.from(ctx.getImageData(cx, Math.min(c.height-2,c.height*7/8), 1, 1).data.slice()); } catch(e) {}\n                            result.push({ index: i, width: c.width, height: c.height, samples });\n                        } else {\n                            result.push({ index: i, width: c.width, height: c.height, error: 'no ctx or zero size' });\n                        }\n                    } catch(e) {\n                        result.push({ index: i, error: e.message });\n                    }\n                });\n                return result;\n            }\"\"\")\n            print(f\"Post-interaction canvas info:\")\n            for c in post_canvases:\n                print(f\"  Canvas {c.get('index','?')}: internal={c.get('width')}x{c.get('height')}\")\n                if 'samples' in c:\n                    for k, v in c['samples'].items():\n                        if isinstance(v, list):\n                            print(f\"    {k}: R={v[0]}, G={v[1]}, B={v[2]}\")\n        \n        except Exception as e:\n            import traceback\n            tb = traceback.format_exc()\n            print(f\"[DEBUG] Exception:\\n{tb}\")\n        \n        finally:\n            browser.close()\n\nif __name__ == \"__main__\":\n    run_test()\n"},"status":"ok","ms":139}
