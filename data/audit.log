{"t":"2026-07-26T15:21:33.233Z","tool":"run_shell","args":{"command":"python3 -c \"\nfrom playwright.sync_api import sync_playwright\nimport time, json\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page(viewport={'width': 1024, 'height': 768})\n    \n    errors = []\n    console_msgs = []\n    def on_console(msg):\n        console_msgs.append(f'[{msg.type}] {msg.text}')\n        if msg.type == 'error':\n            errors.append(msg.text)\n    page.on('console', on_console)\n    \n    # Navigate and wait for full load + animation frames\n    page.goto('http://localhost:9101')\n    time.sleep(3)  # Wait for JS init + several render frames\n    \n    print('=== Console Messages ===')\n    for m in console_msgs[:20]:\n        print(m)\n    \n    if errors:\n        print(f'\\n⚠️ {len(errors)} JS error(s):')\n        for e in errors:\n            print(f'  ERROR: {e}')\n    else:\n        print('\\n✅ No console errors detected')\n    \n    # Check canvas state AFTER load\n    result = page.evaluate('''() => {\n        const c = document.getElementById('game');\n        \n        // Force resize (simulates window.resize event)\n        if (c.width === 0 || c.height === 0) {\n            c.width = window.innerWidth;\n            c.height = window.innerHeight;\n        }\n        \n        try {\n            return JSON.stringify({\n                canvasW: c.width,\n                canvasH: c.height,\n                gameExists: typeof game !== 'undefined',\n                playerX: typeof player !== 'undefined' ? (player.x || 0) : null,\n                enemiesCount: Array.isArray(enemies) ? enemies.length : -1,\n                mapsLoaded: Array.isArray(maps) ? maps.length : -1,\n                loopExists: typeof loop === 'function',\n                renderExists: typeof render === 'function',\n            });\n        } catch(e) {\n            return JSON.stringify({error: e.message});\n        }\n    }''')\n    \n    print(f'\\n=== Game State ===')\n    state = json.loads(result)\n    for k, v in state.items():\n        print(f'  {k}: {v}')\n    \n    # Take screenshot to see what's rendered\n    page.screenshot(path='/workspace/test_game.png', full_page=True)\n    print('\\nScreenshot saved to /workspace/test_game.png')\n    \n    browser.close()\n\" 2>&1\n","timeout_s":30},"status":"ok","ms":3405}
