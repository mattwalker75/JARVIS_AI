{"t":"2026-07-27T04:45:05.855Z","tool":"write_workbench_file","args":{"path":"/workspace/test_viewer.py","content":"import asyncio\nfrom playwright.async_api import async_playwright\nimport base64, os, glob\n\nasync def main():\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n\n        # 1. Navigate to the picture viewer\n        print(\"[TEST] Loading picture_viewer.html...\")\n        await page.goto(\"http://localhost:9101/picture_viewer.html\", wait_until=\"networkidle\")\n        \n        # Check title and header\n        h1 = await page.text_content(\"header h1\")\n        assert \"Picture Viewer\" in h1, f\"Header wrong: {h1}\"\n        print(\"[PASS] Header loaded correctly.\")\n\n        # 2. Read test images as base64 data URLs to inject into IndexedDB\n        img_files = sorted(glob.glob(\"/workspace/test_images/*.jpg\"))\n        assert len(img_files) >= 8, f\"Expected at least 8 images, found {len(img_files)}\"\n        \n        image_data_urls = []\n        for f in img_files:\n            with open(f, \"rb\") as fh:\n                data = base64.b64encode(fh.read()).decode()\n                mime = \"image/jpeg\"\n                name = os.path.basename(f)\n                image_data_urls.append((name, f\"data:{mime};base64,{data}\"))\n        \n        print(f\"[TEST] Injecting {len(image_data_urls)} images into IndexedDB...\")\n\n        # 3. Open DB directly via JS and populate it\n        await page.evaluate(\"\"\"\n            async () => {\n                return new Promise((resolve, reject) => {\n                    const req = indexedDB.open('PictureViewerDB', 1);\n                    req.onupgradeneeded = e => {\n                        const d = e.target.result;\n                        if (!d.objectStoreNames.contains('images')) {\n                            const s = d.createObjectStore('images', { keyPath: 'id' });\n                            s.createIndex('timestamp', 'timestamp');\n                        }\n                    };\n                    req.onsuccess = async (e) => {\n                        const db = e.target.result;\n                        // Clear any existing data\n                        const tx1 = db.transaction('images','readwrite');\n                        tx1.objectStore('images').clear();\n                        \n                        const images = window.__test_images || [];\n                        for (const [name, dataUrl] of images) {\n                            const id = Date.now().toString(36) + Math.random().toString(36).slice(2,8);\n                            const tx = db.transaction('images','readwrite');\n                            tx.objectStore('images').add({ \n                                id: id, \n                                name: name, \n                                dataUrl: dataUrl, \n                                timestamp: Date.now() + Math.random() * 1000 \n                            });\n                        }\n                        \n                        await new Promise((res,rej) => {\n                            tx.oncomplete = res;\n                            tx.onerror = rej;\n                        });\n                        db.close();\n                        resolve('done');\n                    };\n                    req.onerror = reject;\n                });\n            }\n        \"\"\", {\"__test_images\": image_data_urls})\n\n        print(\"[PASS] Images injected into IndexedDB.\")\n\n        # 4. Reload page to pick up the DB data\n        await page.reload(wait_until=\"networkidle\")\n        \n        # Wait for gallery to render\n        await asyncio.sleep(1)\n        \n        # Check gallery grid has thumbnails\n        thumbs = await page.query_selector_all(\".thumb-card img\")\n        assert len(thumbs) == 8, f\"Expected 8 thumbnails in gallery, found {len(thumbs)}\"\n        print(f\"[PASS] Gallery shows {len(thumbs)} images.\")\n\n        # Check count label\n        count_text = await page.text_content(\"#count-label\")\n        assert \"8 image\" in count_text, f\"Count wrong: {count_text}\"\n        print(\"[PASS] Count label correct.\")\n\n        # 5. Test lightbox - click on first thumbnail card (use double-click)\n        print(\"[TEST] Opening lightbox...\")\n        await page.click(\".thumb-card\", position={\"x\":10, \"y\":10})\n        \n        lb = await page.is_visible(\"#lightbox.active\") or await page.evaluate(\"document.getElementById('lightbox').classList.contains('active')\")\n        # The lightbox uses class 'active' not ':visible', check via JS\n        lb_active = await page.evaluate(\"document.getElementById('lightbox').classList.contains('active')\")\n        \n        if not lb_active:\n            # Try double click\n            await page.dblclick(\".thumb-card\", position={\"x\":10, \"y\":10})\n            await asyncio.sleep(0.5)\n            lb_active = await page.evaluate(\"document.getElementById('lightbox').classList.contains('active')\")\n\n        assert lb_active, \"Lightbox not open\"\n        print(\"[PASS] Lightbox opened.\")\n\n        # Check lightbox has an image and info text\n        lb_img_src = await page.eval_on_selector(\"#lb-img\", \"el => el.src.length > 0\")\n        lb_info_text = await page.text_content(\"#lb-info\")\n        \n        assert lb_img_src, \"Lightbox image src is empty\"\n        print(\"[PASS] Lightbox shows an image.\")\n\n        # Check nav info\n        assert \"/ 8\" in lb_info_text or \"1 / 8\" in lb_info_text, f\"Lb info wrong: {lb_info_text}\"\n        print(f\"[PASS] Lightbox navigation info correct: '{lb_info_text}'\")\n\n        # 6. Test next button\n        await page.click(\"#lb-next\")\n        await asyncio.sleep(0.3)\n        new_info = await page.text_content(\"#lb-info\")\n        assert \"2 / 8\" in new_info, f\"After nav info wrong: {new_info}\"\n        print(\"[PASS] Next navigation works.\")\n\n        # Test prev button  \n        await page.click(\"#lb-prev\")\n        await asyncio.sleep(0.3)\n        back_info = await page.text_content(\"#lb-info\")\n        assert \"1 / 8\" in back_info, f\"After prev info wrong: {back_info}\"\n        print(\"[PASS] Previous navigation works.\")\n\n        # Close lightbox with Escape key\n        await page.keyboard.press(\"Escape\")\n        await asyncio.sleep(0.3)\n        still_open = await page.evaluate(\"document.getElementById('lightbox').classList.contains('active')\")\n        assert not still_open, \"Lightbox didn't close on Escape\"\n        print(\"[PASS] Lightbox closed with Escape key.\")\n\n        # 7. Test delete a single image\n        print(\"[TEST] Deleting one image...\")\n        \n        # Accept the confirm dialog\n        page.on(\"dialog\", lambda d: d.accept())\n        \n        await page.click(\".thumb-card .icon-btn.delete\")\n        await asyncio.sleep(0.5)\n        \n        remaining = await page.query_selector_all(\".thumb-card img\")\n        assert len(remaining) == 7, f\"Expected 7 after delete, found {len(remaining)}\"\n        print(f\"[PASS] Delete works: now showing {len(remaining)} images.\")\n\n        # Re-open confirm listener for next test\n        page.remove_listener(\"dialog\", lambda d: d.accept())\n        \n        # 8. Test slideshow start/stop - open lightbox first, then click a speed button\n        print(\"[TEST] Testing slideshow...\")\n        await page.dblclick(\".thumb-card\", position={\"x\":10, \"y\":10})\n        await asyncio.sleep(0.5)\n        \n        # Click the 5s slideshow button\n        slide_btn = await page.query_selector(\"#slideshow-bar button:nth-child(2)\")\n        if slide_btn:\n            await slide_btn.click()\n            await asyncio.sleep(0.3)\n            \n            stop_btn_visible = await page.evaluate(\"\"\"\n                () => document.getElementById('stop-slide-btn').style.display !== 'none'\n            \"\"\")\n            assert stop_btn_visible, \"Stop button not visible after starting slideshow\"\n            print(\"[PASS] Slideshow started.\")\n\n        # 9. Test clear all - accept confirm and verify gallery empties\n        page.on(\"dialog\", lambda d: d.accept())\n        \n        await page.click(\"#stats-bar .secondary\")\n        await asyncio.sleep(0.5)\n        \n        empty_state = await page.is_visible(\"#empty-state\") or await page.evaluate(\"\"\"\n            () => document.getElementById('empty-state').style.display !== 'none'\n        \"\"\")\n        assert empty_state, \"Empty state not shown after clearing all\"\n        print(\"[PASS] Clear All works.\")\n\n        # 10. Verify drag-drop zone is visible and interactive\n        upload_zone = await page.is_visible(\"#upload-zone\")\n        assert upload_zone, \"Upload zone not visible\"\n        \n        drop_text = await page.text_content(\"#upload-zone strong\")\n        assert \"Drag\" in drop_text or \"drag\" in drop_text.lower(), f\"Drop text wrong: {drop_text}\"\n        print(\"[PASS] Drag-drop zone is present and labeled.\")\n\n        # 11. Test keyboard nav on gallery thumbnails (tab through)\n        await page.keyboard.press(\"Tab\")\n        active_el = await page.evaluate(\"document.activeElement.tagName + ' #' + document.activeElement.id || ''\")\n        assert \"upload-zone\" in active_el or \"#file-input\" in active_el, f\"Focus wrong: {active_el}\"\n        print(\"[PASS] Keyboard focus works on upload zone.\")\n\n        # 12. Verify file input accepts image types\n        accept_attr = await page.get_attribute(\"#file-input\", \"accept\")\n        assert \"image/*\" in accept_attr, f\"Accept attr wrong: {accept_attr}\"\n        print(\"[PASS] File input has correct accept attribute (image/*).\")\n\n        # Cleanup - close lightbox if open\n        try:\n            await page.keyboard.press(\"Escape\")\n        except: pass\n        \n        await browser.close()\n        \n        print(\"\\n\" + \"=\"*50)\n        print(\"ALL TESTS PASSED!\")\n        print(\"=\"*50)\n\nasyncio.run(main())\n"},"status":"ok","ms":144}
