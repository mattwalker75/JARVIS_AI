{"t":"2026-07-27T03:15:46.180Z","tool":"write_workbench_file","args":{"path":"/workspace/test_core.js","content":"const { chromium } = require('playwright');\n\n(async () => {\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext();\n  const page = await context.newPage();\n  \n  let passed = 0;\n  let failed = 0;\n  \n  function assert(condition, msg) {\n    if (condition) {\n      console.log(`✅ PASS: ${msg}`);\n      passed++;\n    } else {\n      console.error(`❌ FAIL: ${msg}`);\n      failed++;\n    }\n  }\n\n  try {\n    // ===== TEST 1: Dashboard loads and renders correctly =====\n    await page.goto('http://localhost:9106/');\n    \n    assert(await page.locator('#page-dashboard').isVisible(), 'Dashboard section is visible on load');\n    const dashStats = await page.locator('.stat-card').count();\n    assert(dashStats >= 4, `At least 4 stat cards rendered (found ${dashStats})`);\n    \n    // Check dashboard has pending actions and recent activity sections\n    assert(await page.locator('#pending-actions').isVisible(), 'Pending Actions section renders');\n    assert(await page.locator('#recent-activity').isVisible(), 'Recent Activity section renders');\n    \n    console.log('\\n--- TEST 1: Dashboard loads correctly ---\\n');\n\n    // ===== TEST 2: Navigate to Clients page and add a new client =====\n    await page.click('[data-page=\"clients\"]');\n    await page.waitForTimeout(300);\n    \n    assert(await page.locator('#page-clients').isVisible(), 'Clients section becomes visible on navigation');\n    \n    // Count existing clients before adding\n    const initialRows = await page.locator('#clients-table tr').count();\n    console.log(`  Initial client count: ${initialRows}`);\n    \n    // Click the specific \"Add New Client\" button (the one in .page-header)\n    await page.click('.section.active .btn-primary');\n    await page.waitForTimeout(300);\n    \n    assert(await page.locator('#client-modal.show').isVisible(), 'Client modal opens with overlay visible');\n    \n    // Fill the form using specific IDs\n    await page.fill('#cf-first', 'TestAgent');\n    await page.fill('#cf-last', 'Johnson');\n    await page.fill('#cf-email', 'testagent.johnson@lifeinsurance.com');\n    await page.fill('#cf-phone', '(555) 867-5309');\n    await page.selectOption('#cf-status', 'registered');\n    \n    // Submit the form - use specific selector for submit button inside modal\n    const submitBtn = page.locator('#client-modal .btn-primary[type=\"submit\"]');\n    assert(await submitBtn.isVisible(), 'Save Client submit button is visible in modal');\n    await submitBtn.click();\n    \n    // Wait for modal to close and table to update\n    await page.waitForTimeout(1000);\n    \n    const newRows = await page.locator('#clients-table tr').count();\n    assert(newRows === initialRows + 1, `Client count increased by 1 (was ${initialRows}, now ${newRows})`);\n    \n    // Verify the client name appears in table\n    const firstCellText = await page.locator('#clients-table td:first-child').first().textContent();\n    assert(firstCellText.includes('Johnson'), 'New client \"TestAgent Johnson\" appears in clients table');\n    \n    console.log('\\n--- TEST 2: Add new client workflow ---\\n');\n\n    // ===== TEST 3: Register a policy for the newly added client =====\n    await page.click('[data-page=\"policies\"]');\n    await page.waitForTimeout(500);\n    \n    assert(await page.locator('#page-policies').isVisible(), 'Policies section becomes visible on navigation');\n    \n    const initialPolRows = await page.locator('#policies-table tr').count();\n    console.log(`  Initial policy count: ${initialPolRows}`);\n    \n    // Click the \"Register New Policy\" button in .page-header\n    await page.click('.section.active .btn-primary');\n    await page.waitForTimeout(500);\n    \n    assert(await page.locator('#policy-modal.show').isVisible(), 'Policy registration modal opens');\n    \n    if (await page.locator('#pf-client option[value]').count() > 0) {\n      // Select the client we just created - find by text content\n      const options = await page.locator('#pf-client option').all();\n      let selectedClient = false;\n      \n      for (const opt of options) {\n        const txt = await opt.textContent();\n        if (txt.includes('Johnson')) {\n          await opt.selectOption({ value: await opt.getAttribute('value') });\n          selectedClient = true;\n          break;\n        }\n      }\n      assert(selectedClient, 'TestAgent Johnson appears in policy client select dropdown');\n      \n      // Fill remaining fields - use specific IDs\n      const coverageInput = page.locator('#pf-coverage');\n      await coverageInput.click();\n      await page.keyboard.press('Control+a');\n      await page.type('#pf-coverage', '500000');\n      \n      const premiumInput = page.locator('#pf-premium');\n      await premiumInput.click();\n      await page.keyboard.press('Control+a');\n      await page.type('#pf-premium', '2400');\n      \n      await page.selectOption('#pf-type', 'term_life');\n      await page.fill('#pf-start', '2026-01-15');\n      await page.selectOption('#pf-status', 'active');\n      \n      // Submit policy form - use specific selector for submit button inside modal\n      const polSubmit = page.locator('#policy-modal .btn-primary[type=\"submit\"]');\n      assert(await polSubmit.isVisible(), 'Register Policy submit button is visible in modal');\n      await polSubmit.click();\n      \n      await page.waitForTimeout(1000);\n    } else {\n      console.log('  Warning: No client options found in policy select (may need to re-check)');\n    }\n    \n    const newPolRows = await page.locator('#policies-table tr').count();\n    assert(newPolRows === initialPolRows + 1, `Policy count increased by 1 (was ${initialPolRows}, now ${newPolRows})`);\n    \n    // Verify the policy appears with client name\n    const polClientCell = await page.locator('#policies-table td:nth-child(2)').first().textContent();\n    assert(polClientCell.includes('Johnson'), 'New policy shows \"TestAgent Johnson\" as client');\n    \n    console.log('\\n--- TEST 3: Register new policy workflow ---\\n');\n\n    // ===== TEST 4: Record a payment for the policy =====\n    await page.click('[data-page=\"payments\"]');\n    await page.waitForTimeout(500);\n    \n    assert(await page.locator('#page-payments').isVisible(), 'Payments section becomes visible on navigation');\n    \n    const initialPayRows = await page.locator('#payments-table tr').count();\n    console.log(`  Initial payment count: ${initialPayRows}`);\n    \n    // Click the \"Record Payment\" button (btn-success in .page-header)\n    await page.click('.section.active .btn-success');\n    await page.waitForTimeout(500);\n    \n    assert(await page.locator('#payment-modal.show').isVisible(), 'Payment recording modal opens');\n    \n    if (await page.locator('#pm-policy option[value]').count() > 0) {\n      // Select the policy we just created\n      const payOptions = await page.locator('#pm-policy option').all();\n      let selectedPolicy = false;\n      \n      for (const opt of payOptions) {\n        const txt = await opt.textContent();\n        if (txt.includes('Johnson')) {\n          await opt.selectOption({ value: await opt.getAttribute('value') });\n          selectedPolicy = true;\n          break;\n        }\n      }\n      assert(selectedPolicy, 'New policy appears in payment policy select dropdown');\n      \n      // Fill remaining fields - use specific IDs\n      const payAmountInput = page.locator('#pm-amount');\n      await payAmountInput.click();\n      await page.keyboard.press('Control+a');\n      await page.type('#pm-amount', '2400');\n      \n      await page.fill('#pm-date', '2026-07-15');\n      await page.selectOption('#pm-method', 'check');\n      \n      // Submit payment form - use specific selector for submit button inside modal\n      const paySubmit = page.locator('#payment-modal .btn-success[type=\"submit\"]');\n      assert(await paySubmit.isVisible(), 'Record Payment submit button is visible in modal');\n      await paySubmit.click();\n      \n      await page.waitForTimeout(1000);\n    } else {\n      console.log('  Warning: No policy options found in payment select (may need to re-check)');\n    }\n    \n    const newPayRows = await page.locator('#payments-table tr').count();\n    assert(newPayRows === initialPayRows + 1, `Payment count increased by 1 (was ${initialPayRows}, now ${newPayRows})`);\n    \n    // Verify payment appears with client name and status badge\n    const payClientCell = await page.locator('#payments-table td:nth-child(2)').first().textContent();\n    assert(payClientCell.includes('Johnson'), 'New payment shows \"TestAgent Johnson\" as client');\n    \n    console.log('\\n--- TEST 4: Record payment workflow ---\\n');\n\n    // ===== TEST 5: Dashboard reflects all new data =====\n    await page.click('[data-page=\"dashboard\"]');\n    await page.waitForTimeout(1000);\n    \n    assert(await page.locator('#page-dashboard').isVisible(), 'Dashboard section is accessible after navigation');\n    \n    // Check that stats reflect the added data (should show at least 2 clients total now)\n    const statTexts = [];\n    for (const card of await page.locator('.stat-card').all()) {\n      statTexts.push(await card.textContent());\n    }\n    \n    assert(statTexts.some(t => t.includes('2') || t.includes('1')), 'Dashboard stats reflect updated client count');\n    \n    // Check that pending actions or recent activity sections render without JS errors\n    const pendingRows = await page.locator('#pending-actions tr').count();\n    console.log(`  Pending action rows on dashboard: ${pendingRows}`);\n    \n    const activityRows = await page.locator('#recent-activity tr').count();\n    console.log(`  Recent activity rows on dashboard: ${activityRows}`);\n    \n    // Check for JS errors in the browser console\n    console.log('\\n--- TEST 5: Dashboard reflects all data ---\\n');\n\n    // ===== SUMMARY =====\n    console.log('='.repeat(60));\n    console.log(`RESULTS: ${passed} passed, ${failed} failed out of ${passed + failed} tests`);\n    \n    if (failed === 0) {\n      console.log('\\n🎉 ALL TESTS PASSED! Core workflows verified.');\n    } else {\n      console.log(`\\n⚠️ ${failed} test(s) need attention.`);\n    }\n\n  } catch (err) {\n    console.error('Test error:', err.message);\n    failed++;\n    \n    // Take a screenshot for debugging on failure\n    try {\n      await page.screenshot({ path: '/workspace/test_failure.png' });\n      console.log('\\nScreenshot saved to /workspace/test_failure.png');\n    } catch (e) {}\n  } finally {\n    await browser.close();\n    \n    // Write results to a file for the plan update\n    const fs = require('fs');\n    fs.writeFileSync('/workspace/test_results.txt', \n      `Tests: ${passed} passed, ${failed} failed\\n` +\n      (failed === 0 ? 'ALL TESTS PASSED' : `${failed} test(s) need attention`)\n    );\n    \n    process.exit(failed > 0 ? 1 : 0);\n  }\n})();\n"},"status":"ok","ms":141}
