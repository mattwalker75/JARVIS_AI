n         \"Convert podcast episodes into YouTube video format with AI-generated\\nB-roll, captions, and highlight clips for social media.\")\n    ]\n    \n    conn.executemany(\n        \"INSERT INTO business_products_services (business_id, name, sku, price_amount_cents, is_recurring, description) VALUES (?, ?, ?, ?, ?, ?)\",\n        [(BUSINESS_ID, p[0], p[1], p[2], p[3], p[4]) for p in products_data]\n    )\n\nprint(\"  ✓ Services catalog populated (6 services)\\n\")","new_string":"# Fix prices properly - clear any existing and insert with correct pricing\nwith db() as conn:\n    conn.execute(\"DELETE FROM business_products_services WHERE business_id = ?\", (BUSINESS_ID,))\n    \n    products_data = [\n        (\"YouTube Automation Package\", \"YT-AUTO-01\", 149900, True, \n         \"Full-service YouTube channel management: scriptwriting, voiceover (AI), editing,\\nthumbnails, SEO optimization. 8 videos/month.\"),\n        \n        (\"TikTok Growth Bundle\", \"TT-GROWTH-02\", 89900, True,\n         \"15 short-form TikToks per month with trending audio integration,\\nhook optimization, and growth analytics reporting.\"),\n         \n        (\"AI Video Production (One-Time)\", \"VID-AI-03\", 49700, False,\n         \"Single faceless video: research → script → AI voiceover → editing.\\nPerfect for product launches or one-time campaigns.\"),\n        \n        (\"Content Repurposing Suite\", \"REPURPOSE-04\", 59900, True,\n         \"Turn 1 long-form piece into 30+ short clips across YouTube Shorts,\\nTikTok, Instagram Reels, and LinkedIn carousels.\"),\n         \n        (\"Niche Research & Launch\", \"NICHE-LAUNCH-05\", 249700, False,\n         \"Deep niche analysis: competition mapping, keyword research, content\\ncalendar (3 months), channel setup, first 10 videos produced.\"),\n        \n        (\"Podcast-to-Video Repurpose\", \"PODCAST-VID-06\", 69900, True,\n         \"Convert podcast episodes into YouTube video format with AI-generated\\nB-roll, captions, and highlight clips for social media.\")\n    ]\n    \n    conn.executemany(\n        \"INSERT INTO business_products_services (business_id, name, sku, price_amount_cents, is_recurring, description) VALUES (?, ?, ?, ?, ?, ?)\",\n        [(BUSINESS_ID, p[0], p[1], p[2], p[3], p[4]) for p in products_data]\n    )\n\nprint(\"  ✓ Services catalog populated (6 services)\\n\")"},"status":"ok","ms":145}
