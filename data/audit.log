{"t":"2026-07-26T18:22:09.473Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom_final.py","content":"\"\"\"Final Playwright test for DOOM raycasting game.\"\"\"\nimport sys, time\nfrom playwright.sync_api import sync_playwright\n\ndef run_test():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={\"width\": 1024, \"height\": 768})\n        \n        page = context.new_page()\n        console_messages = []\n        \n        def on_console(msg):\n            try:\n                msg_type = str(getattr(msg, 'type', lambda: 'unknown')()) if callable(getattr(msg, 'type')) else ''\n                msg_text = str(getattr(msg, 'text', lambda: '')()) if callable(getattr(msg, 'text')) else ''\n                console_messages.append({\"type\": msg_type, \"text\": msg_text})\n            except Exception as e:\n                try:\n                    console_messages.append({\"type\": f\"parse:{e}\", \"text\": str(msg)})\n                except: pass\n        \n        page.on(\"console\", on_console)\n        \n        try:\n            # 1. Load the game\n            print(\"[TEST] Loading game at http://localhost:9101...\")\n            page.goto(\"http://localhost:9101/\", timeout=30000)\n            \n            initial_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n            print(f\"[TEST] Initial JS errors before start: {len(initial_errors)}\")\n            results.append(f\"PASS — Page loaded successfully (no load-time JS errors).\" if not initial_errors else f\"WARN — {len(initial_errors)} pre-start console messages.\")\n            \n            # 2. Click the canvas to trigger game start (startScreen overlay)\n            print(\"[TEST] Clicking canvas to start game...\")\n            page.click(\"canvas\", timeout=5000)\n            time.sleep(1)  # Wait for requestAnimationFrame loop to kick in\n            \n            started = page.evaluate(\"\"\"() => {\n                try { return typeof gameStarted !== 'undefined' && !!gameStarted; } catch(e) { return false; }\n            }\"\"\")\n            \n            if started:\n                results.append(\"PASS — Game start triggered (gameStarted=true).\")\n                \n                # 3. Check canvas rendering after start\n                print(\"[TEST] Checking post-start canvas...\")\n                pixel_data = page.evaluate(\"\"\"() => {\n                    const c = document.querySelector('canvas');\n                    if (!c || !c.width) return null;\n                    const ctx = c.getContext('2d');\n                    try {\n                        // Sample multiple positions across the canvas\n                        const w = c.width, h = c.height;\n                        const samples = {};\n                        const positions = [\n                            ['center', Math.floor(w/2), Math.floor(h/2)],\n                            ['ceiling-top', Math.floor(w/4), Math.floor(h*0.15)],\n                            ['floor-bottom', Math.floor(3*w/4), Math.floor(h*0.85)],\n                            ['left-wall', 1, Math.floor(h/2)],\n                            ['right-edge', w-1, Math.floor(h/2)]\n                        ];\n                        for (const [name, x, y] of positions) {\n                            try { samples[name] = Array.from(ctx.getImageData(Math.max(0,x), Math.max(0,y), 1, 1).data.slice()); } catch(e) {}\n                        }\n                        \n                        // Check if any pixel has non-zero values (game is rendering)\n                        let maxVal = 0;\n                        for (const [name, data] of Object.entries(samples)) {\n                            if (Array.isArray(data)) {\n                                const sum = data.slice(0,3).reduce((a,b)=>a+b,0);\n                                if (sum > maxVal) maxVal = sum;\n                            }\n                        }\n                        \n                        return { samples, hasContent: maxVal > 15 };\n                    } catch(e) { return 'error:' + e.message; }\n                }\"\"\")\n                \n                if pixel_data and isinstance(pixel_data, dict):\n                    print(f\"[TEST] Pixel data: hasContent={pixel_data.get('hasContent')}\")\n                    \n                    for name in ['center', 'ceiling-top', 'floor-bottom']:\n                        sample = pixel_data['samples'].get(name)\n                        if isinstance(sample, list):\n                            r, g, b = sample[0], sample[1], sample[2]\n                            print(f\"[TEST] {name}: R={r}, G={g}, B={b}\")\n                    \n                    if pixel_data.get('hasContent'):\n                        results.append(\"PASS — Canvas rendering confirmed (non-black pixels detected).\")\n                        \n                        # Verify sky/ceiling is different from floor/wall\n                        ceiling = pixel_data['samples'].get('ceiling-top')\n                        center = pixel_data['samples'].get('center')\n                        if isinstance(ceiling, list) and isinstance(center, list):\n                            diff = sum(abs(a-b) for a,b in zip(ceiling[:3], center[:3]))\n                            print(f\"[TEST] Ceiling vs Center color difference: {diff}\")\n                            results.append(f\"PASS — Distinct rendering regions detected (color diff={diff}).\")\n                    else:\n                        # Maybe canvas is still initializing; wait longer and retry\n                        time.sleep(2)\n                        pixel_data2 = page.evaluate(\"\"\"() => {\n                            const c = document.querySelector('canvas');\n                            if (!c || !c.width) return null;\n                            const ctx = c.getContext('2d');\n                            try {\n                                const w=c.width, h=c.height;\n                                let maxVal=0;\n                                for(let y=1;y<h-1;y+=Math.max(1,h/10))for(let x=1;x<w-1;x+=Math.max(1,w/5)){\n                                    try{const d=ctx.getImageData(x,y,1,1).data;if(d[0]+d[1]+d[2]>maxVal)maxVal=d[0]+d[1]+d[2];}catch(e){}\n                                }\n                                return {hasContent:maxVal>30};\n                            } catch(e) { return 'error:' + e.message; }\n                        }\"\"\")\n                        \n                        if pixel_data2 and isinstance(pixel_data2, dict):\n                            if pixel_data2.get('hasContent'):\n                                results.append(\"PASS — Canvas rendering confirmed after extended wait.\")\n                            else:\n                                results.append(f\"WARN — Canvas still appears black after {3}s. May need interaction first.\")\n                elif isinstance(pixel_data, str) and 'error' in pixel_data:\n                    results.append(f\"FAIL — Pixel sampling error: {pixel_data}\")\n                \n                # 4. Test keyboard movement (W key = forward)\n                print(\"[TEST] Testing W key press...\")\n                page.keyboard.press(\"KeyW\")\n                time.sleep(0.3)\n                \n                post_w_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n                new_after_w = len(post_w_errors) - len(initial_errors)\n                results.append(f\"PASS — W key processed without JS errors.\" if new_after_w == 0 else f\"WARN — {new_after_w} error(s) after W press.\")\n                \n                # 5. Test shooting (Space)\n                print(\"[TEST] Testing Space (shoot)...\")\n                page.keyboard.press(\"Space\")\n                time.sleep(0.3)\n                \n                post_shoot_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n                new_after_shoot = len(post_shoot_errors) - len(initial_errors)\n                results.append(f\"PASS — Shoot (Space) processed without JS errors.\" if new_after_shoot == 0 else f\"WARN — {new_after_shoot} error(s) after shoot.\")\n                \n                # 6. Test mouse look via pointer lock\n                print(\"[TEST] Testing mouse pointer lock...\")\n                page.click(\"canvas\")\n                time.sleep(0.3)\n                \n                locked = page.evaluate(\"\"\"() => !!document.pointerLockElement\"\"\")\n                if locked:\n                    results.append(\"PASS — Pointer lock acquired (mouse look enabled).\")\n                    \n                    # Simulate mouse movement while locked\n                    page.mouse.move(512, 384)\n                    time.sleep(0.1)\n                    post_mouse_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n                    new_after_mouse = len(post_mouse_errors) - len(initial_errors)\n                    results.append(f\"PASS — Mouse movement processed without JS errors.\" if new_after_mouse == 0 else f\"WARN — {new_after_mouse} error(s) after mouse move.\")\n                else:\n                    results.append(\"WARN — Pointer lock not acquired in headless mode (may be expected).\")\n                \n                # 7. Check UI updates\n                print(\"[TEST] Checking UI elements...\")\n                ui_info = page.evaluate(\"\"\"() => {\n                    try {\n                        const hpEl = document.getElementById('hp');\n                        const ammoEl = document.getElementById('ammo');\n                        return {\n                            hp: hpEl ? hpEl.textContent : null,\n                            ammo: ammoEl ? ammoEl.textContent : null,\n                            uiVisible: !!(hpEl && ammoEl)\n                        };\n                    } catch(e) { return 'error:' + e.message; }\n                }\"\"\")\n                \n                if isinstance(ui_info, dict):\n                    print(f\"[TEST] UI info: {ui_info}\")\n                    results.append(\"PASS — HUD elements (HP/AMMO) present and visible.\")\n                    \n                    # Check that HP/ammo are numeric strings\n                    hp = ui_info.get('hp')\n                    ammo = ui_info.get('ammo')\n                    if hp is not None and ammo is not None:\n                        try:\n                            int(hp); int(ammo)\n                            results.append(f\"PASS — HUD displays valid values (HP={hp}, Ammo={ammo}).\")\n                        except ValueError:\n                            results.append(f\"WARN — HUD values non-numeric (HP='{hp}', Ammo='{ammo}'). May be updating.\")\n                else:\n                    results.append(f\"WARN — Could not read UI info: {ui_info}\")\n                \n            else:\n                results.append(\"FAIL — Game did not start after canvas click. gameStarted may still be false.\")\n                # Check if start screen is visible\n                ss_visible = page.evaluate(\"\"\"() => {\n                    const el = document.getElementById('startScreen');\n                    return !!el && getComputedStyle(el).display !== 'none';\n                }\"\"\")\n                print(f\"[TEST] Start screen visible: {ss_visible}\")\n                \n        except Exception as e:\n            import traceback\n            tb = traceback.format_exc()\n            print(f\"\\n[TEST] EXCEPTION:\\n{tb}\")\n            results.append(f\"FAIL — Test exception: {e}\")\n        \n        finally:\n            browser.close()\n    \n    # Print final summary\n    print(\"\\n\" + \"=\"*50)\n    print(\"FINAL TEST RESULTS\")\n    print(\"=\"*50)\n    for r in results:\n        print(r)\n    \n    passes = [r for r in results if r.startswith(\"PASS\")]\n    warnings = [r for r in results if r.startswith(\"WARN\")]\n    failures = [r for r in results if r.startswith(\"FAIL\")]\n    \n    print(f\"\\n{'='*50}\")\n    print(f\"SUMMARY: {len(passes)} PASS | {len(warnings)} WARN | {len(failures)} FAIL\")\n    print(\"=\"*50)\n    \n    return 0 if not failures else 1\n\nif __name__ == \"__main__\":\n    sys.exit(run_test())\n"},"status":"ok","ms":136}
