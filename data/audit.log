{"t":"2026-07-26T18:19:42.368Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom.py","content":"\"\"\"Comprehensive Playwright test for DOOM-like raycasting FPS game.\"\"\"\nimport sys, time\nfrom playwright.sync_api import sync_playwright\n\ndef run_tests():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 720})\n        \n        page = context.new_page()\n        js_errors = []\n        def on_console(msg):\n            if msg.type == 'error':\n                js_errors.append(msg.text)\n        page.on('console', on_console)\n\n        try:\n            # Test 1: Page loads and returns HTTP 200\n            print(\"TEST 1: Loading game page...\")\n            response = page.goto('http://localhost:9101/', timeout=15000)\n            assert response.status == 200, f\"HTTP {response.status}\"\n            results.append((\"Page loads (HTTP 200)\", True))\n\n            # Test 2: Canvas element exists and has dimensions\n            print(\"TEST 2: Checking canvas...\")\n            page.wait_for_selector('#game', state='attached', timeout=5000)\n            \n            canvas_size = page.evaluate(\"\"\"() => {\n                const c = document.getElementById('game');\n                return {w: c.width, h: c.height};\n            }\"\"\")\n            assert canvas_size['w'] >= 300 and canvas_size['h'] >= 200, \"Canvas too small\"\n            results.append((\"Canvas present with dimensions\", True))\n\n            # Test 3: Start screen exists (check DOM element regardless of visibility)\n            print(\"TEST 3: Checking start screen...\")\n            has_start = page.evaluate(\"\"\"() => !!document.getElementById('startScreen')\"\"\")\n            assert has_start, \"Start screen not in DOM\"\n            results.append((\"Start screen in DOM\", True))\n\n            # Test 4: Click canvas to lock pointer and start game\n            print(\"TEST 4: Starting game...\")\n            page.click('#game')\n            \n            # Wait for pointer lock\n            time.sleep(0.5)\n            \n            started = page.evaluate(\"\"\"() => {\n                return typeof gameStarted !== 'undefined' && gameStarted === true;\n            }\"\"\")\n            results.append((\"Game initialized (started)\", bool(started)))\n\n            # Test 5: Check no JS errors in console after rendering a few frames\n            print(\"TEST 5: Checking for JS errors...\")\n            \n            # Simulate some movement to trigger game logic\n            page.evaluate(\"\"\"() => {\n                const e = new KeyboardEvent('keydown', {'key': 'w'});\n                document.dispatchEvent(e);\n            }\"\"\")\n            \n            time.sleep(1)  # Let frames render\n            \n            results.append((f\"JS console errors: {len(js_errors)}\", len(js_errors) == 0))\n\n            # Test 6: Canvas has been drawn to (check pixel data)\n            print(\"TEST 6: Checking canvas rendering...\")\n            canvas_drawn = page.evaluate(\"\"\"() => {\n                const c = document.getElementById('game');\n                if (!c || !c.width || !c.height) return false;\n                try {\n                    const ctx = c.getContext('2d');\n                    const imgData = ctx.getImageData(10, 10, 5, 5);\n                    let hasPixels = false;\n                    for (let i = 0; i < Math.min(imgData.data.length, 4*50); i += 4) {\n                        if (imgData.data[i] > 30 || imgData.data[i+1] > 30 || imgData.data[i+2] > 30) {\n                            hasPixels = true; break;\n                        }\n                    }\n                    return hasPixels && c.width >= 300 && c.height >= 200;\n                } catch(e) {\n                    return c.width >= 300 && c.height >= 200;\n                }\n            }\"\"\")\n            \n            results.append((\"Canvas rendered with pixel content\", bool(canvas_drawn)))\n\n            # Test 7: HUD elements present in DOM\n            print(\"TEST 7: Checking HUD...\")\n            hp_el = page.query_selector('#hp')\n            ammo_el = page.query_selector('#ammo')\n            hud_ok = hp_el is not None and ammo_el is not None\n            results.append((\"HUD (HP/Ammo) elements present\", hud_ok))\n\n            # Test 8: Enemies initialized in game state\n            print(\"TEST 8: Checking enemy count...\")\n            enemy_count = page.evaluate(\"\"\"() => {\n                return typeof enemies !== 'undefined' ? enemies.length : -1;\n            }\"\"\")\n            results.append((f\"Enemies initialized ({enemy_count} found)\", enemy_count > 0))\n\n            # Test 9: shoot function exists and uses computed distance (Bug 1 fix)\n            print(\"TEST 9: Checking shoot() has en.dist...\")\n            \n            # Check the source code for our fix\n            has_fix = page.evaluate(\"\"\"() => {\n                const scripts = document.querySelectorAll('script');\n                let found = false;\n                for (const s of scripts) {\n                    if (s.textContent.includes('edx=en.x-player.x') && \n                        s.textContent.includes('ed=Math.sqrt(edx*edx+edy*edy)')) {\n                        found = true; break;\n                    }\n                }\n                return found;\n            }\"\"\")\n            \n            results.append((\"Bug 1 fix: shoot() computes en.dist inline\", bool(has_fix)))\n\n            # Test 10: Check minimap renders (bottom-right area)\n            print(\"TEST 10: Checking minimap rendering...\")\n            has_minimap = page.evaluate(\"\"\"() => {\n                const c = document.getElementById('game');\n                if (!c || !c.width) return false;\n                try {\n                    const ctx = c.getContext('2d');\n                    const imgData = ctx.getImageData(c.width - 100, 10, 50, 50);\n                    for (let i = 0; i < Math.min(imgData.data.length, 4*200); i += 4) {\n                        if (imgData.data[i] > 30 && imgData.data[i+1] > 30 && imgData.data[i+2] > 30) return true;\n                    }\n                } catch(e) {}\n                return false;\n            }\"\"\")\n            \n            results.append((\"Minimap area rendered\", bool(has_minimap)))\n\n        except Exception as e:\n            print(f\"TEST ERROR: {e}\")\n            import traceback\n            traceback.print_exc()\n            results.append((f\"Test error: {str(e)}\", False))\n        \n        finally:\n            browser.close()\n\n    # Print summary\n    print(\"\\n\" + \"=\"*60)\n    print(\"PLAYWRIGHT TEST RESULTS\")\n    print(\"=\"*60)\n    \n    all_passed = True\n    for test_name, passed in results:\n        status = \"PASS\" if passed else \"FAIL\"\n        marker = \"[importance: success]\" if passed else \"[importance: attention]\"\n        print(f\"{marker} {status}: {test_name}\")\n        if not passed:\n            all_passed = False\n    \n    if js_errors:\n        print(\"\\n[importance: error] JavaScript console errors:\")\n        for err in js_errors[:5]:\n            print(f\"  - {err[:200]}\")\n    \n    print(\"=\"*60)\n    if all_passed and not js_errors:\n        print(\"[importance: success] ALL TESTS PASSED!\")\n    else:\n        print(\"[importance: attention] Some tests had issues.\")\n    \n    return all_passed\n\nif __name__ == '__main__':\n    run_tests()\n"},"status":"ok","ms":142}
