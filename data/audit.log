{"t":"2026-07-27T02:00:03.469Z","tool":"edit_workbench_file","args":{"path":"/workspace/index.html","old_string":"  // Second row — carriers chart + age distribution + top face amounts\n  const carrierCounts={}; clients.forEach(c=>{ if(c.policy?.carrier){ carrierCounts[c.policy.carrier]=(carrierCounts[c.policy.carrier]||0)+1; }});\n  const sortedCarriers = Object.entries(carrierCounts).sort((a,b)=>b[1]-a[1]).slice(0,8);\n\n  html+=`<div style=\"display:grid; grid-template-columns:1fr 1fr; gap:24px;\">`;\n\n  // Carriers chart\n  if(sortedCarriers.length > 0){\n    html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Clients by Carrier</span></div>\n      <div class=\"chart-container\" style=\"height:260px;\"><canvas id=\"carrierChart\"></canvas></div></div>`;\n  }\n\n  // Top face amounts table\n  const sortedByFace = [...clients].filter(c=>c.policy?.faceAmount).sort((a,b)=>b.policy.faceAmount-a.policy.faceAmount).slice(0,5);\n  html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Top Face Amounts</span></div>`;\n  if(sortedByFace.length===0){ html+='<p style=\"color:var(--text-light);font-size:13px;text-align:center;padding:24px;\">No face amounts recorded yet.</p>'; }\n  else { sortedByFace.forEach((c,i)=>{ html+=`<div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);\">\n    <span style=\"width:24px;height:24px;border-radius:50%;background:${i===0?'var(--accent)':i===1?'#d69e2e':'#edf2f7'};color:white;font-size:11.5px;display:flex;align-items:center;justify-content:center;font-weight:700;\">${i+1}</span>\n    <div style=\"flex:1;\"><strong>${esc(c.firstName+' '+c.lastName)}</strong><br><small style=\"color:var(--text-light)\">${c.policy?.type||''} · ${STAGE_LABELS[c.stage]}</small></div>\n    <div style=\"font-weight:700;color:var(--primary);\">$${(c.policy.faceAmount).toLocaleString()}</div></div>`; }); }\n  html+=`</div></div></div>`;\n\n  document.getElementById('appContent').innerHTML=html;\n\n  // Policy type chart\n  setTimeout(()=>{\n    const ctx=document.getElementById('policyTypeChart'); if(!ctx) return;\n    const types={}; POLICY_TYPES.forEach(t=>types[t]=0); clients.forEach(c=>{ if(c.policy?.type){ types[c.policy.type]=(types[c.policy.type]||0)+1; }});\n    new Chart(ctx,{ type:'doughnut', data:{ labels:Object.keys(types), datasets:[{data:Object.values(types),backgroundColor:['#38a169','#3182ce','#dd6b20','#805ad5','#e53e3e','#4fd1c5'],borderWidth:2,borderColor:'#fff'}] },\n      options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom', labels:{ padding:12, font:{size:11} } } } }});\n\n    // Carrier chart (horizontal bar)\n    const ctx2=document.getElementById('carrierChart'); if(!ctx2) return;\n    new Chart(ctx2,{ type:'bar', data:{ labels:sortedCarriers.map(c=>c[0]), datasets:[{label:'Clients',data:sortedCarriers.map(c=>c[1]),backgroundColor:'#38a169',borderRadius:4,barThickness:24}] },\n      options:{ responsive:true, maintainAspectRatio:false,indexAxis:'y', plugins:{ legend:{display:false} }, scales:{x:{grid:{display:false}}, y:{grid:{display:false},ticks:{font:{size:11}}}}} });\n  },100);","new_string":"  // Second row — monthly acquisition trend + age distribution\n  html+=`<div style=\"display:grid; grid-template-columns:1fr 1fr; gap:24px;\">`;\n\n  // Monthly client acquisition chart (last 6 months)\n  const monthLabels=[]; const monthCounts=[];\n  for(let i=5;i>=0;i--){\n    const d=new Date(); d.setMonth(d.getMonth()-i);\n    monthLabels.push(d.toLocaleDateString('en-US',{month:'short',year:'2-digit'}));\n    const mStart=new Date(d.getFullYear(),d.getMonth(),1).getTime();\n    const mEnd=new Date(d.getFullYear(),d.getMonth()+1,0,23,59,59).getTime();\n    monthCounts.push(clients.filter(c=>{const t=c.createdAt?new Date(c.createdAt).getTime():0;return t>=mStart&&t<=mEnd;}).length);\n  }\n\n  html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Client Acquisition Trend</span></div>\n    <div class=\"chart-container\" style=\"height:260px;\"><canvas id=\"acquisitionChart\"></canvas></div></div>`;\n\n  // Age distribution chart (only if DOB data exists)\n  const agesWithDOB = clients.filter(c=>c.dob).map(c=>{const b=new Date(c.dob);let a=Date.now()/31557600000-b.getFullYear()+new Date().getFullYear();return Math.floor(a)});\n  if(agesWithDOB.length > 0){\n    const ageBuckets={'20-29':0,'30-39':0,'40-49':0,'50-59':0,'60+':0};\n    agesWithDOB.forEach(a=>{if(a>=20&&a<=29)ageBuckets['20-29']++;else if(a>=30&&a<=39)ageBuckets['30-39']++;else if(a>=40&&a<=49)ageBuckets['40-49']++;else if(a>=50&&a<=59)ageBuckets['50-59']++;else ageBuckets['60+']++;});\n    html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Applicant Age Distribution</span></div>\n      <div class=\"chart-container\" style=\"height:260px;\"><canvas id=\"ageChart\"></canvas></div></div>`;\n  } else { html+=`<div class=\"card\"><p style=\"color:var(--text-light);font-size:13px;text-align:center;padding:48px;\">Add DOB data to see age distribution.</p></div>`; }\n\n  // Third row — stage conversion rates + top face amounts\n  html+=`<div style=\"display:grid; grid-template-columns:2fr 1fr; gap:24px;\">`;\n\n  // Stage-to-stage conversion matrix (how many move from each pair)\n  const convPairs=[];\n  for(let i=0;i<STAGES.length-1;i++){\n    const from=STAGES[i];const to=STAGES[i+1];\n    let moved=0,totalInFrom=clients.filter(c=>c.stage===from||c.stageHistory?.some(h=>h.stage===from)).length;\n    clients.forEach(c=>{ if(!c.stageHistory)return; c.stageHistory.slice().reverse(); const idx=c.stageHistory.findIndex(h=>h.stage===from); if(idx>=0&&idx<c.stageHistory.length-1){const next=c.stageHistory[idx+1];if(next?.stage===to)moved++;}});\n    convPairs.push({ from:STAGE_LABELS[from], to:STAGE_LABELS[to], total:totalInFrom, moved });\n  }\n\n  html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Stage Conversion Rates</span></div>`;\n  if(clients.length===0){ html+='<p style=\"color:var(--text-light);font-size:13px;text-align:center;padding:24px;\">Add clients to see conversion data.</p>'; }\n  else {\n    convPairs.forEach(p=>{\n      const rate = p.total>0 ? ((p.moved/p.total)*100).toFixed(0) : '—';\n      html+=`<div style=\"display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);\">`;\n      html+=`<span style=\"width:90px;font-size:12.5px;color:var(--text-light);font-weight:600;text-align:right;\">${p.from}</span>`;\n      html+=`<div style=\"color:var(--primary);font-size:14px;margin-right:8px;\">→</div>`;\n      html+=`<span style=\"width:90px;font-size:12.5px;color:var(--text-light);font-weight:600;text-align:right;\">${p.to}</span>`;\n      if(p.total>0){\n        const barW = Math.max(parseInt(rate),3);\n        html+=`<div style=\"flex:1;background:#edf2f7;border-radius:4px;height:28px;overflow:hidden;display:flex;align-items:center;padding-left:4px;\">`;\n        html+=`<div style=\"width:${barW}%;height:100%;background:${parseInt(rate)>=50?'var(--accent)':parseInt(rate)>=30?'#d69e2e':'var(--danger)'};border-radius:4px;display:flex;align-items:center;padding:0 8px;font-size:11.5px;color:white;font-weight:700;\">${rate}% (${p.moved}/${p.total})</div></div>`;\n      } else { html+=`<span style=\"color:var(--text-light);font-size:12px;padding-left:4px;\">No data yet</span>`; }\n      html+=`</div>`;\n    });\n  }\n  html+=`</div></div>`;\n\n  // Top face amounts table (right column)\n  const sortedByFace = [...clients].filter(c=>c.policy?.faceAmount).sort((a,b)=>b.policy.faceAmount-a.policy.faceAmount).slice(0,5);\n  html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Top Face Amounts</span></div>`;\n  if(sortedByFace.length===0){ html+='<p style=\"color:var(--text-light);font-size:13px;text-align:center;padding:24px;\">No face amounts recorded yet.</p>'; }\n  else { sortedByFace.forEach((c,i)=>{ html+=`<div style=\"display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);\">\n    <span style=\"width:24px;height:24px;border-radius:50%;background:${i===0?'var(--accent)':i===1?'#d69e2e':'#edf2f7'};color:white;font-size:11.5px;display:flex;align-items:center;justify-content:center;font-weight:700;\">${i+1}</span>\n    <div style=\"flex:1;\"><strong>${esc(c.firstName+' '+c.lastName)}</strong><br><small style=\"color:var(--text-light)\">${c.policy?.type||''} · ${STAGE_LABELS[c.stage]}</small></div>\n    <div style=\"font-weight:700;color:var(--primary);\">$${(c.policy.faceAmount).toLocaleString()}</div></div>`; }); }\n  html+=`</div></div></div>`;\n\n  // Fourth row — carriers chart (horizontal bar) if data exists\n  const carrierCounts={}; clients.forEach(c=>{ if(c.policy?.carrier){ carrierCounts[c.policy.carrier]=(carrierCounts[c.policy.carrier]||0)+1; }});\n  const sortedCarriers = Object.entries(carrierCounts).sort((a,b)=>b[1]-a[1]).slice(0,8);\n\n  html+=`<div style=\"display:grid; grid-template-columns:1fr 1fr; gap:24px;\">`;\n\n  if(sortedCarriers.length > 0){\n    html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Clients by Carrier</span></div>\n      <div class=\"chart-container\" style=\"height:260px;\"><canvas id=\"carrierChart\"></canvas></div></div>`;\n\n    // Average premium per carrier chart\n    const carrierPremiums={}; clients.forEach(c=>{ if(c.policy?.carrier&&c.policy.premium){ if(!carrierPremiums[c.policy.carrier])carrierPremiums[c.policy.carrier]=[]; carrierPremiums[c.policy.carrier].push(c.policy.premium); }});\n    const avgCarrierPrem = Object.entries(carrierPremiums).map(([name,vals])=>({name,avg:Math.round(vals.reduce((a,b)=>a+b,0)/vals.length)})).sort((a,b)=>b.avg-a.avg).slice(0,8);\n    if(avgCarrierPrem.length>0){\n      html+=`<div class=\"card\"><div class=\"card-header\"><span class=\"card-title\">Avg Premium by Carrier</span></div>\n        <div class=\"chart-container\" style=\"height:260px;\"><canvas id=\"premiumChart\"></canvas></div></div>`;\n    } else { html+=`<div class=\"card\"><p style=\"color:var(--text-light);font-size:13px;text-align:center;padding:48px;\">Add premium data to see carrier averages.</p></div>`; }\n  }\n\n  document.getElementById('appContent').innerHTML=html;\n\n  // Policy type chart (doughnut)\n  setTimeout(()=>{\n    const ctx=document.getElementById('policyTypeChart'); if(!ctx) return;\n    const types={}; POLICY_TYPES.forEach(t=>types[t]=0); clients.forEach(c=>{ if(c.policy?.type){ types[c.policy.type]=(types[c.policy.type]||0)+1; }});\n    new Chart(ctx,{ type:'doughnut', data:{ labels:Object.keys(types), datasets:[{data:Object.values(types),backgroundColor:['#38a169','#3182ce','#dd6b20','#805ad5','#e53e3e','#4fd1c5'],borderWidth:2,borderColor:'#fff'}] },\n      options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom', labels:{ padding:12, font:{size:11} } } } }});\n\n    // Acquisition trend chart (bar)\n    const ctx3=document.getElementById('acquisitionChart'); if(!ctx3) return;\n    new Chart(ctx3,{ type:'bar', data:{ labels:monthLabels, datasets:[{label:'New Clients',data:monthCounts,backgroundColor:'#3182ce',borderRadius:6,barThickness:20}] },\n      options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{x:{grid:{display:false}}, y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'#f7fafc'}}}}} );\n\n    // Age distribution chart (bar)\n    const ctx4=document.getElementById('ageChart'); if(!ctx4) return;\n    new Chart(ctx4,{ type:'bar', data:{ labels:Object.keys(ageBuckets), datasets:[{label:'Applicants',data:Object.values(ageBuckets),backgroundColor:['#38a169','#3182ce','#dd6b20','#d69e2e','#805ad5'],borderRadius:4,barThickness:32}] },\n      options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{x:{grid:{display:false}}, y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'#f7fafc'}}}}} );\n\n    // Carrier chart (horizontal bar)\n    const ctx2=document.getElementById('carrierChart'); if(!ctx2) return;\n    new Chart(ctx2,{ type:'bar', data:{ labels:sortedCarriers.map(c=>c[0]), datasets:[{label:'Clients',data:sortedCarriers.map(c=>c[1]),backgroundColor:'#38a169',borderRadius:4,barThickness:24}] },\n      options:{ responsive:true, maintainAspectRatio:false,indexAxis:'y', plugins:{ legend:{display:false} }, scales:{x:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'#f7fafc'}}, y:{grid:{display:false}}} }});\n\n    // Premium chart (horizontal bar)\n    const ctx5=document.getElementById('premiumChart'); if(!ctx5) return;\n    new Chart(ctx5,{ type:'bar', data:{ labels:avgCarrierPrem.map(c=>c.name), datasets:[{label:'Avg Monthly Premium ($)',data:avgCarrierPrem.map(c=>c.avg),backgroundColor:'#dd6b20',borderRadius:4,barThickness:28}] },\n      options:{ responsive:true, maintainAspectRatio:false,indexAxis:'y', plugins:{ legend:{display:false} }, scales:{x:{beginAtZero:true,grid:{color:'#f7fafc'}}, y:{grid:{display:false}}} }});\n\n  },100);"},"status":"ok","ms":140}
