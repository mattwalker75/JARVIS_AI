{"t":"2026-07-27T01:54:51.114Z","tool":"edit_workbench_file","args":{"path":"/workspace/index.html","old_string":"    <!-- Age display -->\n    <div style=\"grid-column:1/-1;padding:12px;background:#ebf8ff;border-radius:8px;font-size:13px;color:var(--info);display:none;\" id=\"ageDisplay\"></div>\n  </div>`;\n\n  const footer=`<button class=\"btn btn-outline\" onclick=\"this.closest('.modal-overlay').remove()\">Cancel</button>\n    <button class=\"btn ${isEdit?'btn-primary':'btn-secondary'}\" id=\"f_submit\">${isEdit?'Update Client':'Add Client'}</button>`;\n\n  const overlay=openModal(isEdit?'Edit Client':'New Client', body, footer);\n  document.getElementById('f_submit').onclick=()=>{ submitClient(editId||null); };\n}","new_string":"    <!-- Age display -->\n    <div style=\"grid-column:1/-1;padding:12px;background:#ebf8ff;border-radius:8px;font-size:13px;color:var(--info);display:none;\" id=\"ageDisplay\"></div>\n\n    <!-- Contact History (edit mode only) -->\n    ${isEdit?`<h3 style=\"font-size:15px;color:var(--primary);margin-bottom:0;padding-top:24px;padding-bottom:8px;border-top:2px solid var(--border)\">📞 Contact History</h3>\n    <div id=\"contactHistorySection\" style=\"max-height:200px;overflow-y:auto;margin-bottom:16px;\"></div>\n    <div class=\"form-group\"><label>Add Note</label><textarea id=\"f_contactNote\" rows=\"2\" placeholder=\"Log a phone call, email, or meeting...\"></textarea></div>`:''}\n  </div>`;\n\n  const footer=`<button class=\"btn btn-outline\" onclick=\"this.closest('.modal-overlay').remove()\">Cancel</button>\n    <button class=\"btn ${isEdit?'btn-primary':'btn-secondary'}\" id=\"f_submit\">${isEdit?'Update Client & Save Note':'Add Client'}</button>`;\n\n  const overlay=openModal(isEdit?'Edit Client':'New Client', body, footer);\n  document.getElementById('f_submit').onclick=()=>{ submitClient(editId||null); };\n\n  // Age calculator on DOB change (edit mode)\n  if(isEdit){\n    const dobEl=document.getElementById('f_dob');\n    function calcAge(){\n      const dob=dobEl?.value;\n      const ageDiv=document.getElementById('ageDisplay');\n      if(dob){\n        const birth=new Date(dob);const now=new Date();let age=now.getFullYear()-birth.getFullYear();\n        const m=now.getMonth()-birth.getMonth();if(m<0||(m===0&&now.getDate()<birth.getDate()))age--;\n        ageDiv.style.display='block';ageDiv.innerHTML=`🎂 Age: <strong>${age}</strong> years old (DOB: ${formatDateShort(dob)})`;\n      }else{ageDiv.style.display='none';}\n    }\n    dobEl.addEventListener('input',calcAge);calcAge();\n\n    // Load contact history\n    const ch=document.getElementById('contactHistorySection');\n    if(ch){\n      const contacts=c.contacts||[];\n      if(contacts.length===0){ch.innerHTML='<p style=\"color:var(--text-light);font-size:13px;padding:8px;\">No contact notes yet.</p>';}\n      else{ch.innerHTML=contacts.slice().reverse().map(ct=>`<div style=\"padding:8px 12px;background:#f7fafc;border-radius:6px;margin-bottom:6px;font-size:12.5px;\"><strong>${esc(ct.text)}</strong><br><span style=\"color:var(--text-light)\">${formatDateShort(ct.at)}${ct.type?' · <em>'+esc(ct.type)+'</em>':''}</span></div>`).join('');}\n    }\n  }\n\n  // Age calculator on DOB change (add mode)\n  if(!isEdit){\n    const dobEl=document.getElementById('f_dob');\n    function calcAge(){\n      const dob=dobEl?.value;const ageDiv=document.getElementById('ageDisplay');\n      if(dob){const birth=new Date(dob);const now=new Date();let age=now.getFullYear()-birth.getFullYear();const m=now.getMonth()-birth.getMonth();if(m<0||(m===0&&now.getDate()<birth.getDate()))age--;ageDiv.style.display='block';ageDiv.innerHTML=`🎂 Projected Age: <strong>${age}</strong> years old (DOB: ${formatDateShort(dob)})`;}\n      else{ageDiv.style.display='none';}\n    }dobEl.addEventListener('input',calcAge);\n  }"},"status":"ok","ms":146}
