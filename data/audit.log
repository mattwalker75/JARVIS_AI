{"t":"2026-07-27T03:12:02.466Z","tool":"write_workbench_file","args":{"path":"/workspace/test_all.js","content":"const { chromium } = require('playwright');\nconst http = require('http');\n\n// --- HTTP helper for API tests (no browser needed) ---\nfunction apiRequest(method, path, body = null) {\n  return new Promise((resolve, reject) => {\n    const options = { hostname: 'localhost', port: 9106, method, path };\n    if (body) {\n      options.headers = { 'Content-Type': 'application/json' };\n    }\n    const req = http.request(options, res => {\n      let data = '';\n      res.on('data', chunk => data += chunk);\n      res.on('end', () => {\n        try { resolve({ status: res.statusCode, body: JSON.parse(data) }); }\n        catch (e) { reject(new Error(`Non-JSON response (${res.statusCode}): ${data.substring(0,200)}`)); }\n      });\n    });\n    req.on('error', reject);\n    if (body) req.write(JSON.stringify(body));\n    req.end();\n  });\n}\n\nasync function runTests() {\n  const browser = await chromium.launch({ headless: true });\n  let passed = 0, failed = 0;\n  \n  // ==================== API TESTS ====================\n  console.log('\\n========== API TEST SUITE ==========');\n  \n  // Test 1: Dashboard stats endpoint\n  try {\n    const r = await apiRequest('GET', '/api/dashboard');\n    if (r.status === 200 && r.body.stats) {\n      console.log(`[PASS] GET /api/dashboard - Stats: ${JSON.stringify(r.body.stats).substring(0,150)}...`);\n      passed++;\n    } else {\n      console.log(`[FAIL] Dashboard stats missing. Status=${r.status}, body keys: ${Object.keys(r.body || {})}`);\n      failed++;\n    }\n  } catch(e) { console.log(`[FAIL] GET /api/dashboard - ${e.message}`); failed++; }\n\n  // Test 2: Get clients list (should have seed data)\n  try {\n    const r = await apiRequest('GET', '/api/clients');\n    if (r.status === 200 && Array.isArray(r.body)) {\n      console.log(`[PASS] GET /api/clients - Found ${r.body.length} clients`);\n      passed++;\n    } else {\n      console.log(`[FAIL] Clients list wrong format. Status=${r.status}`); failed++;\n    }\n  } catch(e) { console.log(`[FAIL] GET /api/clients - ${e.message}`); failed++; }\n\n  // Test 3: Get policies (should have seed data)\n  try {\n    const r = await apiRequest('GET', '/api/policies');\n    if (r.status === 200 && Array.isArray(r.body)) {\n      console.log(`[PASS] GET /api/policies - Found ${r.body.length} policies`);\n      passed++;\n    } else {\n      console.log(`[FAIL] Policies list wrong format. Status=${r.status}`); failed++;\n    }\n  } catch(e) { console.log(`[FAIL] GET /api/policies - ${e.message}`); failed++; }\n\n  // Test 4: Get payments (should have seed data)\n  try {\n    const r = await apiRequest('GET', '/api/payments');\n    if (r.status === 200 && Array.isArray(r.body)) {\n      console.log(`[PASS] GET /api/payments - Found ${r.body.length} payments`);\n      passed++;\n    } else {\n      console.log(`[FAIL] Payments list wrong format. Status=${r.status}`); failed++;\n    }\n  } catch(e) { console.log(`[FAIL] GET /api/payments - ${e.message}`); failed++; }\n\n  // Test 5: ADD NEW CLIENT via API\n  try {\n    const newClient = {\n      firstName: 'Test', lastName: 'User789', email: 'testuser789@example.com',\n      phone: '(555) 999-0001', dateOfBirth: '1990-01-01', status: 'active'\n    };\n    const r = await apiRequest('POST', '/api/clients', newClient);\n    if (r.status === 200 && r.body.ok) {\n      console.log(`[PASS] POST /api/clients - Created client id=${r.body.id}`);\n      \n      // Verify it was saved by fetching clients again\n      const verify = await apiRequest('GET', '/api/clients');\n      if (verify.body.some(c => c.email === 'testuser789@example.com')) {\n        console.log(`[PASS] Client verified in database`); passed++;\n      } else {\n        console.log('[FAIL] New client not found after creation'); failed++;\n      }\n    } else {\n      console.log(`[FAIL] POST /api/clients - Status=${r.status}, body: ${JSON.stringify(r.body)}`); failed += 2;\n    }\n  } catch(e) { console.log(`[FAIL] POST /api/clients - ${e.message}`); failed++; }\n\n  // Test 6: ADD NEW POLICY via API (link to our new client)\n  try {\n    const clients = await apiRequest('GET', '/api/clients');\n    const testClient = clients.body.find(c => c.email === 'testuser789@example.com');\n    \n    if (testClient) {\n      const newPolicy = {\n        clientId: testClient.id, type: 'Term Life - 20yr', faceValue: 500000,\n        premiumAmount: 45.99, frequency: 'monthly', startDate: '2026-01-15', status: 'active'\n      };\n      const r = await apiRequest('POST', '/api/policies', newPolicy);\n      if (r.status === 200 && r.body.ok) {\n        console.log(`[PASS] POST /api/policies - Created policy id=${r.body.id}`); passed++;\n        \n        // Verify via GET policies with clientId filter\n        const verify = await apiRequest('GET', `/api/policies?clientId=${testClient.id}`);\n        if (verify.body.length > 0) {\n          console.log(`[PASS] Policy verified for client ${testClient.lastName}`); passed++;\n        } else {\n          console.log('[FAIL] New policy not found via filter'); failed += 2;\n        }\n      } else {\n        console.log(`[FAIL] POST /api/policies - Status=${r.status}, body: ${JSON.stringify(r.body)}`); failed += 2;\n      }\n    } else {\n      console.log('[SKIP] Policy test (client not found for linking)');\n    }\n  } catch(e) { console.log(`[FAIL] POST /api/policies - ${e.message}`); failed++; }\n\n  // Test 7: RECORD PAYMENT via API\n  try {\n    const policies = await apiRequest('GET', '/api/policies');\n    if (policies.body.length > 0) {\n      const policy = policies.body[0];\n      const newPayment = {\n        policyId: policy.id, clientId: policy.clientId, amount: policy.premiumAmount,\n        dueDate: '2026-08-15', status: 'paid', paymentMethod: 'bank_transfer'\n      };\n      const r = await apiRequest('POST', '/api/payments', newPayment);\n      if (r.status === 200 && r.body.ok) {\n        console.log(`[PASS] POST /api/payments - Created payment id=${r.body.id}`); passed++;\n        \n        // Verify via GET payments with filter\n        const verify = await apiRequest('GET', `/api/payments?clientId=${policy.clientId}`);\n        if (verify.body.some(p => p.status === 'paid')) {\n          console.log(`[PASS] Payment verified as paid`); passed++;\n        } else {\n          console.log('[FAIL] New payment not found via filter'); failed += 2;\n        }\n      } else {\n        console.log(`[FAIL] POST /api/payments - Status=${r.status}, body: ${JSON.stringify(r.body)}`); failed += 2;\n      }\n    } else {\n      console.log('[SKIP] Payment test (no policies found)');\n    }\n  } catch(e) { console.log(`[FAIL] POST /api/payments - ${e.message}`); failed++; }\n\n  // Test 8: UPDATE CLIENT via API\n  try {\n    const clients = await apiRequest('GET', '/api/clients');\n    if (clients.body.length > 0) {\n      const client = clients.body[0];\n      const r = await apiRequest('PUT', `/api/clients/${client.id}`, { status: 'active' });\n      if (r.status === 200 && r.body.ok) {\n        console.log(`[PASS] PUT /api/clients/:id - Updated client ${client.lastName}`); passed++;\n        \n        // Verify update persisted\n        const verify = await apiRequest('GET', `/api/clients/${client.id}/detail`);\n        if (verify.status === 200 && verify.body.client) {\n          console.log(`[PASS] Client detail verified after update`); passed++;\n        } else {\n          console.log('[FAIL] Client detail not found after update'); failed += 2;\n        }\n      } else {\n        console.log(`[FAIL] PUT /api/clients/:id - Status=${r.status}`); failed += 2;\n      }\n    }\n  } catch(e) { console.log(`[FAIL] PUT /api/clients/:id - ${e.message}`); failed++; }\n\n  // Test 9: UPDATE PAYMENT STATUS via API (mark as paid if pending)\n  try {\n    const payments = await apiRequest('GET', '/api/payments');\n    let targetPayment = null;\n    \n    // Find a non-paid payment to update, or use the one we just created\n    for (const p of payments.body || []) {\n      if (p.status !== 'paid') { targetPayment = p; break; }\n    }\n    if (!targetPayment && payments.body.length > 0) {\n      // Use any payment and update its status to paid\n      targetPayment = payments.body[payments.body.length - 1];\n    }\n    \n    if (targetPayment) {\n      const r = await apiRequest('PUT', `/api/payments/${targetPayment.id}`, { \n        status: 'paid', paidDate: new Date().toISOString().split('T')[0] \n      });\n      if (r.status === 200 && r.body.ok) {\n        console.log(`[PASS] PUT /api/payments/:id - Updated payment ${targetPayment.id} to paid`); passed++;\n        \n        // Verify via GET payments?status=pending or ?clientId filter\n        const verify = await apiRequest('GET', `/api/payments?clientId=${targetPayment.clientId}`);\n        if (verify.body.some(p => p.status === 'paid')) {\n          console.log(`[PASS] Payment status update verified`); passed++;\n        } else {\n          console.log('[FAIL] Updated payment not found'); failed += 2;\n        }\n      } else {\n        console.log(`[FAIL] PUT /api/payments/:id - Status=${r.status}`); failed += 2;\n      }\n    } else {\n      console.log('[SKIP] Payment update test (no payments to modify)');\n    }\n  } catch(e) { console.log(`[FAIL] PUT /api/payments/:id - ${e.message}`); failed++; }\n\n  // Test 10: DELETE CLIENT via API\n  try {\n    const clients = await apiRequest('GET', '/api/clients');\n    if (clients.body.length > 2) { // Don't delete first seed client\n      const toDelete = [...clients.body].reverse().find(c => c.email !== 'testuser789@example.com' && !c.firstName.startsWith('Test'));\n      if (toDelete) {\n        const r = await apiRequest('DELETE', `/api/clients/${toDelete.id}`);\n        if (r.status === 200 && r.body.ok) {\n          console.log(`[PASS] DELETE /api/clients/:id - Deleted client ${toDelete.lastName} id=${toDelete.id}`); passed++;\n          \n          // Verify deletion and cascading policy/payment removals\n          const verify = await apiRequest('GET', '/api/clients');\n          if (!verify.body.some(c => c.id === toDelete.id)) {\n            console.log(`[PASS] Client deleted from database`); passed++;\n            \n            // Check policies were also removed (cascading delete)\n            const policyCheck = await apiRequest('GET', `/api/policies?clientId=${toDelete.id}`);\n            if (policyCheck.body.length === 0) {\n              console.log(`[PASS] Related policies cascaded deleted`); passed++;\n            } else {\n              console.log('[FAIL] Policies not cascaded deleted'); failed += 2;\n            }\n          } else {\n            console.log('[FAIL] Client still exists after delete'); failed += 2;\n          }\n        } else {\n          console.log(`[FAIL] DELETE /api/clients/:id - Status=${r.status}`); failed += 2;\n        }\n      } else {\n        // Delete the test client we created earlier (it's safe)\n        const tc = clients.body.find(c => c.email === 'testuser789@example.com');\n        if (tc) {\n          const r = await apiRequest('DELETE', `/api/clients/${tc.id}`);\n          console.log(`[PASS] DELETE /api/clients/:id - Cleaned up test client`); passed++;\n        } else {\n          console.log('[SKIP] Delete test'); failed += 2;\n        }\n      }\n    }\n  } catch(e) { console.log(`[FAIL] DELETE /api/clients/:id - ${e.message}`); failed++; }\n\n  // ==================== UI TESTS (Playwright browser) ====================\n  console.log('\\n========== UI TEST SUITE ==========');\n  \n  const page = await browser.newPage();\n  \n  try {\n    // Test 11: Load dashboard and verify it renders\n    await page.goto('http://localhost:9106/');\n    await page.waitForTimeout(2000); // Let JS execute\n    \n    const pageTitle = await page.title();\n    if (pageTitle.includes('LifeShield') || pageTitle.includes('Dashboard')) {\n      console.log(`[PASS] Dashboard loads - Title: \"${pageTitle}\"`); passed++;\n      \n      // Check that stats cards rendered\n      const hasStatsCards = await page.evaluate(() => document.querySelectorAll('.stat-card').length > 0);\n      if (hasStatsCards) {\n        console.log('[PASS] Stats cards are visible on dashboard'); passed++;\n        \n        // Verify actual stat values loaded from API\n        const statsContent = await page.evaluate(() => {\n          return Array.from(document.querySelectorAll('#dash-stats .stat-card')).map(el => el.textContent.trim());\n        });\n        if (statsContent.length > 0 && !statsContent[0].includes('Loading')) {\n          console.log(`[PASS] Stats populated with real data: ${JSON.stringify(statsContent).substring(0,200)}`); passed++;\n        } else {\n          console.log('[FAIL] Stats cards not properly loaded'); failed += 3;\n        }\n      } else {\n        // Check if there's a JS error preventing rendering\n        const errors = await page.evaluate(() => JSON.stringify(window.__jsErrors || []));\n        console.log(`[WARN] No stats cards found. Page body: ${await page.evaluate(() => document.body.innerText.substring(0,500))}`); failed += 2;\n      }\n    } else {\n      console.log(`[FAIL] Dashboard title wrong: \"${pageTitle}\"`); failed++;\n    }\n    \n    // Test 12: Navigate to Clients tab and verify table loads\n    await page.click('[data-page=\"clients\"]');\n    await page.waitForTimeout(500);\n    \n    const clientsTabVisible = await page.evaluate(() => {\n      return document.getElementById('page-clients').classList.contains('active');\n    });\n    if (clientsTabVisible) {\n      console.log('[PASS] Clients tab navigation works'); passed++;\n      \n      // Check table renders with data rows or empty state\n      const hasTableOrEmpty = await page.evaluate(() => \n        document.getElementById('clients-table') || document.getElementById('clients-empty'));\n      if (hasTableOrEmpty) {\n        console.log('[PASS] Clients section shows table/empty state'); passed++;\n        \n        // Count visible rows in the table body  \n        const rowCount = await page.$$eval('#clients-table tr', rows => rows.length);\n        console.log(`[INFO] Client table has ${rowCount} data rows`);\n      } else {\n        console.log('[FAIL] Clients section missing'); failed++;\n      }\n    } else {\n      console.log('[FAIL] Clients tab not active after click'); failed++;\n    }\n\n    // Test 13: Navigate to Policies tab and verify table loads  \n    await page.click('[data-page=\"policies\"]');\n    await page.waitForTimeout(500);\n    \n    const policiesTabVisible = await page.evaluate(() => \n      document.getElementById('page-policies').classList.contains('active'));\n    if (policiesTabVisible) {\n      console.log('[PASS] Policies tab navigation works'); passed++;\n      \n      const hasPolicyTableOrEmpty = await page.evaluate(() => \n        document.getElementById('policies-table') || document.getElementById('policies-empty'));\n      if (hasPolicyTableOrEmpty) {\n        console.log('[PASS] Policies section shows table/empty state'); passed++;\n        \n        const policyRowCount = await page.$$eval('#policies-table tr', rows => rows.length);\n        console.log(`[INFO] Policy table has ${policyRowCount} data rows`);\n      } else {\n        console.log('[FAIL] Policies section missing'); failed++;\n      }\n    } else {\n      console.log('[FAIL] Policies tab not active after click'); failed++;\n    }\n\n    // Test 14: Navigate to Payments tab and verify table loads\n    await page.click('[data-page=\"payments\"]');\n    await page.waitForTimeout(500);\n    \n    const paymentsTabVisible = await page.evaluate(() => \n      document.getElementById('page-payments').classList.contains('active'));\n    if (paymentsTabVisible) {\n      console.log('[PASS] Payments tab navigation works'); passed++;\n      \n      const hasPaymentTableOrEmpty = await page.evaluate(() => \n        document.getElementById('payments-table') || document.getElementById('payments-empty'));\n      if (hasPaymentTableOrEmpty) {\n        console.log('[PASS] Payments section shows table/empty state'); passed++;\n        \n        const paymentRowCount = await page.$$eval('#payments-table tr', rows => rows.length);\n        console.log(`[INFO] Payment table has ${paymentRowCount} data rows`);\n      } else {\n        console.log('[FAIL] Payments section missing'); failed++;\n      }\n    } else {\n      console.log('[FAIL] Payments tab not active after click'); failed++;\n    }\n\n    // Test 15: Open Add Client modal and verify form fields exist\n    await page.click('button.btn-primary', { timeout: 3000 }).catch(() => {}); // Try any primary button\n    \n    const clientModalOpen = await page.evaluate(() => \n      document.getElementById('client-modal')?.classList.contains('show'));\n    \n    if (clientModalOpen) {\n      console.log('[PASS] Add Client modal opens'); passed++;\n      \n      // Verify form fields exist in the modal\n      const hasFields = await page.evaluate(() => {\n        return !!document.getElementById('cf-first') && \n               !!document.getElementById('cf-last') && \n               !!document.getElementById('cf-email') && \n               !!document.getElementById('cf-phone');\n      });\n      \n      if (hasFields) {\n        console.log('[PASS] Client form has all required fields'); passed++;\n        \n        // Close modal\n        await page.click('#client-modal .modal-close');\n        await page.waitForTimeout(300);\n        \n        const closed = await page.evaluate(() => \n          !document.getElementById('client-modal')?.classList.contains('show'));\n        if (closed) {\n          console.log('[PASS] Client modal closes properly'); passed++;\n        } else {\n          console.log('[FAIL] Client modal did not close'); failed += 2;\n        }\n      } else {\n        console.log('[FAIL] Client form missing required fields'); failed += 2;\n      }\n    } else {\n      // Try clicking the specific \"Add New Client\" button text\n      const addBtn = await page.$('text=Add New Client') || await page.$('.btn-primary:has-text(\"Add\")');\n      if (addBtn) {\n        await addBtn.click();\n        await page.waitForTimeout(500);\n        \n        const clientModalOpen2 = await page.evaluate(() => \n          document.getElementById('client-modal')?.classList.contains('show'));\n        if (clientModalOpen2) {\n          console.log('[PASS] Add Client modal opens via button click'); passed++;\n          \n          // Close and continue\n          await page.click('#client-modal .modal-close').catch(() => {});\n          await page.waitForTimeout(300);\n        } else {\n          console.log(`[FAIL] Modal not showing. Body preview: ${await page.evaluate(() => document.body.innerText.substring(0,400))}`); failed += 2;\n        }\n      } else {\n        console.log('[WARN] Could not find Add Client button on Clients tab'); \n      }\n    }\n\n    // Test 16: Open Register Policy modal from Policies page\n    await page.click('[data-page=\"policies\"]');\n    await page.waitForTimeout(300);\n    \n    const policyModalBtn = await page.$('text=Register New Policy') || await page.$('.btn-primary', { timeout: 2000 }).catch(() => null);\n    if (policyModalBtn) {\n      await policyModalBtn.click();\n      await page.waitForTimeout(500);\n      \n      const policyModalOpen = await page.evaluate(() => \n        document.getElementById('policy-modal')?.classList.contains('show'));\n      if (policyModalOpen) {\n        console.log('[PASS] Register Policy modal opens'); passed++;\n        \n        // Verify client dropdown exists in the form\n        const hasClientSelect = await page.evaluate(() => !!document.getElementById('pf-client'));\n        if (hasClientSelect) {\n          console.log('[PASS] Policy form has client selection dropdown'); passed++;\n          \n          // Close modal\n          await page.click('#policy-modal .modal-close').catch(() => {});\n          await page.waitForTimeout(300);\n        } else {\n          console.log('[FAIL] Policy form missing client select'); failed += 2;\n        }\n      } else {\n        const bodyPreview = await page.evaluate(() => document.body.innerText.substring(0,400));\n        console.log(`[WARN] Policy modal not showing. Body: ${bodyPreview}`); \n      }\n    }\n\n    // Test 17: Open Record Payment modal from Payments page  \n    await page.click('[data-page=\"payments\"]');\n    await page.waitForTimeout(300);\n    \n    const paymentModalBtn = await page.$('text=Record Payment') || await page.$('.btn-success', { timeout: 2000 }).catch(() => null);\n    if (paymentModalBtn) {\n      await paymentModalBtn.click();\n      await page.waitForTimeout(500);\n      \n      const payModalOpen = await page.evaluate(() => \n        document.getElementById('payment-modal')?.classList.contains('show'));\n      if (payModalOpen) {\n        console.log('[PASS] Record Payment modal opens'); passed++;\n        \n        // Close modal\n        await page.click('#payment-modal .modal-close').catch(() => {});\n        await page.waitForTimeout(300);\n      } else {\n        const bodyPreview = await page.evaluate(() => document.body.innerText.substring(0,400));\n        console.log(`[WARN] Payment modal not showing. Body: ${bodyPreview}`); \n      }\n    }\n\n  } catch(e) {\n    console.log(`[FAIL] UI test error - ${e.message}`); failed++;\n    \n    // Take screenshot for debugging\n    try { await page.screenshot({ path: '/workspace/test_ui_error.png', fullPage: true }); } catch(_) {}\n  } finally {\n    await browser.close();\n  }\n\n  // ==================== SUMMARY ====================\n  console.log('\\n========== TEST RESULTS ==========');\n  console.log(`Passed: ${passed}`);\n  console.log(`Failed: ${failed}`);\n  console.log(`Total:  ${passed + failed}`);\n  \n  if (failed === 0) {\n    console.log('ALL TESTS PASSED! ✅');\n  } else {\n    console.log(`${failed} test(s) FAILED ❌`);\n  }\n\n  return { passed, failed };\n}\n\nrunTests().catch(e => {\n  console.error('Test runner error:', e.message);\n});\n"},"status":"ok","ms":139}
