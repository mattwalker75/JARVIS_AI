xn_date, txn_year, txn_type, counterparty, amount_cents, notes)\n        VALUES (?, ?, CAST(strftime('%Y', ?) AS INTEGER), ?, ?, ?, 'Auto-generated historical entry')\"\"\",\n        (2, txn_date[:4], txn_date, txn_type, counterparty, amount_cents))\n\n# === UPDATE BUDGET for 2026 with realistic projections ===\nbudget_2026 = [\n    ('Revenue', 'YouTube Faceless Services', 5987000),\n    ('Revenue', 'TikTok/Shorts Automation', 1499000),\n    ('Revenue', 'One-Time Setup Fees', 340000),\n    ('Operating Expense', 'Pictory AI Enterprise', 154800),\n    ('Operating Expense', 'ElevenLabs Premium', 69600),\n    ('Operating Expense', 'Google Workspace', 86400),\n    ('Operating Expense', 'Contract Editors & Writers', 2376000),\n]\n\nfor type_key, category, planned_cents in budget_2026:\n    cur.execute(\"\"\"INSERT INTO budget_entries \n        (business_id, year, type_key, category, planned_cents)\n        VALUES (?, 2026, ?, ?, ?)\"\"\",\n        (2, type_key, category, planned_cents))\n\nconn.commit()\n\n# Verify counts\nprint('=== VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_capital_accounts WHERE business_id = 2\")\nprint(f'Capital accounts: {cur.fetchone()[0]}')\ncur.execute(\"SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE is_active = 1 AND business_id = 2\")\ntotal_monthly = cur.fetchone()[0] or 0\nprint(f'Total monthly recurring expenses (cents): {total_monthly} (${total_monthly/100:.2f})')\ncur.execute(\"SELECT COUNT(*) FROM recurring_bills WHERE business_id = 2 AND active = 1\")\nprint(f'Recurring bills: {cur.fetchone()[0]}')\ncur.execute(\"SELECT COUNT(*) FROM ledger_transactions WHERE business_id = 2\")\nprint(f'Ledger transactions total: {cur.fetchone()[0]}')\ncur.execute(\"SELECT COUNT(*) FROM budget_entries WHERE business_id = 2 AND year = 2026\")\nprint(f'Budget entries for 2026: {cur.fetchone()[0]}')\n\n# Calculate projected annual revenue vs expenses\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Revenue', 'Income')\"\"\")\nrev = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Revenue: ${rev/100:.2f}')\n\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Operating Expense', 'Expense')\"\"\")\nexp = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Expenses: ${exp/100:.2f}')\nprint(f'Projected 2026 Net Income: ${(rev-exp)/100:.2f} ({((rev-exp)*100)//rev}% margin)')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":132}
