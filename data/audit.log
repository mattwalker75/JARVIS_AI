{"t":"2026-07-27T04:47:48.269Z","tool":"run_shell","args":{"command":"cat << 'PYEOF' > /workspace/test_pictures.py\nimport subprocess, json, base64, os\n\n# Read a test image as base64 data URL\nimg_path = '/workspace/test_images/mountain.jpg'\nwith open(img_path, 'rb') as f:\n    img_data = f.read()\n\nb64 = base64.b64encode(img_data).decode('ascii')\ndata_url = f'data:image/jpeg;base64,{b64}'\n\n# Create a test runner HTML that loads picture_viewer.html's IndexedDB and tests everything\ntest_html = '''<!DOCTYPE html>\n<html><head><title>PicViewer Test</title></head><body>\n<pre id=\"out\"></pre>\n<script>\nconst DB_NAME='PictureViewerDB'; const STORE='images';\n\nfunction log(msg) { document.getElementById('out').textContent += msg + '\\\\n'; }\n\nasync function openDB() {\n  return new Promise((resolve, reject) => {\n    const req = indexedDB.open(DB_NAME, 1);\n    req.onupgradeneeded = e => {\n      const d = e.target.result;\n      if (!d.objectStoreNames.contains(STORE)) {\n        const s = d.createObjectStore(STORE, { keyPath: 'id' });\n        s.createIndex('timestamp', 'timestamp');\n      }\n    };\n    req.onsuccess = () => resolve(req.result);\n    req.onerror = () => reject(req.error);\n  });\n}\n\nasync function test() {\n  try {\n    // Clear any existing data first\n    let db = await openDB();\n    \n    // Step 1: Delete all existing images  \n    log('Step 1: Cleaning up...');\n    const tx1 = db.transaction(STORE, 'readwrite');\n    tx1.objectStore(STORE).clear();\n    await new Promise((r,j) => { tx1.oncomplete=r; tx1.onerror=j; });\n    \n    // Step 2: Save an image to IndexedDB  \n    log('Step 2: Saving test image...');\n    const imgData = '\" + data_url.replace(/\"/g, '&quot;') + \"';\n    const id = 'test_' + Date.now();\n    const tx2 = db.transaction(STORE, 'readwrite');\n    tx2.objectStore(STORE).add({ \n      id: id, \n      name: 'mountain_test.jpg', \n      dataUrl: imgData, \n      timestamp: Date.now() \n    });\n    await new Promise((r,j) => { tx2.oncomplete=r; tx2.onerror=j; });\n    log('  Saved with id=' + id);\n    \n    // Step 3: Retrieve all images  \n    log('Step 3: Retrieving all images...');\n    const tx3 = db.transaction(STORE, 'readonly');\n    const req3 = tx3.objectStore(STORE).getAll();\n    const results = await new Promise((r,j) => { \n      req3.onsuccess = () => r(req3.result); \n      req3.onerror = j; \n    });\n    \n    if (results.length !== 1) throw 'Expected 1 image, got ' + results.length;\n    log('  Found ' + results.length + ' image(s) ✓');\n    log('  Name: ' + results[0].name);\n    log('  Data URL length: ' + results[0].dataUrl.length + ' chars');\n    \n    // Step 4: Verify data integrity  \n    log('Step 4: Verifying data...');\n    if (results[0].id !== id) throw 'ID mismatch';\n    if (!results[0].name.includes('mountain')) throw 'Name check failed';\n    if (!results[0].dataUrl.startsWith('data:image/jpeg;base64,')) throw 'Data URL format wrong';\n    \n    // Decode and verify size matches original  \n    const tx4 = db.transaction(STORE, 'readonly');\n    const req4 = tx4.objectStore(STORE).get(id);\n    const retrieved = await new Promise((r,j) => { \n      req4.onsuccess = () => r(req4.result); \n      req4.onerror = j; \n    });\n    \n    // Compare the base64 portion (strip data URL prefix for comparison)  \n    const origB64 = imgData.replace('data:image/jpeg;base64,', '');\n    const retB64 = retrieved.dataUrl.replace('data:image/jpeg;base64,', '');\n    if (origB64 === retB64) {\n      log('  Data integrity verified ✓');\n    } else {\n      throw 'Data mismatch after retrieval';\n    }\n    \n    // Step 5: Delete the image  \n    log('Step 5: Deleting test image...');\n    const tx5 = db.transaction(STORE, 'readwrite');\n    tx5.objectStore(STORE).delete(id);\n    await new Promise((r,j) => { tx5.oncomplete=r; tx5.onerror=j; });\n    \n    // Verify deletion  \n    const tx6 = db.transaction(STORE, 'readonly');\n    const req6 = tx6.objectStore(STORE).getAll();\n    const afterDel = await new Promise((r,j) => { \n      req6.onsuccess = () => r(req6.result); \n      req6.onerror = j; \n    });\n    \n    if (afterDel.length !== 0) throw 'Expected 0 images after delete, got ' + afterDel.length;\n    log('  Image deleted and verified empty ✓');\n    \n    // Step 6: Multiple image test  \n    log('Step 6: Testing multiple images...');\n    const ids = [];\n    for (let i = 0; i < 3; i++) {\n      const mid = 'multi_' + Date.now() + '_' + i;\n      const tx7 = db.transaction(STORE, 'readwrite');\n      tx7.objectStore(STORE).add({ \n        id: mid, name: 'test_' + i + '.jpg', \n        dataUrl: imgData, timestamp: Date.now() - (2-i) // ensure ordering  \n      });\n      await new Promise((r,j) => { tx7.oncomplete=r; tx7.onerror=j; });\n      ids.push(mid);\n    }\n    \n    const tx8 = db.transaction(STORE, 'readonly');\n    const req8 = tx8.objectStore(STORE).getAll();\n    const multiResults = await new Promise((r,j) => { \n      req8.onsuccess = () => r(req8.result); \n      req8.onerror = j; \n    });\n    \n    if (multiResults.length !== 3) throw 'Expected 3 images, got ' + multiResults.length;\n    log('  Stored and retrieved 3 images ✓');\n    \n    // Verify sorting by timestamp desc  \n    for (let i = 0; i < multiResults.length - 1; i++) {\n      if (multiResults[i].timestamp < multiResults[i+1].timestamp) {\n        throw 'Sort order wrong at index ' + i;\n      }\n    }\n    log('  Sort order verified ✓');\n    \n    // Cleanup  \n    const tx9 = db.transaction(STORE, 'readwrite');\n    tx9.objectStore(STORE).clear();\n    await new Promise((r,j) => { tx9.oncomplete=r; tx9.onerror=j; });\n    \n    log('\\\\n=== ALL TESTS PASSED ===');\n  } catch(e) {\n    log('\\\\nTEST FAILED: ' + e);\n  }\n}\n\ntest();\n</script></body></html>'''\n\n# Write test runner  \nwith open('/workspace/test_runner.html', 'w') as f:\n    f.write(test_html)\n\nprint(\"Test runner created. Launching browser...\")\nsubprocess.Popen(['chromium', '--headless', '--no-sandbox', \n                   '--disable-gpu', '--remote-debugging-port=9222',\n                   '/workspace/test_runner.html'])\nPYEOF\npython3 /workspace/test_pictures.py\n","timeout_s":15},"status":"ok","ms":2133}
{"t":"2026-07-27T04:47:55.056Z","tool":"run_shell","args":{"command":"cat << 'PYEOF' > /workspace/test_pictures.py\nimport base64, os\n\n# Read all test images as data URLs  \ntest_images = {}\nimg_dir = '/workspace/test_images/'\nfor fname in sorted(os.listdir(img_dir)):\n    fpath = os.path.join(img_dir, fname)\n    with open(fpath, 'rb') as f:\n        img_data = base64.b64encode(f.read()).decode('ascii')\n    ext = os.path.splitext(fname)[1].replace('.','')\n    mime_map = {'jpg':'jpeg', 'png':'png'}\n    test_images[fname] = f'data:image/{mime_map.get(ext, \"octet-stream\")};base64,{img_data}'\n\n# Write a JSON file with all image data for the playwright script  \nimport json\nwith open('/workspace/test_image_data.json', 'w') as f:\n    json.dump(test_images, f)\n\nprint(f\"Prepared {len(test_images)} test images\")\nPYEOF\npython3 /workspace/test_pictures.py\n","timeout_s":10},"status":"ok","ms":134}
