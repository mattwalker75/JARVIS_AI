{"t":"2026-07-28T18:50:57.744Z","tool":"write_file","args":{"path":"/READ_WRITE_FILES/engine.js","content":"import Monster from './monsters.js';\nimport map from './map.js';\n\n// Initialize player object\nconst player = {\n  x: 2,\n  y: 2,\n  angle: 0,\n  speed: 0.05,\n  turnSpeed: 0.03,\n  health: 10,\n  shooting: false,\n  takeDamage: function(dmg) {\n    this.health -= dmg;\n    const healthDiv = document.getElementById('health');\n    if(this.health <= 0) {\n      this.health = 0;\n      healthDiv.textContent = 'Health: 0 - You died!';\n      console.log('Player died!');\n      // Could implement game over logic here\n    } else {\n      healthDiv.textContent = 'Health: ' + this.health;\n      console.log('Player health:', this.health);\n    }\n  }\n};\n\nconst monsters = [\n  new Monster(5.5, 4.5, {isWall: (x, y) => {\n    if (x < 0 || y < 0 || y >= map.length || x >= map[0].length) return true;\n    return map[Math.floor(y)][Math.floor(x)] === 1;\n  }}),\n  new Monster(3.5, 5.5, {isWall: (x, y) => {\n    if (x < 0 || y < 0 || y >= map.length || x >= map[0].length) return true;\n    return map[Math.floor(y)][Math.floor(x)] === 1;\n  }})\n];\n\nfunction updateMonsters() {\n  monsters.forEach(monster => {\n    if (!monster.alive) return;\n    monster.update();\n\n    // Check if monster is close enough to attack player\n    const dx = monster.x - player.x;\n    const dy = monster.y - player.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    if (dist < 0.6) {\n      player.takeDamage(1);\n    }\n  });\n}\n\n// Modify update function to include monsters update and draw\nconst oldUpdate = update;\nfunction update() {\n  // Movement controls\n  if(keys['ArrowUp'] || keys['w']) {\n    const newX = player.x + Math.cos(player.angle) * player.speed;\n    const newY = player.y + Math.sin(player.angle) * player.speed;\n    if(map[Math.floor(newY)][Math.floor(newX)] === 0) {\n      player.x = newX;\n      player.y = newY;\n    }\n  }\n  if(keys['ArrowDown'] || keys['s']) {\n    const newX = player.x - Math.cos(player.angle) * player.speed;\n    const newY = player.y - Math.sin(player.angle) * player.speed;\n    if(map[Math.floor(newY)][Math.floor(newX)] === 0) {\n      player.x = newX;\n      player.y = newY;\n    }\n  }\n  if(keys['ArrowLeft'] || keys['a']) {\n    player.angle -= player.turnSpeed;\n  }\n  if(keys['ArrowRight'] || keys['d']) {\n    player.angle += player.turnSpeed;\n  }\n\n  castRays();\n\n  updateMonsters();\n\n  monsters.forEach(monster => monster.draw(ctx, player));\n\n  // Shooting effect\n  if(player.shooting) {\n    // Flash the weapon image briefly\n    weaponImg.style.filter = 'brightness(2)';\n    setTimeout(() => {\n      weaponImg.style.filter = '';\n    }, 100);\n  }\n\n  requestAnimationFrame(update);\n}\n"},"status":"ok","ms":6}
{"t":"2026-07-28T18:50:57.745Z","tool":"write_file","args":{"path":"/READ_WRITE_FILES/monsters.js","content":"// monsters.js - Implement monsters that chase and attack the player\n\nclass Monster {\n  constructor(x, y, game) {\n    this.x = x;\n    this.y = y;\n    this.game = game;\n    this.speed = 0.02; // Movement speed\n    this.size = 0.5; // For collision and drawing\n    this.health = 3;\n    this.alive = true;\n  }\n\n  update() {\n    if (!this.alive) return;\n\n    // Simple chasing AI: move towards player if no collision\n    const dx = this.game.player.x - this.x;\n    const dy = this.game.player.y - this.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n\n    if (dist > 0.1) { // Stop close to player\n      const nx = dx / dist;\n      const ny = dy / dist;\n\n      // Check collision with walls\n      const newX = this.x + nx * this.speed;\n      const newY = this.y + ny * this.speed;\n\n      if (!this.game.isWall(newX, this.y)) this.x = newX;\n      if (!this.game.isWall(this.x, newY)) this.y = newY;\n    }\n\n    // Attack player if close\n    if (dist < 0.6) {\n      this.game.player.takeDamage(1);\n    }\n  }\n\n  draw(ctx, player) {\n    if (!this.alive) return;\n\n    // Draw monster as a simple red square or circle in 3D space using raycasting depth\n    // We'll project the monster's position relative to player to screen space\n\n    const dx = this.x - player.x;\n    const dy = this.y - player.y;\n\n    const angle = Math.atan2(dy, dx) - player.dir;\n\n    // Normalize angle to -PI..PI\n    let a = angle;\n    while (a > Math.PI) a -= 2 * Math.PI;\n    while (a < -Math.PI) a += 2 * Math.PI;\n\n    // Only draw if in front of player (angle near 0)\n    if (Math.abs(a) > Math.PI / 2) return;\n\n    const dist = Math.sqrt(dx*dx + dy*dy);\n\n    // Project size inversely proportional to distance\n    const size = Math.min(1 / dist * 100, 50);\n\n    // Calculate screen position\n    const screenX = ctx.canvas.width / 2 + Math.tan(a) * ctx.canvas.width / 2;\n    const screenY = ctx.canvas.height / 2 + 50;\n\n    ctx.fillStyle = 'red';\n    ctx.beginPath();\n    ctx.arc(screenX, screenY, size / 2, 0, 2 * Math.PI);\n    ctx.fill();\n  }\n}\n\nexport default Monster;\n"},"status":"ok","ms":4}
