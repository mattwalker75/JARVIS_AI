{"t":"2026-07-27T03:10:23.202Z","tool":"write_workbench_file","args":{"path":"/workspace/test_workflow.js","content":"const { chromium } = require('playwright');\n\n(async () => {\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext();\n  const page = await context.newPage();\n  \n  let passed = 0;\n  let failed = 0;\n  \n  function assert(condition, msg) {\n    if (condition) {\n      console.log(`✅ PASS: ${msg}`);\n      passed++;\n    } else {\n      console.error(`❌ FAIL: ${msg}`);\n      failed++;\n    }\n  }\n\n  try {\n    // ===== TEST 1: Dashboard loads and shows stats grid =====\n    await page.goto('http://localhost:9106/');\n    const dashStats = await page.locator('#dash-stats').count();\n    assert(dashStats === 1, 'Dashboard renders with #dash-stats element');\n\n    // Check stat cards exist (4 total)\n    const statCards = await page.locator('.stat-card').all();\n    assert(statCards.length >= 3, `At least 3 stat cards visible (found ${statCards.length})`);\n\n    console.log('\\n--- TEST 1: Dashboard loads correctly ---\\n');\n\n    // ===== TEST 2: Add a new client via modal form =====\n    await page.click('[data-page=\"clients\"]');\n    \n    // Wait for clients section to be active\n    const clientsSection = await page.locator('#page-clients').isVisible();\n    assert(clientsSection, 'Clients page is accessible');\n\n    // Click \"Add New Client\" button\n    await page.click('button.btn-primary:has-text(\"Add\")');\n    \n    // Wait for modal to show\n    const clientModal = await page.locator('#client-modal.show').isVisible();\n    assert(clientModal, 'Client modal opens when clicking Add New Client');\n\n    if (clientModal) {\n      // Fill in the form\n      await page.fill('#cf-first', 'Alice');\n      await page.fill('#cf-last', 'Johnson');\n      await page.fill('#cf-email', 'alice.johnson@email.com');\n      await page.fill('#cf-phone', '(555) 867-5309');\n      await page.selectOption('#cf-status', 'registered');\n\n      // Submit the form\n      const submitBtn = page.locator('button[type=\"submit\"]:has-text(\"Save Client\")');\n      await submitBtn.click();\n\n      // Wait for modal to close and table to render\n      await page.waitForTimeout(1000);\n\n      // Check if client appears in table\n      const rows = await page.locator('#clients-table tr').all();\n      assert(rows.length >= 1, `Client Alice Johnson appears in clients table (found ${rows.length} row(s))`);\n\n      // Verify the name is visible\n      const firstRowText = await page.locator('#clients-table td:first-child').first().textContent();\n      assert(firstRowText.includes('Alice'), 'First client row shows \"Alice\"');\n    } else {\n      console.log('\\n--- TEST 2: Client modal test skipped (modal issue) ---\\n');\n    }\n\n    // ===== TEST 3: Register a new policy for the client =====\n    await page.click('[data-page=\"policies\"]');\n    \n    const policiesSection = await page.locator('#page-policies').isVisible();\n    assert(policiesSection, 'Policies page is accessible');\n\n    await page.click('button.btn-primary:has-text(\"Register\")');\n    \n    // Wait for policy modal to show and populate client select\n    await page.waitForTimeout(500);\n    const policyModal = await page.locator('#policy-modal.show').isVisible();\n    assert(policyModal, 'Policy registration modal opens');\n\n    if (policyModal) {\n      // Select the client we just created\n      const clientsInSelect = await page.locator('#pf-client option[value]').all();\n      assert(clientsInSelect.length >= 1, `Client select has options (${clientsInSelect.length} found)`);\n\n      // Fill policy form\n      await page.selectOption('#pf-client', 'client-0');\n      \n      const coverageInput = await page.locator('#pf-coverage').inputValue();\n      if (!coverageInput) {\n        await page.fill('#pf-coverage', '500000');\n      } else {\n        await page.click('#pf-coverage');\n        await page.keyboard.press('Control+a');\n        await page.type('#pf-coverage', '500000');\n      }\n\n      const premiumInput = await page.locator('#pf-premium').inputValue();\n      if (!premiumInput) {\n        await page.fill('#pf-premium', '2400');\n      } else {\n        await page.click('#pf-premium');\n        await page.keyboard.press('Control+a');\n        await page.type('#pf-premium', '2400');\n      }\n\n      await page.selectOption('#pf-type', 'term_life');\n      await page.fill('#pf-start', '2026-01-15');\n      await page.selectOption('#pf-status', 'active');\n      \n      // Submit\n      const policySubmit = page.locator('button[type=\"submit\"]:has-text(\"Register Policy\")');\n      await policySubmit.click();\n\n      await page.waitForTimeout(1000);\n\n      // Check policy appears in table\n      const polRows = await page.locator('#policies-table tr').all();\n      assert(polRows.length >= 1, `Policy for Alice Johnson appears (found ${polRows.length} row(s))`);\n\n      if (polRows.length > 0) {\n        const firstPolText = await page.locator('#policies-table td:nth-child(2)').first().textContent();\n        assert(firstPolText.includes('Alice'), 'First policy row shows client \"Alice\"');\n      }\n    } else {\n      console.log('\\n--- TEST 3: Policy modal test skipped ---\\n');\n    }\n\n    // ===== TEST 4: Record a payment for the policy =====\n    await page.click('[data-page=\"payments\"]');\n    \n    const paymentsSection = await page.locator('#page-payments').isVisible();\n    assert(paymentsSection, 'Payments page is accessible');\n\n    await page.click('button.btn-success:has-text(\"Record\")');\n    \n    // Wait for payment modal to show and populate policy select\n    await page.waitForTimeout(500);\n    const payModal = await page.locator('#payment-modal.show').isVisible();\n    assert(payModal, 'Payment recording modal opens');\n\n    if (payModal) {\n      // Select the policy we just created\n      await page.selectOption('#pm-policy', 'policy-0');\n\n      // Fill payment form\n      const amountInput = await page.locator('#pm-amount').inputValue();\n      if (!amountInput || amountInput === '') {\n        await page.fill('#pm-amount', '2400');\n      } else {\n        await page.click('#pm-amount');\n        await page.keyboard.press('Control+a');\n        await page.type('#pm-amount', '2400');\n      }\n\n      await page.fill('#pm-date', '2026-07-15');\n      await page.selectOption('#pm-method', 'check');\n\n      // Submit\n      const paySubmit = page.locator('button[type=\"submit\"]:has-text(\"Record Payment\")');\n      await paySubmit.click();\n\n      await page.waitForTimeout(1000);\n\n      // Check payment appears in table\n      const payRows = await page.locator('#payments-table tr').all();\n      assert(payRows.length >= 1, `Payment for Alice Johnson's policy recorded (found ${payRows.length} row(s))`);\n\n      if (payRows.length > 0) {\n        const firstPayText = await page.locator('#payments-table td:nth-child(2)').first().textContent();\n        assert(firstPayText.includes('Alice'), 'First payment row shows client \"Alice\"');\n        \n        // Check for Received badge\n        const statusBadges = await page.locator('.badge-active').all();\n        assert(statusBadges.length >= 1, `At least one \"Received\" badge visible`);\n      }\n    } else {\n      console.log('\\n--- TEST 4: Payment modal test skipped ---\\n');\n    }\n\n    // ===== TEST 5: Dashboard reflects all data =====\n    await page.click('[data-page=\"dashboard\"]');\n    \n    const dashSection = await page.locator('#page-dashboard').isVisible();\n    assert(dashSection, 'Dashboard page is accessible after navigation');\n\n    await page.waitForTimeout(1000);\n\n    // Check stats reflect our data (should show 1 client)\n    const statTexts = [];\n    for (const card of await page.locator('.stat-card').all()) {\n      statTexts.push(await card.textContent());\n    }\n    \n    assert(statTexts.some(t => t.includes('1')), 'Dashboard shows at least 1 total client');\n\n    // Check pending actions or recent activity sections render without errors\n    const pendingActions = await page.locator('#pending-actions').count();\n    assert(pendingActions === 1, 'Pending Actions section renders on dashboard');\n\n    console.log('\\n--- TEST 5: Dashboard reflects data correctly ---\\n');\n\n    // ===== SUMMARY =====\n    console.log('='.repeat(60));\n    console.log(`RESULTS: ${passed} passed, ${failed} failed out of ${passed + failed} tests`);\n    \n    if (failed === 0) {\n      console.log('\\n🎉 ALL TESTS PASSED! Core workflows verified.');\n    } else {\n      console.log(`\\n⚠️ ${failed} test(s) need attention.`);\n    }\n\n  } catch (err) {\n    console.error('Test error:', err.message);\n    failed++;\n  } finally {\n    await browser.close();\n    \n    // Write results to a file for the plan update\n    const fs = require('fs');\n    fs.writeFileSync('/workspace/test_results.txt', \n      `Tests: ${passed} passed, ${failed} failed\\n` +\n      (failed === 0 ? 'ALL TESTS PASSED' : `${failed} test(s) need attention`)\n    );\n    \n    process.exit(failed > 0 ? 1 : 0);\n  }\n})();\n"},"status":"ok","ms":140}
