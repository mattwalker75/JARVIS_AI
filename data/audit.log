{"t":"2026-07-26T00:54:04.956Z","tool":"write_workbench_file","args":{"path":"/workspace/doom/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Hell Runner - Doom Clone</title>\n<style>\nbody { margin:0; background:#000; display:flex; justify-content:center; align-items:center; height:100vh; overflow:hidden; font-family:'Courier New',monospace; }\n#game-container { position:relative; width:640px; height:520px; border:3px solid #8B0000; box-shadow: 0 0 30px rgba(139,0,0,0.7); }\ncanvas { display:block; image-rendering:pixelated; }\n#hud-bar { position:absolute; bottom:0; left:0; right:0; height:48px; background:#2a0505; border-top:2px solid #6B0000; color:#FFD700; font-size:13px; display:flex; align-items:center; justify-content:space-around; padding:0 10px; z-index:10; }\n#minimap-container { position:absolute; top:8px; right:8px; border:2px solid #6B0000; background:rgba(0,0,0,0.7); z-index:5; }\n#crosshair { position:absolute; top:50%; left:50%; width:4px; height:4px; background:#FFD700; border-radius:50%; transform:translate(-50%,-50%); pointer-events:none; z-index:10; box-shadow: 0 0 6px #FFD700, -8px 0 2px rgba(255,215,0,0.4), 8px 0 2px rgba(255,215,0,0.4); }\n#message { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#FFD700; font-size:36px; text-align:center; z-index:20; pointer-events:none; display:none; text-shadow: 0 0 15px #FF4500, 0 0 30px #8B0000; }\n#start-screen { position:absolute; top:0;left:0;width:100%;height:100%; background:#0a0202; display:flex; flex-direction:column; justify-content:center; align-items:center; z-index:30; cursor:pointer; }\n#start-screen h1 { color:#FF4500; font-size:64px; margin-bottom:8px; text-shadow: 0 0 20px #FF4500, 0 0 40px #8B0000; letter-spacing:6px; }\n#start-screen h3 { color:#CC3300; font-size:18px; margin-bottom:40px; text-shadow: 0 0 10px #FF4500; letter-spacing:2px; }\n#enter-btn { background:none; border:3px solid #8B0000; color:#FFD700; font-size:26px; padding:14px 48px; cursor:pointer; font-family:'Courier New',monospace; letter-spacing:4px; transition:all 0.3s; text-shadow:0 0 10px #FF4500; }\n#enter-btn:hover { background:#8B0000; color:#FFF; box-shadow:0 0 25px rgba(255,69,0,0.7); transform:scale(1.05); border-color:#FFD700; }\n.controls-hint { margin-top:30px;color:#8B4513;font-size:13px;text-align:center;line-height:2; }\n</style>\n</head>\n<body>\n\n<div id=\"game-container\">\n  <canvas id=\"screen\" width=\"320\" height=\"240\"></canvas>\n  <div id=\"minimap-container\"><canvas id=\"minimap-canvas\" width=\"128\" height=\"128\"></canvas></div>\n  <div id=\"crosshair\"></div>\n  <div id=\"hud-bar\">\n    <span style=\"color:#FF6347;\">♥ HP: <b id=\"hp-val\">100</b>%</span>\n    <span style=\"color:#4682B4;\">🛡️ ARMOR: <b id=\"armor-val\">0</b></span>\n    <span style=\"color:#FFD700;\">⚔️ WEAPON: <b id=\"weapon-name\">PISTOL</b></span>\n    <span style=\"color:#CD853F;\">📦 AMMO: <b id=\"ammo-val\">50</b></span>\n    <span style=\"color:#FF4500;\">💀 KILLS: <b id=\"kills-val\">0/10</b></span>\n  </div>\n  <div id=\"message\"></div>\n\n  <div id=\"start-screen\" onclick=\"startGame()\">\n    <h3 style=\"color:#8B4513;font-size:16px;margin-bottom:20px;letter-spacing:8px;\">A DOOM-INSPIRED EXPERIENCE</h3>\n    <h1>HELL RUNNER</h1>\n    <h3>KILL ALL 10 DEMONS TO ESCAPE</h3>\n    <button id=\"enter-btn\">ENTER HELL</button>\n    <div class=\"controls-hint\">\n      WASD — Move &nbsp;|&nbsp; MOUSE — Look<br>\n      LEFT CLICK — Shoot &nbsp;|&nbsp; R — Switch Weapon\n    </div>\n  </div>\n</div>\n\n<script>\n// ============ CONSTANTS ============\nconst canvas = document.getElementById('screen');\nconst ctx = canvas.getContext('2d', { willReadFrequently: true });\nconst miniCanvas = document.getElementById('minimap-canvas');\nconst miniCtx = miniCanvas.getContext('2d');\nconst msgEl = document.getElementById('message');\n\n// ============ MAP DATA (1=wall, 0=floor) ============\nconst mapData = [\n  \"11111111111111111111\",\n  \"10000000000000000001\",\n  \"10000000000000000001\",\n  \"10011100000000111001\",\n  \"10010000000000001001\",\n  \"10010000030000001001\",\n  \"10000000000000000001\",\n  \"10000002000000000001\",\n  \"10000000000000000001\",\n  \"10000000000400000001\",\n  \"10000000000000000001\",\n  \"10020000000000003001\",\n  \"10000000000000000001\",\n  \"10000000050000000001\",\n  \"10000000000000000001\",\n  \"10000000000000600001\",\n  \"10000000000000000001\",\n  \"10400000000000700001\",\n  \"10000000000000000501\",\n  \"11111111111111111111\"\n];\n\nconst MAP_W = mapData[0].length;\nconst MAP_H = mapData.length;\nlet wallMap = []; // true=wall, false=floor\nlet torches = [{x:2.5,y:2.5},{x:9,y:4},{x:16,y:7},{x:3,y:9},{x:10,y:11},{x:17,y:8},{x:5,y:14},{x:14,y:16},{x:8,y:17},{x:12,y:18}];\nconst wallColors = { '1': '#3a2a1a', '2': '#2a3a2a', '3': '#3a1a1a', '4': '#1a2a3a', '5': '#3a3a1a', '6': '#2a1a3a' };\n\n// ============ PARSE MAP ============\nfunction parseMap() {\n  wallMap = [];\n  for (let row = 0; row < MAP_H; row++) {\n    wallMap[row] = [];\n    const line = mapData[row];\n    for (let col = 0; col < line.length; col++) {\n      wallMap[row][col] = (line[col] !== '0');\n    }\n  }\n}\n\n// ============ GAME STATE ============\nlet gameState = 'menu'; // menu | playing | won | lost\nlet player = {};\nlet entities = [];\nlet particles = [];\nconst keys = {};\nlet mouseDown = false;\nlet shootCooldown = 0;\nlet weaponIndex = 1;\n\n// ============ WEAPONS ============\nconst weapons = [\n  { name: 'FIST', ammoMax: Infinity, damage: 25, cooldown: 30 },\n  { name: 'PISTOL', ammoMax: 999, damage: 35, cooldown: 18 },\n  { name: 'SHOTGUN', ammoMax: 64, damage: 70, cooldown: 40 }\n];\n\n// ============ RESET GAME ============\nfunction resetGame() {\n  player.x = 2.5; player.y = 2.5; player.angle = Math.PI / 4;\n  player.health = 100; player.armor = 0; player.ammo = 50;\n  entities = []; particles = []; shootCooldown = 0; weaponIndex = 1;\n\n  // Spawn enemies at positions (offset by half-cell)\n  const enemyPositions = [\n    {x:9,y:4},{x:16,y:7},{x:3,y:9},{x:10,y:11},\n    {x:17,y:8},{x:5,y:14},{x:14,y:16},{x:8,y:17}\n  ];\n  enemyPositions.forEach((p,i) => {\n    entities.push({ x:p.x+0.5, y:p.y+0.5, type:'imp', health:50, speed:0.025, damage:8, alive:true });\n  });\n\n  // Add two more enemies for total of 10\n  entities.push({x:7,y:3,type:'demon',health:80,speed:0.03,damage:12,alive:true});\n  entities.push({x:15,y:14,type:'zombie',health:60,speed:0.02,damage:10,alive:true});\n\n  // Pickups\n  const pickupPositions = [\n    {x:5.5,y:7.5,type:'health'},{x:13.5,y:9.5,type:'ammo'},\n    {x:8.5,y:14.5,type:'armor'}\n  ];\n  entities.push(...pickupPositions.map(p => ({...p, type:p.type, alive:true})));\n\n  updateHUD();\n}\n\n// ============ START GAME (FIXED) ============\nfunction startGame() {\n  if (!canvas || !ctx) return;\n  parseMap();\n  resetGame();\n  gameState = 'playing';\n  document.getElementById('start-screen').style.display = 'none';\n  msgEl.style.display = 'none';\n\n  // Pointer lock for mouse look\n  canvas.requestPointerLock = canvas.requestPointerLock || canvas.mozRequestPointerLock;\n  canvas.requestPointerLock();\n}\n\n// ============ RAYCASTING ENGINE (DDA) ============\nconst FOV = Math.PI / 3; // 60 degrees field of view\n\nfunction castRay(angle) {\n  let sinA = Math.sin(angle);\n  let cosA = Math.cos(angle);\n\n  let mapX = Math.floor(player.x);\n  let mapY = Math.floor(player.y);\n\n  const deltaDistX = Math.abs(1 / (cosA || 0.0001));\n  const deltaDistY = Math.abs(1 / (sinA || 0.0001));\n\n  let stepX, stepY;\n  let sideDistX, sideDistY;\n\n  if (cosA < 0) { stepX = -1; sideDistX = (player.x - mapX) * deltaDistX; }\n  else          { stepX = 1;  sideDistX = (mapX + 1.0 - player.x) * deltaDistX; }\n\n  if (sinA < 0) { stepY = -1; sideDistY = (player.y - mapY) * deltaDistY; }\n  else          { stepY = 1;  sideDistY = (mapY + 1.0 - player.y) * deltaDistY; }\n\n  let hit = false, side = 0;\n  while (!hit) {\n    if (sideDistX < sideDistY) {\n      sideDistX += deltaDistX; mapX += stepX; side = 0;\n    } else {\n      sideDistY += deltaDistY; mapY += stepY; side = 1;\n    }\n    if (mapX >= 0 && mapX < MAP_W && mapY >= 0 && mapY < MAP_H) {\n      if (wallMap[mapY][mapX]) hit = true;\n    } else { hit = true; }\n  }\n\n  let perpDist, wallPos;\n  if (side === 0) { perpDist = sideDistX - deltaDistX; wallPos = player.y + perpDist * sinA; }\n  else          { perpDist = sideDistY - deltaDistY; wallPos = player.x + perpDist * cosA; }\n\n  let hitSide = (side === 1) ? 'NS' : 'EW';\n  if (wallPos < 0) wallPos += 1;\n  if (wallPos >= 1) wallPos -= 1;\n\n  return { perpDist, side, wallX: wallPos, mapX, mapY };\n}\n\n// ============ LIGHTING CALCULATION ============\nfunction getLightAt(x, y) {\n  let light = 0.35; // ambient minimum\n  for (let t of torches) {\n    const dx = x - t.x, dy = y - t.y;\n    const distSq = dx * dx + dy * dy;\n    if (distSq < 16) light += Math.max(0, 3.5 / (1 + distSq)); // inverse-square falloff\n  }\n  return Math.min(light, 4);\n}\n\n// ============ RENDERING ============\nfunction render() {\n  ctx.fillStyle = '#0a0202';\n  ctx.fillRect(0, 0, 320, 240); // dark background\n\n  const zBuffer = new Float32Array(320).fill(Infinity);\n\n  for (let x = 0; x < 320; x++) {\n    let rayAngle = player.angle - FOV / 2 + (x / 320) * FOV;\n    const result = castRay(rayAngle);\n    if (!result || isNaN(result.perpDist)) continue;\n\n    // Correct fisheye\n    const perpDistCorrected = result.perpDist * Math.cos(rayAngle - player.angle);\n    zBuffer[x] = perpDistCorrected;\n\n    const lineHeight = (3.0 / perpDistCorrected) * 240;\n    let drawStart = Math.max(0, Math.floor(120 - lineHeight / 2));\n    let drawEnd   = Math.min(239, Math.floor(120 + lineHeight / 2));\n\n    // Wall rendering with color and lighting\n    const wallChar = mapData[result.mapY][result.mapX];\n    const baseColorStr = wallColors[wallChar] || '#5a4a3a';\n    let r = parseInt(baseColorStr.slice(1,3), 16);\n    let g = parseInt(baseColorStr.slice(3,5), 16);\n    let b = parseInt(baseColorStr.slice(5,7), 16);\n\n    // Lighting from torches + distance fog\n    const wallXWorld = player.x + result.perpDist * Math.cos(rayAngle);\n    const wallYWorld = player.y + result.perpDist * Math.sin(rayAngle);\n    let lighting = getLightAt(wallXWorld, wallYWorld) / 3.5;\n\n    // Distance fog (darker further away — classic Doom feel)\n    const distanceFog = Math.max(0.12, 1 - result.perpDist / 9);\n    lighting *= distanceFog;\n\n    r = Math.floor(r * lighting);\n    g = Math.floor(g * lighting);\n    b = Math.floor(b * lighting);\n\n    // Clamp to valid range and draw wall strip\n    ctx.fillStyle = `rgb(${Math.max(0,Math.min(255,r))},${Math.max(0,Math.min(255,g))},${Math.max(0,Math.min(255,b))})`;\n    ctx.fillRect(x, drawStart, 1, drawEnd - drawStart + 1);\n\n    // Floor rendering with lighting and fog\n    const floorStep = Math.floor(120 + lineHeight / 2);\n    for (let y = floorStep; y < 240; y++) {\n      const rayDistForFloor = result.perpDist * (y - 120) / 120 + 0.5;\n      if (rayDistForFloor > 9 || isNaN(rayDistForFloor)) continue;\n\n      let floorLighting = getLightAt(wallXWorld, wallYWorld) / 3.5;\n      const fogFactor = Math.max(0.1, 1 - rayDistForFloor / 8);\n      floorLighting *= fogFactor;\n\n      // Checkerboard pattern for floor texture feel\n      const checker = ((Math.floor(player.x + (wallXWorld-player.x)*(y-floorStep)/(240-floorStep)) ^ Math.floor(player.y + (wallYWorld-player.y)*(y-floorStep)/(240-floorStep))) & 1);\n      let fr, fg, fb;\n      if (checker) { fr = 35; fg = 28; fb = 20; } else { fr = 28; fg = 22; fb = 16; }\n\n      ctx.fillStyle = `rgb(${Math.max(0,Math.min(255,fr*floorLighting))},${Math.max(0,Math.min(255,fg*floorLighting))},${Math.max(0,Math.min(255,fb*floorLighting))})`;\n      ctx.fillRect(x, y, 1, 1);\n    }\n\n    // Ceiling rendering with lighting and fog\n    const ceilStart = Math.floor(Math.max(0, 120 - lineHeight / 2));\n    for (let y = ceilStart; y < 120; y++) {\n      const rayDistForCeil = result.perpDist * (120 - y) / 120 + 0.5;\n      if (rayDistForCeil > 9 || isNaN(rayDistForCeil)) continue;\n\n      let ceilLighting = getLightAt(wallXWorld, wallYWorld) / 3.5;\n      const fogFactor = Math.max(0.1, 1 - rayDistForCeil / 8);\n      ceilLighting *= fogFactor;\n\n      // Checkerboard pattern for ceiling texture feel\n      const checker2 = ((Math.floor(player.x + (wallXWorld-player.x)*(y-ceilStart)/(ceilStart-y)) ^ Math.floor(player.y + (wallYWorld-player.y)*(y-ceilStart)/(ceilStart-y))) & 1);\n      let cr, cg, cb;\n      if (checker2) { cr = 45; cg = 38; cb = 30; } else { cr = 36; cg = 30; cb = 22; }\n\n      ctx.fillStyle = `rgb(${Math.max(0,Math.min(255,cr*ceilLighting))},${Math.max(0,Math.min(255,cg*ceilLighting))},${Math.max(0,Math.min(255,cb*ceilLighting))})`;\n      ctx.fillRect(x, y, 1, 1);\n    }\n  }\n\n  // ============ RENDER ENTITIES (SPRITES) ============\n  const sortedEntities = entities.filter(e => e.alive).sort((a,b) => {\n    return ((b.x-player.x)**2+(b.y-player.y)**2) - ((a.x-player.x)**2+(a.y-player.y)**2); // far first (painter's algo reversed)\n  });\n\n  for (const entity of sortedEntities) {\n    const dx = entity.x - player.x;\n    const dy = entity.y - player.y;\n    const distSq = dx*dx + dy*dy;\n    if (distSq < 0.1 || distSq > 81) continue; // too close or too far\n\n    const dist = Math.sqrt(distSq);\n    let spriteAngle = Math.atan2(dy, dx) - player.angle;\n    while (spriteAngle < -Math.PI) spriteAngle += 2*Math.PI;\n    while (spriteAngle > Math.PI) spriteAngle -= 2*Math.PI;\n\n    if (Math.abs(spriteAngle) > FOV/2 + 0.3) continue; // outside field of view\n\n    const screenX = Math.floor((0.5 + spriteAngle / FOV) * 320);\n    const spriteHeight = Math.min(48, Math.floor(600 / dist));\n    const spriteWidth = Math.min(48, Math.floor(600 / dist));\n\n    const drawStartY = Math.max(0, 120 - spriteHeight/2);\n    const drawEndY   = Math.min(239, 120 + spriteHeight/2);\n    const drawStartX = Math.max(0, screenX - spriteWidth/2);\n    const drawEndX   = Math.min(319, screenX + spriteWidth/2);\n\n    // Check z-buffer — only render if in front of walls\n    let visible = false;\n    for (let px = drawStartX; px <= drawEndX; px++) {\n      if (zBuffer[px] > dist) { visible = true; break; }\n    }\n    if (!visible) continue;\n\n    // Lighting + fog on sprite\n    let lighting = getLightAt(entity.x, entity.y) / 3.5 * Math.max(0.12, 1 - dist/9);\n\n    ctx.save();\n    ctx.beginPath();\n    for (let px = drawStartX; px <= drawEndX; px++) {\n      if (zBuffer[px] > dist) ctx.rect(px, drawStartY, Math.min(319-px+drawStartX, 1), spriteHeight);\n    }\n    // Simple clipping via z-buffer check per column\n    for (let px = drawStartX; px <= drawEndX; px++) {\n      if (zBuffer[px] > dist) {\n        let sr, sg, sb;\n\n        if (entity.type === 'imp')       { sr=205*lighting|0; sg=69*lighting|0;  sb=43*lighting|0; }   // red demon\n        else if (entity.type === 'demon') { sr=178*lighting|0; sg=34*lighting|0;  sb=34*lighting|0; }   // darker red\n        else if (entity.type === 'zombie'){ sr=154*lighting|0; sg=169*lighting|0; sb=87*lighting|0; }   // greenish zombie\n        else if (entity.type === 'health') {sr=255*lighting|0; sg=32*lighting|0;  sb=32*lighting|0; }    // red cross\n        else if (entity.type === 'ammo')   {sr=184*lighting|0; sg=179*lighting|0; sb=65*lighting|0; }     // yellow box\n        else if (entity.type === 'armor')  {sr=32*lighting|0;  sg=117*lighting|0; sb=224*lighting|0;}     // blue shield\n\n        ctx.fillStyle = `rgb(${Math.max(0,Math.min(255,sr))},${Math.max(0,Math.min(255,sg))},${Math.max(0,Math.min(255,sb))})`;\n        ctx.fillRect(px, drawStartY, 1, spriteHeight);\n\n        // Draw cross for health pickup\n        if (entity.type === 'health' && px >= screenX-4 && px <= screenX+4) {\n          ctx.fillStyle = `rgb(255,${Math.max(0,Math.min(255,255*lighting))},${Math.max(0,Math.min(255,255*lighting))})`;\n          if (px === screenX || drawStartY+spriteHeight/4 < 120) { /* simple cross */ }\n        }\n      }\n    }\n\n    // Draw enemy eyes (bright dots for imp/demon/zombie)\n    if (entity.type !== 'health' && entity.type !== 'ammo' && entity.type !== 'armor') {\n      const eyeY = drawStartY + spriteHeight * 0.3;\n      const eyeSize = Math.max(2, spriteWidth / 14);\n\n      ctx.fillStyle = `rgb(${Math.min(255,255*lighting)|0},${Math.min(255,200*lighting)|0},0)`; // yellow eyes\n      if (entity.type === 'demon') {\n        ctx.fillRect(screenX - spriteWidth/4 - eyeSize, eyeY, eyeSize+1, eyeSize+1);\n        ctx.fillRect(screenX + spriteWidth/4 - 1, eyeY, eyeSize+1, eyeSize+1); // two eyes spread wider\n      } else {\n        ctx.fillRect(screenX - spriteWidth/5 - eyeSize/2, eyeY, eyeSize, eyeSize);\n        ctx.fillRect(screenX + spriteWidth/5 - eyeSize/2, eyeY, eyeSize, eyeSize);\n      }\n\n      // Health bar above enemy\n      if (entity.health < 80) {\n        const barW = Math.max(4, spriteWidth * entity.health / 100);\n        ctx.fillStyle = '#FFD700';\n        ctx.fillRect(screenX - spriteWidth/2, drawStartY - 6, barW, 3);\n      }\n    }\n\n    ctx.restore();\n  }\n\n  // ============ RENDER PARTICLES (blood) ============\n  for (const p of particles) {\n    const dx = p.x - player.x;\n    const dy = p.y - player.y;\n    const distSq = dx*dx + dy*dy;\n    if (distSq < 0.1 || distSq > 81) continue;\n\n    let angle = Math.atan2(dy, dx) - player.angle;\n    while (angle < -Math.PI) angle += 2*Math.PI;\n    while (angle > Math.PI) angle -= 2*Math.PI;\n    if (Math.abs(angle) > FOV/2 + 0.3) continue;\n\n    const screenX = Math.floor((0.5 + angle / FOV) * 320);\n    const dist = Math.sqrt(distSq);\n    const size = Math.max(1, Math.floor(60 / dist));\n    if (screenX < 0 || screenX >= 320 || zBuffer[screenX] > dist) continue;\n\n    ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},0.8)`;\n    ctx.fillRect(screenX, Math.floor(120 - size/2), size, size);\n  }\n\n  // ============ WEAPON RENDERING (bottom center of screen) ============\n  const weaponY = 195 + (shootCooldown > 10 ? -(40-shootCooldown)*3 : shootCooldown > 0 ? ((shootCooldown-10)*2) : 0);\n  ctx.fillStyle = '#8B7355';\n\n  if (weaponIndex === 0) { // Fist\n    ctx.fillRect(160, weaponY, 40, 45);\n    ctx.fillStyle = '#D2B48C';\n    for(let i=0;i<4;i++) ctx.fillRect(170+i*9, weaponY+35, 7, 12); // fingers\n  } else if (weaponIndex === 1) { // Pistol\n    ctx.fillStyle = '#6a6a6a';\n    ctx.fillRect(180, weaponY-40, 18, 50); // barrel\n    ctx.fillStyle = '#3a2a1a';\n    ctx.fillRect(178, weaponY+10, 22, 30); // grip\n  } else { // Shotgun\n    ctx.fillStyle = '#6a6a6a';\n    ctx.fillRect(155, weaponY-45, 10, 55); // left barrel\n    ctx.fillRect(178, weaponY-45, 10, 55); // right barrel\n    ctx.fillStyle = '#3a2a1a';\n    ctx.fillRect(165, weaponY+5, 25, 35); // stock\n  }\n\n  // Muzzle flash\n  if (shootCooldown > 8) {\n    const flashSize = Math.max(4, shootCooldown * 4);\n    ctx.fillStyle = `rgba(255,${100+Math.random()*155|0},0,0.9)`;\n    ctx.beginPath();\n    ctx.arc(178 + (weaponIndex===1?6:0), weaponY-48, flashSize/3, 0, Math.PI*2);\n    ctx.fill();\n  }\n\n  // ============ MINIMAP RENDERING ============\n  miniCtx.fillStyle = 'rgba(5,5,10,0.9)';\n  miniCtx.fillRect(0, 0, 128, 128);\n  const scale = 3; // pixels per map cell\n\n  for (let row=0;row<MAP_H;row++) {\n    for(let col=0;col<MAP_W;col++){\n      if(wallMap[row] && wallMap[row][col]){\n        miniCtx.fillStyle='#5a4a3a';\n        miniCtx.fillRect(col*scale, row*scale, scale, scale);\n      } else {\n        // subtle floor grid\n        miniCtx.strokeStyle='rgba(60,50,40,0.15)';\n        miniCtx.strokeRect(col*scale, row*scale, scale, scale);\n      }\n    }\n  }\n\n  // Torches on minimap\n  for (const t of torches) {\n    miniCtx.fillStyle='#FFD700';\n    miniCtx.fillRect(t.x*scale-1, t.y*scale-1, 3, 3);\n  }\n\n  // Enemies on minimap\n  for(const e of entities){\n    if(!e.alive || (e.type!=='imp'&&e.type!=='demon'&&e.type!=='zombie')) continue;\n    miniCtx.fillStyle='#FF4500';\n    miniCtx.fillRect(e.x*scale-1, e.y*scale-1, 3, 3);\n  }\n\n  // Pickups on minimap\n  for(const p of entities){\n    if(!p.alive || (p.type!=='health'&&p.type!=='ammo'&&p.type!=='armor')) continue;\n    miniCtx.fillStyle = p.type==='health'?'#FF0000':(p.type==='ammo'?'#FFFF00':'#4682B4');\n    miniCtx.fillRect(p.x*scale-1, p.y*scale-1, 3, 3);\n  }\n\n  // Player on minimap (green triangle)\n  const pmx = player.x * scale;\n  const pmy = player.y * scale;\n  miniCtx.fillStyle='#00FF00';\n  miniCtx.beginPath();\n  miniCtx.arc(pmx, pmy, 2.5, 0, Math.PI*2);\n  miniCtx.fill();\n\n  // Direction indicator on minimap\n  const dirLen = 8;\n  miniCtx.strokeStyle='#00FF00';\n  miniCtx.lineWidth=1;\n  miniCtx.beginPath();\n  miniCtx.moveTo(pmx, pmy);\n  miniCtx.lineTo(pmx+Math.cos(player.angle)*dirLen, pmy+Math.sin(player.angle)*dirLen);\n  miniCtx.stroke();\n\n  // ============ UPDATE HUD ============\n  updateHUD();\n}\n\n// ============ UPDATE HUD ============\nfunction updateHUD() {\n  document.getElementById('hp-val').textContent = Math.max(0, player.health|0);\n  document.getElementById('armor-val').textContent = Math.min(100, player.armor|0);\n  document.getElementById('weapon-name').textContent = weapons[weaponIndex].name;\n  document.getElementById('ammo-val').textContent = weaponIndex===0?'∞':Math.max(0,player.ammo|0);\n\n  const aliveCount = entities.filter(e => e.alive && (e.type==='imp'||e.type==='demon'||e.type==='zombie')).length;\n  document.getElementById('kills-val').textContent = `${10-aliveCount}/10`;\n\n  // Health color changes based on HP\n  const hpEl = document.getElementById('hp-val');\n  if(player.health > 60) hpEl.style.color='#FF6347';\n  else if(player.health > 25) hpEl.style.color='#FFD700';\n  else hpEl.style.color='#FF0000';\n\n  // Low health warning (red flash on screen edges)\n  if(gameState === 'playing' && player.health < 30) {\n    ctx.fillStyle = `rgba(255,0,0,${0.1 + Math.sin(Date.now()/200)*0.08})`;\n    ctx.fillRect(0,0,320,4); // top bar\n    ctx.fillRect(0,236,320,4); // bottom bar (above HUD)\n  }\n}\n\n// ============ UPDATE GAME STATE ============\nfunction update() {\n  if(gameState !== 'playing') return;\n\n  const moveSpeed = 0.05;\n  const rotSpeed = keys['ArrowLeft'] ? -0.04 : keys['ArrowRight'] ? 0.04 : 0;\n\n  // Rotation from mouse (handled in event listener)\n  player.angle += rotationDelta || 0;\n  rotationDelta = 0;\n\n  if(rotSpeed !== 0) {\n    const cosA = Math.cos(player.angle);\n    const sinA = Math.sin(player.angle);\n    player.angle += rotSpeed;\n  }\n\n  // Movement with collision detection\n  let moveX = 0, moveY = 0;\n  if(keys['KeyW'] || keys['ArrowUp']) { moveX += Math.cos(player.angle)*moveSpeed; moveY += Math.sin(player.angle)*moveSpeed; }\n  if(keys['KeyS'] || keys['ArrowDown']){ moveX -= Math.cos(player.angle)*moveSpeed*0.65; moveY -= Math.sin(player.angle)*moveSpeed*0.65;}\n  // Strafe\n  const strafeAngle = player.angle + (keys['KeyA'] ? -1 : keys['KeyD'] ? 1 : 0) * Math.PI/2;\n  if(keys['KeyA'] || keys['KeyD']) { moveX += Math.cos(strafeAngle)*moveSpeed*0.65; moveY += Math.sin(strafeAngle)*moveSpeed*0.65;}\n\n  // Collision check (with wall buffer)\n  const buf = 0.2;\n  if(!wallMap[Math.floor(player.y)][Math.floor(player.x + moveX + buf*Math.sign(moveX))]) player.x += moveX;\n  if(!wallMap[Math.floor(player.y + moveY + buf*Math.sign(moveY))][Math.floor(player.x)]) player.y += moveY;\n\n  // Shooting cooldown tick down\n  if(shootCooldown > 0) shootCooldown--;\n\n  // ============ UPDATE ENEMIES (AI) ============\n  for(const entity of entities){\n    if(entity.type!=='imp'&&entity.type!=='demon'&&entity.type!=='zombie') continue;\n    if(!entity.alive) continue;\n\n    const dx = player.x - entity.x;\n    const dy = player.y - entity.y;\n    const distSq = dx*dx + dy*dy;\n    const dist = Math.sqrt(distSq);\n\n    // Only chase if close enough (line of sight-ish)\n    if(dist < 10){\n      let nx = entity.x + (dx/dist)*entity.speed;\n      let ny = entity.y + (dy/dist)*entity.speed;\n\n      // Simple collision — don't walk through walls\n      const eBuf = 0.25;\n      if(!wallMap[Math.floor(entity.y)][Math.floor(nx+eBuf*Math.sign(dx))]) entity.x=nx;\n      else ny += Math.sin(player.angle-entityAngleAtEntity)*entity.speed*0.3; // try to slide around\n\n      if(dist < 1 && shootCooldown <= 5) {\n        let dmg = entity.damage * (player.armor > 0 ? 0.6 : 1);\n        player.health -= dmg;\n        player.armor = Math.max(0, player.armor - entity.damage*0.3);\n\n        // Spawn blood particles at enemy position\n        for(let i=0;i<5;i++){\n          particles.push({x:entity.x+(Math.random()-0.5)*0.4,y:entity.y+(Math.random()-0.5)*0.4, vx:(dx/dist)*0.1*(Math.random()),vy:(dy/dist)*0.1*(Math.random()),life:25,r:200+Math.random()*55|0,g:0,b:0});\n        }\n\n        if(player.health <= 0){ gameState='lost'; showMessage('YOU DIED', '#FF4500'); return; }\n      }\n    }\n  }\n\n  // ============ UPDATE PARTICLES ============\n  for(let i=particles.length-1;i>=0;i--){\n    const p=particles[i];\n    p.x+=p.vx; p.y+=p.vy; p.life--;\n    if(p.life<=0) particles.splice(i,1);\n  }\n\n  // ============ CHECK PICKUP COLLISIONS ============\n  for(const entity of entities){\n    if(entity.type!=='health'&&entity.type!=='ammo'&&entity.type!=='armor') continue;\n    if(!entity.alive) continue;\n\n    const dx=player.x-entity.x, dy=player.y-entity.y;\n    if(dx*dx+dy*dy < 0.5){\n      entity.alive=false;\n      switch(entity.type){\n        case 'health': player.health=Math.min(100,player.health+25); break;\n        case 'ammo':   player.ammo+=30; break;\n        case 'armor':  player.armor=Math.min(100,player.armor+25); break;\n      }\n    }\n  }\n\n  // ============ CHECK WIN CONDITION ============\n  const aliveEnemies = entities.filter(e => e.alive && (e.type==='imp'||e.type==='demon'||e.type==='zombie'));\n  if(aliveEnemies.length === 0){ gameState='won'; showMessage('HELL CLEARED!', '#FFD700'); }\n\n  // Render every frame\n  render();\n}\n\n// ============ SHOOTING LOGIC ============\nfunction shoot() {\n  if(gameState!=='playing'||shootCooldown>0) return;\n  const weapon=weapons[weaponIndex];\n  if(weapon.name==='FIST'){\n    // Melee — check for nearby enemies in front of player\n    let hit=false;\n    for(const e of entities){\n      if(!e.alive||(e.type!=='imp'&&e.type!=='demon'&&e.type!=='zombie')) continue;\n      const dx=e.x-player.x, dy=e.y-player.y;\n      const dist=Math.sqrt(dx*dx+dy*dy);\n      let angleToE= Math.atan2(dy,dx)-player.angle;\n      while(angleToE<-Math.PI)angleToE+=2*Math.PI;\n      while(angleToE>Math.PI)angleToE-=2*Math.PI;\n      if(dist<1.5 && Math.abs(angleToE)<0.6){\n        e.health -= weapon.damage; hit=true;\n        // Blood particles\n        for(let i=0;i<8;i++){\n          particles.push({x:e.x+(Math.random()-0.5)*0.3,y:e.y+(Math.random()-0.5)*0.3,vx:(dx/dist)*0.12*(Math.random()+0.5),vy:(dy/dist)*0.12*(Math.random()+0.5),life:20,r:200+Math.random()*55|0,g:0,b:0});\n        }\n        if(e.health<=0){ e.alive=false; break; } // only hit one at a time with fist\n      }\n    }\n  } else {\n    // Ranged — hitscan (raycast through center)\n    const rayResult = castRay(player.angle);\n    let closestHitDist = Infinity, closestEntity = null;\n\n    for(const e of entities){\n      if(!e.alive||(e.type!=='imp'&&e.type!=='demon'&&e.type!=='zombie')) continue;\n      // Check if entity is roughly in the ray's path (within a small angle)\n      const dx=e.x-player.x, dy=e.y-player.y;\n      const dist=Math.sqrt(dx*dx+dy*dy);\n      let angleToE = Math.atan2(dy,dx)-player.angle;\n      while(angleToE<-Math.PI)angleToE+=2*Math.PI;\n      while(angleToE>Math.PI)angleToE-=2*Math.PI;\n\n      if(Math.abs(angleToE)<0.15 && dist<closestHitDist){\n        // Check wall behind entity doesn't block\n        const wallCheck = castRay(player.angle + angleToE);\n        if(wallCheck.perpDist > dist - 0.3) { closestHitDist=dist; closestEntity=e; }\n      }\n    }\n\n    if(closestEntity){\n      // Check ammo for non-infinite weapons\n      if(weapon.ammoMax !== Infinity && player.ammo <= 0){ return; } // no ammo!\n      if(weapon.ammoMax !== Infinity) player.ammo--;\n\n      closestEntity.health -= weapon.damage; hit=true;\n\n      // Blood particles on hit\n      for(let i=0;i<12;i++){\n        const eAngle=Math.random()*Math.PI*2, eSpeed=0.08+Math.random()*0.15;\n        particles.push({x:closestEntity.x,y:closestEntity.y,vx: Math.cos(eAngle)*eSpeed,vy: Math.sin(eAngle)*eSpeed,life:30,r:200+Math.random()*55|0,g:0,b:0});\n      }\n\n      if(closestEntity.health<=0){ closestEntity.alive=false; shootCooldown=weapon.cooldown; return; }\n    } else {\n      // Hit wall — sparks!\n      for(let i=0;i<4;i++){\n        const eAngle=Math.random()*Math.PI*2, eSpeed=0.05+Math.random()*0.1;\n        particles.push({x:player.x+(dx>0?0.8:-0.8),y:player.y+(dy>0?0.8:-0.8),vx: Math.cos(eAngle)*eSpeed,vy: Math.sin(eAngle)*eSpeed,life:15,r:255,g:200+Math.random()*55|0,b:50});\n      }\n    }\n\n  shootCooldown=weapon.cooldown;\n}\n\n// ============ SHOW MESSAGE (WIN/LOSE) ============\nfunction showMessage(text, color){\n  msgEl.textContent=text;\n  msgEl.style.color=color||'#FFD700';\n  msgEl.style.display='block';\n  setTimeout(()=>{msgEl.style.display='none'},3500);\n}\n\n// ============ INPUT HANDLING ============\nlet rotationDelta = 0; // accumulated mouse rotation per frame\n\ndocument.addEventListener('keydown', e => { keys[e.code]=true; if(e.code==='KeyR') weaponIndex=(weaponIndex+1)%weapons.length; });\ndocument.addEventListener('keyup',   e => { keys[e.code]=false; });\ncanvas.addEventListener('mousedown', () => { mouseDown=true; shoot(); });\ndocument.addEventListener('mouseup', () => { mouseDown=false; });\n\n// Mouse look via pointer lock (delta movement)\ndocument.addEventListener('mousemove', e => {\n  if(document.pointerLockElement === canvas){\n    rotationDelta += e.movementX * 0.0035; // sensitivity factor for smooth turning\n  }\n});\n\n// ============ GAME LOOP ============\nfunction gameLoop() {\n  update();\n  requestAnimationFrame(gameLoop);\n}\n\ngameLoop();\n</script>\n</body>\n</html>"},"status":"ok","ms":140}
