{"t":"2026-07-26T04:17:02.024Z","tool":"write_workbench_file","args":{"path":"/workspace/test_gameplay.py","content":"\"\"\"\nComprehensive automated gameplay tests for DOOM-like FPS game.\nTests: movement, mouse look, collision detection, shooting, enemy AI, pickups, HUD, win condition.\nUses Playwright to automate browser interactions and inject test logic via page.evaluate().\n\"\"\"\n\nimport json\nfrom playwright.sync_api import sync_playwright\n\ndef run_tests():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        ctx = browser.new_context(viewport={\"width\": 1280, \"height\": 720})\n        page = ctx.new_page()\n        \n        # Navigate to the game\n        print(\"Navigating to game...\")\n        page.goto(\"http://localhost:9101\", timeout=30000)\n        page.wait_for_timeout(2000)  # Let it load\n        \n        def test(name, fn):\n            try:\n                result = fn(page)\n                results.append({\"test\": name, \"status\": \"PASS\", \"detail\": str(result)})\n                print(f\"  ✅ PASS: {name}\")\n            except Exception as e:\n                results.append({\"test\": name, \"status\": \"FAIL\", \"detail\": str(e)[:200]})\n                print(f\"  ❌ FAIL: {name} — {e}\")\n        \n        # ==================== TEST 1: Game loads and canvas exists ====================\n        def test_game_loads(page):\n            result = page.evaluate(\"\"\"() => {\n                return {\n                    hasCanvas: !!document.getElementById('game'),\n                    hasHPDisplay: !!document.getElementById('hp'),\n                    hasAmmoDisplay: !!document.getElementById('ammo'),\n                    canvasWidth: document.getElementById('game')?.width || 0,\n                    canvasHeight: document.getElementById('game')?.height || 0,\n                };\n            }\"\"\")\n            \n            assert result['hasCanvas'], \"No game canvas found\"\n            assert result['canvasWidth'] > 0 and result['canvasHeight'] > 0, f\"Invalid canvas size: {result['canvasWidth']}x{result['canvasHeight']}\"\n            return json.dumps(result)\n        test(\"Game loads with canvas\", test_game_loads)\n        \n        # ==================== TEST 2: Player starts at correct position ====================\n        def test_player_start(page):\n            state = page.evaluate(\"\"\"() => {\n                return { x: player.x, y: player.y, angle: player.a };\n            }\"\"\")\n            \n            assert abs(state['x'] - game_map.px) < 0.5, f\"Wrong start X: expected ~{game_map.px}, got {state['x']}\"\n            assert abs(state['y'] - game_map.py) < 0.5, f\"Wrong start Y: expected ~{game_map.py}, got {state['y']}\"\n            return json.dumps(state)\n        test(\"Player starts at spawn\", lambda p: test_player_start(p))\n        \n        # ==================== TEST 3: Movement - WASD forward/backward ====================\n        def test_movement_forward(page):\n            page.evaluate(\"\"\"() => {\n                keys['w'] = true;\n            }\"\"\")\n            \n            # Simulate ~60 frames of movement (1 second at 60fps)\n            for _ in range(60):\n                page.evaluate(\"\"\"() => {\n                    const spd = player.spd || 0.05;\n                    const dx = Math.cos(player.a) * spd;\n                    const dy = Math.sin(player.a) * spd;\n                    const newX = player.x + dx;\n                    const newY = player.y + dy;\n                    \n                    // Simple collision check (same as game logic)\n                    if(game.grid[Math.floor(newY)][Math.floor(newX)] === 0) {\n                        player.x = newX;\n                        player.y = newY;\n                    }\n                }\"\"\")\n            \n            state = page.evaluate(\"\"\"() => ({ x: player.x, y: player.y })\"\"\")\n            \n            # Player should have moved forward (positive X since angle=0 means facing right)\n            assert state['x'] > game_map.px + 1.5, f\"Player didn't move enough forward: {state}\"\n            return json.dumps(state)\n        test(\"WASD movement - forward\", lambda p: test_movement_forward(p))\n        \n        # ==================== TEST 4: Collision detection with walls ====================\n        def test_collision(page):\n            page.evaluate(\"\"\"() => {\n                player.x = game_map.px;\n                player.y = game_map.py;\n                player.a = Math.PI / 2; // face up (negative Y)\n            }\"\"\")\n            \n            # Try to move forward for many frames - should hit a wall eventually\n            initial_y = page.evaluate(\"() => player.y\")\n            \n            for _ in range(100):\n                page.evaluate(\"\"\"() => {\n                    const spd = 0.05;\n                    const dx = Math.cos(player.a) * spd;\n                    const dy = Math.sin(player.a) * spd;\n                    const newX = player.x + dx;\n                    const newY = player.y + dy;\n                    \n                    if(game.grid[Math.floor(newY)][Math.floor(newX)] === 0) {\n                        player.x = newX;\n                        player.y = newY;\n                    }\n                }\"\"\")\n            \n            final_y = page.evaluate(\"() => player.y\")\n            \n            # Player should have moved but stopped at some wall\n            assert initial_y != final_y, \"Player didn't move in any direction\"\n            return json.dumps({\"initialY\": initial_y, \"finalY\": final_y})\n        test(\"Collision detection - walls block movement\", lambda p: test_collision(p))\n        \n        # ==================== TEST 5: Mouse look (angle change) ====================\n        def test_mouse_look(page):\n            page.evaluate(\"\"\"() => {\n                player.a = Math.PI / 4; // start at 45 degrees\n            }\"\"\")\n            \n            initial_angle = page.evaluate(\"() => player.a\")\n            \n            # Simulate mouse movement (right click drag)\n            for _ in range(20):\n                page.evaluate(\"\"\"() => {\n                    const sensitivity = 0.01;\n                    player.a += sensitivity; // turn right\n                }\"\"\")\n            \n            final_angle = page.evaluate(\"() => player.a\")\n            \n            assert final_angle > initial_angle, f\"Angle didn't increase: {initial_angle} -> {final_angle}\"\n            return json.dumps({\"start\": round(initial_angle, 4), \"end\": round(final_angle, 4)})\n        test(\"Mouse look - angle changes\", lambda p: test_mouse_look(p))\n        \n        # ==================== TEST 6: Shooting mechanics ====================\n        def test_shooting(page):\n            page.evaluate(\"\"\"() => {\n                player.ammo = 50;\n                shootCd = 999; // ensure not on cooldown\n            }\"\"\")\n            \n            initial_ammo = page.evaluate(\"() => player.ammo\")\n            \n            # Simulate shooting (same as game's shoot function)\n            for _ in range(3):\n                page.evaluate(\"\"\"() => {\n                    if(player.ammo > 0 && shootCd <= 0) {\n                        player.ammo--;\n                        playSound('shoot');\n                        // Simple raycast to check hit\n                        const dx = Math.cos(player.a);\n                        const dy = Math.sin(player.a);\n                        \n                        let mapX = Math.floor(player.x), mapY = Math.floor(player.y);\n                        for(let i=0; i<20; i++) {\n                            if(game.grid[mapY][mapX] > 0) break;\n                            mapX += Math.sign(dx);\n                            mapY += Math.sign(dy);\n                        }\n                    }\n                }\"\"\")\n            \n            final_ammo = page.evaluate(\"() => player.ammo\")\n            \n            assert initial_ammo == 50, f\"Ammo didn't start at 50: {initial_ammo}\"\n            assert final_ammo < initial_ammo, f\"Ammo not consumed on shoot: started {initial_ammo}, ended {final_ammo}\"\n            return json.dumps({\"start\": initial_ammo, \"end\": final_ammo})\n        test(\"Shooting - ammo decreases\", lambda p: test_shooting(p))\n        \n        # ==================== TEST 7: Empty gun sound/behavior ====================\n        def test_empty_gun(page):\n            page.evaluate(\"\"\"() => {\n                player.ammo = 0;\n            }\"\"\")\n            \n            empty_count_before = page.evaluate(\"() => window._emptyCount || 0\")\n            \n            # Try to shoot with no ammo\n            for _ in range(5):\n                page.evaluate(\"\"\"() => {\n                    if(player.ammo <= 0) {\n                        playSound('empty');\n                        window._emptyCount = (window._emptyCount || 0) + 1;\n                    }\n                }\"\"\")\n            \n            empty_count_after = page.evaluate(\"() => window._emptyCount || 0\")\n            \n            assert empty_count_after > empty_count_before, \"Empty gun sound not triggered\"\n            return json.dumps({\"empties\": empty_count_after})\n        test(\"Empty gun - plays click sound\", lambda p: test_empty_gun(p))\n        \n        # ==================== TEST 8: Enemy spawning and count ====================\n        def test_enemy_spawning(page):\n            enemies = page.evaluate(\"\"\"() => {\n                return enemies.map(e => ({\n                    x: e.x, y: e.y, hp: e.hp, state: e.state, alive: e.hp > 0\n                }));\n            }\"\"\")\n            \n            assert len(enemies) > 0, \"No enemies spawned\"\n            \n            # Check enemy properties\n            for en in enemies[:3]:  # check first 3\n                assert 'x' in en and 'y' in en, f\"Enemy missing position: {en}\"\n                assert en['hp'] > 0, f\"Enemy has no HP: {en}\"\n                assert en['state'] == 'patrol', f\"Enemy should start as patrol: got {en['state']}\"\n            \n            return json.dumps({\"count\": len(enemies), \"sample\": enemies[:2]})\n        test(\"Enemies spawn with correct initial state\", lambda p: test_enemy_spawning(p))\n        \n        # ==================== TEST 9: Enemy AI - chase behavior ====================\n        def test_enemy_chase(page):\n            page.evaluate(\"\"\"() => {\n                // Place player close to enemies so they detect\n                const firstEnemy = enemies[0];\n                if(firstEnemy) {\n                    player.x = firstEnemy.x + 1;\n                    player.y = firstEnemy.y + 1;\n                    \n                    // Update enemy sight range check\n                    for(const e of enemies) {\n                        const dx = player.x - e.x;\n                        const dy = player.y - e.y;\n                        const dist = Math.sqrt(dx*dx + dy*dy);\n                        \n                        if(dist < e.sightRange && e.state === 'patrol') {\n                            e.state = 'chase';\n                            e.dir = Math.atan2(dy, dx);\n                        }\n                    }\n                }\n            }\"\"\")\n            \n            enemy_states = page.evaluate(\"\"\"() => {\n                return enemies.map(e => ({ state: e.state, hp: e.hp }));\n            }\"\"\")\n            \n            has_chase = any(es['state'] == 'chase' for es in enemy_states)\n            assert has_chase, \"No enemy entered chase state\"\n            return json.dumps({\"states\": [es['state'] for es in enemy_states]})\n        test(\"Enemy AI - enters chase when player is near\", lambda p: test_enemy_chase(p))\n        \n        # ==================== TEST 10: Enemy takes damage and dies ====================\n        def test_enemy_damage(page):\n            page.evaluate(\"\"\"() => {\n                // Reset first enemy to known state\n                if(enemies.length > 0) {\n                    enemies[0].hp = 50;\n                    enemies[0].maxHp = 50;\n                    \n                    // Simulate hit (same as game's shoot raycast + damage logic)\n                    const e = enemies[0];\n                    const dx = player.x - e.x;\n                    const dy = player.y - e.y;\n                    const dist = Math.sqrt(dx*dx + dy*dy);\n                    \n                    if(dist < 15 && dist > 0.5) { // within range\n                        e.hp -= 20;\n                        e.hitFlash = 30;\n                        \n                        if(e.hp <= 0) {\n                            kills++;\n                            e.state = 'dead';\n                        }\n                    }\n                }\n            }\"\"\")\n            \n            enemy_data = page.evaluate(\"\"\"() => {\n                return enemies.length > 0 ? { hp: enemies[0].hp, state: enemies[0].state, kills: kills } : null;\n            }\"\"\")\n            \n            assert enemy_data is not None, \"No data returned\"\n            if enemy_data['hp'] < 50 and enemy_data['hp'] > 0:\n                return json.dumps({\"damage_applied\": True, \"remaining_hp\": enemy_data['hp'], \"state\": enemy_data['state']})\n            elif enemy_data['hp'] <= 0:\n                assert enemy_data['kills'] >= 1, \"Kill count not incremented\"\n                return json.dumps({\"enemy_dead\": True, \"kill_count\": enemy_data['kills']})\n            else:\n                raise AssertionError(f\"Enemy HP unchanged: {enemy_data}\")\n        test(\"Enemies take damage and can die\", lambda p: test_enemy_damage(p))\n        \n        # ==================== TEST 11: Health pickups ====================\n        def test_health_pickup(page):\n            page.evaluate(\"\"\"() => {\n                player.hp = 30; // low health\n                \n                if(items.length > 0) {\n                    const item = items[0];\n                    if(item.type === 'health' && item.active) {\n                        const dx = player.x - item.x;\n                        const dy = player.y - item.y;\n                        const dist = Math.sqrt(dx*dx + dy*dy);\n                        \n                        if(dist < 1.5) { // close enough to pickup\n                            item.active = false;\n                            player.hp = Math.min(player.maxHp, player.hp + 25);\n                            playSound('pickup');\n                        }\n                    }\n                }\n            }\"\"\")\n            \n            state = page.evaluate(\"\"\"() => ({ hp: player.hp, itemsActive: items.filter(i=>i.active).length })\"\"\")\n            \n            assert state['hp'] > 30, f\"Health not increased: {state}\"\n            return json.dumps(state)\n        test(\"Health pickups restore HP\", lambda p: test_health_pickup(p))\n        \n        # ==================== TEST 12: Ammo pickups ====================\n        def test_ammo_pickup(page):\n            page.evaluate(\"\"\"() => {\n                player.ammo = 5; // low ammo\n                \n                const ammoItem = items.find(i => i.type === 'ammo' && i.active);\n                if(ammoItem) {\n                    const dx = player.x - ammoItem.x;\n                    const dy = player.y - ammoItem.y;\n                    const dist = Math.sqrt(dx*dx + dy*dy);\n                    \n                    if(dist < 1.5) {\n                        ammoItem.active = false;\n                        player.ammo += 20;\n                        playSound('pickup');\n                    }\n                }\n            }\"\"\")\n            \n            state = page.evaluate(\"\"\"() => ({ ammo: player.ammo, itemsActive: items.filter(i=>i.active).length })\"\"\")\n            \n            assert state['ammo'] > 5, f\"Ammo not increased: {state}\"\n            return json.dumps(state)\n        test(\"Ammo pickups increase ammunition\", lambda p: test_ammo_pickup(p))\n        \n        # ==================== TEST 13: HUD updates via DOM ====================\n        def test_hud_updates(page):\n            page.evaluate(\"\"\"() => {\n                player.hp = 75;\n                player.ammo = 20;\n                \n                document.getElementById('hp').textContent = Math.round(player.hp);\n                document.getElementById('ammo').textContent = Math.round(player.ammo);\n            }\"\"\")\n            \n            hud_data = page.evaluate(\"\"\"() => ({\n                hpText: document.getElementById('hp')?.textContent,\n                ammoText: document.getElementById('ammo')?.textContent\n            })\"\"\")\n            \n            assert hud_data['hpText'] == '75', f\"HP display wrong: {hud_data}\"\n            assert hud_data['ammoText'] == '20', f\"Ammo display wrong: {hud_data}\"\n            return json.dumps(hud_data)\n        test(\"HUD DOM elements update correctly\", lambda p: test_hud_updates(p))\n        \n        # ==================== TEST 14: Win condition - all enemies dead ====================\n        def test_win_condition(page):\n            page.evaluate(\"\"\"() => {\n                kills = 0;\n                \n                // Kill ALL enemies at once\n                for(const e of enemies) {\n                    if(e.hp > 0) {\n                        e.hp = 0;\n                        e.state = 'dead';\n                        kills++;\n                    }\n                }\n            }\"\"\")\n            \n            win_data = page.evaluate(\"\"\"() => ({\n                totalEnemies: enemies.length,\n                aliveCount: enemies.filter(e=>e.hp>0).length,\n                kills: kills,\n                won: kills >= totalEnemies && totalEnemies > 0\n            })\"\"\")\n            \n            assert win_data['aliveCount'] == 0, f\"Still have living enemies: {win_data}\"\n            assert win_data['won'], \"Win condition not met despite all enemies dead\"\n            return json.dumps(win_data)\n        test(\"Win condition triggers when all enemies are killed\", lambda p: test_win_condition(p))\n        \n        # ==================== TEST 15: Lose condition - HP reaches zero ====================\n        def test_lose_condition(page):\n            page.evaluate(\"\"\"() => {\n                player.hp = 0;\n                \n                if(player.hp <= 0) {\n                    prevState = 'gameover';\n                }\n            }\"\"\")\n            \n            state = page.evaluate(\"\"\"() => ({ hp: player.hp, gameOverState: prevState })\"\"\")\n            \n            assert state['hp'] == 0, f\"HP not zero: {state}\"\n            assert state['gameOverState'] == 'gameover', \"Game over state not set\"\n            return json.dumps(state)\n        test(\"Lose condition triggers when HP reaches zero\", lambda p: test_lose_condition(p))\n        \n        # ==================== TEST 16: Raycasting - wall detection works ====================\n        def test_raycasting(page):\n            result = page.evaluate(\"\"\"() => {\n                const ray = castRay(player.x, player.y, player.a);\n                return { \n                    hit: ray.hit, \n                    dist: Math.round(ray.dist * 100) / 100,\n                    wallType: ray.texId || 'none',\n                    side: ray.side !== undefined ? (ray.side === 0 ? 'X' : 'Y') : 'unknown'\n                };\n            }\"\"\")\n            \n            assert result['hit'], \"Ray didn't hit anything\"\n            assert result['dist'] > 0, f\"Distance is zero or negative: {result}\"\n            return json.dumps(result)\n        test(\"Raycasting detects walls with correct distance\", lambda p: test_raycasting(p))\n        \n        # ==================== TEST 17: Multiple maps available ====================\n        def test_multiple_maps(page):\n            map_data = page.evaluate(\"\"\"() => ({\n                currentMapName: game.name,\n                totalMaps: maps.length,\n                hasSecondMap: maps[1] ? true : false,\n                secondMapName: maps[1]?.name || 'none'\n            })\"\"\")\n            \n            assert map_data['totalMaps'] >= 2, f\"Expected at least 2 maps, got {map_data['totalMaps']}\"\n            return json.dumps(map_data)\n        test(\"Multiple maps available in game\", lambda p: test_multiple_maps(p))\n        \n        # ==================== TEST 18: Minimap rendering data ====================\n        def test_minimap(page):\n            minimap = page.evaluate(\"\"\"() => {\n                if(!window.minimapData) return null;\n                \n                // Check that player position is on the minimap\n                const px = Math.floor(player.x);\n                const py = Math.floor(player.y);\n                \n                return {\n                    mapWidth: game.w,\n                    mapHeight: game.h,\n                    playerOnMap: px >= 0 && px < game.w && py >= 0 && py < game.h,\n                    gridAtPlayerPos: game.grid[py]?.[px] || 'out of bounds'\n                };\n            }\"\"\")\n            \n            assert minimap is not None, \"Minimap data unavailable\"\n            assert minimap['playerOnMap'], f\"Player not on map: {minimap}\"\n            return json.dumps(minimap)\n        test(\"Minimap shows player position correctly\", lambda p: test_minimap(p))\n        \n        # ==================== TEST 19: Texture generation for walls ====================\n        def test_textures(page):\n            textures = page.evaluate(\"\"\"() => {\n                const texIds = [1,2,3,4,5,6,7,8];\n                return texIds.map(id => ({\n                    id: id,\n                    hasTexture: !!texCache[String(id)],\n                    canvasWidth: texCache[String(id)]?.width || 0,\n                    canvasHeight: texCache[String(id)]?.height || 0\n                }));\n            }\"\"\")\n            \n            all_have_textures = all(t['hasTexture'] for t in textures)\n            assert all_have_textures, f\"Not all textures generated. Results: {json.dumps(textures)}\"\n            return json.dumps({\"texture_count\": len([t for t in textures if t['hasTexture']])})\n        test(\"All wall texture types are generated\", lambda p: test_textures(p))\n        \n        # ==================== TEST 20: Sprite rendering z-buffer occlusion ====================\n        def test_zbuffer(page):\n            result = page.evaluate(\"\"\"() => {\n                if(zBuf && zBuf.length > 0) {\n                    return {\n                        bufferSize: zBuf.length,\n                        hasValues: Array.from(zBuf).some(v => v < Infinity),\n                        rayCount: RAYS || 'unknown'\n                    };\n                }\n                return null;\n            }\"\"\")\n            \n            assert result is not None, \"Z-buffer unavailable\"\n            assert result['hasValues'], \"Z-buffer has no valid values\"\n            return json.dumps(result)\n        test(\"Z-buffer exists for sprite occlusion\", lambda p: test_zbuffer(p))\n        \n        # ==================== Summary ====================\n        print(\"\\n\" + \"=\"*60)\n        print(\"GAMEPLAY TEST RESULTS SUMMARY\")\n        print(\"=\"*60)\n        \n        passed = sum(1 for r in results if r['status'] == 'PASS')\n        failed = sum(1 for r in results if r['status'] == 'FAIL')\n        \n        print(f\"\\nTotal: {len(results)} tests\")\n        print(f\"✅ Passed: {passed}\")\n        print(f\"❌ Failed: {failed}\\n\")\n        \n        for r in results:\n            status_icon = \"✅\" if r['status'] == 'PASS' else \"❌\"\n            print(f\"{status_icon} {r['test']}\")\n            if r['detail']:\n                detail_preview = str(r['detail'])[:80]\n                if len(str(r['detail'])) > 80:\n                    detail_preview += \"...\"\n                print(f\"   → {detail_preview}\")\n        \n        browser.close()\n        \n        return passed, failed\n\nif __name__ == \"__main__\":\n    run_tests()\n"},"status":"ok","ms":144}
