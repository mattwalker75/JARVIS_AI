{"t":"2026-07-26T03:02:47.728Z","tool":"write_workbench_file","args":{"path":"/workspace/game/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>DOOM-like FPS</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #000; overflow: hidden; font-family: monospace; cursor: none; }\ncanvas#game { display: block; width: 100vw; height: 100vh; image-rendering: pixelated; }\n</style>\n</head>\n<body>\n<canvas id=\"game\"></canvas>\n<script>\n// ============================================================\n// DOOM-LIKE RAYCASTING ENGINE - Full Implementation\n// ============================================================\n\nconst canvas = document.getElementById('game');\nconst ctx = canvas.getContext('2d');\n\n// --- Constants ---\nconst SCREEN_W = 640;\nconst SCREEN_H = 384;\ncanvas.width = SCREEN_W;\ncanvas.height = SCREEN_H;\n\nconst FOV = Math.PI / 3; // 60 degrees\nconst HALF_FOV = FOV / 2;\nconst NUM_RAYS = SCREEN_W;\nconst MAX_DEPTH = 20;\nconst TILE_SIZE = 1;\nconst MOVE_SPEED = 3.0;\nconst ROT_SPEED = 2.5;\nconst MOUSE_SENSITIVITY = 0.002;\n\n// --- Map (0=empty, 1-6=walls of different types) ---\nconst MAP_W = 24;\nconst MAP_H = 24;\nconst map = [\n  // Row 0: border walls\n  \"######################\",\n  \"#........................#\",\n  \"#....####..............#.\",\n  \"#....#...#.............#.\",\n  \"#....#...#.............#.\",\n  \"#.................#####.#\",\n  \"#..................#....#.\",\n  \"#......###.......##.....#.\",\n  \"#......#.#.......#......#.\",\n  \"#......#.########.......#.\",\n  \"#..............#..........#\",\n  \"####.######...############.#\",\n  \"#...........#.............#.\",\n  \"#.........##............##..#\",\n  \"#........#..............#...\",#\",\n  \"#....###................#...\",#\",\n  \"#....#.#................#...\",#\",\n  \"#....#..########.......#.....#\",\n  \"#..........#......#...#......#\",\n  \"####.######..#####.###.........#\",\n  \"#...........#...............##.#\",\n  \"#..............................#\",\n  \"#..............................#\",\n  \"######################\"\n];\n\n// Fix map rows to be consistent width (24 chars each)\nconst MAP = [];\nfor (let y = 0; y < MAP_H; y++) {\n    let row = \"\";\n    for (let x = 0; x < MAP_W; x++) {\n        if (y === 0 || y === MAP_H-1 || x === 0 || x === MAP_W-1) {\n            row += \"#\";\n        } else if (MAP[y] && MAP[y][x]) {\n            row += MAP[y][x];\n        } else {\n            row += \".\";\n        }\n    }\n    MAP.push(row);\n}\n\n// Wall colors by type\nconst WALL_COLORS = {\n  '#': [128, 0, 0],     // Red brick wall\n  'a': [64, 64, 192],   // Blue stone\n  'b': [32, 128, 32],   // Green slime wall  \n  'c': [128, 128, 0],   // Yellow metal\n  'd': [128, 64, 128],  // Purple arcane\n  'e': [64, 128, 128],  // Cyan tech wall\n};\n\n// --- Player State ---\nlet player = {\n    x: 3.5, y: 3.5,        // Position (grid coords)\n    angle: 0,               // Facing direction in radians\n    health: 100,\n    ammo: 24,\n    weaponFrame: 0,\n    shooting: false,\n    shootTimer: 0,\n};\n\n// --- Input State ---\nconst keys = {};\nlet mouseDown = false;\ndocument.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });\ndocument.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\ncanvas.addEventListener('mousedown', () => { \n    canvas.requestPointerLock(); \n    mouseDown = true; \n});\ndocument.addEventListener('mouseup', () => { mouseDown = false; });\ndocument.addEventListener('mousemove', (e) => {\n    if (document.pointerLockElement === canvas) {\n        player.angle += e.movementX * MOUSE_SENSITIVITY;\n    }\n});\n\n// --- Z-Buffer for sprite occlusion ---\nlet zBuffer = new Float32Array(SCREEN_W);\n\n// ============================================================\n// TEXTURE GENERATION (procedural textures)\n// ============================================================\nconst TEX_SIZE = 64; // texture resolution\nfunction createTexture(type) {\n    const offscreen = document.createElement('canvas');\n    offscreen.width = TEX_SIZE;\n    offscreen.height = TEX_SIZE;\n    const octx = offscreen.getContext('2d');\n    \n    let r, g, b;\n    if (type === '#') { [r,g,b] = WALL_COLORS['#']; }\n    else if (type === 'a') { [r,g,b] = WALL_COLORS['a']; }\n    else if (type === 'b') { [r,g,b] = WALL_COLORS['b']; }\n    else if (type === 'c') { [r,g,b] = WALL_COLORS['c']; }\n    else if (type === 'd') { [r,g,b] = WALL_COLORS['d']; }\n    else if (type === 'e') { [r,g,b] = WALL_COLORS['e']; }\n    \n    // Base fill\n    octx.fillStyle = `rgb(${r},${g},${b})`;\n    octx.fillRect(0, 0, TEX_SIZE, TEX_SIZE);\n    \n    // Add noise/detail based on type\n    const imgData = octx.getImageData(0, 0, TEX_SIZE, TEX_SIZE);\n    for (let y = 0; y < TEX_SIZE; y++) {\n        for (let x = 0; x < TEX_SIZE; x++) {\n            const i = (y * TEX_SIZE + x) * 4;\n            \n            // Brick pattern or stone noise\n            if (type === '#') {\n                // Brick texture\n                let brickNoise = Math.random() * 20 - 10;\n                // Horizontal mortar lines\n                if (y % 8 < 1) brickNoise -= 40;\n                // Vertical mortar lines  \n                if (x % 16 < 1 || x % 16 > 13) brickNoise -= 25;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + brickNoise));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g * (0.6 + brickNoise/200)));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b * (0.4 + brickNoise/300)));\n            } else if (type === 'a') {\n                // Blue stone - hexagonal pattern\n                let noise = (Math.random() * 30 - 15);\n                let gridX = Math.sin(x * 0.8) * Math.cos(y * 0.6) * 20;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + noise));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g + gridX));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b + noise * 2));\n            } else if (type === 'b') {\n                // Green slime - dripping pattern\n                let drip = Math.sin(x * 0.3) * 15;\n                let noise = Math.random() * 25 - 12;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + noise));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g + drip + noise));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b * (0.3) + noise));\n            } else if (type === 'c') {\n                // Yellow metal - panel lines\n                let panelNoise = Math.random() * 15;\n                let lineX = x % 8 < 1 ? -30 : 0;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + panelNoise));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g * (0.7) + lineX));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b + panelNoise));\n            } else if (type === 'd') {\n                // Purple arcane - glowing runes pattern  \n                let glow = Math.sin(x * 1.2) * Math.cos(y * 1.2) * 30;\n                let rune = ((x + y) % 16 < 4 && x > 8 && x < 56 && y > 8 && y < 56) ? 40 : -20;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + glow));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g * (0.3) + rune));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b + glow + rune));\n            } else if (type === 'e') {\n                // Cyan tech - circuit board pattern\n                let circuit = ((x % 16 < 3) || (y % 16 < 3)) ? 40 : Math.random() * 20;\n                \n                imgData.data[i]     = Math.max(0, Math.min(255, r + circuit));\n                imgData.data[i + 1] = Math.max(0, Math.min(255, g + circuit));\n                imgData.data[i + 2] = Math.max(0, Math.min(255, b + circuit * 2));\n            } else {\n                // Default noise texture  \n                let n = Math.random() * 30 - 15;\n                imgData.data[i]     = r + n;\n                imgData.data[i+1]   = g + n;\n                imgData.data[i+2]   = b + n;\n            }\n        }\n    }\n    \n    octx.putImageData(imgData, 0, 0);\n    return offscreen;\n}\n\n// Generate all textures once at startup  \nconst textures = {};\nfor (let type in WALL_COLORS) {\n    textures[type] = createTexture(type);\n}\n\n// Floor/ceiling colors\nconst FLOOR_COLOR = [40, 35, 30];\nconst CEILING_COLOR = [20, 18, 25];\n\n// ============================================================\n// RAYCASTING ENGINE (DDA Algorithm)\n// ============================================================\nfunction castRay(ox, oy, angle) {\n    const sin = Math.sin(angle);\n    const cos = Math.cos(angle);\n    \n    // Direction vector\n    let dirX = cos;\n    let dirY = sin;\n    \n    // Current map position\n    let mapX = Math.floor(ox);\n    let mapY = Math.floor(oy);\n    \n    // Length of ray from current x,y position to next x- or y-side\n    const deltaDistX = Math.abs(1 / dirX);\n    const deltaDistY = Math.abs(1 / dirY);\n    \n    // Step direction and initial side distance  \n    let stepX, stepY;\n    let sideDistX, sideDistY;\n    \n    if (dirX < 0) {\n        stepX = -1;\n        sideDistX = (ox - mapX) * deltaDistX;\n    } else {\n        stepX = 1;\n        sideDistX = (mapX + 1.0 - ox) * deltaDistX;\n    }\n    \n    if (dirY < 0) {\n        stepY = -1;\n        sideDistY = (oy - mapY) * deltaDistY;\n    } else {\n        stepY = 1;\n        sideDistY = (mapY + 1.0 - oy) * deltaDistY;\n    }\n    \n    let hit = false;\n    let side = 0; // 0=NS wall, 1=E-W wall\n    \n    // DDA loop\n    while (!hit && sideDistX < MAX_DEPTH && sideDistY < MAX_DEPTH) {\n        if (sideDistX < sideDistY) {\n            sideDistX += deltaDistX;\n            mapX += stepX;\n            side = 0;\n        } else {\n            sideDistY += deltaDistY;\n            mapY += stepY;\n            side = 1;\n        }\n        \n        // Check bounds\n        if (mapX < 0 || mapX >= MAP_W || mapY < 0 || mapY >= MAP_H) {\n            hit = true;\n            return { distance: MAX_DEPTH, wallType: '#', side, texCoord: 0 };\n        }\n        \n        const cell = MAP[mapY][mapX];\n        if (cell !== '.' && cell !== ' ') {\n            hit = true;\n            \n            // Calculate exact wall intersection for texture coordinate\n            let wallX;\n            if (side === 0) {\n                wallX = oy + sideDistY * dirY;\n            } else {\n                wallX = ox + sideDistX * dirX;\n            }\n            wallX -= Math.floor(wallX); // fractional part\n            \n            return { \n                distance: side === 0 ? sideDistY - deltaDistY : sideDistX - deltaDistX,\n                wallType: cell, \n                side,\n                texCoord: wallX\n            };\n        }\n    }\n    \n    return { distance: MAX_DEPTH, wallType: '#', side, texCoord: 0 };\n}\n\n// ============================================================\n// RENDERING\n// ============================================================\nfunction render() {\n    // --- Clear to ceiling/floor gradient ---\n    const ceilGrad = ctx.createLinearGradient(0, 0, 0, SCREEN_H / 2);\n    ceilGrad.addColorStop(0, '#1a1520');\n    ceilGrad.addColorStop(1, CEILING_COLOR.join(','));\n    ctx.fillStyle = ceilGrad;\n    ctx.fillRect(0, 0, SCREEN_W, SCREEN_H / 2);\n    \n    const floorGrad = ctx.createLinearGradient(0, SCREEN_H / 2, 0, SCREEN_H);\n    floorGrad.addColorStop(0, FLOOR_COLOR.join(','));\n    floorGrad.addColorStop(1, '#3a3530');\n    ctx.fillStyle = floorGrad;\n    ctx.fillRect(0, SCREEN_H / 2, SCREEN_W, SCREEN_H / 2);\n    \n    // --- Cast rays and render walls ---\n    for (let col = 0; col < NUM_RAYS; col++) {\n        const rayAngle = player.angle - HALF_FOV + (col / NUM_RAYS) * FOV;\n        \n        // Normalize angle\n        let normAngle = rayAngle % (2 * Math.PI);\n        if (normAngle < 0) normAngle += 2 * Math.PI;\n        \n        const result = castRay(player.x, player.y, normAngle);\n        \n        // Fix fisheye effect\n        const perpDist = result.distance * Math.cos(normAngle - player.angle);\n        zBuffer[col] = perpDist;\n        \n        if (result.wallType === '.' || result.wallType === ' ') continue;\n        \n        // Calculate wall height on screen  \n        const lineHeight = SCREEN_H / perpDist;\n        const drawStart = Math.max(0, Math.floor((SCREEN_H - lineHeight) / 2));\n        const drawEnd = Math.min(SCREEN_H - 1, Math.ceil((SCREEN_H + lineHeight) / 2));\n        \n        // Get texture coordinates  \n        let texChar = result.wallType;\n        if (!textures[texChar]) {\n            // Try to find a matching key or use default\n            for (let k in textures) {\n                if (k === '#') { texChar = '#'; break; }\n            }\n        }\n        \n        const texture = textures[result.wallType] || textures['#'];\n        const texX = Math.floor(result.texCoord * TEX_SIZE);\n        \n        // Draw the vertical strip of textured wall\n        if (lineHeight > 0 && drawEnd > drawStart) {\n            ctx.drawImage(\n                texture, \n                texX, 0, 1, TEX_SIZE,  // source: single column from texture\n                col, drawStart, 1, drawEnd - drawStart  // dest: vertical strip on screen\n            );\n            \n            // Apply shading based on distance and side\n            const shade = Math.max(0.15, 1.0 - perpDist / MAX_DEPTH);\n            ctx.fillStyle = `rgba(0,0,0,${1.0 - shade})`;\n            ctx.fillRect(col, drawStart, 1, drawEnd - drawStart);\n            \n            // Darken side walls for depth perception\n            if (result.side === 1) {\n                ctx.fillStyle = 'rgba(0,0,0,0.25)';\n                ctx.fillRect(col, drawStart, 1, drawEnd - drawStart);\n            }\n        }\n    }\n    \n    // --- Draw weapon (bottom center of screen) ---\n    drawWeapon();\n    \n    // --- Draw crosshair ---\n    const cx = SCREEN_W / 2;\n    const cy = SCREEN_H / 2;\n    ctx.strokeStyle = 'rgba(0,255,0,0.7)';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(cx - 8, cy); ctx.lineTo(cx + 8, cy);\n    ctx.moveTo(cx, cy - 8); ctx.lineTo(cx, cy + 8);\n    ctx.stroke();\n    \n    // --- Draw HUD ---\n    drawHUD();\n}\n\n// ============================================================\n// WEAPON RENDERING\n// ============================================================\nfunction drawWeapon() {\n    const weaponW = 160;\n    const weaponH = 140;\n    const wx = (SCREEN_W - weaponW) / 2;\n    const wy = SCREEN_H - weaponH + Math.sin(Date.now()/300) * 5; // subtle bob\n    \n    if (player.shooting && player.shootTimer > 0) {\n        // Muzzle flash\n        ctx.fillStyle = `rgba(255, ${180 + Math.random()*75}, 0, ${Math.min(1, player.shootTimer/3)})`;\n        ctx.beginPath();\n        const mx = SCREEN_W / 2;\n        const my = cy - 60;\n        for (let i = 0; i < 8; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const r = 15 + Math.random() * 30;\n            ctx.lineTo(mx + Math.cos(angle) * r, my + Math.sin(angle) * r);\n        }\n        ctx.fill();\n    }\n    \n    // Gun body (pixel art style using rectangles)\n    ctx.fillStyle = '#4a4a52';\n    ctx.fillRect(wx + 60, wy + 30, 40, weaponH - 30);\n    \n    // Barrel  \n    ctx.fillStyle = '#3a3a42';\n    ctx.fillRect(wx + 70, wy + 10, 20, 35);\n    \n    // Grip detail\n    ctx.fillStyle = '#38383e';\n    ctx.fillRect(wx + 65, wy + weaponH - 50, 30, 40);\n    \n    // Sight  \n    ctx.fillStyle = '#5a5a62';\n    ctx.fillRect(wx + 75, wy + 5, 10, 8);\n    \n    // Trigger guard\n    ctx.strokeStyle = '#4a4a52';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.arc(wx + 80, wy + weaponH - 30, 12, Math.PI * 0.3, Math.PI * 0.7);\n    ctx.stroke();\n}\n\n// ============================================================\n// HUD RENDERING  \n// ============================================================\nfunction drawHUD() {\n    const hudY = SCREEN_H - 48;\n    \n    // Background bar\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(0, hudY, SCREEN_W, 48);\n    \n    // Health (red heart icon + number)\n    ctx.font = 'bold 16px monospace';\n    ctx.textAlign = 'left';\n    \n    // Heart symbol  \n    drawHeart(20, hudY + 30, 12);\n    \n    const healthColor = player.health > 50 ? '#ff4444' : (player.health > 25 ? '#ff8844' : '#ff2222');\n    ctx.fillStyle = healthColor;\n    ctx.fillText(`${Math.ceil(player.health)}`, 36, hudY + 38);\n    \n    // Ammo  \n    drawAmmoIcon(100, hudY + 30);\n    ctx.fillStyle = '#ffcc44';\n    ctx.fillText(`${player.ammo}`, 125, hudY + 38);\n    \n    // Minimap (top right)\n    drawMinimap();\n}\n\nfunction drawHeart(x, y, size) {\n    ctx.beginPath();\n    const topCurveHeight = size * 0.4;\n    ctx.moveTo(x, y + topCurveHeight);\n    // Left curve\n    ctx.bezierCurveTo(\n        x - size/2, y - size/3, \n        x - size, y + size/3, \n        x, y + size  \n    );\n    // Right curve\n    ctx.bezierCurveTo(\n        x + size, y + size/3, \n        x + size/2, y - size/3, \n        x, y + topCurveHeight\n    );\n    ctx.fill();\n}\n\nfunction drawAmmoIcon(x, y) {\n    // Simple bullet shape  \n    ctx.fillStyle = '#ffcc44';\n    ctx.fillRect(x + 8, y - 5, 6, 12);\n    ctx.beginPath();\n    ctx.arc(x + 11, y - 7, 3, Math.PI, 0);\n    ctx.fill();\n}\n\nfunction drawMinimap() {\n    const mmSize = 4; // pixels per cell  \n    const mmW = MAP_W * mmSize;\n    const mmH = MAP_H * mmSize;\n    const mmX = SCREEN_W - mmW - 10;\n    const mmY = 10;\n    \n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(mmX - 2, mmY - 2, mmW + 4, mmH + 4);\n    \n    // Draw map cells  \n    for (let y = 0; y < MAP_H; y++) {\n        for (let x = 0; x < MAP_W; x++) {\n            const cell = MAP[y][x];\n            if (cell !== '.' && cell !== ' ') {\n                ctx.fillStyle = '#666';\n                ctx.fillRect(mmX + x * mmSize, mmY + y * mmSize, mmSize - 1, mmSize - 1);\n            }\n        }\n    }\n    \n    // Draw player on minimap  \n    const pmx = mmX + Math.floor(player.x * mmSize);\n    const pmy = mmY + Math.floor(player.y * mmSize);\n    ctx.fillStyle = '#0f0';\n    ctx.fillRect(pmx - 1, pmy - 1, 3, 3);\n    \n    // Draw direction indicator  \n    ctx.strokeStyle = '#0f0';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(pmx, pmy);\n    ctx.lineTo(\n        pmx + Math.cos(player.angle) * 8, \n        pmy + Math.sin(player.angle) * 8\n    );\n    ctx.stroke();\n}\n\n// ============================================================\n// PLAYER UPDATE (movement, collision, shooting)  \n// ============================================================\nfunction update(dt) {\n    // --- Rotation via keyboard (Q/E as backup to mouse) ---\n    if (keys['q']) player.angle -= ROT_SPEED * dt;\n    if (keys['e']) player.angle += ROT_SPEED * dt;\n    \n    // --- Movement direction ---  \n    let moveX = 0, moveY = 0;\n    const cos = Math.cos(player.angle);\n    const sin = Math.sin(player.angle);\n    \n    if (keys['w'] || keys['arrowup']) {\n        moveX += MOVE_SPEED * dt * cos;\n        moveY += MOVE_SPEED * dt * sin;\n    }\n    if (keys['s'] || keys['arrowdown']) {\n        moveX -= MOVE_SPEED * dt * cos;\n        moveY -= MOVE_SPEED * dt * sin;\n    }\n    \n    // Strafe  \n    const strafeCos = Math.cos(player.angle - Math.PI/2);\n    const strafeSin = Math.sin(player.angle - Math.PI/2);\n    if (keys['a'] || keys['arrowleft']) {\n        moveX += MOVE_SPEED * dt * strafeCos;\n        moveY += MOVE_SPEED * dt * strafeSin;\n    }\n    if (keys['d'] || keys['arrowright']) {\n        moveX -= MOVE_SPEED * dt * strafeCos;\n        moveY -= MOVE_SPEED * dt * strafeSin;\n    }\n    \n    // --- Collision detection with sliding along walls ---  \n    const margin = 0.25; // collision buffer\n    \n    let newX = player.x + moveX;\n    let newY = player.y + moveY;\n    \n    // Check X movement against map (with wall slide)\n    if (moveX !== 0) {\n        const checkX = Math.floor(newX + margin * Math.sign(moveX));\n        const checkY1 = Math.floor(player.y - margin);\n        const checkY2 = Math.floor(player.y + margin);\n        \n        let blockedX = false;\n        if (checkX > 0 && checkX < MAP_W-1) {\n            for (let cy of [checkY1, checkY2]) {\n                if (cy > 0 && cy < MAP_H-1 && MAP[cy][checkX] !== '.' && MAP[cy][checkX] !== ' ') {\n                    blockedX = true;\n                    break;\n                }\n            }\n        }\n        \n        if (!blockedX) player.x = newX;\n    }\n    \n    // Check Y movement against map (with wall slide)  \n    if (moveY !== 0) {\n        const checkX1 = Math.floor(player.x - margin);\n        const checkX2 = Math.floor(player.x + margin);\n        const checkY = Math.floor(newY + margin * Math.sign(moveY));\n        \n        let blockedY = false;\n        if (checkY > 0 && checkY < MAP_H-1) {\n            for (let cx of [checkX1, checkX2]) {\n                if (cx > 0 && cx < MAP_W-1 && MAP[checkY][cx] !== '.' && MAP[checkY][cx] !== ' ') {\n                    blockedY = true;\n                    break;\n                }\n            }\n        }\n        \n        if (!blockedY) player.y = newY;\n    }\n    \n    // --- Shooting ---  \n    if (mouseDown || keys[' '] || keys['f']) {\n        shoot();\n    }\n    \n    if (player.shootTimer > 0) player.shootTimer--;\n}\n\nfunction shoot() {\n    if (!player.shooting || player.shootTimer <= 0) {\n        if (player.ammo > 0) {\n            player.shooting = true;\n            player.shootTimer = 8; // frames for muzzle flash  \n            player.ammo--;\n            \n            // Simple hit detection along ray direction\n            const cos = Math.cos(player.angle);\n            const sin = Math.sin(player.angle);\n            \n            let dist = 0.5;\n            while (dist < MAX_DEPTH) {\n                const checkX = Math.floor(player.x + cos * dist);\n                const checkY = Math.floor(player.y + sin * dist);\n                \n                if (checkX > 0 && checkX < MAP_W-1 && checkY > 0 && checkY < MAP_H-1) {\n                    // Check for enemies at this position would go here  \n                    break;\n                }\n                dist += 0.5;\n            }\n        } else {\n            player.shooting = false; // Out of ammo, can't shoot\n        }\n    }\n}\n\n// ============================================================\n// GAME LOOP\n// ============================================================\nlet lastTime = performance.now();\n\nfunction gameLoop(timestamp) {\n    const dt = Math.min((timestamp - lastTime) / 1000, 0.05); // cap delta time  \n    lastTime = timestamp;\n    \n    update(dt);\n    render();\n    \n    requestAnimationFrame(gameLoop);\n}\n\n// ============================================================\n// START GAME\n// ============================================================\nconsole.log('DOOM-like FPS loaded!');\nconsole.log('Controls: WASD to move, Mouse to look, Click/Space/F to shoot, Q/E for keyboard turn');\nrequestAnimationFrame(gameLoop);\n</script>\n</body>\n</html>\n"},"status":"ok","ms":140}
