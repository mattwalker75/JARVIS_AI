{"t":"2026-07-26T04:17:48.812Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_context(viewport={'width':1280,'height':720}).new_page()\n    \n    errors = []\n    def on_console(msg):\n        if msg.type == 'error' or 'Error' in str(msg.text).lower():\n            errors.append(f'{msg.type}: {msg.text}')\n    page.on('console', lambda m: print(f'[LOG] [{m.type}] {m.text}'))\n    page.on('pageerror', lambda e: errors.append(str(e)))\n    \n    page.goto('http://localhost:9101', timeout=30000)\n    page.wait_for_timeout(3000)  # Wait longer for init\n    \n    if errors:\n        print('\\\\n--- ERRORS ---')\n        for e in errors:\n            print(e)\n    \n    result = page.evaluate('''() => {\n        const keys = Object.keys(window).filter(k => \n            ['player','enemies','items','game','maps','shootCd','zBuf','RAYS','totalEnemies'].includes(k));\n        return { foundKeys: keys, playerType: typeof window.player };\n    }''')\n    print(result)\n    \n    browser.close()\n\" 2>&1\n","timeout_s":30},"status":"ok","ms":3386}
