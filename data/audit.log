{"t":"2026-07-25T04:28:52.494Z","tool":"write_workbench_file","args":{"path":"/workspace/property_manager/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>PropFlow — Property Management</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\"/>\n  <style>body{font-family:'Inter',sans-serif}</style>\n</head>\n<body class=\"bg-gray-50 text-gray-800 h-screen flex overflow-hidden\">\n\n<!-- Sidebar -->\n<aside id=\"sidebar\" class=\"w-64 bg-slate-900 text-white flex flex-col shadow-xl z-20 transition-all duration-300\">\n  <div class=\"p-5 border-b border-slate-700 flex items-center gap-3\">\n    <div class=\"w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center font-bold text-white\">PF</div>\n    <h1 class=\"text-xl font-semibold tracking-tight\">PropFlow</h1>\n  </div>\n  <nav class=\"flex-1 p-4 space-y-2 overflow-y-auto\">\n    <button onclick=\"navigate('dashboard')\" id=\"nav-dashboard\" class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-slate-700 transition flex items-center gap-2 bg-blue-600 font-medium\">📊 Dashboard</button>\n    <button onclick=\"navigate('properties')\" id=\"nav-properties\" class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-slate-700 transition flex items-center gap-2\">🏢 Properties</button>\n    <button onclick=\"navigate('tenants')\" id=\"nav-tenants\" class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-slate-700 transition flex items-center gap-2\">👥 Tenants</button>\n    <button onclick=\"navigate('maintenance')\" id=\"nav-maintenance\" class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-slate-700 transition flex items-center gap-2\">🔧 Maintenance</button>\n    <button onclick=\"navigate('finances')\" id=\"nav-finances\" class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-slate-700 transition flex items-center gap-2\">💰 Finances</button>\n  </nav>\n  <div class=\"p-4 border-t border-slate-700 text-xs text-slate-400\">v1.0 • Demo Mode</div>\n</aside>\n\n<!-- Main Content -->\n<main id=\"main\" class=\"flex-1 flex flex-col overflow-hidden relative\">\n  <!-- Header -->\n  <header class=\"bg-white border-b px-6 py-3 flex items-center justify-between shadow-sm z-10\">\n    <h2 id=\"page-title\" class=\"text-lg font-semibold text-gray-800\">Dashboard</h2>\n    <div class=\"flex items-center gap-4\">\n      <span class=\"text-sm text-gray-500\">Demo Account • Admin</span>\n      <div class=\"w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-semibold\">A</div>\n    </div>\n  </header>\n\n  <!-- Content Area -->\n  <div id=\"content\" class=\"flex-1 overflow-y-auto p-6\"></div>\n</main>\n\n<!-- Detail Modal Overlay (hidden by default) -->\n<div id=\"modal-overlay\" class=\"fixed inset-0 bg-black/40 z-50 hidden flex items-center justify-center backdrop-blur-sm\">\n  <div id=\"modal-content\" class=\"bg-white rounded-xl shadow-2xl w-full max-w-3xl p-6 relative max-h-[90vh] overflow-y-auto\"></div>\n</div>\n\n<script>\n// ================= DATA STORE =================\nconst state = {\n  currentView: 'dashboard',\n  searchQuery: '',\n  maintenanceFilter: 'all'\n};\n\nlet properties = [\n  { id:'P1', name:'Sunset Apartments', address:'420 Sunset Blvd, Austin TX', units:8, occupied:7, rentPerUnit:1650, status:'active', image:'🏢' },\n  { id:'P2', name:'Oakwood Condos', address:'118 Oak St, Denver CO', units:4, occupied:3, rentPerUnit:2100, status:'active', image:'🏬' },\n  { id:'P3', name:'Riverside Townhomes', address:'55 River Rd, Portland OR', units:6, occupied:5, rentPerUnit:1875, status:'active', image:'🏘️' },\n  { id:'P4', name:'Maple Grove Duplexes', address:'203 Maple Ave, Nashville TN', units:4, occupied:4, rentPerUnit:1450, status:'active', image:'🏡' }\n];\n\nlet tenants = [\n  { id:'T1', name:'Sarah Chen', propertyId:'P1', unit:'2B', leaseStart:'2023-06-01', leaseEnd:'2025-05-31', rent:1650, status:'current', email:'sarah.c@email.com', phone:'(512) 555-0142' },\n  { id:'T2', name:'Marcus Johnson', propertyId:'P1', unit:'4A', leaseStart:'2023-09-01', leaseEnd:'2025-08-31', rent:1650, status:'current', email:'marcus.j@email.com', phone:'(512) 555-0198' },\n  { id:'T3', name:'Elena Rodriguez', propertyId:'P2', unit:'3C', leaseStart:'2024-01-15', leaseEnd:'2026-01-14', rent:2100, status:'current', email:'elena.r@email.com', phone:'(720) 555-0287' },\n  { id:'T4', name:'David Kim', propertyId:'P3', unit:'1A', leaseStart:'2022-11-01', leaseEnd:'2024-10-31', rent:1875, status:'expiring_soon', email:'david.k@email.com', phone:'(503) 555-0331' },\n  { id:'T5', name:'Priya Patel', propertyId:'P2', unit:'2B', leaseStart:'2024-06-01', leaseEnd:'2026-05-31', rent:2100, status:'current', email:'priya.p@email.com', phone:'(720) 555-0419' },\n  { id:'T6', name:'James Wilson', propertyId:'P4', unit:'B', leaseStart:'2023-03-01', leaseEnd:'2025-02-28', rent:1450, status:'current', email:'james.w@email.com', phone:'(615) 555-0576' }\n];\n\nlet maintenance = [\n  { id:'M1', propertyId:'P1', tenantId:'T1', title:'Kitchen faucet leaking badly', priority:'high', status:'open', created:'2024-11-08', notes:'Dripping onto counter, needs washer replacement.' },\n  { id:'M2', propertyId:'P3', tenantId:'T4', title:'Thermostat not responding to settings', priority:'medium', status:'in_progress', created:'2024-11-10', notes:'HVAC tech scheduled for Nov 15.' },\n  { id:'M3', propertyId:'P2', tenantId:'T3', title:'Bathroom tile crack in shower', priority:'low', status:'open', created:'2024-11-12', notes:'Cosmetic but water may seep behind wall.' },\n  { id:'M4', propertyId:'P4', tenantId:'T6', title:'Front door lock sticking', priority:'high', status:'resolved', created:'2024-10-30', resolvedDate:'2024-11-05', notes:'Lock cylinder replaced. Tenant confirmed working.' },\n  { id:'M5', propertyId:'P1', tenantId:'T2', title:'Balcony railing loose on west side', priority:'medium', status:'open', created:'2024-11-13', notes:'Wobbles when leaned against. Safety concern.' }\n];\n\nlet finances = [\n  { id:'F1', tenantId:'T1', month:'November 2024', amount:1650, paid:true, paidDate:'2024-11-01' },\n  { id:'F2', tenantId:'T2', month:'November 2024', amount:1650, paid:false, dueDate:'2024-11-01' },\n  { id:'F3', tenantId:'T3', month:'November 2024', amount:2100, paid:true, paidDate:'2024-10-31' },\n  { id:'F4', tenantId:'T4', month:'November 2024', amount:1875, paid:false, dueDate:'2024-11-01' },\n  { id:'F5', tenantId:'T5', month:'November 2024', amount:2100, paid:true, paidDate:'2024-11-03' },\n  { id:'F6', tenantId:'T6', month:'November 2024', amount:1450, paid:false, dueDate:'2024-11-01' }\n];\n\n// ================= HELPERS =================\nconst getProp = id => properties.find(p=>p.id===id);\nconst getTenant = id => tenants.find(t=>t.id===id);\nconst formatCurrency = n => '$'+n.toLocaleString();\nconst daysUntil = d => { const diff=new Date(d)-new Date(); return Math.ceil(diff/86400000); };\n\n// ================= NAVIGATION =================\nfunction navigate(view) {\n  state.currentView = view;\n  document.querySelectorAll('aside button').forEach(b=>b.classList.remove('bg-blue-600','font-medium'));\n  const activeBtn = document.getElementById('nav-'+view);\n  if(activeBtn){activeBtn.classList.add('bg-blue-600','font-medium');}\n  \n  const titles = {dashboard:'Dashboard',properties:'Properties',tenants:'Tenants Directory',maintenance:'Maintenance Queue',finances:'Finances & Rent Roll'};\n  document.getElementById('page-title').textContent = titles[view] || 'PropFlow';\n  renderView();\n}\n\n// ================= RENDERERS =================\nfunction renderView(){\n  const c = document.getElementById('content');\n  switch(state.currentView){\n    case 'dashboard': c.innerHTML = renderDashboard(); break;\n    case 'properties': c.innerHTML = renderProperties(); break;\n    case 'tenants': c.innerHTML = renderTenants(); break;\n    case 'maintenance': c.innerHTML = renderMaintenance(); break;\n    case 'finances': c.innerHTML = renderFinances(); break;\n  }\n}\n\nfunction renderDashboard(){\n  const totalUnits = properties.reduce((s,p)=>s+p.units,0);\n  const occupied = tenants.filter(t=>t.status==='current').length;\n  const occupancyRate = ((occupied/totalUnits)*100).toFixed(1);\n  const monthlyRevenue = finances.reduce((s,f)=>s+(f.paid?f.amount:0),0);\n  const outstanding = finances.reduce((s,f)=>s+(!f.paid?f.amount:0),0);\n  const openTickets = maintenance.filter(m=>m.status==='open').length;\n\n  return `\n    <div class=\"space-y-6\">\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5\">\n        ${kpiCard('Total Units', totalUnits, '🏢')}\n        ${kpiCard('Occupancy Rate', occupancyRate+'%', parseFloat(occupancyRate)>80?'text-green-600':'text-yellow-600')}\n        ${kpiCard('Monthly Revenue Collected', formatCurrency(monthlyRevenue), 'text-blue-600')}\n        ${kpiCard('Outstanding Rent', formatCurrency(outstanding), outstanding>4000?'text-red-500':'text-green-600')}\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <div class=\"bg-white rounded-xl shadow-sm border p-5\">\n          <h3 class=\"font-semibold mb-4 flex items-center gap-2\">🔧 Open Maintenance Tickets</h3>\n          ${maintenance.filter(m=>m.status==='open').length===0?'<p class=\"text-gray-500 text-sm\">All clear!</p>':''}\n          <div class=\"space-y-3\">\n            ${maintenance.filter(m=>m.status==='open').map(t=>`\n              <div class=\"flex items-center justify-between p-3 bg-gray-50 rounded-lg border hover:shadow-sm transition cursor-pointer\" onclick=\"showMaintenanceDetail('${t.id}')\">\n                <div>\n                  <p class=\"font-medium text-sm\">${t.title}</p>\n                  <p class=\"text-xs text-gray-500 mt-1\">${getProp(t.propertyId)?.name} • ${getTenant(t.tenantId)?.name || 'Unknown'}</p>\n                </div>\n                <span class=\"px-2 py-1 rounded-full text-xs font-medium ${t.priority==='high'?'bg-red-100 text-red-700':t.priority==='medium'?'bg-yellow-100 text-yellow-800':'bg-blue-100 text-blue-700'}\">${t.priority}</span>\n              </div>`).join('')}\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow-sm border p-5\">\n          <h3 class=\"font-semibold mb-4 flex items-center gap-2\">📅 Lease Expirations (Next 90 Days)</h3>\n          ${tenants.filter(t=>daysUntil(t.leaseEnd)<=90).length===0?'<p class=\"text-gray-500 text-sm\">No upcoming expirations.</p>':''}\n          <div class=\"space-y-3\">\n            ${tenants.filter(t=>daysUntil(t.leaseEnd)<=90).map(t=>`\n              <div class=\"flex items-center justify-between p-3 bg-gray-50 rounded-lg border cursor-pointer hover:shadow-sm transition\" onclick=\"showTenantDetail('${t.id}')\">\n                <div>\n                  <p class=\"font-medium text-sm\">${getProp(t.propertyId)?.name} • Unit ${t.unit}</p>\n                  <p class=\"text-xs text-gray-500 mt-1\">${t.name}</p>\n                </div>\n                <span class=\"px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-700\">${daysUntil(t.leaseEnd)} days left</span>\n              </div>`).join('')}\n          </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow-sm border p-5 lg:col-span-2\">\n          <h3 class=\"font-semibold mb-4 flex items-center gap-2\">📊 Quick Actions</h3>\n          <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            ${actionBtn('Send Rent Reminder','💳',()=>navigate('finances'))}\n            ${actionBtn('Schedule Property Inspection','🔍',()=>navigate('properties'))}\n            ${actionBtn('View Maintenance Queue','🛠️',()=>navigate('maintenance'))}\n          </div>\n        </div>\n      </div>\n    </div>`;\n}\n\nfunction kpiCard(label, value, colorClass){\n  return `\n    <div class=\"bg-white rounded-xl shadow-sm border p-5 hover:shadow-md transition\">\n      <p class=\"text-xs font-medium text-gray-400 uppercase tracking-wide\">${label}</p>\n      <p class=\"${colorClass} text-2xl font-bold mt-1\">${value}</p>\n    </div>`;\n}\n\nfunction actionBtn(label, icon, fn){\n  return `<button onclick=\"fn()\" class=\"flex items-center gap-3 p-4 bg-blue-50 hover:bg-blue-100 rounded-xl border border-blue-200 transition text-left\">\n    <span class=\"text-2xl\">${icon}</span>\n    <span class=\"font-medium text-sm text-blue-800\">${label}</span>\n  </button>`;\n}\n\nfunction renderProperties(){\n  const filtered = properties.filter(p => !state.searchQuery || p.name.toLowerCase().includes(state.searchQuery) || p.address.toLowerCase().includes(state.searchQuery));\n  return `\n    <div class=\"space-y-5\">\n      <div class=\"flex items-center gap-3 bg-white rounded-xl border shadow-sm px-4 py-2 max-w-md\">\n        🔍 <input id=\"prop-search\" type=\"text\" placeholder=\"Search properties...\" value=\"${state.searchQuery}\" oninput=\"handlePropSearch(this.value)\" class=\"w-full outline-none text-sm\"/>\n      </div>\n      ${filtered.length===0?'<p class=\"text-gray-500\">No matches found.</p>':''}\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        ${filtered.map(p=>{\n          const occRate = ((tenants.filter(t=>t.propertyId===p.id&&t.status==='current').length/p.units)*100).toFixed(0);\n          return `\n            <div class=\"bg-white rounded-xl shadow-sm border p-5 hover:shadow-md transition cursor-pointer\" onclick=\"showPropertyDetail('${p.id}')\">\n              <div class=\"flex items-start justify-between mb-3\">\n                <div>\n                  <h4 class=\"font-semibold text-lg\">${p.image} ${p.name}</h4>\n                  <p class=\"text-sm text-gray-500 mt-1\">${p.address}</p>\n                </div>\n                <span class=\"px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700\">Active</span>\n              </div>\n              <div class=\"grid grid-cols-3 gap-4 mt-4 pt-4 border-t\">\n                <div><p class=\"text-xs text-gray-400\">Units</p><p class=\"font-semibold\">${p.units}</p></div>\n                <div><p class=\"text-xs text-gray-400\">Occupancy</p><p class=\"font-semibold ${parseFloat(occRate)<75?'text-yellow-600':'text-green-600'}\">${occRate}%</p></div>\n                <div><p class=\"text-xs text-gray-400\">Rent/Unit</p><p class=\"font-semibold\">${formatCurrency(p.rentPerUnit)}</p></div>\n              </div>\n            </div>`;\n        }).join('')}\n      </div>\n    </div>`;\n}\n\nfunction renderTenants(){\n  const filtered = tenants.filter(t => !state.searchQuery || t.name.toLowerCase().includes(state.searchQuery) || getProp(t.propertyId)?.name.toLowerCase().includes(state.searchQuery));\n  return `\n    <div class=\"space-y-5\">\n      <div class=\"flex items-center gap-3 bg-white rounded-xl border shadow-sm px-4 py-2 max-w-md\">\n        🔍 <input id=\"tenant-search\" type=\"text\" placeholder=\"Search tenants...\" value=\"${state.searchQuery}\" oninput=\"handleTenantSearch(this.value)\" class=\"w-full outline-none text-sm\"/>\n      </div>\n      ${filtered.length===0?'<p class=\"text-gray-500\">No matches found.</p>':''}\n      <div class=\"bg-white rounded-xl shadow-sm border overflow-hidden\">\n        <table class=\"w-full text-left\">\n          <thead class=\"bg-gray-50 border-b\"><tr><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Tenant</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Property</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Lease End</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Status</th></tr></thead>\n          <tbody>\n            ${filtered.map(t=>`<tr class=\"border-b hover:bg-blue-50 transition cursor-pointer\" onclick=\"showTenantDetail('${t.id}')\">\n              <td class=\"px-4 py-3\"><div class=\"font-medium\">${t.name}</div><div class=\"text-xs text-gray-400 mt-1\">${t.email}</div></td>\n              <td class=\"px-4 py-3 text-sm\">${getProp(t.propertyId)?.name} • Unit ${t.unit}</td>\n              <td class=\"px-4 py-3 text-sm\">${t.leaseEnd}</td>\n              <td class=\"px-4 py-3\"><span class=\"px-2 py-1 rounded-full text-xs font-medium ${t.status==='current'?'bg-green-100 text-green-700':'bg-orange-100 text-orange-700'}\">${t.status.replace('_',' ')}</span></td>\n            </tr>`).join('')}\n          </tbody>\n        </table>\n      </div>\n    </div>`;\n}\n\nfunction renderMaintenance(){\n  const filterMap = {all:maintenance, open:m=>m.status==='open', in_progress:m=>m.status==='in_progress', resolved:m=>m.status==='resolved'};\n  const list = state.maintenanceFilter==='all' ? maintenance : (filterMap[state.maintenanceFilter]||maintenance);\n  \n  return `\n    <div class=\"space-y-5\">\n      <div class=\"flex items-center gap-3 bg-white rounded-xl border shadow-sm px-4 py-2 max-w-md\">\n        🔍 <input id=\"maint-search\" type=\"text\" placeholder=\"Search tickets...\" value=\"${state.searchQuery}\" oninput=\"handleMaintSearch(this.value)\" class=\"w-full outline-none text-sm\"/>\n      </div>\n      \n      <div class=\"flex gap-3 flex-wrap\">\n        ${['all','open','in_progress','resolved'].map(f=>`<button onclick=\"filterMaintenance('${f}')\" class=\"${state.maintenanceFilter===f?'bg-blue-600 text-white':'bg-gray-100 hover:bg-gray-200'} px-3 py-1.5 rounded-lg text-sm font-medium transition\">${f==='all'?'All':f.replace('_',' ')}</button>`).join('')}\n      </div>\n\n      ${list.length===0?'<p class=\"text-gray-500\">No tickets match.</p>':''}\n      <div class=\"space-y-4\">\n        ${list.map(m=>`\n          <div class=\"bg-white rounded-xl shadow-sm border p-5 hover:shadow-md transition cursor-pointer\" onclick=\"showMaintenanceDetail('${m.id}')\">\n            <div class=\"flex items-start justify-between mb-2\">\n              <h4 class=\"font-semibold\">${m.title}</h4>\n              <span class=\"px-2 py-1 rounded-full text-xs font-medium ${m.priority==='high'?'bg-red-100 text-red-700':m.priority==='medium'?'bg-yellow-100 text-yellow-800':'bg-blue-100 text-blue-700'}\">${m.priority}</span>\n            </div>\n            <p class=\"text-sm text-gray-500 mb-3\">📍 ${getProp(m.propertyId)?.name} • 🧑 ${getTenant(m.tenantId)?.name || 'Unknown'}</p>\n            <div class=\"flex items-center justify-between pt-3 border-t\">\n              <span class=\"text-xs text-gray-400\">Created: ${m.created}</span>\n              <span class=\"px-2 py-1 rounded-full text-xs font-medium ${m.status==='open'?'bg-red-50 text-red-600':m.status==='in_progress'?'bg-blue-50 text-blue-600':'bg-green-50 text-green-600'}\">${m.status.replace('_',' ')}</span>\n            </div>\n          </div>`).join('')}\n      </div>\n    </div>`;\n}\n\nfunction renderFinances(){\n  const totalCollected = finances.filter(f=>f.paid).reduce((s,f)=>s+f.amount,0);\n  const totalOutstanding = finances.filter(f=>!f.paid).reduce((s,f)=>s+f.amount,0);\n  \n  return `\n    <div class=\"space-y-5\">\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        ${kpiCard('Collected This Month', formatCurrency(totalCollected), 'text-green-600')}\n        ${kpiCard('Outstanding Balance', formatCurrency(totalOutstanding), totalOutstanding>4000?'text-red-500':'text-yellow-600')}\n      </div>\n\n      <div class=\"bg-white rounded-xl shadow-sm border overflow-hidden\">\n        <table class=\"w-full text-left\">\n          <thead class=\"bg-gray-50 border-b\"><tr><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Tenant</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Month</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Amount</th><th class=\"px-4 py-3 font-medium text-xs uppercase tracking-wide text-gray-500\">Status</th></tr></thead>\n          <tbody>\n            ${finances.map(f=>{\n              const t = getTenant(f.tenantId);\n              return `<tr class=\"border-b hover:bg-blue-50 transition cursor-pointer\" onclick=\"${f.paid?`showFinanceDetail('${f.id}')`:''}\">\n                <td class=\"px-4 py-3 font-medium\">${t?.name || 'Unknown'}</td>\n                <td class=\"px-4 py-3 text-sm\">${f.month}</td>\n                <td class=\"px-4 py-3 font-semibold\">${formatCurrency(f.amount)}</td>\n                <td class=\"px-4 py-3\">\n                  ${f.paid?`<span class=\"px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700\">Paid</span>`:`\n                    <button onclick=\"event.stopPropagation();markPaid('${f.id}')\" class=\"bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium transition shadow-sm\">Mark Paid</button>\n                  `}\n                </td>\n              </tr>`;\n            }).join('')}\n          </tbody>\n        </table>\n      </div>\n    </div>`;\n}\n\n// ================= ACTIONS & FILTERS =================\nfunction handlePropSearch(v){ state.searchQuery=v.toLowerCase(); renderProperties(); }\nfunction handleTenantSearch(v){ state.searchQuery=v.toLowerCase(); renderTenants(); }\nfunction handleMaintSearch(v){ state.searchQuery=v.toLowerCase(); renderMaintenance(); }\nfunction filterMaintenance(f){ state.maintenanceFilter=f; renderMaintenance(); }\n\nfunction markPaid(id){\n  const f = finances.find(x=>x.id===id);\n  if(f) { f.paid=true; f.paidDate=new Date().toISOString().split('T')[0]; renderFinances(); showNotification(`${getTenant(f.tenantId)?.name} rent marked as paid!`); }\n}\n\nfunction resolveTicket(id){\n  const m = maintenance.find(x=>x.id===id);\n  if(m) { m.status='resolved'; m.resolvedDate=new Date().toISOString().split('T')[0]; renderMaintenance(); showNotification(`Ticket #${m.id} resolved!`); }\n}\n\n// ================= MODALS =================\nfunction openModal(html){ document.getElementById('modal-content').innerHTML=html; document.getElementById('modal-overlay').classList.remove('hidden'); }\nfunction closeModal(){ document.getElementById('modal-overlay').classList.add('hidden'); }\ndocument.getElementById('modal-overlay').addEventListener('click', e=>{ if(e.target.id==='modal-overlay') closeModal(); });\n\nfunction showPropertyDetail(id){\n  const p = getProp(id);\n  const units = tenants.filter(t=>t.propertyId===id).map(t=>`<div class=\"flex justify-between items-center py-2 border-b\"><span>${getTenant(t.id)?.name || 'Unit '+t.unit}</span><span class=\"text-sm text-gray-500\">${formatCurrency(getTenant(t.id)?.rent||p.rentPerUnit)}/mo</span></div>`).join('');\n  openModal(`\n    <h3 class=\"font-bold text-xl mb-1\">${p.image} ${p.name}</h3>\n    <p class=\"text-gray-500 mb-4\">${p.address}</p>\n    <div class=\"grid grid-cols-2 gap-4 mb-6\">\n      <div class=\"bg-blue-50 p-3 rounded-lg\"><p class=\"text-xs text-blue-700 font-medium\">Total Units</p><p class=\"font-bold\">${p.units}</p></div>\n      <div class=\"bg-green-50 p-3 rounded-lg\"><p class=\"text-xs text-green-700 font-medium\">Occupancy Rate</p><p class=\"font-bold\">${((tenants.filter(t=>t.propertyId===id&&t.status==='current').length/p.units)*100).toFixed(0)}%</p></div>\n      <div class=\"bg-yellow-50 p-3 rounded-lg\"><p class=\"text-xs text-yellow-700 font-medium\">Monthly Revenue</p><p class=\"font-bold\">${formatCurrency(p.rentPerUnit*p.units)}</p></div>\n      <div class=\"bg-purple-50 p-3 rounded-lg\"><p class=\"text-xs text-purple-700 font-medium\">Avg Rent/Unit</p><p class=\"font-bold\">${formatCurrency(p.rentPerUnit)}</p></div>\n    </div>\n    <h4 class=\"font-semibold mb-2\">Current Tenants & Units</h4>\n    ${units||'<p class=\"text-sm text-gray-500\">No active tenants.</p>'}\n  `);\n}\n\nfunction showTenantDetail(id){\n  const t = getTenant(id);\n  if(!t) return;\n  openModal(`\n    <div class=\"flex items-center justify-between mb-4\">\n      <h3 class=\"font-bold text-xl\">${t.name}</h3>\n      <span class=\"px-2 py-1 rounded-full text-xs font-medium ${t.status==='current'?'bg-green-100 text-green-700':'bg-orange-100 text-orange-700'}\">${t.status.replace('_',' ')}</span>\n    </div>\n    <p class=\"text-gray-500 mb-4\">📍 ${getProp(t.propertyId)?.name} • Unit ${t.unit}</p>\n    <div class=\"grid grid-cols-2 gap-4 mb-6\">\n      <div><p class=\"text-xs text-gray-400\">Email</p><p class=\"font-medium\">${t.email}</p></div>\n      <div><p class=\"text-xs text-gray-400\">Phone</p><p class=\"font-medium\">${t.phone}</p></div>\n      <div><p class=\"text-xs text-gray-400\">Lease Start</p><p class=\"font-medium\">${t.leaseStart}</p></div>\n      <div><p class=\"text-xs text-gray-400\">Lease End</p><p class=\"font-medium\">${t.leaseEnd} (${daysUntil(t.leaseEnd)} days)</p></div>\n      <div><p class=\"text-xs text-gray-400\">Monthly Rent</p><p class=\"font-bold text-green-600\">${formatCurrency(t.rent)}</p></div>\n    </div>\n  `);\n}\n\nfunction showMaintenanceDetail(id){\n  const m = maintenance.find(x=>x.id===id);\n  if(!m) return;\n  openModal(`\n    <h3 class=\"font-bold text-xl mb-1\">#${m.id}: ${m.title}</h3>\n    <p class=\"text-gray-500 mb-4\">📍 ${getProp(m.propertyId)?.name} • 🧑 ${getTenant(m.tenantId)?.name || 'Unknown'}</p>\n    <div class=\"grid grid-cols-2 gap-4 mb-6\">\n      <div><p class=\"text-xs text-gray-400\">Priority</p><span class=\"px-2 py-1 rounded-full text-xs font-medium ${m.priority==='high'?'bg-red-100 text-red-700':m.priority==='medium'?'bg-yellow-100 text-yellow-800':'bg-blue-100 text-blue-700'}\">${m.priority}</span></div>\n      <div><p class=\"text-xs text-gray-400\">Status</p><span class=\"px-2 py-1 rounded-full text-xs font-medium ${m.status==='open'?'bg-red-50 text-red-600':m.status==='in_progress'?'bg-blue-50 text-blue-600':'bg-green-50 text-green-600'}\">${m.status.replace('_',' ')}</span></div>\n      <div><p class=\"text-xs text-gray-400\">Created</p><p>${m.created}</p></div>\n      ${m.resolvedDate?`<div><p class=\"text-xs text-gray-400\">Resolved</p><p>${m.resolvedDate}</p></div>`:''}\n    </div>\n    <h4 class=\"font-semibold mb-2\">Notes</h4>\n    <p class=\"bg-gray-50 p-3 rounded-lg text-sm\">${m.notes}</p>\n    ${m.status!=='resolved'?`<button onclick=\"resolveTicket('${m.id}');closeModal()\" class=\"mt-4 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition\">Mark Resolved</button>`:''}\n  `);\n}\n\nfunction showFinanceDetail(id){\n  const f = finances.find(x=>x.id===id);\n  if(!f) return;\n  openModal(`\n    <h3 class=\"font-bold text-xl mb-1\">${getTenant(f.tenantId)?.name}</h3>\n    <p class=\"text-gray-500 mb-4\">Payment Record</p>\n    <div class=\"grid grid-cols-2 gap-4 mb-6\">\n      <div><p class=\"text-xs text-gray-400\">Month</p><p>${f.month}</p></div>\n      <div><p class=\"text-xs text-gray-400\">Amount</p><p class=\"font-bold\">${formatCurrency(f.amount)}</p></div>\n      <div><p class=\"text-xs text-gray-400\">Status</p><span class=\"px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700\">Paid</span></div>\n      ${f.paidDate?`<div><p class=\"text-xs text-gray-400\">Paid Date</p><p>${f.paidDate}</p></div>`:''}\n    </div>\n  `);\n}\n\nfunction showNotification(msg){\n  const n = document.createElement('div');\n  n.className='fixed bottom-6 right-6 bg-green-600 text-white px-5 py-3 rounded-xl shadow-lg z-50 font-medium animate-bounce';\n  n.textContent=msg;\n  document.body.appendChild(n);\n  setTimeout(()=>n.remove(),2500);\n}\n\n// ================= INIT =================\nnavigate('dashboard');\n</script>\n</body>\n</html>\n"},"status":"ok","ms":143}
