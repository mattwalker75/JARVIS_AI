{"t":"2026-07-27T02:51:43.463Z","tool":"write_workbench_file","args":{"path":"/workspace/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LifeShield Agent Dashboard</title>\n<style>\n:root {\n  --primary: #1a5276;\n  --primary-light: #2980b9;\n  --accent: #27ae60;\n  --warning: #f39c12;\n  --danger: #e74c3c;\n  --bg: #ecf0f1;\n  --card-bg: #ffffff;\n  --text: #2c3e50;\n  --text-light: #7f8c8d;\n  --border: #bdc3c7;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }\n\n/* Sidebar */\n.sidebar { width: 260px; background: linear-gradient(180deg, #0d3b5e 0%, #1a5276 100%); color: white; padding: 0; position: fixed; height: 100vh; overflow-y: auto; z-index: 100; }\n.sidebar-header { padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); text-align: center; }\n.sidebar-header h1 { font-size: 18px; font-weight: 700; letter-spacing: 0.5px; }\n.sidebar-header p { font-size: 11px; opacity: 0.7; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }\n.nav-menu { padding: 12px 0; }\n.nav-item { display: flex; align-items: center; gap: 12px; padding: 13px 24px; cursor: pointer; transition: all 0.2s; font-size: 14px; border-left: 3px solid transparent; color: rgba(255,255,255,0.7); }\n.nav-item:hover { background: rgba(255,255,255,0.08); color: white; }\n.nav-item.active { background: rgba(255,255,255,0.12); border-left-color: var(--accent); color: white; font-weight: 600; }\n.nav-icon { width: 20px; text-align: center; font-size: 16px; }\n\n/* Main */\n.main { margin-left: 260px; flex: 1; min-height: 100vh; padding: 30px; }\n\n.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }\n.page-title h2 { font-size: 24px; color: var(--primary); font-weight: 700; }\n.page-title p { font-size: 13px; color: var(--text-light); margin-top: 4px; }\n\n/* Cards */\n.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }\n.stat-card { background: var(--card-bg); border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: flex; align-items: center; gap: 16px; }\n.stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: white; flex-shrink: 0; }\n.stat-info h3 { font-size: 26px; font-weight: 700; line-height: 1.1; }\n.stat-info p { font-size: 12px; color: var(--text-light); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }\n\n/* Table */\n.card { background: var(--card-bg); border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden; margin-bottom: 24px; }\n.card-header { padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }\n.card-header h3 { font-size: 16px; color: var(--primary); }\n\ntable { width: 100%; border-collapse: collapse; }\nth, td { padding: 14px 20px; text-align: left; font-size: 13px; }\nth { background: #f8f9fa; color: var(--text-light); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px; border-bottom: 2px solid var(--border); }\ntd { border-bottom: 1px solid #eee; }\ntr:hover td { background: #f8fbff; }\n\n/* Badges */\n.badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }\n.badge-active { background: #d5f5e3; color: #196f3d; }\n.badge-pending { background: #fef9e7; color: #b7950b; }\n.badge-expired { background: #fadbd8; color: #a94442; }\n.badge-draft { background: #eaecee; color: #6c757d; }\n\n/* Buttons */\n.btn { padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; border: none; display: inline-flex; align-items: center; gap: 6px; }\n.btn-primary { background: var(--primary); color: white; }\n.btn-primary:hover { background: #154360; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(26,82,118,0.3); }\n.btn-success { background: var(--accent); color: white; }\n.btn-success:hover { background: #1e8449; }\n.btn-danger { background: var(--danger); color: white; padding: 6px 12px; font-size: 12px; }\n.btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }\n\n/* Modal */\n.modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 200; justify-content: center; align-items: flex-start; padding-top: 60px; overflow-y: auto; }\n.modal-overlay.show { display: flex; }\n.modal { background: var(--card-bg); border-radius: 14px; width: 95%; max-width: 620px; box-shadow: 0 8px 32px rgba(0,0,0,0.2); margin-bottom: 40px; }\n.modal-header { padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }\n.modal-header h3 { font-size: 18px; color: var(--primary); }\n.modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-light); padding: 0 4px; line-height: 1; }\n.modal-body { padding: 24px; max-height: 65vh; overflow-y: auto; }\n\n/* Form */\n.form-group { margin-bottom: 18px; }\n.form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }\n.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\ninput, select, textarea { width: 100%; padding: 10px 14px; border: 2px solid var(--border); border-radius: 8px; font-size: 13px; transition: border-color 0.2s; outline: none; }\ninput:focus, select:focus, textarea:focus { border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(41,128,185,0.1); }\n\n/* Section */\n.section { display: none; }\n.section.active { display: block; }\n\n/* Search bar */\n.search-bar { padding: 6px 14px; border: 2px solid var(--border); border-radius: 8px; font-size: 13px; width: 250px; outline: none; transition: all 0.2s; }\n.search-bar:focus { border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(41,128,185,0.1); width: 300px; }\n\n/* Actions bar */\n.actions-row { display: flex; gap: 6px; align-items: center; }\n\n.empty-state { text-align: center; padding: 60px 20px; color: var(--text-light); }\n.empty-state .icon { font-size: 48px; margin-bottom: 12px; opacity: 0.5; }\n.empty-state p { font-size: 14px; }\n\n/* Payment amount */\n.payment-amount { font-weight: 700; color: var(--accent); }\n.overdue { color: var(--danger) !important; }\n\n/* Responsive */\n@media (max-width: 900px) {\n  .sidebar { width: 220px; }\n  .main { margin-left: 220px; padding: 16px; }\n}\n</style>\n</head>\n<body>\n\n<aside class=\"sidebar\">\n<div class=\"sidebar-header\">\n<h1>&#9783; LifeShield</h1>\n<p>Agent Dashboard</p>\n</div>\n<nav class=\"nav-menu\">\n<div class=\"nav-item active\" data-page=\"dashboard\"><span class=\"nav-icon\">&#9642;</span>Dashboard</div>\n<div class=\"nav-item\" data-page=\"clients\"><span class=\"nav-icon\">&#128101;</span>Clients</div>\n<div class=\"nav-item\" data-page=\"policies\"><span class=\"nav-icon\">&#127896;</span>Policies</div>\n<div class=\"nav-item\" data-page=\"payments\"><span class=\"nav-icon\">&#128176;</span>Payments</div>\n</nav>\n</aside>\n\n<main class=\"main\">\n\n<!-- DASHBOARD -->\n<section id=\"page-dashboard\" class=\"section active\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#9642; Dashboard Overview</h2><p>Your agency at a glance</p></div>\n</div>\n<div class=\"stats-grid\" id=\"dash-stats\"></div>\n\n<div class=\"card\">\n<div class=\"card-header\"><h3>Pending Actions</h3></div>\n<table><thead><tr><th>Type</th><th>Name / Policy</th><th>Detail</th><th>Action</th></tr></thead>\n<tbody id=\"pending-actions\"></tbody></table>\n</div>\n\n<div class=\"card\">\n<div class=\"card-header\"><h3>Recent Activity</h3></div>\n<table><thead><tr><th>Date</th><th>Type</th><th>Description</th></tr></thead>\n<tbody id=\"recent-activity\"></tbody></table>\n</div>\n</section>\n\n<!-- CLIENTS -->\n<section id=\"page-clients\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#128101; Client Management</h2><p>All registered clients and their registration status</p></div>\n<button class=\"btn btn-primary\" onclick=\"openModal('client-modal')\">&#43; Add New Client</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Policies</th><th>Last Payment</th><th>Actions</th></tr></thead>\n<tbody id=\"clients-table\"></tbody></table>\n<div class=\"empty-state\" id=\"clients-empty\"><div class=\"icon\">&#128101;</div><p>No clients yet. Add your first client to get started.</p></div>\n</div>\n</section>\n\n<!-- POLICIES -->\n<section id=\"page-policies\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#127896; Policy Registry</h2><p>All policies and their current status</p></div>\n<button class=\"btn btn-primary\" onclick=\"openModal('policy-modal')\">&#43; Register New Policy</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Policy #</th><th>Client</th><th>Type</th><th>Coverage Amount</th><th>Premium</th><th>Status</th><th>Actions</th></tr></thead>\n<tbody id=\"policies-table\"></tbody></table>\n<div class=\"empty-state\" id=\"policies-empty\"><div class=\"icon\">&#127896;</div><p>No policies registered yet.</p></div>\n</div>\n</section>\n\n<!-- PAYMENTS -->\n<section id=\"page-payments\" class=\"section\">\n<div class=\"page-header\">\n<div class=\"page-title\"><h2>&#128176; Payment Tracker</h2><p>Premium payments and collection status</p></div>\n<button class=\"btn btn-success\" onclick=\"openModal('payment-modal')\">&#43; Record Payment</button>\n</div>\n\n<div class=\"card\">\n<table><thead><tr><th>Date</th><th>Client</th><th>Policy</th><th>Type</th><th>Amount Due</th><th>Paid</th><th>Status</th></tr></thead>\n<tbody id=\"payments-table\"></tbody></table>\n<div class=\"empty-state\" id=\"payments-empty\"><div class=\"icon\">&#128176;</div><p>No payments recorded yet.</p></div>\n</div>\n</section>\n\n</main>\n\n<!-- CLIENT MODAL -->\n<div class=\"modal-overlay\" id=\"client-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Add New Client</h3><button class=\"modal-close\" onclick=\"closeModal('client-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"saveClient(event)\">\n<div class=\"form-row\">\n<div class=\"form-group\"><label>First Name *</label><input id=\"cf-first\" required placeholder=\"John\"></div>\n<div class=\"form-group\"><label>Last Name *</label><input id=\"cf-last\" required placeholder=\"Doe\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Email Address *</label><input type=\"email\" id=\"cf-email\" required placeholder=\"john@example.com\"></div>\n<div class=\"form-group\"><label>Phone Number *</label><input id=\"cf-phone\" required placeholder=\"(555) 123-4567\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Date of Birth</label><input type=\"date\" id=\"cf-dob\"></div>\n<div class=\"form-group\"><label>Registration Status</label>\n<select id=\"cf-status\"><option value=\"registered\">Registered</option><option value=\"pending\">Pending Verification</option></select></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Occupation</label><input id=\"cf-occupation\" placeholder=\"Engineer\"></div>\n<div class=\"form-group\"><label>Annual Income</label><input type=\"number\" id=\"cf-income\" placeholder=\"75000\"></div>\n</div>\n<button type=\"submit\" class=\"btn btn-primary\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#128994; Save Client</button>\n</form>\n</div></div></div>\n\n<!-- POLICY MODAL -->\n<div class=\"modal-overlay\" id=\"policy-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Register New Policy</h3><button class=\"modal-close\" onclick=\"closeModal('policy-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"savePolicy(event)\">\n<div class=\"form-group\"><label>Select Client *</label><select id=\"pf-client\" required></select></div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Policy Type *</label>\n<select id=\"pf-type\" required onchange=\"updateCoverage()\">\n<option value=\"\">-- Select --</option>\n<option value=\"Term Life - 10yr\">Term Life (10 Year)</option>\n<option value=\"Term Life - 20yr\">Term Life (20 Year)</option>\n<option value=\"Whole Life\">Whole Life</option>\n<option value=\"Universal Life\">Universal Life</option>\n<option value=\"Endowment\">Endowment</option>\n<option value=\"Critical Illness\">Critical Illness</option>\n</select></div>\n<div class=\"form-group\"><label>Coverage Amount ($) *</label><input type=\"number\" id=\"pf-coverage\" required placeholder=\"500000\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Annual Premium ($) *</label><input type=\"number\" id=\"pf-premium\" step=\"0.01\" required placeholder=\"2400\"></div>\n<div class=\"form-group\"><label>Billing Frequency</label>\n<select id=\"pf-billfreq\">\n<option value=\"annual\">Annually</option>\n<option value=\"semi-annual\">Semi-Annual</option>\n<option value=\"quarterly\">Quarterly</option>\n<option value=\"monthly\">Monthly</option></select></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Start Date *</label><input type=\"date\" id=\"pf-start\" required></div>\n<div class=\"form-group\"><label>Status</label>\n<select id=\"pf-status\"><option value=\"active\">Active</option><option value=\"pending_approval\">Pending Approval</option><option value=\"expired\">Expired</option><option value=\"lapsed\">Lapsed</option></select></div>\n</div>\n<div class=\"form-group\"><label>Beneficiary Name(s)</label><input id=\"pf-benefit\" placeholder=\"Jane Doe, John Doe\"></div>\n<button type=\"submit\" class=\"btn btn-primary\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#127943; Register Policy</button>\n</form></div></div></div>\n\n<!-- PAYMENT MODAL -->\n<div class=\"modal-overlay\" id=\"payment-modal\">\n<div class=\"modal\">\n<div class=\"modal-header\"><h3>Record Payment</h3><button class=\"modal-close\" onclick=\"closeModal('policy-modal')\">&times;</button></div>\n<div class=\"modal-body\">\n<form onsubmit=\"savePayment(event)\">\n<div class=\"form-group\"><label>Select Policy *</label><select id=\"pm-policy\" required onchange=\"updatePolicyInfo()\"></select></div>\n<div id=\"payment-client-info\" style=\"background:#f8f9fa;padding:12px;border-radius:8px;margin-bottom:16px;display:none;\">\n<p style=\"font-size:13px;color:var(--text-light);\">Client: <strong id=\"pm-client-name\"></strong></p>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Payment Date *</label><input type=\"date\" id=\"pm-date\" required></div>\n<div class=\"form-group\"><label>Premium Amount ($) *</label><input type=\"number\" id=\"pm-amount\" step=\"0.01\" required placeholder=\"200\"></div>\n</div>\n<div class=\"form-row\">\n<div class=\"form-group\"><label>Payment Method</label>\n<select id=\"pm-method\"><option value=\"bank_transfer\">Bank Transfer</option><option value=\"check\">Check</option><option value=\"credit_card\">Credit Card</option><option value=\"cash\">Cash</option></select></div>\n<div class=\"form-group\"><label>Reference / Check #</label><input id=\"pm-ref\" placeholder=\"TXN-12345\"></div>\n</div>\n<div class=\"form-group\"><label>Notes</label><textarea id=\"pm-notes\" rows=\"2\" placeholder=\"Optional notes...\"></textarea></div>\n<button type=\"submit\" class=\"btn btn-success\" style=\"width:100%;justify-content:center;margin-top:8px;\">&#9989; Record Payment</button>\n</form></div></div></div>\n\n<script>\n// ==================== DATA LAYER (localStorage) ====================\nconst DB = {\n  get(key) { try { return JSON.parse(localStorage.getItem('ls_'+key)) || []; } catch(e) { return []; } },\n  set(key, data) { localStorage.setItem('ls_'+key, JSON.stringify(data)); },\n  genId() { return Date.now().toString(36) + Math.random().toString(36).substr(2,5); }\n};\n\n// ==================== NAVIGATION ====================\ndocument.querySelectorAll('.nav-item').forEach(item => {\n  item.addEventListener('click', () => {\n    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));\n    item.classList.add('active');\n    const page = item.dataset.page;\n    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));\n    document.getElementById('page-'+page).classList.add('active');\n  });\n});\n\nfunction openModal(id) {\n  if (id === 'policy-modal') populateClientSelect();\n  if (id === 'payment-modal') populatePolicySelect();\n  document.getElementById(id).classList.add('show');\n}\nfunction closeModal(id) { document.getElementById(id).classList.remove('show'); }\n\n// Close modal on overlay click\ndocument.querySelectorAll('.modal-overlay').forEach(overlay => {\n  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('show'); });\n});\n\n// ==================== CLIENTS ====================\nfunction saveClient(e) {\n  e.preventDefault();\n  const clients = DB.get('clients');\n  const client = {\n    id: DB.genId(),\n    firstName: document.getElementById('cf-first').value.trim(),\n    lastName: document.getElementById('cf-last').value.trim(),\n    email: document.getElementById('cf-email').value.trim(),\n    phone: document.getElementById('cf-phone').value.trim(),\n    dob: document.getElementById('cf-dob').value,\n    status: document.getElementById('cf-status').value,\n    occupation: document.getElementById('cf-occupation').value.trim(),\n    income: parseFloat(document.getElementById('cf-income').value) || 0,\n    createdAt: new Date().toISOString()\n  };\n  clients.push(client);\n  DB.set('clients', clients);\n  e.target.reset();\n  closeModal('client-modal');\n  renderAll();\n}\n\nfunction deleteClient(id) {\n  if (!confirm('Delete this client and all their policies/payments?')) return;\n  let clients = DB.get('clients').filter(c => c.id !== id);\n  DB.set('clients', clients);\n  const pols = DB.get('policies').filter(p => p.clientId !== id);\n  DB.set('policies', pols);\n  const pays = DB.get('payments').filter(p => {\n    const policy = pols.find(pp => pp.id === p.policyId);\n    return policy; // keep payments for surviving policies, remove orphaned ones\n  });\n  DB.set('payments', pays.filter(p => pols.some(pp=>pp.id===p.policyId)));\n  renderAll();\n}\n\nfunction getFullName(c) { return c.firstName + ' ' + c.lastName; }\n\n// ==================== POLICIES ====================\nfunction populateClientSelect() {\n  const clients = DB.get('clients');\n  const sel = document.getElementById('pf-client');\n  sel.innerHTML = '<option value=\"\">-- Select Client --</option>' +\n    clients.map(c => `<option value=\"${c.id}\">${getFullName(c)} (${c.status})</option>`).join('');\n}\n\nfunction updateCoverage() { /* placeholder for future dynamic logic */ }\n\nfunction savePolicy(e) {\n  e.preventDefault();\n  const policies = DB.get('policies');\n  const policy = {\n    id: DB.genId(),\n    clientId: document.getElementById('pf-client').value,\n    type: document.getElementById('pf-type').value,\n    coverageAmount: parseFloat(document.getElementById('pf-coverage').value),\n    annualPremium: parseFloat(document.getElementById('pf-premium').value),\n    billingFrequency: document.getElementById('pf-billfreq').value,\n    startDate: document.getElementById('pf-start').value,\n    status: document.getElementById('pf-status').value,\n    beneficiary: document.getElementById('pf-benefit').value.trim(),\n    createdAt: new Date().toISOString()\n  };\n  policies.push(policy);\n  DB.set('policies', policies);\n  e.target.reset();\n  closeModal('policy-modal');\n  renderAll();\n}\n\nfunction deletePolicy(id) {\n  if (!confirm('Delete this policy?')) return;\n  const pols = DB.get('policies').filter(p => p.id !== id);\n  DB.set('policies', pols);\n  DB.set('payments', DB.get('payments').filter(p => p.policyId !== id));\n  renderAll();\n}\n\n// ==================== PAYMENTS ====================\nfunction populatePolicySelect() {\n  const policies = DB.get('policies');\n  const sel = document.getElementById('pm-policy');\n  sel.innerHTML = '<option value=\"\">-- Select Policy --</option>' +\n    policies.map(p => `<option value=\"${p.id}\">${getFullName(DB.get('clients').find(c=>c.id===p.clientId)||{firstName:'?',lastName:''})} - ${p.type}</option>`).join('');\n}\n\nfunction updatePolicyInfo() {\n  const pol = DB.get('policies').find(p => p.id === document.getElementById('pm-policy').value);\n  if (pol) {\n    const client = DB.get('clients').find(c => c.id === pol.clientId);\n    document.getElementById('payment-client-info').style.display = 'block';\n    document.getElementById('pm-client-name').textContent = getFullName(client||{firstName:'?',lastName:''});\n  } else {\n    document.getElementById('payment-client-info').style.display = 'none';\n  }\n}\n\nfunction savePayment(e) {\n  e.preventDefault();\n  const payments = DB.get('payments');\n  payment = {\n    id: DB.genId(),\n    policyId: document.getElementById('pm-policy').value,\n    date: document.getElementById('pm-date').value,\n    amount: parseFloat(document.getElementById('pm-amount').value),\n    method: document.getElementById('pm-method').value,\n    reference: document.getElementById('pm-ref').value.trim(),\n    notes: document.getElementById('pm-notes').value.trim()\n  };\n  payments.push(payment);\n  DB.set('payments', payments);\n  e.target.reset();\n  closeModal('payment-modal');\n  renderAll();\n}\n\n// ==================== RENDERING ====================\nfunction getStatusBadge(status) {\n  const map = {'registered':'active','pending':'pending','expired':'expired','draft':'draft'};\n  return `<span class=\"badge badge-${map[status]||'draft'}\">${status}</span>`;\n}\n\nfunction getPolicyStatusBadge(s) {\n  const map = {'active':'active','pending_approval':'pending','lapsed':'expired'};\n  return `<span class=\"badge badge-${map[s]||'draft'}\">${s.replace('_',' ')}</span>`;\n}\n\nfunction renderAll() {\n  renderDashboard();\n  renderClientsTable();\n  renderPoliciesTable();\n  renderPaymentsTable();\n}\n\n// Dashboard stats\nfunction renderDashboard() {\n  const clients = DB.get('clients');\n  const policies = DB.get('policies');\n  const payments = DB.get('payments');\n  \n  const totalCoverage = policies.reduce((s,p) => s + (p.coverageAmount||0), 0);\n  const activePolicies = policies.filter(p=>p.status==='active').length;\n  const totalCollected = payments.reduce((s,p)=>s+(parseFloat(p.amount)||0),0);\n  \n  // Pending actions: pending clients, expired/lapsed policies with no recent payment\n  const pendingClients = clients.filter(c => c.status === 'pending');\n  const overduePolicies = [];\n  policies.forEach(pol => {\n    if (pol.status !== 'active') return;\n    const polPayments = payments.filter(p => p.policyId === pol.id).sort((a,b) => b.date.localeCompare(a.date));\n    if (!polPayments.length || !isRecentPayment(polPayments[0].date)) overduePolicies.push({policy:pol, lastPay:polPayments[0]?.date||'N/A'});\n  });\n\n  document.getElementById('dash-stats').innerHTML = `\n    <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:#2980b9;\">&#128101;</div><div class=\"stat-info\"><h3>${clients.length}</h3><p>Total Clients</p></div></div>\n    <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:#27ae60;\">&#127896;</div><div class=\"stat-info\"><h3>${activePolicies}</h3><p>Active Policies</p></div></div>\n    <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:#f39c12;\">&#128176;</div><div class=\"stat-info\"><h3>$${totalCollected.toLocaleString()}</h3><p>Total Collected</p></div></div>\n    <div class=\"stat-card\"><div class=\"stat-icon\" style=\"background:#e74c3c;\">&#9829;</div><div class=\"stat-info\"><h3>$${Math.round(totalCoverage).toLocaleString()}</h3><p>Total Coverage</p></div></div>\n  `;\n\n  // Pending actions table\n  let pendingHtml = '';\n  if (pendingClients.length) {\n    pendingClients.forEach(c => {\n      pendingHtml += `<tr><td>&#128101;</td><td>${getFullName(c)}</td><td>Pending verification</td>\n        <td><button class=\"btn btn-sm btn-primary\" onclick=\"approveClient('${c.id}')\">Approve</button></td></tr>`;\n    });\n  }\n  overduePolicies.forEach(op => {\n    pendingHtml += `<tr><td>&#127896;</td><td>${getFullName(DB.get('clients').find(c=>c.id===op.policy.clientId)||{firstName:'?',lastName:''})}</td>\n      <td>Last payment: ${op.lastPay} (overdue?)</td>\n      <td><button class=\"btn btn-sm btn-success\" onclick=\"openModal('payment-modal')\">Record Payment</button></td></tr>`;\n  });\n  if (!pendingHtml) pendingHtml = '<tr><td colspan=\"4\" style=\"text-align:center;color:var(--text-light);padding:30px;\">No pending actions. Great job!</td></tr>';\n  document.getElementById('pending-actions').innerHTML = pendingHtml;\n\n  // Recent activity (last 15 entries)\n  const activities = [];\n  policies.forEach(p => { if (p.createdAt) activities.push({date:p.createdAt, type:'Policy', desc:`\"${p.type}\" registered for ${getFullName(DB.get('clients').find(c=>c.id===p.clientId)||{firstName:'',lastName:''})}`}); });\n  payments.forEach(p => { if (p.date) activities.push({date:p.date+'T00:00:00Z', type:'Payment', desc:`$${parseFloat(p.amount).toLocaleString()} received for policy ${DB.get('clients').find(c=>c.id===DB.get('policies').find(pp=>pp.id===p.policyId)?.clientId)||{firstName:'',lastName:''}}'s policy`}); });\n  activities.sort((a,b) => b.date.localeCompare(a.date));\n\n  let actHtml = '';\n  (activities.slice(0,15)).forEach(act => {\n    const d = new Date(act.date).toLocaleDateString();\n    actHtml += `<tr><td>${d}</td><td><span class=\"badge ${act.type==='Payment'?'badge-active':'badge-pending'}\">${act.type}</span></td><td>${act.desc}</td></tr>`;\n  });\n  if (!actHtml) actHtml = '<tr><td colspan=\"3\" style=\"text-align:center;color:var(--text-light);padding:20px;\">No activity yet.</td></tr>';\n  document.getElementById('recent-activity').innerHTML = actHtml;\n}\n\nfunction isRecentPayment(dateStr) {\n  const d = new Date(dateStr);\n  return (Date.now() - d.getTime()) < 95 * 86400000; // ~3 months\n}\n\nfunction approveClient(id) {\n  const clients = DB.get('clients');\n  const c = clients.find(x => x.id === id);\n  if (c) { c.status = 'registered'; DB.set('clients', clients); renderAll(); }\n}\n\n// Client table\nfunction renderClientsTable() {\n  const clients = DB.get('clients');\n  const policies = DB.get('policies');\n  const payments = DB.get('payments');\n  \n  if (!clients.length) { document.getElementById('clients-table').innerHTML=''; document.getElementById('clients-empty').style.display='block'; return; }\n  document.getElementById('clients-empty').style.display='none';\n\n  let html = '';\n  clients.forEach(c => {\n    const cPolicies = policies.filter(p=>p.clientId===c.id);\n    const lastPay = payments.filter(p=>{const pol=policies.find(pp=>pp.id===p.policyId&&pol?.clientId===c.id);return!!pol;}).sort((a,b)=>b.date.localeCompare(a.date))[0];\n    html += `<tr>\n      <td><strong>${getFullName(c)}</strong></td>\n      <td>${c.email}</td>\n      <td>${c.phone}</td>\n      <td>${getStatusBadge(c.status)}</td>\n      <td>${cPolicies.length} policy${cPolicies.length!==1?'ies':''}</td>\n      <td>${lastPay ? new Date(lastPay.date).toLocaleDateString() : 'N/A'}</td>\n      <td class=\"actions-row\"><button class=\"btn btn-danger btn-sm\" onclick=\"deleteClient('${c.id}')\">Delete</button></td>\n    </tr>`;\n  });\n  document.getElementById('clients-table').innerHTML = html;\n}\n\n// Policies table\nfunction renderPoliciesTable() {\n  const policies = DB.get('policies');\n  \n  if (!policies.length) { document.getElementById('policies-table').innerHTML=''; document.getElementById('policies-empty').style.display='block'; return; }\n  document.getElementById('policies-empty').style.display='none';\n\n  let html = '';\n  const clients = DB.get('clients');\n  policies.forEach(p => {\n    const client = clients.find(c=>c.id===p.clientId);\n    // Generate policy number\n    const polNum = 'POL-' + p.id.substr(0,8).toUpperCase();\n    html += `<tr>\n      <td><code>${polNum}</code></td>\n      <td>${client ? getFullName(client) : '<em>Unknown</em>'}</td>\n      <td>${p.type}</td>\n      <td>$${(p.coverageAmount||0).toLocaleString()}</td>\n      <td>$${(p.annualPremium||0).toLocaleString()}/${['annual','semi-annual'].includes(p.billingFrequency)?'yr':'mo'}*</td>\n      <td>${getPolicyStatusBadge(p.status)}</td>\n      <td class=\"actions-row\"><button class=\"btn btn-danger btn-sm\" onclick=\"deletePolicy('${p.id}')\">Delete</button></td>\n    </tr>`;\n  });\n  document.getElementById('policies-table').innerHTML = html;\n}\n\n// Payments table\nfunction renderPaymentsTable() {\n  const payments = DB.get('payments');\n  \n  if (!payments.length) { document.getElementById('payments-table').innerHTML=''; document.getElementById('payments-empty').style.display='block'; return; }\n  document.getElementById('payments-empty').style.display='none';\n\n  let html = '';\n  const policies = DB.get('policies');\n  payments.sort((a,b)=>b.date.localeCompare(a.date)).forEach(p => {\n    const pol = policies.find(pp=>pp.id===p.policyId);\n    if (!pol) return; // orphaned payment\n    const client = DB.get('clients').find(c=>c.id===pol.clientId);\n    \n    let statusBadge, dueAmount;\n    if (p.status === 'pending') {\n      statusBadge = '<span class=\"badge badge-pending\">Pending</span>';\n      dueAmount = '$' + parseFloat(p.amount).toLocaleString();\n    } else {\n      statusBadge = '<span class=\"badge badge-active\">Received</span>';\n      dueAmount = '';\n    }\n\n    html += `<tr>\n      <td>${new Date(p.date).toLocaleDateString()}</td>\n      <td>${client ? getFullName(client) : 'Unknown'}</td>\n      <td><code>${pol.type.split(' - ')[0]}</code></td>\n      <td>${p.method.replace('_',' ')}</td>\n      <td class=\"${isRecentPayment(p.date)?'':'overdue'}\">${dueAmount||'<em style=\"color:var(--text-light);\">—</em>'}</td>\n      <td><span class=\"payment-amount\">$${parseFloat(p.amount).toLocaleString()}</span></td>\n      <td>${statusBadge}${p.reference?'<br><small style=\"color:var(--text-light)\">Ref:'+p.reference+'</small>':''}</td>\n    </tr>`;\n  });\n  document.getElementById('payments-table').innerHTML = html;\n}\n\n// ==================== INIT ====================\nrenderAll();\n</script>\n</body>\n</html>\n"},"status":"ok","ms":146}
