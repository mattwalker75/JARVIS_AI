           results.append((\"Test 6\", \"PASS\"))\n                else:\n                    raise AssertionError(f\"Expected fewer images after delete. Before={count_before}, After={count_after}\")\n            elif not dialog_accepted:\n                raise AssertionError(\"Confirm dialog was not triggered/accepted\")\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 6\", f\"FAIL: {e}\"))"},"status":"ok","ms":152}
{"t":"2026-07-27T04:53:27.490Z","tool":"edit_workbench_file","args":{"path":"/workspace/test_core.py","old_string":"        # ── Test 6: Delete a single image ──\n        print(\"\\n=== TEST 6: Delete single image ===\")\n        \n        dialog_accepted = False\n        async def handle_confirm(dialog):\n            nonlocal dialog_accepted\n            await dialog.accept()\n        \n        page.on(\"dialog\", handle_confirm)\n        \n        try:\n            # Clear DB first for a clean test, then upload exactly 1 image\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            # Wait for gallery to load\n            await asyncio.sleep(2)\n            \n            thumbs_before = await page.query_selector_all(\".thumb-card img\")\n            count_before = len(thumbs_before)\n            \n            if count_before == 0:\n                raise AssertionError(\"No images in gallery to test deletion (DB may have been cleared)\")\n            \n            print(f\"  Images before delete: {count_before}\")\n            \n            # Click the first image's delete button (visible on hover via CSS, but we can click directly)\n            await page.click(\".thumb-card .icon-btn.delete\", force=True)\n            \n            try:\n                toast = await page.wait_for_selector(\".toast.success\", timeout=3000)\n            except Exception:\n                pass\n            \n            # Wait for gallery re-render after delete\n            await asyncio.sleep(2)\n            \n            thumbs_after = await page.query_selector_all(\".thumb-card img\")\n            count_after = len(thumbs_after)\n            print(f\"  Images after delete: {count_after}\")\n            \n            if dialog_accepted and count_before > 0:\n                # At least one image was removed (could be more from prior tests, but confirm fired)\n                if count_after < count_before or thumbs_after == []:\n                    print(\"  PASS: Single image deleted successfully\")\n                    results.append((\"Test 6\", \"PASS\"))\n                else:\n                    raise AssertionError(f\"Expected fewer images after delete. Before={count_before}, After={count_after}\")\n            elif not dialog_accepted:\n                raise AssertionError(\"Confirm dialog was not triggered/accepted\")\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 6\", f\"FAIL: {e}\"))","new_string":"        # ── Test 6: Delete a single image ──\n        print(\"\\n=== TEST 6: Delete single image ===\")\n        \n        dialog_accepted = False\n        async def handle_confirm(dialog):\n            nonlocal dialog_accepted\n            await dialog.accept()\n        \n        page.on(\"dialog\", handle_confirm)\n        \n        try:\n            # Navigate fresh and clear DB via JS, then upload exactly 1 image for clean test\n            await page.goto(APP_URL, wait_until=\"networkidle\", timeout=10000)\n            \n            # Clear existing images from IndexedDB first\n            cleared = await page.evaluate(\"\"\"() => {\n                return new Promise((resolve) => {\n                    const req = indexedDB.open('PictureViewerDB', 1);\n                    req.onsuccess = () => {\n                        const db = req.result;\n                        if (db.objectStoreNames.contains('images')) {\n                            const tx = db.transaction('images', 'readwrite');\n                            tx.objectStore('images').clear();\n                            tx.oncomplete = () => resolve(true);\n                        } else { resolve(true); }\n                    };\n                    req.onerror = () => resolve(false);\n                });\n            }\"\"\")\n            \n            await asyncio.sleep(1)\n            \n            # Upload exactly 2 images so we can delete one and still have the other\n            image_files = [os.path.join(TEST_IMAGES_DIR, \"mountain.jpg\"), os.path.join(TEST_IMAGES_DIR, \"ocean.jpg\")]\n            await page.click(\"#upload-zone\")\n            await page.set_input_files(\"#file-input\", image_files)\n            \n            try:\n                toast_el = await page.wait_for_selector(\".toast.success\", timeout=5000)\n                print(f\"  Upload confirmation: '{await toast_el.inner_text()}'\")\n            except Exception:\n                pass\n            \n            # Wait for gallery to fully render both images\n            await asyncio.sleep(3)\n            \n            thumbs_before = await page.query_selector_all(\".thumb-card img\")\n            count_before = len(thumbs_before)\n            print(f\"  Images before delete: {count_before}\")\n            \n            if count_before < 2:\n                raise AssertionError(f\"Not enough images to test deletion. Found {count_before}, need at least 2.\")\n            \n            # Click the first image's delete button\n            await page.click(\".thumb-card .icon-btn.delete\", force=True)\n            \n            try:\n                toast_del = await page.wait_for_selector(\".toast.success\", timeout=3000)\n                print(f\"  Delete confirmation: '{await toast_del.inner_text()}'\")\n            except Exception:\n                pass\n            \n            # Wait for gallery re-render after delete\n            await asyncio.sleep(2)\n            \n            thumbs_after = await page.query_selector_all(\".thumb-card img\")\n            count_after = len(thumbs_after)\n            print(f\"  Images after delete: {count_after}\")\n            \n            if dialog_accepted and count_before >= 2:\n                expected_count = count_before - 1\n                if count_after == expected_count:\n                    print(\"  PASS: Single image deleted successfully\")\n                    results.append((\"Test 6\", \"PASS\"))\n                else:\n                    raise AssertionError(f\"Expected {expected_count} images after delete, got {count_after}\")\n            elif not dialog_accepted:\n                raise AssertionError(\"Confirm dialog was not triggered/accepted\")\n        except Exception as e:\n            print(f\"  FAIL: {e}\")\n            results.append((\"Test 6\", f\"FAIL: {e}\"))"},"status":"ok","ms":144}
