{"t":"2026-07-26T04:14:59.541Z","tool":"write_workbench_file","args":{"path":"/workspace/test_gameplay.py","content":"\"\"\"Automated DOOM-like FPS game test via Playwright.\"\"\"\nimport json, time\nfrom playwright.sync_api import sync_playwright\n\nBASE = \"http://localhost:9102\"\n\ndef run_tests():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page(viewport={\"width\": 800, \"height\": 600})\n        \n        # ===== TEST 1: Page loads and game canvas exists =====\n        print(\"[TEST] Loading game page...\")\n        page.goto(BASE, timeout=15000)\n        time.sleep(2)  # Let JS initialize\n        \n        has_canvas = page.evaluate(\"!!document.getElementById('game')\")\n        results.append((\"Game canvas element\", has_canvas))\n        \n        ui_text = page.inner_text(\"#ui\") if page.is_visible(\"#ui\") else \"\"\n        hp_present = \"HP:\" in ui_text or \"hp\" in ui_text.lower()\n        ammo_present = \"AMMO:\" in ui_text or \"ammo\" in ui_text.lower()\n        results.append((\"HUD displays HP and Ammo\", hp_present and ammo_present))\n        \n        crosshair_visible = page.is_visible(\"#crosshair\")\n        results.append((\"Crosshair visible\", crosshair_visible))\n        \n        # ===== TEST 2: Click to lock pointer & simulate mouse movement (mouse look) =====\n        print(\"[TEST] Testing mouse look...\")\n        canvas_elem = page.locator(\"canvas#game\")\n        canvas_elem.click()\n        time.sleep(0.3)\n        \n        initial_angle = page.evaluate(\"\"\"() => {\n            return window.player ? Math.round(window.player.a * 100) / 100 : -999;\n        }\"\"\")\n        print(f\"  Initial angle: {initial_angle}\")\n        \n        # Simulate mouse movement (pointer lock delta)\n        page.evaluate(\"\"\"() => {\n            document.dispatchEvent(new MouseEvent('mousemove', {movementX: 20, bubbles: true}));\n        }\"\"\")\n        time.sleep(0.3)\n        \n        after_angle = page.evaluate(\"\"\"() => {\n            return window.player ? Math.round(window.player.a * 100) / 100 : -999;\n        }\"\"\")\n        print(f\"  After mouse move: {after_angle}\")\n        angle_changed = abs(after_angle - initial_angle) > 0.5 if initial_angle != -999 else False\n        results.append((\"Mouse look changes player angle\", angle_changed))\n        \n        # ===== TEST 3: WASD movement (W key forward) =====\n        print(\"[TEST] Testing W key forward movement...\")\n        page.keyboard.down(\"w\")\n        time.sleep(0.5)\n        page.keyboard.up(\"w\")\n        time.sleep(0.5)\n        \n        initial_pos = page.evaluate(\"\"\"() => {\n            if (!window.player) return null;\n            return {x: Math.round(window.player.x * 100)/100, y: Math.round(window.player.y * 100)/100};\n        }\"\"\")\n        \n        # Press W and hold for a bit to move forward\n        page.keyboard.down(\"w\")\n        time.sleep(0.8)\n        page.keyboard.up(\"w\")\n        time.sleep(0.3)\n        \n        moved_pos = page.evaluate(\"\"\"() => {\n            if (!window.player) return null;\n            return {x: Math.round(window.player.x * 100)/100, y: Math.round(window.player.y * 100)/100};\n        }\"\"\")\n        \n        print(f\"  Initial pos: {initial_pos}, Moved pos: {moved_pos}\")\n        if initial_pos and moved_pos:\n            dx = abs(moved_pos[\"x\"] - initial_pos[\"x\"])\n            dy = abs(moved_pos[\"y\"] - initial_pos[\"y\"])\n            movement_detected = (dx > 0.01 or dy > 0.01)\n        else:\n            movement_detected = False\n        results.append((\"W key moves player forward\", movement_detected))\n        \n        # ===== TEST 4: Shooting mechanics =====\n        print(\"[TEST] Testing shooting...\")\n        initial_ammo = page.evaluate(\"\"\"() => {\n            return window.player ? window.player.ammo : -999;\n        }\"\"\")\n        print(f\"  Ammo before shoot: {initial_ammo}\")\n        \n        # Click canvas to focus, then press Space or F to shoot\n        canvas_elem.click()\n        time.sleep(0.2)\n        page.keyboard.press(\"Space\")\n        time.sleep(1)\n        \n        after_shoot = page.evaluate(\"\"\"() => {\n            return window.player ? window.player.ammo : -999;\n        }\"\"\")\n        print(f\"  Ammo after shoot: {after_shoot}\")\n        ammo_decreased = (initial_ammo != -999 and initial_ammo > after_shoot) or (initial_ammo == 50 and after_shoot < 50)\n        \n        # Check muzzle flash was triggered\n        has_muzzle_flash = page.evaluate(\"\"\"() => {\n            return window.muzzleFlash ? true : false;\n        }\"\"\")\n        results.append((\"Shooting decreases ammo\", ammo_decreased))\n        results.append((\"Muzzle flash effect active after shoot\", bool(has_muzzle_flash)))\n        \n        # ===== TEST 5: Enemies exist and render =====\n        print(\"[TEST] Checking enemies...\")\n        enemy_count = page.evaluate(\"\"\"() => {\n            return window.enemies ? window.enemies.length : -999;\n        }\"\"\")\n        results.append((\"Enemies spawned\", enemy_count > 0))\n        \n        # Check minimap shows enemies (rendered as dots)\n        has_minimap = page.evaluate(\"\"\"() => {\n            const canvas = document.getElementById('minimap');\n            return !!canvas;\n        }\"\"\")\n        if not has_minimap:\n            # Minimap might be drawn on the main game canvas in bottom-right corner\n            has_minimap_on_game = True  # assume it's part of render\n        results.append((\"Minimap present\", has_minimap))\n        \n        # ===== TEST 6: Enemy AI states visible =====\n        print(\"[TEST] Checking enemy AI...\")\n        enemy_states = page.evaluate(\"\"\"() => {\n            if (!window.enemies) return [];\n            return window.enemies.map(e => ({state: e.state, hp: Math.round(e.hp), x: Math.round(e.x*10)/10}));\n        }\"\"\")\n        print(f\"  Enemy states: {json.dumps(enemy_states)}\")\n        \n        has_patrol = any(e.get(\"state\") == \"patrol\" for e in enemy_states) if isinstance(enemy_states, list) else False\n        results.append((\"Enemies have AI patrol state\", has_patrol))\n        \n        # ===== TEST 7: Pickup items exist =====\n        print(\"[TEST] Checking pickups...\")\n        item_count = page.evaluate(\"\"\"() => {\n            return window.items ? window.items.filter(i => i.active).length : -999;\n        }\"\"\")\n        results.append((\"Pickup items spawned\", item_count > 0))\n        \n        # ===== TEST 8: Health pickup works =====\n        print(\"[TEST] Testing health pickup...\")\n        current_hp = page.evaluate(\"\"\"() => {\n            return window.player ? Math.round(window.player.hp) : -999;\n        }\"\"\")\n        print(f\"  Current HP: {current_hp}\")\n        \n        # Move player to a known position and check if any health pickup is nearby\n        # We'll teleport the player close to a health item by simulating movement toward it\n        page.evaluate(\"\"\"() => {\n            const items = window.items;\n            const player = window.player;\n            if (!items || !player) return false;\n            \n            // Find first active health pickup\n            for (const item of items) {\n                if (item.type === 'health' && item.active) {\n                    const dx = item.x - player.x;\n                    const dy = item.y - player.y;\n                    const dist = Math.sqrt(dx*dx + dy*dy);\n                    \n                    // Move toward it step by step\n                    for (let i = 0; i < 50; i++) {\n                        if (dist > 1.2) break;\n                        const nx = item.x - player.x;\n                        const ny = item.y - player.y;\n                        const ndist = Math.sqrt(nx*nx + ny*ny);\n                        if (ndist < 0.3) break;\n                        \n                        // Simple move toward target, check wall collision\n                        const stepX = nx / ndist * 0.15;\n                        const stepY = ny / ndist * 0.15;\n                        const newX = player.x + stepX;\n                        const newY = player.y + stepY;\n                        \n                        // Check walls at new position (grid is [y][x])\n                        const mapGrid = window.game.grid;\n                        if (!mapGrid) break;\n                        \n                        const gx = Math.floor(newX);\n                        const gy = Math.floor(newY);\n                        if (gy >= 0 && gy < mapGrid.length && gx >= 0 && gx < mapGrid[0].length) {\n                            if (mapGrid[gy][gx] === 0) {\n                                player.x += stepX;\n                                player.y += stepY;\n                            } else break;\n                        }\n                    }\n                    \n                    // Check collision with item\n                    const cdx = item.x - player.x;\n                    const cdy = item.y - player.y;\n                    if (Math.sqrt(cdx*cdx + cdy*cdy) < 0.5) {\n                        return true; // picked up!\n                    }\n                }\n            }\n            return false;\n        }\"\"\")\n        \n        time.sleep(1)\n        new_hp = page.evaluate(\"\"\"() => {\n            return window.player ? Math.round(window.player.hp) : -999;\n        }\"\"\")\n        print(f\"  HP after pickup attempt: {new_hp}\")\n        health_picked_up = (current_hp != -999 and new_hp > current_hp) or item_pickup_result\n        \n        results.append((\"Health pickup increases HP\", health_picked_up))\n        \n        # ===== TEST 9: Win condition check =====\n        print(\"[TEST] Testing win/lose conditions...\")\n        game_state = page.evaluate(\"\"\"() => {\n            return window.prevState || 'playing';\n        }\"\"\")\n        results.append((\"Game state accessible\", game_state in [\"playing\", \"won\", \"lost\"]))\n        \n        # ===== TEST 10: Multiple maps exist =====\n        print(\"[TEST] Checking map system...\")\n        has_maps = page.evaluate(\"\"\"() => {\n            return typeof window.maps !== 'undefined' && Array.isArray(window.maps) && window.maps.length >= 2;\n        }\"\"\")\n        results.append((\"Multiple maps defined\", has_maps))\n        \n        # ===== TEST 11: Z-buffer occlusion working (enemies behind walls hidden) =====\n        print(\"[TEST] Checking z-buffer...\")\n        has_zbuf = page.evaluate(\"\"\"() => {\n            return typeof window.zBuf !== 'undefined' && Array.isArray(window.zBuf);\n        }\"\"\")\n        results.append((\"Z-buffer initialized\", has_zbuf))\n        \n    # Print summary\n    print(\"\\n\" + \"=\"*60)\n    print(\"GAMEPLAY TEST RESULTS\")\n    print(\"=\"*60)\n    \n    passed = 0\n    failed = 0\n    \n    for test_name, result in results:\n        status = \"PASS\" if result else \"FAIL\"\n        icon = \"✓\" if result else \"✗\"\n        print(f\"  {icon} [{status}] {test_name}\")\n        if result:\n            passed += 1\n        else:\n            failed += 1\n    \n    print(\"=\"*60)\n    print(f\"RESULTS: {passed}/{len(results)} tests passed, {failed} failed\")\n    \n    # Save results to file for reference\n    with open(\"/workspace/test_results.json\", \"w\") as f:\n        json.dump({\n            \"total\": len(results),\n            \"passed\": passed,\n            \"failed\": failed,\n            \"tests\": [{\"name\": n, \"result\": r} for n, r in results]\n        }, f, indent=2)\n    \n    browser.close()\n    return passed == len(results)\n\nif __name__ == \"__main__\":\n    success = run_tests()\n    exit(0 if success else 1)\n"},"status":"ok","ms":143}
