{"t":"2026-07-28T04:13:57.220Z","tool":"write_workbench_file","args":{"path":"/workspace/populate_summit.sql","content":"-- ============================================================\n-- Summit Digital Agency LLC — Full Data Population (business_id = 2)\n-- Faceless content agency: YouTube, TikTok, Shorts automation\n-- ============================================================\n\nBEGIN TRANSACTION;\n\n-- ===================================================================\n-- STEP 4: Products/Services Catalog (table: business_products_services)\n-- ===================================================================\n\nINSERT INTO business_products_services (business_id, kind, name, sku, price_cents, description, status, notes) VALUES\n(2, 'service', 'Faceless YouTube Channel Management — Starter', 'SDA-YT-STARTER', 249700,\n'Monthly package: 8 long-form faceless videos (script + voiceover + edit), thumbnail design, SEO optimization, channel strategy review. Ideal for new channels or testing the model.', 'active'),\n\n(2, 'service', 'Faceless YouTube Channel Management — Growth', 'SDA-YT-GROWTH', 499700,\n'Monthly package: 16 long-form videos, thumbnails, SEO, A/B tested titles/descriptions, community management (comments), weekly analytics report. For channels with existing traction.', 'active'),\n\n(2, 'service', 'Faceless YouTube Channel Management — Scale', 'SDA-YT-SCALE', 849700,\n'Monthly package: Unlimited long-form videos, full branding suite, multi-channel strategy (YouTube + TikTok cross-post), dedicated account manager, priority support.', 'active'),\n\n(2, 'service', 'TikTok/Shorts Automation — Starter', 'SDA-TK-STARTER', 199700,\n'Monthly package: 15 short-form videos (9-60 sec), trending sound integration, auto-captioning, posting schedule optimization. Perfect for brand awareness.', 'active'),\n\n(2, 'service', 'TikTok/Shorts Automation — Growth', 'SDA-TK-GROWTH', 349700,\n'Monthly package: 30 short-form videos, trend forecasting, hashtag strategy, engagement optimization, cross-platform repurposing (YouTube Shorts + TikTok).', 'active'),\n\n(2, 'service', 'Short-Form Content Repurposing Pack', 'SDA-RP-SHORTS', 149700,\n'Take existing long-form content and slice into 20+ short clips with captions, hooks, and platform-specific formatting. Monthly retainer.', 'active'),\n\n(2, 'service', 'Thumbnail Design — Per Session', 'SDA-THUMBNAIL', 29700,\n'Custom-designed YouTube thumbnail (16:9) optimized for CTR — includes A/B variant option. One-time purchase per batch of thumbnails.', 'active'),\n\n(2, 'service', 'Professional Voiceover Production', 'SDA-VO-PROD', 39700,\n'AI-enhanced professional voiceover recording (up to 15 min). Includes script polishing, tone matching, and background music bed. Per-video pricing.', 'active'),\n\n(2, 'service', 'Channel Audit & Strategy Report', 'SDA-AUDIT-ONEOFF', 99700,\n'One-time comprehensive channel audit: niche analysis, competitor benchmarking, content gap identification, SEO keyword map, and 12-month growth roadmap.', 'active'),\n\n(2, 'service', 'Full Brand Identity Package', 'SDA-BRAND-ID', 149700,\n'Complete faceless brand identity: logo suite (light/dark), color palette, typography guide, channel banner art, intro/outro animation templates, and style document.', 'active'),\n\n(2, 'product', 'AI Voiceover Credit Pack — 5 Credits', 'SDA-AI-VO-PACK5', 14900,\n'Pre-paid pack of 5 AI voiceover credits. Each credit = one video up to 15 minutes with professional narration and music bed.', 'active'),\n\n(2, 'product', 'Stock Footage Subscription — Monthly Add-on', 'SDA-STOCK-MONTHLY', 49700,\n'Unlimited access to curated stock footage library (Pexels, Pixabay, Storyblocks) for faceless video production. Billed monthly.', 'active'),\n\n(2, 'product', 'SEO Keyword Research Report — Per Niche', 'SDA-SEOREPORT', 19700,\n'Detailed keyword research document: top 50 searchable keywords in your niche with volume data, difficulty scores, and content angle suggestions.', 'active');\n\n\n-- ===================================================================\n-- STEP 6a: Contacts — Team Members (table: contacts)\n-- ===================================================================\n\nINSERT INTO contacts (business_id, name, phone, email, notes, category_id) VALUES\n(2, 'Alex Rivera', '+1-555-0147', 'alex@summitdigitalagency.com', 'Founder & CEO. Oversees strategy, client relations, and brand direction. Former YouTube strategist with 8 years experience.', NULL),\n\n(2, 'Jordan Kim', '', 'jordan.kim.contractor@gmail.com', 'Lead Video Editor (contract). Specializes in faceless documentary-style editing. Tools: Premiere Pro, After Effects, DaVinci Resolve.', NULL),\n\n(2, 'Sam Chen', '', 'samchen.creative@proton.me', 'Thumbnail & Motion Graphics Designer. Creates high-CTR thumbnails and channel branding assets.', NULL),\n\n(2, 'Priya Sharma', '+1-555-0198', 'priya.sharma.vo@gmail.com', 'Voiceover Artist / Scriptwriter. Produces AI-enhanced voiceovers and scripts for faceless content across niches (finance, tech, health).', NULL),\n\n(2, 'Marcus Webb', '', 'marcus.webb.seo@protonmail.com', 'SEO & Analytics Specialist. Manages keyword strategy, channel analytics dashboards, and growth reporting.', NULL);\n\n\n-- ===================================================================\n-- STEP 6b: Contacts — Vendors (table: contacts)\n-- ===================================================================\n\nINSERT INTO contacts (business_id, name, business_name, phone, email, website_url, notes) VALUES\n(2, 'OpenAI', '', '+1-888-739-0456', 'api@openai.com', 'https://openai.com', 'ChatGPT API & GPT-4o for script generation and content ideation.', NULL),\n\n(2, 'ElevenLabs', '', '+1-415-800-7390', 'support@elevenlabs.io', 'https://elevenlabs.io', 'AI voiceover platform. Used for premium human-like narration on client videos.', NULL),\n\n(2, 'Storyblocks', '', '+1-866-504-8221', 'business@storyblocks.com', 'https://storyblocks.com', 'Stock footage and music licensing subscription for faceless video production.', NULL),\n\n(2, 'Canva (Business)', '', '', 'support@canva.com', 'https://canva.com', 'Design tool for thumbnails, social graphics, and client presentations. Business plan.', NULL),\n\n(2.0, 'Notion', '', '+1-415-800-7390', 'enterprise@notion.so', 'https://notion.so', 'Project management, CRM lite, content calendars for team collaboration.', NULL),\n\n(2, 'Adobe (Creative Cloud)', '', '+1-800-833-6687', 'business@adobe.com', 'https://adobe.com', 'Premiere Pro & After Effects licenses for Jordan Kim. Business plan per seat.', NULL),\n\n(2, 'Vimeo (Pro)', '', '', 'support@vimeo.com', 'https://vimeo.com', 'Video hosting and client delivery portal. Pro plan for watermark-free uploads.', NULL);\n\n\n-- ===================================================================\n-- STEP 5: Recurring Invoices (client retainers) — table: recurring_invoices\n-- ===================================================================\n\nINSERT INTO recurring_invoices (business_id, customer_name, number_prefix, amount_cents, tax_cents, frequency, interval_count, next_run_date, notes) VALUES\n(2, 'Horizon Wealth Media', NULL, 499700, 39976, 'monthly', 1, '2026-08-15', 'Growth plan — Faceless YouTube channel for finance niche. 16 videos/month + thumbnails + SEO.'),\n\n(2, 'TechPulse Reviews', NULL, 499700, 39976, 'monthly', 1, '2026-08-15', 'Growth plan — Faceless YouTube channel for tech reviews. 16 videos/month + thumbnails.'),\n\n(2, 'FitLife Digital Co.', NULL, 149700, 11976, 'monthly', 1, '2026-08-15', 'Short-form repurposing — converting FitLife podcast into Shorts/TikToks. Monthly retainer.'),\n\n(2, 'GreenEarth Insights', NULL, 349700, 27976, 'monthly', 1, '2026-08-15', 'Growth plan — TikTok automation for sustainability brand. 30 short-form videos/month + trend forecasting.'),\n\n(2, 'Mindful Moments App', NULL, 249700, 19976, 'monthly', 1, '2026-08-15', 'Starter plan — Faceless YouTube channel for meditation/mental health niche. Testing phase.'),\n\n(2, 'CryptoBrief Daily', NULL, 849700, 67976, 'monthly', 1, '2026-08-15', 'Scale plan — Unlimited faceless crypto news videos + multi-channel strategy (YT + TikTok).');\n\n\n-- ===================================================================\n-- STEP 5: Recurring Bills (operational expenses) — table: recurring_bills\n-- ===================================================================\n\nINSERT INTO recurring_bills (business_id, vendor_name, bill_number_prefix, amount_cents, frequency, interval_count, next_run_date, notes) VALUES\n(2, 'OpenAI', NULL, 49700, 'monthly', 1, '2026-08-01', 'ChatGPT API — script generation and content ideation for all client videos.'),\n\n(2, 'ElevenLabs', NULL, 35000, 'monthly', 1, '2026-08-01', 'Voiceover credits — premium AI voice model usage for narration production.'),\n\n(2, 'Storyblocks', NULL, 49700, 'quarterly', 1, '2026-10-01', 'Stock footage & music licensing. Billed quarterly at $49.70/mo equivalent.'),\n\n(2, 'Notion (Business)', NULL, 10000, 'monthly', 1, '2026-08-01', 'Project management and team workspace for content calendar & CRM.'),\n\n(2, 'Adobe Creative Cloud', NULL, 59700, 'monthly', 1, '2026-08-01', 'Premiere Pro + After Effects license for lead editor Jordan Kim. Business plan.'),\n\n(2, 'Vimeo (Pro)', NULL, 49700, 'yearly', 1, '2026-12-01', 'Video hosting and client delivery portal — annual billing at $24/mo equivalent (~$288/yr).'),\n\n(2, 'Google Workspace (Business Starter)', NULL, 15000, 'monthly', 1, '2026-08-01', 'Email (@summitdigitalagency.com), Drive storage, and business tools for team.'),\n\n(2, 'Cloud Storage — Backblaze B2', NULL, 39700, 'yearly', 1, '2026-12-01', 'Raw footage archive and project backup. ~$5/mo equivalent annually.');\n\n\n-- ===================================================================\n-- STEP 5: Budget entries for FY2026 — table: budget_entries\n-- Uses ledger_types type_key (Income / Expense)\n-- ===================================================================\n\nINSERT INTO budget_entries (business_id, year, type_key, category, planned_cents) VALUES\n(2, 2026, 'Income', 'YouTube Retainers (Growth)', 1498800),\n(2, 2026, 'Income', 'TikTok/Shorts Automation', 749100),\n(2, 2026, 'Income', 'Faceless YouTube Starter Plans', 499500),\n(2, 2026, 'Income', 'YouTube Scale Plan', 849700),\n(2, 2026, 'Income', 'Short-Form Repurposing', 149700),\n(2, 2026, 'Income', 'Thumbnail Design (one-off)', 59400),\n(2, 2026, 'Income', 'Voiceover Production (one-off)', 39700),\n(2, 2026, 'Income', 'Channel Audit & Strategy', 199400),\n(2, 2026, 'Income', 'Brand Identity Packages', 299000),\n(2, 2026, 'Expense', 'AI Voiceover (ElevenLabs)', 70000),\n(2, 2026, 'Expense', 'ChatGPT API Usage', 596400),\n(2, 2026, 'Expense', 'Stock Footage & Music (Storyblocks)', 149100),\n(2, 2026, 'Expense', 'Adobe Creative Cloud Licenses', 716400),\n(2, 2026, 'Expense', 'Notion Business Plan', 120000),\n(2, 2026, 'Expense', 'Vimeo Pro Hosting', 59400),\n(2, 2026, 'Expense', 'Google Workspace (Email/Drive)', 180000),\n(2, 2026, 'Expense', 'Freelance Editor (Jordan Kim) — Contract Fee', 3000000),\n(2, 2026, 'Expense', 'Freelance Designer (Sam Chen) — Per Project', 594000),\n(2, 2026, 'Expense', 'Freelance VO Artist (Priya Sharma)', 397800),\n(2, 2026, 'Expense', 'SEO Tools & Software (Ahrefs/SEMrush)', 149400),\n(2, 2026, 'Expense', 'LLC Formation & Legal — One-time', 50000),\n(2, 2026, 'Expense', 'Website Domain & SSL (summitdigitalagency.com)', 39700);\n\n\n-- ===================================================================\n-- STEP 1: Business Info Section Visibility (custom fields for the company)\n-- These are stored as custom key-value pairs in a metadata table if available\n-- or we can use notes/document entries to capture them.\n-- Let's check what business_info_section_visibility looks like first.\nSELECT 'checking schema' AS info;\n\nCOMMIT;\n"},"status":"ok","ms":139}
