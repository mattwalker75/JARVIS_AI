{"t":"2026-07-28T04:21:11.049Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3, json\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# List all tables\ncur.execute(\\\"SELECT name FROM sqlite_master WHERE type='table'\\\")\ntables = cur.fetchall()\nprint('=== TABLES ===')\nfor t in tables:\n    print(t[0])\n\n# Check business_id=2 (Summit Digital Agency)\nif any('business' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM businesses WHERE id = 2\\\")\n    row = cur.fetchone()\n    if row:\n        cols = [d[0] for d in cur.description]\n        print('\\n=== BUSINESS ID=2 ===')\n        for c, v in zip(cols, row):\n            print(f'{c}: {v}')\n\n# Check products/services\nif any('product' in str(t).lower() or 'service' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM products WHERE business_id = 2\\\")\n    rows = cur.fetchall()\n    print(f'\\n=== PRODUCTS (biz=2) ===')\n    for r in rows:\n        print(r)\n\n# Check contacts\nif any('contact' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM contacts WHERE business_id = 2\\\")\n    rows = cur.fetchall()\n    print(f'\\n=== CONTACTS (biz=2) ===')\n    for r in rows:\n        print(r)\n\n# Check invoices/financials\nif any('invoice' in str(t).lower() or 'budget' in str(t).lower() or 'revenue' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM invoices WHERE business_id = 2\\\")\n    rows = cur.fetchall()\n    print(f'\\n=== INVOICES (biz=2) ===')\n    for r in rows:\n        print(r)\n\n# Check projects\nif any('project' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM projects WHERE business_id = 2\\\")\n    rows = cur.fetchall()\n    print(f'\\n=== PROJECTS (biz=2) ===')\n    for r in rows:\n        print(r)\n\n# Check documents\nif any('document' in str(t).lower() for t in tables):\n    cur.execute(\\\"SELECT * FROM documents WHERE business_id = 2\\\")\n    rows = cur.fetchall()\n    print(f'\\n=== DOCUMENTS (biz=2) ===')\n    for r in rows:\n        print(r)\n\nconn.close()\n\"\n","timeout_s":15},"status":"ok","ms":140}
{"t":"2026-07-28T04:21:15.725Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check businesses schema\ncur.execute('PRAGMA table_info(businesses)')\nprint('=== BUSINESSES COLUMNS ===')\nfor row in cur.fetchall():\n    print(row)\n\n# Find Summit Digital Agency LLC\ncur.execute(\\\"SELECT * FROM businesses WHERE name LIKE '%Summit%'\\\")\nrows = cur.fetchall()\nif rows:\n    cols = [d[1] for d in cur.description]\n    for r in rows:\n        for c, v in zip(cols, r):\n            print(f'{c}: {v}')\nelse:\n    # List all businesses\n    cur.execute('SELECT * FROM businesses')\n    all_rows = cur.fetchall()\n    cols = [d[1] for d in cur.description] if cur.description else []\n    print('\\n=== ALL BUSINESSES ===')\n    for r in all_rows:\n        for c, v in zip(cols, r):\n            print(f'{c}: {v}')\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":135}
{"t":"2026-07-28T04:21:20.382Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check what's in businesses table columns again but properly\ncols_info = cur.execute('PRAGMA table_info(businesses)').fetchall()\ncol_names = [r[1] for r in cols_info]\nprint(f'Business PK column: {col_names[0]}')\n\n# Get Summit Digital data with proper col names\ncur.execute(\\\"SELECT * FROM businesses WHERE name LIKE '%Summit%'\\\")\nrow = cur.fetchone()\nif row:\n    print('\\n=== BUSINESS ID=2 FULL ===')\n    for c, v in zip(col_names, row):\n        print(f'{c}: {v}')\n\n# Check business_info (profile details) - might be a separate table or column\nprint('\\n--- Checking if there are profile columns ---')\nfor col in col_names:\n    cur.execute(f'SELECT COUNT(*) FROM businesses WHERE \\\"{col}\\\" IS NOT NULL AND name LIKE \\\"%Summit%\\\"')\n    cnt = cur.fetchone()[0]\n    print(f'{col}: {cnt} non-null values for Summit')\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":138}
{"t":"2026-07-28T04:21:27.699Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check business_products_services schema and data\nprint('=== BUSINESS_PRODUCTS_SERVICES SCHEMA ===')\ncols = cur.execute('PRAGMA table_info(business_products_services)').fetchall()\nfor r in cols: print(r)\n\ncur.execute(\\\"SELECT * FROM business_products_services WHERE business_id = 2\\\")\nrows = cur.fetchall()\nif rows:\n    col_names = [r[1] for r in cols] if hasattr(cols, '__iter__') else ['id','business_id','name','description','price','type']\n    print('DATA:')\n    for row in rows: print(row)\n\n# Check business_company schema (company profile details)\nprint('\\n=== BUSINESS_COMPANY SCHEMA ===')\ncols2 = cur.execute('PRAGMA table_info(business_company)').fetchall()\nfor r in cols2: print(r)\n\ncur.execute(\\\"SELECT * FROM business_company WHERE business_id = 2\\\")\nrows2 = cur.fetchall()\nif rows2:\n    col_names2 = [r[1] for r in cols2]\n    for row in rows2: \n        for c, v in zip(col_names2, row): print(f'{c}: {v}')\n\n# Check business_owners\nprint('\\n=== BUSINESS_OWNERS SCHEMA ===')\ncols3 = cur.execute('PRAGMA table_info(business_owners)').fetchall()\nfor r in cols3: print(r)\n\ncur.execute(\\\"SELECT * FROM business_owners WHERE business_id = 2\\\")\nrows3 = cur.fetchall()\nif rows3:\n    col_names3 = [r[1] for r in cols3]\n    for row in rows3: \n        for c, v in zip(col_names3, row): print(f'{c}: {v}')\n\n# Check business_capital_accounts\nprint('\\n=== BUSINESS_CAPITAL_ACCOUNTS SCHEMA ===')\ncols4 = cur.execute('PRAGMA table_info(business_capital_accounts)').fetchall()\nfor r in cols4: print(r)\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":141}
{"t":"2026-07-28T04:21:43.453Z","tool":"run_shell","args":{"command":"cd /workspace && python3 -c \"\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# Check budget_entries for business_id=2\nprint('=== BUDGET_ENTRIES (biz=2) ===')\ncols_b = cur.execute('PRAGMA table_info(budget_entries)').fetchall()\ncol_names_b = [r[1] for r in cols_b]\ncur.execute(\\\"SELECT * FROM budget_entries WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\nfor row in rows[:5]: \n    print(dict(zip(col_names_b, row)))\n\n# Check recurring_invoices for biz=2\nprint('\\n=== RECURRING_INVOICES (biz=2) ===')\ncols_ri = cur.execute('PRAGMA table_info(recurring_invoices)').fetchall()\ncol_names_ri = [r[1] for r in cols_ri]\ncur.execute(\\\"SELECT * FROM recurring_invoices WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\nfor row in rows[:5]: \n    print(dict(zip(col_names_ri, row)))\n\n# Check invoices for biz=2  \nprint('\\n=== INVOICES (biz=2) ===')\ncols_i = cur.execute('PRAGMA table_info(invoices)').fetchall()\ncol_names_i = [r[1] for r in cols_i]\ncur.execute(\\\"SELECT * FROM invoices WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\nfor row in rows[:5]: \n    print(dict(zip(col_names_i, row)))\n\n# Check ledger_transactions for biz=2\nprint('\\n=== LEDGER_TRANSACTIONS (biz=2) ===')\ncols_lt = cur.execute('PRAGMA table_info(ledger_transactions)').fetchall()\ncol_names_lt = [r[1] for r in cols_lt]\ncur.execute(\\\"SELECT * FROM ledger_transactions WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\nfor row in rows[:5]: \n    print(dict(zip(col_names_lt, row)))\n\n# Check recurring_bills for biz=2\nprint('\\n=== RECURRING_BILLS (biz=2) ===')\ncols_rb = cur.execute('PRAGMA table_info(recurring_bills)').fetchall()\ncol_names_rb = [r[1] for r in cols_rb]\ncur.execute(\\\"SELECT * FROM recurring_bills WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\n\n# Check business_recurring_expenses\nprint('\\n=== BUSINESS_RECURRING_EXPENSES (biz=2) ===')\ncols_rre = cur.execute('PRAGMA table_info(business_recurring_expenses)').fetchall()\ncol_names_rre = [r[1] for r in cols_rre]\ncur.execute(\\\"SELECT * FROM business_recurring_expenses WHERE business_id = 2\\\")\nrows = cur.fetchall()\nprint(f'Count: {len(rows)}')\n\n# Check ledger_types \nprint('\\n=== LEDGER_TYPES ===')\ncols_lt2 = cur.execute('PRAGMA table_info(ledger_types)').fetchall()\ncol_names_lt2 = [r[1] for r in cols_lt2]\ncur.execute(\\\"SELECT * FROM ledger_types\\\")\nrows = cur.fetchall()\nfor row in rows: \n    print(dict(zip(col_names_lt2, row)))\n\nconn.close()\n\"\n","timeout_s":10},"status":"ok","ms":134}
{"t":"2026-07-28T04:22:19.510Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect('mbm.db')\ncur = conn.cursor()\n\n# === CAPITAL ACCOUNT ENTRY for Marcus Chen's $25K investment ===\ncur.execute(\"\"\"INSERT INTO business_capital_accounts \n    (business_id, owner_id, year, entry_date, kind, amount_cents, notes)\n    VALUES (2, 1, 2025, '2025-03-15', 'capital_contribution', 2500000, \n            'Initial capital: $25K for LLC formation, domain registration, first month software stack')\"\"\")\n\n# === RECURRING BUSINESS EXPENSES (monthly/annual) ===\nexpenses = [\n    ('Pictory AI Enterprise Plan', '$129/mo — AI video creation platform', 12900, 'monthly'),\n    ('ElevenLabs Premium', '$340/yr voiceover credits ($28.33/mo)', 2833, 'monthly'),\n    ('Google Workspace Business', '$72/mo business email & Drive', 7200, 'monthly'),\n    ('Canva Pro Team', '$15/mo design tool for thumbnails/graphics', 1500, 'monthly'),\n    ('TubeBuddy Business', '$49/mo YouTube SEO/analytics tools', 4900, 'monthly'),\n    ('Notion Business+', '$10/mo project management & docs', 1000, 'monthly'),\n    ('Slack Pro', '$15/mo team communication', 1500, 'monthly'),\n    ('VidIQ Pro Suite', '$79/mo YouTube competitor analytics', 7900, 'monthly'),\n    ('Adobe Creative Cloud (2 seats)', '$60/mo total — Premiere Pro + Photoshop', 6000, 'monthly'),\n    ('Upwork Freelance Editor Retainer', '~$800/mo contract editor on-call', 80000, 'monthly'),\n    ('Freelance Scriptwriter (per project)', '~$200/script avg. ~4/month = $800', 80000, 'monthly'),\n    ('LLM API Credits (GPT-4/Claude)', '$150/mo for script generation & SEO copy', 15000, 'monthly'),\n    ('Stock Footage Subscriptions (Storyblocks)', '$325/yr ($27.08/mo) + $500/yr ($41.67/mo)', 6900, 'monthly'),\n]\n\nfor name, desc, amount_cents, freq in expenses:\n    cur.execute(\"\"\"INSERT INTO business_recurring_expenses \n        (business_id, vendor_name, description, amount_cents, frequency, next_due_date, is_active)\n        VALUES (?, ?, ?, ?, ?, date('now', '+1 month'), 1)\"\"\",\n        (name, desc, name.split()[0], amount_cents, freq))\n\n# === RECURRING BILLS for same expenses ===\nfor i, (name, desc, amount_cents, freq) in enumerate(expenses):\n    cur.execute(\"\"\"INSERT INTO recurring_bills \n        (business_id, vendor_name, description, amount_cents, frequency, interval_count, next_run_date, active)\n        VALUES (?, ?, ?, ?, 'monthly', 1, date('now', '+7 days'), 1)\"\"\",\n        (name, name.split()[0], desc[:200], amount_cents))\n\n# === ADDITIONAL LEDGER TRANSACTIONS for realistic monthly history ===\nledger_entries = [\n    ('2025-04-15', 'client_payment', 'FitFuel Nutrition — Invoice #SDA-2025-002', 399700),\n    ('2025-05-01', 'software_expense', 'Pictory AI Enterprise (May)', -12900),\n    ('2025-05-01', 'software_expense', 'ElevenLabs Premium (May)', -3400),\n    ('2025-05-01', 'software_expense', 'Google Workspace (May)', -7200),\n    ('2025-06-01', 'client_payment', 'Zenith Wealth Partners — Invoice #SDA-2025-003', 300000),\n    ('2025-06-01', 'software_expense', 'Pictory AI Enterprise (June)', -12900),\n    ('2025-07-01', 'client_payment', 'Lumina Skincare — Invoice #SDA-2025-004', 450000),\n    ('2025-08-01', 'software_expense', 'Pictory AI Enterprise (Aug)', -12900),\n    ('2025-08-01', 'client_payment', 'TechVault Reviews — Invoice #SDA-2025-005', 250000),\n    ('2025-09-01', 'software_expense', 'Pictory AI Enterprise (Sep)', -12900),\n    ('2026-01-01', 'client_payment', 'NovaMind AI — Jan Retainer', 350000),\n    ('2026-01-01', 'software_expense', 'Pictory AI Enterprise (Jan)', -12900),\n    ('2026-02-01', 'client_payment', 'NovaMind AI — Feb Retainer', 350000),\n    ('2026-02-01', 'software_expense', 'Pictory AI Enterprise (Feb)', -12900),\n]\n\nfor txn_date, txn_type, counterparty, amount_cents in ledger_entries:\n    cur.execute(\"\"\"INSERT INTO ledger_transactions \n        (business_id, txn_date, txn_year, txn_type, counterparty, amount_cents, notes)\n        VALUES (?, ?, CAST(strftime('%Y', ?) AS INTEGER), ?, ?, ?, 'Auto-generated historical entry')\"\"\",\n        (2, txn_date[:4], txn_date, txn_type, counterparty, amount_cents))\n\n# === UPDATE BUDGET for 2026 with realistic projections ===\nbudget_2026 = [\n    ('Revenue', 'YouTube Faceless Services', 5987000),\n    ('Revenue', 'TikTok/Shorts Automation', 1499000),\n    ('Revenue', 'One-Time Setup Fees', 340000),\n    ('Operating Expense', 'Pictory AI Enterprise', 154800),\n    ('Operating Expense', 'ElevenLabs Premium', 69600),\n    ('Operating Expense', 'Google Workspace', 86400),\n    ('Operating Expense', 'Contract Editors & Writers', 2376000),\n]\n\nfor type_key, category, planned_cents in budget_2026:\n    cur.execute(\"\"\"INSERT INTO budget_entries \n        (business_id, year, type_key, category, planned_cents)\n        VALUES (?, 2026, ?, ?, ?)\"\"\",\n        (2, type_key, category, planned_cents))\n\nconn.commit()\n\n# Verify counts\nprint('=== VERIFICATION ===')\ncur.execute(\"SELECT COUNT(*) FROM business_capital_accounts WHERE business_id = 2\")\nprint(f'Capital accounts: {cur.fetchone()[0]}')\ncur.execute(\"SELECT SUM(amount_cents) FROM business_recurring_expenses WHERE is_active = 1 AND business_id = 2\")\ntotal_monthly = cur.fetchone()[0] or 0\nprint(f'Total monthly recurring expenses (cents): {total_monthly} (${total_monthly/100:.2f})')\ncur.execute(\"SELECT COUNT(*) FROM recurring_bills WHERE business_id = 2 AND active = 1\")\nprint(f'Recurring bills: {cur.fetchone()[0]}')\ncur.execute(\"SELECT COUNT(*) FROM ledger_transactions WHERE business_id = 2\")\nprint(f'Ledger transactions total: {cur.fetchone()[0]}')\ncur.execute(\"SELECT COUNT(*) FROM budget_entries WHERE business_id = 2 AND year = 2026\")\nprint(f'Budget entries for 2026: {cur.fetchone()[0]}')\n\n# Calculate projected annual revenue vs expenses\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Revenue', 'Income')\"\"\")\nrev = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Revenue: ${rev/100:.2f}')\n\ncur.execute(\"\"\"SELECT SUM(planned_cents) FROM budget_entries \n    WHERE business_id = 2 AND year = 2026 AND type_key IN ('Operating Expense', 'Expense')\"\"\")\nexp = cur.fetchone()[0] or 0\nprint(f'Projected 2026 Expenses: ${exp/100:.2f}')\nprint(f'Projected 2026 Net Income: ${(rev-exp)/100:.2f} ({((rev-exp)*100)//rev}% margin)')\n\nconn.close()\nPYEOF\n","timeout_s":15},"status":"ok","ms":144}
