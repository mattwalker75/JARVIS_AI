{"t":"2026-07-27T02:45:10.084Z","tool":"write_workbench_file","args":{"path":"/workspace/server.js","content":"const express = require('express');\nconst path = require('path');\nconst app = express();\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// In-memory data store (simulates a database)\nlet clients = [];\nlet policies = [];\nlet payments = [];\nlet idCounter = 100;\n\nfunction nextId() { return ++idCounter; }\n\n// Seed demo data if empty\nif (!clients.length && !policies.length) {\n  const seedClients = [\n    { firstName: 'James', lastName: 'Anderson', email: 'james.anderson@email.com', phone: '(555) 123-4567', dateOfBirth: '1980-03-15', address: '123 Oak Street, Springfield, IL 62701', registrationDate: '2024-01-15', status: 'active' },\n    { firstName: 'Maria', lastName: 'Garcia', email: 'maria.garcia@email.com', phone: '(555) 234-5678', dateOfBirth: '1975-07-22', address: '456 Elm Ave, Austin, TX 73301', registrationDate: '2024-03-22', status: 'active' },\n    { firstName: 'Robert', lastName: 'Chen', email: 'robert.chen@email.com', phone: '(555) 345-6789', dateOfBirth: '1990-11-08', address: '789 Pine Rd, Seattle, WA 98101', registrationDate: '2024-06-10', status: 'pending' },\n    { firstName: 'Sarah', lastName: 'Johnson', email: 'sarah.johnson@email.com', phone: '(555) 456-7890', dateOfBirth: '1985-02-28', address: \"321 Maple Dr, Denver, CO 80201\", registrationDate: '2023-11-05', status: 'active' },\n    { firstName: 'David', lastName: 'Williams', email: 'david.williams@email.com', phone: '(555) 567-8901', dateOfBirth: '1968-09-14', address: '654 Cedar Ln, Miami, FL 33101', registrationDate: '2024-08-18', status: 'inactive' },\n    { firstName: 'Emily', lastName: 'Thompson', email: 'emily.thompson@email.com', phone: '(555) 678-9012', dateOfBirth: '1992-04-30', address: '987 Birch St, Portland, OR 97201', registrationDate: '2025-01-20', status: 'active' },\n    { firstName: 'Michael', lastName: 'Brown', email: 'michael.brown@email.com', phone: '(555) 789-0123', dateOfBirth: '1978-12-01', address: '147 Walnut Ave, Chicago, IL 60601', registrationDate: '2024-05-12', status: 'pending' },\n    { firstName: 'Lisa', lastName: 'Martinez', email: 'lisa.martinez@email.com', phone: '(555) 890-1234', dateOfBirth: '1983-06-17', address: '258 Spruce Ct, Phoenix, AZ 85001', registrationDate: '2023-09-30', status: 'active' },\n  ];\n\n  seedClients.forEach(c => {\n    const id = nextId();\n    clients.push({ ...c, id });\n  });\n\n  // Seed policies linked to some clients\n  const policyTypes = ['Term Life - 20yr', 'Whole Life Premium', 'Universal Life Gold', 'Term Life - 10yr', 'Final Expense Basic'];\n  seedClients.slice(0, 6).forEach((c, i) => {\n    policies.push({\n      id: nextId(), clientId: c.id, policyNumber: `POL-${String(nextId()).padStart(5,'0')}`, type: policyTypes[i], faceValue: [250000, 500000, 750000, 100000, 300000][i],\n      premiumAmount: [45.99, 89.50, 120.00, 28.75, 35.00][i], frequency: 'monthly', startDate: ['2024-02-01','2024-04-01','2024-07-01','2023-12-01','2024-09-01'][i],\n      maturityDate: ['2044-02-01','2054-04-01','2064-07-01','2034-12-01','2044-09-01'][i], status: 'active', beneficiary: ['Jane Anderson','Carlos Garcia','Lily Chen','Tom Johnson','Karen Williams'][i]\n    });\n  });\n\n  // Seed payments linked to some policies\n  const statuses = ['paid','pending','overdue'];\n  for (let i = 0; i < Math.min(policies.length, 4); i++) {\n    [1,2].forEach(m => {\n      payments.push({\n        id: nextId(), policyId: policies[i].id, clientId: policies[i].clientId, amount: policies[i].premiumAmount, dueDate: `2025-${String(3+m).padStart(2,'0')}-15`, paidDate: null, status: statuses[Math.floor(Math.random()*statuses.length)],\n        paymentMethod: ['bank_transfer','credit_card','check'][Math.floor(Math.random()*3)]\n      });\n    });\n  }\n\n  // Seed more payments for the last two policies\n  for (let i = Math.min(policies.length,4); i < policies.length; i++) {\n    [1,2].forEach(m => {\n      payments.push({\n        id: nextId(), policyId: policies[i].id, clientId: policies[i].clientId, amount: policies[i].premiumAmount, dueDate: `2025-${String(3+m).padStart(2,'0')}-15`, paidDate: null, status: statuses[Math.floor(Math.random()*statuses.length)],\n        paymentMethod: ['bank_transfer','credit_card','check'][Math.floor(Math.random()*3)]\n      });\n    });\n  }\n}\n\n// --- API Routes ---\n\n// Dashboard stats\napp.get('/api/dashboard', (req, res) => {\n  const totalClients = clients.length;\n  const activePolicies = policies.filter(p => p.status === 'active').length;\n  const pendingPayments = payments.filter(p => p.status === 'pending' || p.status === 'overdue').length;\n  const totalRevenue = payments.filter(p => p.status === 'paid').reduce((s, p) => s + p.amount, 0);\n  const activeClients = clients.filter(c => c.status === 'active').length;\n  const pendingRegistrations = clients.filter(c => c.status === 'pending').length;\n\n  // Recent payments\n  const recentPayments = [...payments].sort((a,b) => new Date(b.dueDate) - new Date(a.dueDate)).slice(0, 5);\n\n  // Revenue by month (last 6 months simulation)\n  const monthlyRevenue = [423.74, 389.50, 512.00, 467.25, 398.00, totalRevenue > 0 ? Math.round(totalRevenue * 0.15 * 100) / 100 : 450];\n\n  res.json({\n    stats: { totalClients, activePolicies, pendingPayments, totalRevenue: Math.round(totalRevenue*100)/100, activeClients, pendingRegistrations },\n    recentPayments,\n    monthlyRevenue\n  });\n});\n\n// Clients CRUD\napp.get('/api/clients', (req, res) => {\n  let list = [...clients];\n  if (req.query.search) {\n    const s = req.query.search.toLowerCase();\n    list = list.filter(c => `${c.firstName} ${c.lastName}`.toLowerCase().includes(s) || c.email.includes(s) || c.phone.includes(s));\n  }\n  if (req.query.status) list = list.filter(c => c.status === req.query.status);\n  res.json(list.sort((a,b) => a.lastName.localeCompare(b.lastName)));\n});\n\napp.post('/api/clients', (req, res) => {\n  const client = { ...req.body, id: nextId() };\n  clients.push(client);\n  res.json({ ok: true, id: client.id });\n});\n\napp.put('/api/clients/:id', (req, res) => {\n  const idx = clients.findIndex(c => c.id === parseInt(req.params.id));\n  if (idx === -1) return res.status(404).json({ error: 'Client not found' });\n  clients[idx] = { ...clients[idx], ...req.body };\n  res.json({ ok: true });\n});\n\napp.delete('/api/clients/:id', (req, res) => {\n  const idx = clients.findIndex(c => c.id === parseInt(req.params.id));\n  if (idx !== -1) clients.splice(idx, 1);\n  // Also remove related policies and payments\n  policies = policies.filter(p => p.clientId !== parseInt(req.params.id));\n  payments = payments.filter(p => p.clientId !== parseInt(req.params.id));\n  res.json({ ok: true });\n});\n\n// Policies CRUD\napp.get('/api/policies', (req, res) => {\n  let list = policies.map(p => ({ ...p }));\n  if (req.query.clientId) list = list.filter(p => p.clientId === parseInt(req.query.clientId));\n  if (req.query.status) list = list.filter(p => p.status === req.query.status);\n  res.json(list.sort((a,b) => a.policyNumber.localeCompare(b.policyNumber)));\n});\n\napp.post('/api/policies', (req, res) => {\n  const policy = { ...req.body, id: nextId(), policyNumber: `POL-${String(nextId()).padStart(5,'0')}` };\n  policies.push(policy);\n  res.json({ ok: true, id: policy.id });\n});\n\napp.put('/api/policies/:id', (req, res) => {\n  const idx = policies.findIndex(p => p.id === parseInt(req.params.id));\n  if (idx === -1) return res.status(404).json({ error: 'Policy not found' });\n  policies[idx] = { ...policies[idx], ...req.body };\n  res.json({ ok: true });\n});\n\napp.delete('/api/policies/:id', (req, res) => {\n  const idx = policies.findIndex(p => p.id === parseInt(req.params.id));\n  if (idx !== -1) policies.splice(idx, 1);\n  payments = payments.filter(p => p.policyId !== parseInt(req.params.id));\n  res.json({ ok: true });\n});\n\n// Payments CRUD\napp.get('/api/payments', (req, res) => {\n  let list = [...payments];\n  if (req.query.clientId) list = list.filter(p => p.clientId === parseInt(req.query.clientId));\n  if (req.query.status) list = list.filter(p => p.status === req.query.status);\n  res.json(list.sort((a,b) => new Date(b.dueDate) - new Date(a.dueDate)));\n});\n\napp.post('/api/payments', (req, res) => {\n  const payment = { ...req.body, id: nextId() };\n  payments.push(payment);\n  res.json({ ok: true, id: payment.id });\n});\n\napp.put('/api/payments/:id', (req, res) => {\n  const idx = payments.findIndex(p => p.id === parseInt(req.params.id));\n  if (idx === -1) return res.status(404).json({ error: 'Payment not found' });\n  payments[idx] = { ...payments[idx], ...req.body };\n  res.json({ ok: true });\n});\n\napp.delete('/api/payments/:id', (req, res) => {\n  const idx = payments.findIndex(p => p.id === parseInt(req.params.id));\n  if (idx !== -1) payments.splice(idx, 1);\n  res.json({ ok: true });\n});\n\n// Client detail with policies and payments joined\napp.get('/api/clients/:id/detail', (req, res) => {\n  const client = clients.find(c => c.id === parseInt(req.params.id));\n  if (!client) return res.status(404).json({ error: 'Client not found' });\n  const clientPolicies = policies.filter(p => p.clientId === client.id);\n  const clientPayments = payments.filter(p => p.clientId === client.id);\n  res.json({ client, policies: clientPolicies, payments: clientPayments });\n});\n\nconst PORT = process.env.PORT || 9106;\napp.listen(PORT, '0.0.0.0', () => console.log(`LifeInsure Pro running on port ${PORT}`));\n"},"status":"ok","ms":147}
