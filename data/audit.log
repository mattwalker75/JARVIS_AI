{"t":"2026-07-26T00:07:42.674Z","tool":"write_workbench_file","args":{"path":"/workspace/doom/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Doom-like Web Game</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #111; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; font-family: monospace; color: #ccc; }\n#game-container { position: relative; width: 800px; height: 600px; border: 2px solid #333; background: #000; image-rendering: pixelated; cursor: crosshair; }\ncanvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }\n#hud { position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background: linear-gradient(to top, #2a1a1a, #4a2a2a); border-top: 3px solid #666; display: flex; align-items: center; justify-content: space-around; padding: 5px; }\n.hud-item { text-align: center; font-size: 18px; color: #ff0; text-shadow: 2px 2px #000; }\n.hud-label { font-size: 11px; color: #aaa; margin-bottom: 2px; }\n#health-val, #armor-val, #ammo-val, #score-val { font-size: 36px; color: #ff4444; text-shadow: 0 0 8px rgba(255,0,0,0.5); }\n#weapon-display { position: absolute; bottom: 90px; right: 30px; font-size: 16px; color: #ffaa00; z-index: 2; text-align: center; pointer-events: none; }\n#message-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background: rgba(0,0,0,0.7); z-index: 10; font-size: 32px; color: #f44; text-shadow: 0 0 20px red; }\n#minimap { position: absolute; top: 10px; right: 10px; border: 1px solid #555; opacity: 0.7; z-index: 3; pointer-events: none; }\n#crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: rgba(255,100,100,0.6); font-size: 30px; z-index: 4; pointer-events: none; }\n#damage-flash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,0,0,0); pointer-events: none; transition: background 0.08s; z-index: 5; }\n#start-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(180deg, #1a0000, #330000); z-index: 20; }\n#start-screen h1 { font-size: 72px; color: #cc0000; text-shadow: 0 0 40px red, 0 0 80px darkred; margin-bottom: 20px; letter-spacing: 8px; }\n#start-screen p { font-size: 16px; color: #aaa; margin: 5px; }\n#start-btn { margin-top: 30px; padding: 15px 40px; font-size: 24px; background: #8b0000; color: #fff; border: 2px solid #ff4444; cursor: pointer; font-family: monospace; letter-spacing: 3px; }\n#start-btn:hover { background: #cc0000; box-shadow: 0 0 20px rgba(255,0,0,0.5); }\n</style>\n</head>\n<body>\n\n<div id=\"game-container\">\n<canvas id=\"screen\" width=\"320\" height=\"240\"></canvas>\n<canvas id=\"minimap\" width=\"100\" height=\"100\"></canvas>\n<div id=\"crosshair\">+</div>\n<div id=\"damage-flash\"></div>\n<div id=\"weapon-display\"></div>\n\n<div id=\"hud\">\n  <div class=\"hud-item\"><div class=\"hud-label\">HEALTH</div><span id=\"health-val\">100%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">ARMOR</div><span id=\"armor-val\" style=\"color:#4488ff;\">25%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">AMMO</div><span id=\"ammo-val\" style=\"color:#ffaa00;\">50</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">KILLS</div><span id=\"score-val\" style=\"color:#44ff44;\">0</span></div>\n</div>\n\n<div id=\"message-overlay\"></div>\n<div id=\"start-screen\">\n<h1>DOOM-LIKE</h1>\n<p>WASD - Move | Mouse - Look | Click - Shoot</p>\n<p>R - Reload/Change Weapon</p>\n<p>Kill all demons to win!</p>\n<button id=\"start-btn\" onclick=\"startGame()\">ENTER HELL</button>\n</div>\n</div>\n\n<script>\n// ============ MAP DEFINITION ============\nconst TILE = 64;\nconst mapGrid = [\n  \"####################\",\n  \"#........#.........#\",\n  \"#........#.........#\",\n  \"#...##.....##......#\",\n  \"#...#.#####.#......#\",\n  \"#...#.#...#.#......#\",\n  \"#...#.#.0.#.#......#\",\n  \"#...#.#...#.#......#\",\n  \"#...#####.#.#......#\",\n  \"#.......#..#....###\",\n  \"####.##.....#.##...\",\n  \"#...#.#.1.#..#.....#\",\n  \"#...#.#...#..#.....#\",\n  \"#...#.#.2.#..#.....#\",\n  \"#...#####..#......#\",\n  \"#...........#....##\",\n  \"###.#########....#.\",\n  \"#................#.\",\n  \"#.......3........#.\",\n  \"#.......4........#.\",\n  \"#.......5........#.\",\n  \"####################\"\n];\n\nconst MAP_H = mapGrid.length;\nconst MAP_W = Math.max(...mapGrid.map(r => r.length));\n\n// Convert to numeric grid: 0=empty, >0 wall type\nlet walls = [];\nfor (let y = 0; y < MAP_H; y++) {\n  let row = [];\n  for (let x = 0; x < MAP_W; x++) {\n    const ch = mapGrid[y][x];\n    if (ch >= '1' && ch <= '9') row.push(parseInt(ch));\n    else if (ch === '#') row.push(1); // default wall type 1\n    else row.push(0);\n  }\n  walls.push(row);\n}\n\n// ============ GAME STATE ============\nlet player = { x: 3.5, y: 2.5, angle: 0, health: 100, armor: 25, ammo: 50, kills: 0 };\nconst weapons = [\n  { name: \"FIST\", damage: 10, fireRate: 400, magSize: Infinity, ammoCost: 0 },\n  { name: \"PISTOL\", damage: 20, fireRate: 350, magSize: Infinity, ammoCost: 1 },\n  { name: \"SHOTGUN\", damage: 60, fireRate: 800, magSize: Infinity, ammoCost: 2 }\n];\nlet currentWeapon = 1; // start with pistol\nlet lastShotTime = 0;\nlet gameState = 'menu'; // menu, playing, dead, won\nlet enemies = [];\nlet pickups = [];\nlet particles = [];\n\n// ============ ENEMY TYPES ============\nconst enemyTypes = {\n  imp:    { name:\"Imp\",     hp:40, speed:1.2, damage:8, color:\"#cc6633\", size:0.35 },\n  demon:  { name:\"Demon\",  hp:70, speed:1.8, damage:15, color:\"#aa2222\", size:0.45 },\n  zombie: { name:\"Zombie\", hp:50, speed:0.9, damage:12, color:\"#6b8e3a\", size:0.4 }\n};\n\n// ============ SPAWN ENEMIES & PICKUPS ============\nfunction spawnEntities() {\n  enemies = [];\n  pickups = [];\n  \n  // Place enemies at specific map positions (in grid coords)\n  const enemySpawns = [\n    { x:5, y:3, type:\"zombie\" },\n    { x:14, y:2, type:\"imp\" },\n    { x:8, y:7, type:\"demon\" },\n    { x:16, y:9, type:\"zombie\" },\n    { x:3, y:10, type:\"imp\" },\n    { x:12, y:14, type:\"demon\" },\n    { x:5, y:17, type:\"zombie\" },\n    { x:18, y:16, type:\"imp\" },\n    { x:9, y:18, type:\"demon\" },\n    { x:20, y:3, type:\"zombie\" }\n  ];\n\n  enemySpawns.forEach(s => {\n    enemies.push({\n      ...s,\n      hp: enemyTypes[s.type].hp,\n      maxHp: enemyTypes[s.type].hp,\n      speed: enemyTypes[s.type].speed * TILE / 1000,\n      damage: enemyTypes[s.type].damage,\n      color: enemyTypes[s.type].color,\n      size: enemyTypes[s.type].size,\n      name: enemyTypes[s.type].name,\n      alive: true,\n      attackCooldown: 0,\n      hitFlash: 0\n    });\n  });\n\n  // Pickups scattered around\n  const pickupSpawns = [\n    { x:9.5, y:6.5, type:\"health\" },\n    { x:14.5, y:8.5, type:\"ammo\" },\n    { x:3.5, y:12.5, type:\"armor\" },\n    { x:17.5, y:13.5, type:\"health\" },\n    { x:9.5, y:16.5, type:\"ammo\" }\n  ];\n\n  pickupSpawns.forEach(p => {\n    pickups.push({ ...p, alive: true });\n  });\n}\n\n// ============ CANVAS SETUP ============\nconst canvas = document.getElementById('screen');\nconst ctx = canvas.getContext('2d', { alpha: false });\ncanvas.width = 320;\ncanvas.height = 240;\n\nconst miniCanvas = document.getElementById('minimap');\nconst mctx = miniCanvas.getContext('2d');\n\n// ============ INPUT ============\nlet keys = {};\ndocument.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });\ndocument.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\n\nlet mouseDown = false;\ncanvas.addEventListener('mousedown', () => { if(gameState === 'playing') mouseDown = true; });\ncanvas.addEventListener('mouseup', () => { mouseDown = false; });\ncanvas.addEventListener('click', () => { \n  if (gameState === 'playing') canvas.requestPointerLock();\n});\n\ndocument.addEventListener('mousemove', e => {\n  if (gameState === 'playing' && document.pointerLockElement) {\n    player.angle += e.movementX * 0.003;\n  }\n});\n\n// ============ RAYCASTING ENGINE ============\nconst FOV = Math.PI / 3; // 60 degrees\nconst NUM_RAYS = 128; // reduced for retro feel and performance\nconst MAX_DEPTH = 20; // max wall distance in tiles\n\nfunction castRay(ox, oy, angle) {\n  const sinA = Math.sin(angle);\n  const cosA = Math.cos(angle);\n  \n  let dist = 0;\n  let hitX = ox, hitY = oy;\n  let wallType = 0;\n  \n  // DDA raycasting algorithm (simplified)\n  for (let d = 0.01; d < MAX_DEPTH * TILE / 64; d += 0.02) {\n    const testX = ox + cosA * d;\n    const testY = oy + sinA * d;\n    \n    const gridX = Math.floor(testX);\n    const gridY = Math.floor(testY);\n    \n    if (gridX < 0 || gridX >= MAP_W || gridY < 0 || gridY >= MAP_H) break;\n    \n    if (walls[gridY][gridX] > 0) {\n      dist = d * TILE / 64; // convert to world units\n      hitX = testX;\n      hitY = testY;\n      wallType = walls[gridY][gridX];\n      \n      // Determine which face was hit for shading\n      break;\n    }\n  }\n  \n  return { dist: Math.max(dist, 0.1), hitX, hitY, wallType };\n}\n\n// Wall colors by type (dark palette)\nconst WALL_COLORS = {\n  0: null,\n  1: [80, 60, 50],   // brown brick\n  2: [90, 70, 40],   // dark stone  \n  3: [60, 50, 70],   // purple stone\n  4: [100, 80, 30],   // gold-ish\n  5: [50, 90, 50]    // green slime wall\n};\n\nfunction getWallColor(type) {\n  return WALL_COLORS[type] || [70, 55, 45];\n}\n\n// ============ RENDERING ============\nfunction render() {\n  const imgData = ctx.createImageData(320, 240);\n  const buf = imgData.data; // pixel buffer\n  \n  // Clear to dark ceiling/floor colors\n  for (let y = 0; y < 240; y++) {\n    let color;\n    if (y < 120) {\n      // Ceiling - dark gradient\n      const t = y / 120;\n      color = [Math.floor(15 * (1-t)), Math.floor(8 * (1-t)), Math.floor(20 * (1-t))];\n    } else {\n      // Floor - darker gradient  \n      const t = (y - 120) / 120;\n      color = [Math.floor(30 * (1-t)), Math.floor(15 * (1-t)), Math.floor(8 * (1-t))];\n    }\n    \n    for (let x = 0; x < 320; x++) {\n      const idx = (y * 320 + x) * 4;\n      buf[idx]     = color[0]; // R\n      buf[idx + 1] = color[1]; // G  \n      buf[idx + 2] = color[2]; // B\n      buf[idx + 3] = 255;       // A\n    }\n  }\n\n  // Cast rays for each column and draw walls\n  const stripWidth = Math.max(1, Math.floor(320 / NUM_RAYS));\n  \n  for (let i = 0; i < NUM_RAYS; i++) {\n    const rayAngle = player.angle - FOV/2 + (i / NUM_RAYS) * FOV;\n    const result = castRay(player.x, player.y, rayAngle);\n    \n    // Fix fisheye\n    const correctedDist = result.dist * Math.cos(rayAngle - player.angle);\n    \n    if (result.wallType === 0 || correctedDist > MAX_DEPTH) continue;\n    \n    // Wall height on screen\n    const wallHeight = Math.min(240, Math.floor((TILE / correctedDist) * TILE));\n    const wallTop = Math.max(0, Math.floor(120 - wallHeight/2));\n    const wallBottom = Math.min(239, Math.floor(120 + wallHeight/2));\n    \n    // Shading based on distance (fog effect) and face\n    let shade = 1.0 / (1 + correctedDist * 0.4);\n    shade *= 0.7; // base darkness\n    \n    const [r, g, b] = getWallColor(result.wallType);\n    \n    for (let y = wallTop; y <= wallBottom; y++) {\n      for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n        const idx = (y * 320 + sx) * 4;\n        \n        // Add slight vertical stripe pattern on walls\n        let wallShade = shade;\n        if ((sx % 8 < 4)) wallShade *= 0.95;\n        \n        buf[idx]     = Math.floor(r * wallShade);\n        buf[idx + 1] = Math.floor(g * wallShade);\n        buf[idx + 2] = Math.floor(b * wallShade);\n      }\n    }\n    \n    // Draw floor/ceiling cast from this ray (simplified - just the column)\n    for (let y = wallBottom; y < 180; y++) {\n      const t = (y - wallBottom) / (240 - wallBottom);\n      let fR, fG, fB;\n      \n      if (t > 0.3 && Math.random() < 0.05 * shade) {\n        // Floor detail spots\n        fR = r + Math.floor(Math.random()*10);\n        fG = g - 20;\n        fB = b - 10;\n      } else {\n        const floorShade = shade * (1.5 / (t + 0.3));\n        fR = Math.floor(40 * floorShade);\n        fG = Math.floor(20 * floorShade);\n        fB = Math.floor(10 * floorShade);\n      }\n      \n      for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n        const idx = (y * 320 + sx) * 4;\n        buf[idx]     = fR;\n        buf[idx + 1] = fG; \n        buf[idx + 2] = fB;\n      }\n    }\n    \n    // Ceiling column\n    for (let y = wallTop - 5; y < Math.max(wallTop, 0); y++) {\n      const t = (wallTop - y) / 5 || 1;\n      const ceilShade = shade * (2.5 / (t + 0.3));\n      \n      for (let sx = i * stripWidth; sx < Math.min((i+1) * stripWidth, 320); sx++) {\n        if (y >= 0 && y < 240) {\n          const idx = (y * 320 + sx) * 4;\n          buf[idx]     = Math.floor(8 * ceilShade);\n          buf[idx + 1] = Math.floor(5 * ceilShade);\n          buf[idx + 2] = Math.floor(12 * ceilShade);\n        }\n      }\n    }\n  }\n\n  ctx.putImageData(imgData, 0, 0);\n  \n  // Draw sprites (enemies and pickups) - sorted by distance\n  drawSprites();\n}\n\nfunction drawSprites() {\n  const allSprites = [];\n  \n  enemies.forEach(e => {\n    if (!e.alive) return;\n    \n    const dx = e.x - player.x;\n    const dy = e.y - player.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    \n    let angleToEnemy = Math.atan2(dy, dx) - player.angle;\n    // Normalize angle\n    while (angleToEnemy > Math.PI) angleToEnemy -= 2*Math.PI;\n    while (angleToEnemy < -Math.PI) angleToEnemy += 2*Math.PI;\n    \n    if (Math.abs(angleToEnemy) < FOV/2 + 0.1 && dist < MAX_DEPTH * TILE / 64) {\n      allSprites.push({ ...e, dist, relAngle: angleToEnemy });\n    }\n  });\n\n  pickups.forEach(p => {\n    if (!p.alive) return;\n    \n    const dx = p.x - player.x;\n    const dy = p.y - player.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    \n    let angleToPickup = Math.atan2(dy, dx) - player.angle;\n    while (angleToPickup > Math.PI) angleToPickup -= 2*Math.PI;\n    while (angleToPickup < -Math.PI) angleToPickup += 2*Math.PI;\n    \n    if (Math.abs(angleToPickup) < FOV/2 + 0.1 && dist < MAX_DEPTH * TILE / 64) {\n      allSprites.push({ ...p, dist, relAngle: angleToPickup });\n    }\n  });\n\n  // Sort back to front\n  allSprites.sort((a,b) => b.dist - a.dist);\n\n  // Draw each sprite as a colored rectangle (retro style)\n  allSprites.forEach(s => {\n    const screenX = Math.floor(160 + s.relAngle / FOV * NUM_RAYS);\n    \n    if (s.hp !== undefined && s.alive) {\n      // Enemy - draw as pixelated sprite\n      let shade = 1.0 / (1 + s.dist * 0.4);\n      \n      const size = Math.floor(s.size * TILE / s.dist * TILE / 64);\n      if (size < 2 || screenX < -50 || screenX > 370) return;\n      \n      // Flash white when hit\n      let colorR, colorG, colorB;\n      if (s.hitFlash > 0) {\n        [colorR, colorG, colorB] = [255, 200, 180];\n      } else {\n        const hexToRgb = h => {\n          const r = parseInt(h.slice(1,3),16);\n          const g = parseInt(h.slice(3,5),16); \n          const b = parseInt(h.slice(5,7),16);\n          return [r,g,b];\n        };\n        [colorR, colorG, colorB] = hexToRgb(s.color) || [200, 80, 40];\n      }\n\n      // Draw enemy body (simple rectangle with pixelated look)\n      const spriteTop = Math.max(0, Math.floor(120 - size/2));\n      const spriteBottom = Math.min(239, Math.floor(120 + size/2));\n      \n      for (let y = spriteTop; y <= spriteBottom; y++) {\n        for (let x = screenX - Math.floor(size/2); x < screenX + Math.floor(size/2); x++) {\n          if (x >= 0 && x < 320) {\n            const idx = (y * 320 + x) * 4;\n            \n            // Add some pixelation - only draw every other pixel for retro feel\n            const pxMod = Math.floor(x / 2);\n            if ((pxMod % 2 === 0 || size < 15)) {\n              buf[idx]     = Math.min(255, Math.floor(colorR * shade));\n              buf[idx + 1] = Math.min(255, Math.floor(colorG * shade));\n              buf[idx + 2] = Math.min(255, Math.floor(colorB * shade));\n            }\n          }\n        }\n      }\n\n      // Draw eyes (two bright dots)\n      const eyeSize = Math.max(1, size / 8);\n      const eyeY = spriteTop + Math.floor(size * 0.25);\n      \n      for (let ey of [-size*0.15, size*0.15]) {\n        const ex = screenX + Math.floor(ey);\n        if (ex >= 0 && ex < 320) {\n          for (let dy = -eyeSize; dy <= eyeSize; dy++) {\n            for (let dx = -eyeSize; dx <= eyeSize; dx++) {\n              const px = Math.floor(ex + dx);\n              const py = Math.floor(eyeY + dy);\n              if (px >= 0 && px < 320 && py >= 0 && py < 240) {\n                const idx = (py * 320 + px) * 4;\n                buf[idx]     = 255; // bright eyes\n                buf[idx+1]   = Math.floor(80 * shade);\n                buf[idx+2]   = Math.floor(60 * shade);\n              }\n            }\n          }\n        }\n      }\n\n    } else if (s.type === 'health') {\n      // Health pickup - green cross\n      let shade = 1.0 / (1 + s.dist * 0.4);\n      const size = Math.floor(25 / s.dist * TILE/64);\n      if (size < 3) return;\n      \n      for (let y = 120 - size; y <= 120 + size; y++) {\n        for (let x = screenX - size; x <= screenX + size; x++) {\n          const idx = (y * 320 + Math.max(0,Math.min(319,x))) * 4;\n          if ((x >= screenX-size && x < screenX+size) || \n              (y >= 120-size/2 && y <= 120+size/2)) {\n            buf[idx]     = Math.floor(50 * shade);\n            buf[idx + 1] = Math.floor(200 * shade);\n            buf[idx + 2] = Math.floor(80 * shade);\n          }\n        }\n      }\n    } else if (s.type === 'ammo') {\n      // Ammo pickup - yellow box\n      let shade = 1.0 / (1 + s.dist * 0.4);\n      const size = Math.floor(20 / s.dist * TILE/64);\n      if (size < 3) return;\n      \n      for (let y = 125 - size; y <= 125 + size; y++) {\n        for (let x = screenX - size; x <= screenX + size; x++) {\n          const idx = (y * 320 + Math.max(0,Math.min(319,x))) * 4;\n          buf[idx]     = Math.floor(200 * shade);\n          buf[idx + 1] = Math.floor(180 * shade);\n          buf[idx + 2] = Math.floor(50 * shade);\n        }\n      }\n    } else if (s.type === 'armor') {\n      // Armor pickup - blue shield shape\n      let shade = 1.0 / (1 + s.dist * 0.4);\n      const size = Math.floor(25 / s.dist * TILE/64);\n      if (size < 3) return;\n      \n      for (let y = 120 - size; y <= 120 + size; y++) {\n        for (let x = screenX - size; x <= screenX + size; x++) {\n          const idx = (y * 320 + Math.max(0,Math.min(319,x))) * 4;\n          if ((x-screenX)**2/size**2 + (y-120)**2/(size*0.7)**2 <= 1) {\n            buf[idx]     = Math.floor(60 * shade);\n            buf[idx + 1] = Math.floor(80 * shade);\n            buf[idx + 2] = Math.floor(255 * shade);\n          }\n        }\n      }\n    }\n  });\n\n  // Draw particles (blood, sparks)\n  particles.forEach(p => {\n    const dx = p.x - player.x;\n    const dy = p.y - player.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    \n    let angleToP = Math.atan2(dy, dx) - player.angle;\n    while (angleToP > Math.PI) angleToP -= 2*Math.PI;\n    while (angleToP < -Math.PI) angleToP += 2*Math.PI;\n    \n    if (Math.abs(angleToP) < FOV/2 && dist < MAX_DEPTH * TILE / 64) {\n      const screenX = Math.floor(160 + angleToP / FOV * NUM_RAYS);\n      let shade = 1.0 / (1 + dist * 0.5);\n      \n      for (let y = p.screenY - 2; y <= p.screenY + 2; y++) {\n        for (let x = screenX - 2; x <= screenX + 2; x++) {\n          if (x >= 0 && x < 320 && y >= 0 && y < 240) {\n            const idx = (y * 320 + x) * 4;\n            buf[idx]     = Math.floor(p.color[0] * shade);\n            buf[idx+1]   = Math.floor(p.color[1] * shade);\n            buf[idx+2]   = Math.floor(p.color[2] * shade);\n          }\n        }\n      }\n    }\n  });\n\n  ctx.putImageData(imgData, 0, 0);\n}\n\n// ============ MINIMAP ============\nfunction drawMinimap() {\n  mctx.fillStyle = '#1a1a1a';\n  mctx.fillRect(0, 0, 100, 100);\n  \n  const scale = 4; // pixels per tile\n  \n  // Draw walls\n  for (let y = 0; y < MAP_H; y++) {\n    for (let x = 0; x < MAP_W; x++) {\n      if (walls[y][x] > 0) {\n        mctx.fillStyle = '#556';\n        mctx.fillRect(x * scale, y * scale, scale-1, scale-1);\n      }\n    }\n  }\n  \n  // Draw enemies as red dots\n  enemies.forEach(e => {\n    if (!e.alive) return;\n    const sx = (e.x - player.x + 5) / 10 * 100;\n    const sy = (e.y - player.y + 5) / 10 * 100;\n    mctx.fillStyle = '#f44';\n    mctx.fillRect(sx-2, sy-2, 4, 4);\n  });\n  \n  // Draw pickups as colored dots\n  pickups.forEach(p => {\n    if (!p.alive) return;\n    const sx = (p.x - player.x + 5) / 10 * 100;\n    const sy = (p.y - player.y + 5) / 10 * 100;\n    mctx.fillStyle = p.type === 'health' ? '#4f4' : p.type === 'ammo' ? '#ff4' : '#48f';\n    mctx.fillRect(sx-2, sy-2, 3, 3);\n  });\n  \n  // Draw player (white triangle)\n  const px = 50;\n  const py = 50;\n  mctx.fillStyle = '#fff';\n  mctx.beginPath();\n  mctx.arc(px, py, 4, 0, Math.PI*2);\n  mctx.fill();\n  \n  // Direction indicator\n  mctx.strokeStyle = '#ff0';\n  mctx.lineWidth = 1;\n  mctx.beginPath();\n  mctx.moveTo(px, py);\n  mctx.lineTo(px + Math.cos(player.angle)*8, py + Math.sin(player.angle)*8);\n  mctx.stroke();\n}\n\n// ============ SHOOTING ============\nfunction shoot() {\n  const now = Date.now();\n  const weapon = weapons[currentWeapon];\n  \n  if (now - lastShotTime < weapon.fireRate) return;\n  if (weapon.ammoCost > player.ammo) return; // out of ammo\n  \n  lastShotTime = now;\n  player.ammo -= weapon.ammoCost;\n  \n  // Screen flash for muzzle\n  const flash = document.getElementById('damage-flash');\n  flash.style.background = 'rgba(255,200,100,0.3)';\n  setTimeout(() => { flash.style.background = 'rgba(255,0,0,0)'; }, 80);\n\n  // Raycast straight ahead to hit enemies\n  const rayAngle = player.angle;\n  \n  if (currentWeapon === 0) {\n    // Fist - melee only\n    let closestEnemy = null;\n    let closestDist = Infinity;\n    \n    enemies.forEach(e => {\n      if (!e.alive) return;\n      const dx = e.x - player.x;\n      const dy = e.y - player.y;\n      const dist = Math.sqrt(dx*dx + dy*dy);\n      \n      let angleToE = Math.atan2(dy, dx) - rayAngle;\n      while (angleToE > Math.PI) angleToE -= 2*Math.PI;\n      while (angleToE < -Math.PI) angleToE += 2*Math.PI;\n      \n      if (dist < closestDist && Math.abs(angleToE) < 0.3 && dist < 1.5 * TILE/64) {\n        closestEnemy = e;\n        closestDist = dist;\n      }\n    });\n    \n    if (closestEnemy) damageEnemy(closestEnemy, weapon.damage);\n    return;\n  }\n\n  // Check enemies in a cone straight ahead for ranged weapons  \n  const hitCone = Math.PI / 12; // narrow cone\n  \n  let closestHitDist = Infinity;\n  let targetToDamage = null;\n  \n  enemies.forEach(e => {\n    if (!e.alive) return;\n    \n    const dx = e.x - player.x;\n    const dy = e.y - player.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    \n    let angleToE = Math.atan2(dy, dx) - rayAngle;\n    while (angleToE > Math.PI) angleToE -= 2*Math.PI;\n    while (angleToE < -Math.PI) angleToE += 2*Math.PI;\n    \n    if (Math.abs(angleToE) < hitCone && dist < closestHitDist) {\n      // Check wall blocking\n      const rayResult = castRay(player.x, player.y, Math.atan2(dy,dx));\n      if (rayResult.dist > dist * TILE/64 - 0.5) {\n        targetToDamage = e;\n        closestHitDist = dist;\n      }\n    }\n  });\n\n  // Shotgun shoots multiple pellets (spread)\n  const pellets = currentWeapon === 2 ? [0, -3, 3] : [0];\n  \n  pellets.forEach(offset => {\n    if (!targetToDamage || offset !== 0) {\n      let hitEnemy = null;\n      \n      enemies.forEach(e => {\n        if (!e.alive) return;\n        \n        const dx = e.x - player.x;\n        const dy = e.y - player.y;\n        const dist = Math.sqrt(dx*dx + dy*dy);\n        \n        let angleToE = Math.atan2(dy, dx) - (rayAngle + offset * 0.015);\n        while (angleToE > Math.PI) angleToE -= 2*Math.PI;\n        while (angleToE < -Math.PI) angleToE += 2*Math.PI;\n        \n        if (Math.abs(angleToE) < hitCone && dist < closestHitDist) {\n          const rayResult = castRay(player.x, player.y, Math.atan2(dy,dx));\n          if (rayResult.dist > dist * TILE/64 - 0.5) {\n            hitEnemy = e;\n            closestHitDist = dist;\n          }\n        }\n      });\n\n      if (hitEnemy && offset === pellets[pellets.length-1]) { // only damage once per shot\n        damageEnemy(hitEnemy, weapon.damage / pellets.length);\n        \n        // Blood particles at hit location\n        const hx = player.x + Math.cos(Math.atan2(dy,hitEnemy.y-hitEnemy.y)) * closestHitDist;\n        const hy = player.y + Math.sin(Math.atan2(hy,p)) * closestHitDist;\n      }\n    }\n  });\n\n  // If nothing hit, spawn sparks at impact point on wall\n  if (!targetToDamage) {\n    for (let i = 0; i < 5; i++) {\n      particles.push({\n        x: player.x + Math.cos(rayAngle) * 3,\n        y: player.y + Math.sin(rayAngle) * 3,\n        vx: Math.cos(rayAngle + Math.random()*0.5 - 0.25) * 2,\n        vy: Math.sin(rayAngle + Math.random()*0.5 - 0.25) * 2,\n        life: 15,\n        color: [255, 200, 80] // sparks\n      });\n    }\n  }\n\n  updateHUD();\n}\n\nfunction damageEnemy(enemy, dmg) {\n  enemy.hp -= dmg;\n  enemy.hitFlash = 6; // frames to flash white\n  \n  if (enemy.hp <= 0) {\n    enemy.alive = false;\n    player.kills++;\n    \n    // Blood splatter particles\n    for (let i = 0; i < 15; i++) {\n      particles.push({\n        x: enemy.x,\n        y: enemy.y,\n        vx: Math.random() * 3 - 1.5,\n        vy: Math.random() * 3 - 1.5,\n        life: 40 + Math.random()*20,\n        color: [Math.floor(80+Math.random()*60), 0, 0] // blood red\n      });\n    }\n\n    updateHUD();\n    \n    if (enemies.filter(e => e.alive).length === 0) {\n      gameState = 'won';\n      showMessage(\"HELL CLEARED! You survived!\", \"#4f4\");\n    }\n  } else {\n    // Hit particles  \n    for (let i = 0; i < 5; i++) {\n      particles.push({\n        x: enemy.x,\n        y: enemy.y,\n        vx: Math.random()*2-1,\n        vy: Math.random()*2-1,\n        life: 20 + Math.random()*10,\n        color: [180, 30, 30] // dark blood\n      });\n    }\n  }\n}\n\n// ============ ENEMY AI ============\nfunction updateEnemies() {\n  enemies.forEach(e => {\n    if (!e.alive) return;\n    \n    const dx = player.x - e.x;\n    const dy = player.y - e.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n\n    // Move toward player (simple chase AI)\n    if (dist > 0.8 * TILE/64 && dist < MAX_DEPTH * TILE / 64) {\n      let moveX = dx/dist * e.speed;\n      let moveY = dy/dist * e.speed;\n      \n      const newX = e.x + moveX;\n      const newY = e.y + moveY;\n      \n      // Check wall collision (simple grid check)\n      if (walls[Math.floor(newY)][Math.floor(e.x)] === 0) {\n        e.y += moveY * 0.7; // slightly slower sideways\n      }\n      if (walls[Math.floor(e.y)][Math.floor(newX)] === 0) {\n        e.x += moveX * 0.7;\n      }\n    }\n\n    // Attack player when close enough\n    if (dist < 1.2 && dist > 0.5) {\n      e.attackCooldown--;\n      if (e.attackCooldown <= 0) {\n        let damage = e.damage;\n        \n        // Armor absorbs some damage\n        if (player.armor > 0) {\n          const absorbed = Math.min(damage * 0.6, player.armor);\n          player.armor -= absorbed;\n          damage -= absorbed;\n        }\n        \n        player.health -= damage;\n        e.attackCooldown = 45 + Math.random()*30; // frames between attacks\n        \n        // Red flash on screen\n        const flash = document.getElementById('damage-flash');\n        flash.style.background = 'rgba(255,0,0,0.6)';\n        setTimeout(() => { flash.style.background = 'rgba(255,0,0,0)'; }, 150);\n\n        updateHUD();\n        \n        if (player.health <= 0) {\n          gameState = 'dead';\n          showMessage(\"YOU DIED\", \"#f44\");\n        }\n      }\n    }\n    \n    // Reduce hit flash timer\n    if (e.hitFlash > 0) e.hitFlash--;\n  });\n\n  // Update particles  \n  for (let i = particles.length - 1; i >= 0; i--) {\n    const p = particles[i];\n    p.x += p.vx * 0.05;\n    p.y += p.vy * 0.05;\n    p.life--;\n    \n    // Wall collision for particles  \n    if (walls[Math.floor(p.y)][Math.floor(p.x)] > 0) {\n      p.vx *= -0.5;\n      p.vy *= -0.5;\n    }\n    \n    if (p.life <= 0) {\n      particles.splice(i, 1);\n    }\n  }\n\n  // Check pickup collection  \n  pickups.forEach(p => {\n    if (!p.alive) return;\n    \n    const dx = player.x - p.x;\n    const dy = player.y - p.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    \n    if (dist < 0.5 * TILE/64) {\n      switch(p.type) {\n        case 'health':\n          player.health = Math.min(100, player.health + 25);\n          break;\n        case 'ammo':\n          player.ammo += 30;\n          break;\n        case 'armor':\n          player.armor = Math.min(100, player.armor + 25);\n          break;\n      }\n      \n      p.alive = false;\n      updateHUD();\n    }\n  });\n}\n\n// ============ PLAYER MOVEMENT ============\nfunction movePlayer() {\n  const speed = 3 * TILE/64 / 60; // tiles per frame at 60fps\n  \n  let dx = 0, dy = 0;\n  \n  if (keys['w'] || keys['arrowup']) {\n    dx += Math.cos(player.angle) * speed;\n    dy += Math.sin(player.angle) * speed;\n  }\n  if (keys['s'] || keys['arrowdown']) {\n    dx -= Math.cos(player.angle) * speed;\n    dy -= Math.sin(player.angle) * speed;\n  }\n  if (keys['a']) {\n    dx += Math.cos(player.angle - Math.PI/2) * speed;\n    dy += Math.sin(player.angle - Math.PI/2) * speed;\n  }\n  if (keys['d'] || keys['arrowright']) {\n    player.angle += speed * 0.8; // strafe right + turn slightly  \n    dx -= Math.cos(player.angle) * speed * 0.3;\n    dy -= Math.sin(player.angle) * speed * 0.3;\n  }\n\n  if (keys['r']) {\n    currentWeapon = (currentWeapon + 1) % weapons.length;\n    document.getElementById('weapon-display').textContent = \"WEAPON: \" + weapons[currentWeapon].name;\n    keys['r'] = false; // prevent rapid cycling\n  }\n\n  // Collision detection with wall sliding  \n  const newX = player.x + dx;\n  const newY = player.y + dy;\n  \n  if (walls[Math.floor(player.y)][Math.floor(newX)] === 0) {\n    player.x = newX;\n  }\n  if (walls[Math.floor(newY)][Math.floor(player.x)] === 0) {\n    player.y = newY;\n  }\n\n  // Shooting\n  mouseDown && shoot();\n}\n\n// ============ HUD UPDATE ============\nfunction updateHUD() {\n  document.getElementById('health-val').textContent = Math.max(0, Math.floor(player.health)) + '%';\n  document.getElementById('armor-val').textContent = Math.max(0, Math.floor(player.armor)) + '%';\n  document.getElementById('ammo-val').textContent = player.ammo;\n  document.getElementById('score-val').textContent = player.kills;\n  \n  const hpEl = document.getElementById('health-val');\n  if (player.health < 25) {\n    hpEl.style.color = '#ff0000';\n  } else if (player.health < 50) {\n    hpEl.style.color = '#ff8800';\n  } else {\n    hpEl.style.color = '#4f4';\n  }\n}\n\nfunction showMessage(text, color='#f44') {\n  const overlay = document.getElementById('message-overlay');\n  overlay.innerHTML = text;\n  overlay.style.display = 'flex';\n  \n  if (gameState === 'dead' || gameState === 'won') {\n    setTimeout(() => {\n      overlay.innerHTML += '<br><span style=\"font-size:18px;color:#aaa;\">Click to restart</span>';\n      document.getElementById('game-container').addEventListener('click', function handler() {\n        resetGame();\n        this.removeEventListener('click', handler);\n      });\n    }, 500);\n  }\n}\n\n// ============ GAME LOOP ============\nfunction gameLoop() {\n  if (gameState === 'playing') {\n    movePlayer();\n    updateEnemies();\n    render();\n    drawMinimap();\n    \n    // Update weapon display  \n    document.getElementById('weapon-display').textContent = \"WEAPON: \" + weapons[currentWeapon].name;\n  } else if (gameState === 'dead' || gameState === 'won') {\n    render();\n    drawMinimap();\n  }\n}\n\n// ============ START / RESET ============\nfunction startGame() {\n  document.getElementById('start-screen').style.display = 'none';\n  \n  player.x = 3.5;\n  player.y = 2.5;\n  player.angle = Math.PI/4; // face northeast to start\n  player.health = 100;\n  player.ammo = 50;\n  player.kills = 0;\n  currentWeapon = 1;\n  \n  spawnEntities();\n  \n  gameState = 'playing';\n  updateHUD();\n  \n  canvas.requestPointerLock();\n}\n\nfunction resetGame() {\n  document.getElementById('message-overlay').style.display = 'none';\n  startGame();\n}\n\n// Initial render of menu background\nspawnEntities();\nrender();\ndrawMinimap();\n\n</script>\n</body>\n</html>\n"},"status":"ok","ms":144}
