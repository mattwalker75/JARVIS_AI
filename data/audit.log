{"t":"2026-07-28T17:12:41.841Z","tool":"write_workbench_file","args":{"path":"/workspace/public/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Retro FPS - Doom Style</title>\n  <style>\n    body { margin: 0; background: #111; overflow: hidden; }\n    #instructions { position: absolute; top: 10px; left: 10px; color: #fff; font-family: monospace; background: rgba(0,0,0,0.7); padding: 8px; border-radius: 4px; z-index: 10; }\n  </style>\n</head>\n<body>\n  <div id=\"instructions\">\n    <b>Controls:</b><br>\n    WASD = Move<br>\n    Mouse = Look<br>\n    Left Click = Shoot<br>\n    Space = Jump<br>\n    ESC = Unlock Mouse<br>\n  </div>\n  <script src=\"https://cdn.jsdelivr.net/npm/three@0.154.0/build/three.min.js\"></script>\n  <script src=\"game.js\"></script>\n</body>\n</html>\n"},"status":"ok","ms":147}
{"t":"2026-07-28T17:13:21.817Z","tool":"write_workbench_file","args":{"path":"/workspace/public/game.js","content":"// Doom-style FPS core using Three.js\nlet camera, scene, renderer, controls, raycaster;\nlet moveForward = false, moveBackward = false, moveLeft = false, moveRight = false, canJump = false;\nlet velocity = new THREE.Vector3();\nlet direction = new THREE.Vector3();\nlet objects = [];\nlet bullets = [];\nlet enemies = [];\nlet clock = new THREE.Clock();\nlet player = { health: 100 };\n\nconst pointerLock = () => {\n  const havePointerLock = 'pointerLockElement' in document;\n  if (havePointerLock) {\n    const element = document.body;\n    element.requestPointerLock = element.requestPointerLock || element.mozRequestPointerLock;\n    document.addEventListener('click', () => {\n      element.requestPointerLock();\n    });\n    document.addEventListener('pointerlockchange', lockChange, false);\n  }\n};\nfunction lockChange() {\n  if (document.pointerLockElement === document.body) {\n    document.addEventListener('mousemove', onMouseMove, false);\n  } else {\n    document.removeEventListener('mousemove', onMouseMove, false);\n  }\n}\nfunction onMouseMove(event) {\n  if (!controls.enabled) return;\n  controls.getObject().rotation.y -= event.movementX * 0.002;\n  controls.getPitchObject().rotation.x -= event.movementY * 0.002;\n  controls.getPitchObject().rotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, controls.getPitchObject().rotation.x));\n}\n\nfunction init() {\n  camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 1, 1000);\n  scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x222222);\n  // Floor\n  const floorGeometry = new THREE.PlaneGeometry(100, 100, 10, 10);\n  const floorMaterial = new THREE.MeshBasicMaterial({ color: 0x333333, wireframe: true });\n  const floor = new THREE.Mesh(floorGeometry, floorMaterial);\n  floor.rotation.x = -Math.PI/2;\n  scene.add(floor);\n  // Walls (simple maze)\n  const wallMaterial = new THREE.MeshBasicMaterial({ color: 0x666666 });\n  for (let x = -40; x <= 40; x += 10) {\n    for (let z = -40; z <= 40; z += 10) {\n      if (x === 0 && z === 0) continue;\n      if (Math.random() > 0.7) {\n        const wall = new THREE.Mesh(new THREE.BoxGeometry(10, 10, 2), wallMaterial);\n        wall.position.set(x, 5, z);\n        scene.add(wall);\n        objects.push(wall);\n      }\n    }\n  }\n  // Player controls\n  controls = new THREE.PointerLockControls(camera, document.body);\n  scene.add(controls.getObject());\n  // Enemies\n  for (let i = 0; i < 5; i++) {\n    let enemy = new THREE.Mesh(new THREE.BoxGeometry(4,8,4), new THREE.MeshBasicMaterial({ color: 0xff0000 }));\n    enemy.position.set(Math.random()*80-40, 4, Math.random()*80-40);\n    enemy.userData = { health: 30 };\n    scene.add(enemy);\n    enemies.push(enemy);\n  }\n  raycaster = new THREE.Raycaster(new THREE.Vector3(), new THREE.Vector3(), 0, 10);\n  renderer = new THREE.WebGLRenderer();\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  document.body.appendChild(renderer.domElement);\n  pointerLock();\n  animate();\n}\n\nfunction animate() {\n  requestAnimationFrame(animate);\n  const delta = clock.getDelta();\n  velocity.x -= velocity.x * 10.0 * delta;\n  velocity.z -= velocity.z * 10.0 * delta;\n  direction.z = Number(moveForward) - Number(moveBackward);\n  direction.x = Number(moveRight) - Number(moveLeft);\n  direction.normalize();\n  if (moveForward || moveBackward) velocity.z -= direction.z * 400.0 * delta;\n  if (moveLeft || moveRight) velocity.x -= direction.x * 400.0 * delta;\n  controls.moveRight(-velocity.x * delta);\n  controls.moveForward(-velocity.z * delta);\n  // Bullets\n  for (let i = bullets.length-1; i >= 0; i--) {\n    let bullet = bullets[i];\n    bullet.position.add(bullet.userData.dir.clone().multiplyScalar(50*delta));\n    // Bullet-enemy collision\n    for (let j = enemies.length-1; j >= 0; j--) {\n      if (bullet.position.distanceTo(enemies[j].position) < 4) {\n        enemies[j].userData.health -= 10;\n        if (enemies[j].userData.health <= 0) {\n          scene.remove(enemies[j]);\n          enemies.splice(j,1);\n        }\n        scene.remove(bullet);\n        bullets.splice(i,1);\n        break;\n      }\n    }\n    // Remove bullet if too far\n    if (Math.abs(bullet.position.x) > 100 || Math.abs(bullet.position.z) > 100) {\n      scene.remove(bullet);\n      bullets.splice(i,1);\n    }\n  }\n  // Enemies move toward player\n  enemies.forEach(enemy => {\n    let toPlayer = controls.getObject().position.clone().sub(enemy.position);\n    if (toPlayer.length() > 2) {\n      toPlayer.y = 0;\n      toPlayer.normalize();\n      enemy.position.add(toPlayer.multiplyScalar(10*delta));\n    } else {\n      // Damage player\n      player.health -= 10*delta;\n      if (player.health <= 0) {\n        alert('Game Over! Refresh to play again.');\n        window.location.reload();\n      }\n    }\n  });\n  renderer.render(scene, camera);\n}\n\ndocument.addEventListener('keydown', function(event) {\n  switch(event.code) {\n    case 'ArrowUp':\n    case 'KeyW': moveForward = true; break;\n    case 'ArrowLeft':\n    case 'KeyA': moveLeft = true; break;\n    case 'ArrowDown':\n    case 'KeyS': moveBackward = true; break;\n    case 'ArrowRight':\n    case 'KeyD': moveRight = true; break;\n    case 'Space': if (canJump) velocity.y += 350; canJump = false; break;\n  }\n});\ndocument.addEventListener('keyup', function(event) {\n  switch(event.code) {\n    case 'ArrowUp':\n    case 'KeyW': moveForward = false; break;\n    case 'ArrowLeft':\n    case 'KeyA': moveLeft = false; break;\n    case 'ArrowDown':\n    case 'KeyS': moveBackward = false; break;\n    case 'ArrowRight':\n    case 'KeyD': moveRight = false; break;\n  }\n});\ndocument.addEventListener('mousedown', function(event) {\n  if (event.button === 0 && controls.enabled) {\n    // Shoot\n    let bullet = new THREE.Mesh(new THREE.SphereGeometry(0.5,8,8), new THREE.MeshBasicMaterial({ color: 0xffff00 }));\n    bullet.position.copy(controls.getObject().position);\n    let dir = new THREE.Vector3();\n    camera.getWorldDirection(dir);\n    bullet.userData = { dir: dir.clone() };\n    scene.add(bullet);\n    bullets.push(bullet);\n  }\n});\nwindow.addEventListener('resize', function() {\n  camera.aspect = window.innerWidth / window.innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(window.innerWidth, window.innerHeight);\n});\n\n// Simple pointer lock controls\nTHREE.PointerLockControls = function(camera, domElement) {\n  this.domElement = domElement;\n  this.isLocked = false;\n  camera.rotation.set(0,0,0);\n  const scope = this;\n  this.getObject = function() { return camera; };\n  this.getPitchObject = function() { return camera; };\n  this.enabled = false;\n  document.addEventListener('pointerlockchange', function() {\n    scope.enabled = document.pointerLockElement === domElement;\n  });\n};\nTHREE.PointerLockControls.prototype.moveForward = function(distance) {\n  const vector = new THREE.Vector3();\n  this.getObject().getWorldDirection(vector);\n  vector.y = 0;\n  vector.normalize();\n  this.getObject().position.addScaledVector(vector, distance);\n};\nTHREE.PointerLockControls.prototype.moveRight = function(distance) {\n  const vector = new THREE.Vector3();\n  this.getObject().getWorldDirection(vector);\n  vector.y = 0;\n  vector.normalize();\n  vector.cross(this.getObject().up);\n  this.getObject().position.addScaledVector(vector, distance);\n};\n\nwindow.onload = init;\n"},"status":"ok","ms":151}
{"t":"2026-07-28T17:13:28.449Z","tool":"write_workbench_file","args":{"path":"/workspace/server.js","content":"const express = require('express');\nconst path = require('path');\nconst app = express();\nconst PORT = 9101;\n\napp.use(express.static(path.join(__dirname, 'public')));\n\napp.listen(PORT, '0.0.0.0', () => {\n  console.log(`Retro FPS game running at http://localhost:${PORT}`);\n});\n"},"status":"ok","ms":162}
