{"t":"2026-07-26T15:19:52.130Z","tool":"run_shell","args":{"command":"python3 -c \"\nfrom playwright.sync_api import sync_playwright\nimport time\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page(viewport={'width': 800, 'height': 600})\n    \n    # Navigate to the game\n    page.goto('http://localhost:9101/')\n    time.sleep(2)  # Let it initialize\n    \n    # Check canvas exists and has content\n    canvas = page.locator('#game')\n    print(f'Canvas present: {canvas.is_visible()}')\n    \n    # Check HUD elements\n    hp_text = page.inner_text('body').split('\\\\n')[0] if page.inner_text('body') else ''\n    print(f'HUD visible (HP/Ammo): {\\\"HP:\\\" in page.content() and \\\"AMMO:\\\" in page.content()}')\n    \n    # Check crosshair exists\n    print(f'Crosshair present: {page.locator(\\\"#crosshair\\\").is_visible()}')\n    \n    # Check minimap is drawn on canvas (check for green pixel)\n    screenshot = page.screenshot()\n    print(f'Screenshot taken, size: {len(screenshot)} bytes')\n    \n    # Verify key JS functions exist by evaluating them\n    has_castRay = page.evaluate('typeof castRay === \\\"function\\\"')\n    has_updatePlayer = page.evaluate('typeof updatePlayer === \\\"function\\\"')\n    has_render = page.evaluate('typeof render === \\\"function\\\"')\n    has_loop = page.evaluate('typeof loop === \\\"function\\\"')\n    print(f'castRay function: {has_castRay}')\n    print(f'updatePlayer function: {has_updatePlayer}')\n    print(f'render function: {has_render}')\n    print(f'loop function: {has_loop}')\n    \n    # Check maps exist\n    num_maps = page.evaluate('maps.length')\n    print(f'Maps defined: {num_maps}')\n    \n    # Check enemy AI states in code\n    has_patrol = 'state=\\\\\\\"patrol\\\\\\\"' in page.content() or \\\"state='patrol'\\\" in page.content()\n    has_chase = 'state=\\\\\\\"chase\\\\\\\"' in page.content() or \\\"state='chase'\\\" in page.content()\n    print(f'Enemy patrol state: {has_patrol}')\n    print(f'Enemy chase state: {has_chase}')\n    \n    # Check sound effects present\n    has_shoot = 'shoot' in page.content() and 'AudioContext' in page.content()\n    print(f'Sound system (Web Audio API): {has_shoot}')\n    \n    # Check lighting/darkness overlay exists\n    has_darkness = 'darkness' in page.content().lower() or 'brightness' in page.content().lower()\n    print(f'Distance fog/lighting: {has_darkness}')\n    \n    browser.close()\n\"\n","timeout_s":30},"status":"ok","ms":2383}
{"t":"2026-07-26T15:20:06.728Z","tool":"run_shell","args":{"command":"python3 -c \"\nfrom playwright.sync_api import sync_playwright\nimport time, json\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = p.chromium.launch_persistent_context('/tmp/pw-user', headless=True).new_page()\n    \n    # Capture console messages to check for errors\n    page.on('console', lambda msg: print(f'CONSOLE [{msg.type}]: {msg.text}'))\n    \n    page.goto('http://localhost:9101/')\n    time.sleep(3)  # Let it fully initialize\n    \n    # Check canvas has actual rendered content (not just empty black)\n    screenshot = page.screenshot()\n    print(f'Screenshot size: {len(screenshot)} bytes')\n    \n    # Get the full HTML to verify all features are present\n    html = page.content()\n    \n    checks = [\n        ('Raycasting engine', 'castRay' in html),\n        ('DDA algorithm', 'dda' in html.lower()),\n        ('Player movement WASD', \\\"keys['w']\\\" in html and \\\"keys['s']\\\" in html),\n        ('Mouse look (pointer lock)', 'requestPointerLock' in html or 'onmousemove' in html),\n        ('Collision detection', 'grid[.*\\\\]\\\\[.*\\\\]===0' in html.replace('\\\\n','')),\n        ('Multiple maps', 'maps=[' in html and len(html) > 15000),\n        ('Weapon/shooting', 'fireWeapon' in html or 'shootCd' in html),\n        ('Enemy AI patrol state', \\\"state='patrol'\\\" in html),\n        ('Enemy AI chase state', \\\"state='chase'\\\" in html),\n        ('Enemy AI attack state', \\\"state='attack'\\\" in html),\n        ('HUD - HP display', 'id=\\\"hp\\\"' in html or 'id=\\\\\\\"hp\\\\\\\"' in html),\n        ('HUD - Ammo display', 'id=\\\"ammo\\\"' in html or 'id=\\\\\\\"ammo\\\\\\\"' in html),\n        ('Crosshair element', 'id=\\\"crosshair\\\"' in html),\n        ('Minimap rendering', 'minimap' in html.lower()),\n        ('Sound: shoot', \\\"case'shoot'\\\" in html or 'shoot:' in html.replace(' ','')),\n        ('Sound: hit', \\\"case'hit'\\\" in html or 'hit:' in html.replace(' ','')),\n        ('Sound: enemy_die', \\\"case'enemy_die'\\\" in html),\n        ('Sound: hurt', \\\"case'hurt'\\\" in html),\n        ('Sound: pickup', \\\"case'pickup'\\\" in html),\n        ('Web Audio API (AudioContext)', 'AudioContext' in html or 'webkitAudioContext' in html),\n        ('Game loop (requestAnimationFrame)', 'requestAnimationFrame(loop)' in html),\n        ('Death condition (HP<=0)', 'player.hp<=0' in html),\n        ('Level transition', 'maps[1]' in html and 'The Dungeon' in html),\n    ]\n    \n    all_pass = True\n    for name, result in checks:\n        status = '✅ PASS' if result else '❌ FAIL'\n        if not result:\n            all_pass = False\n        print(f'{status}: {name}')\n    \n    browser.close()\n\"\n","timeout_s":30},"status":"ok","ms":3408}
