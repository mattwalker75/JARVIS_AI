{"t":"2026-07-28T04:16:12.175Z","tool":"run_shell","args":{"command":"cd /workspace && sqlite3 mbm.db <<'SQL'\n-- Step 3: Company entity details - Address\nINSERT INTO business_addresses (business_id, label, line1, city, state, postal_code, country, is_primary) VALUES\n(2, 'Headquarters', '450 S La Salle St, Suite 4800', 'Chicago', 'IL', '60605', 'US', 1);\n\n-- Registered Agent\nINSERT INTO business_registered_agent (business_id, name, address, email) VALUES\n(2, 'Corporation Service Company', '357 S Jackson Ave, Dover, DE 19901', 'registered@summitdigitalagency.com');\n\n-- Business Emails\nINSERT INTO business_emails (business_id, label, email, is_primary) VALUES\n(2, 'General Inquiries', 'hello@summitdigitalagency.com', 1),\n(2, 'Sales', 'sales@summitdigitalagency.com', 0),\n(2, 'Support', 'support@summitdigitalagency.com', 0);\n\n-- Business Phones (VOIP)\nINSERT INTO business_phones (business_id, label, number, is_primary) VALUES\n(2, 'Main Line', '+1 (312) 555-0198', 1),\n(2, 'Sales Direct', '+1 (312) 555-0199', 0);\n\n-- Business Domains\nINSERT INTO business_domains (business_id, domain_name, status, is_primary) VALUES\n(2, 'summitdigitalagency.com', 'active', 1),\n(2, 'summit.digital', 'redirect', 0);\nSQL\necho \"Company details inserted: $?\"","timeout_s":10},"status":"ok","ms":139}
