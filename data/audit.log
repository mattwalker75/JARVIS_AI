{"t":"2026-07-24T22:50:49.109Z","tool":"write_workbench_file","args":{"path":"/workspace/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Three Nations Beer Guide 🍺</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600&display=swap');\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    background: #1a1a2e;\n    color: #eee;\n    font-family: 'Inter', sans-serif;\n    min-height: 100vh;\n  }\n\n  header {\n    text-align: center;\n    padding: 40px 20px 20px;\n    background: linear-gradient(135deg, #16213e, #0f3460);\n    border-bottom: 4px solid #e94560;\n  }\n\n  header h1 {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 3.5rem;\n    letter-spacing: 4px;\n    color: #fff;\n    text-shadow: 2px 2px 8px rgba(0,0,0,.6);\n  }\n\n  header p {\n    margin-top: 8px;\n    font-size: .95rem;\n    opacity: .7;\n  }\n\n  .flags-row {\n    display: flex;\n    justify-content: center;\n    gap: 40px;\n    padding: 30px 20px;\n    background: #16213e;\n  }\n\n  .flag-btn {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.5rem;\n    letter-spacing: 2px;\n    padding: 14px 36px;\n    border: 2px solid #e94560;\n    background: transparent;\n    color: #fff;\n    cursor: pointer;\n    transition: all .2s;\n    text-transform: uppercase;\n  }\n\n  .flag-btn:hover, .flag-btn.active {\n    background: #e94560;\n    transform: scale(1.08);\n  }\n\n  .content-area {\n    max-width: 900px;\n    margin: 30px auto;\n    padding: 0 20px 60px;\n  }\n\n  .nation-section { display: none; }\n  .nation-section.active { display: block; }\n\n  .section-title {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 2.4rem;\n    letter-spacing: 3px;\n    margin-bottom: 6px;\n    color: #e94560;\n  }\n\n  .section-subtitle {\n    opacity: .6;\n    margin-bottom: 28px;\n    font-size: .9rem;\n  }\n\n  /* Style Cards */\n  .style-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n    gap: 16px;\n    margin-bottom: 36px;\n  }\n\n  .style-card {\n    background: #16213e;\n    border-radius: 12px;\n    padding: 20px;\n    border-left: 4px solid #e94560;\n    transition: transform .15s;\n  }\n\n  .style-card:hover { transform: translateY(-3px); }\n\n  .style-card h3 {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.3rem;\n    letter-spacing: 2px;\n    color: #e94560;\n    margin-bottom: 8px;\n  }\n\n  .style-card p {\n    font-size: .85rem;\n    line-height: 1.55;\n    opacity: .75;\n  }\n\n  /* Brewery List */\n  h2.section-head {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.6rem;\n    letter-spacing: 2px;\n    color: #e94560;\n    margin-bottom: 14px;\n    border-bottom: 1px solid rgba(233,69,96,.3);\n    padding-bottom: 8px;\n  }\n\n  .brewery-list { list-style: none; margin-bottom: 36px; }\n\n  .brewery-list li {\n    background: #16213e;\n    border-radius: 10px;\n    padding: 14px 18px;\n    margin-bottom: 10px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    transition: transform .15s;\n  }\n\n  .brewery-list li:hover { transform: translateX(4px); }\n\n  .brewery-emoji { font-size: 1.6rem; flex-shrink: 0; }\n\n  .brewery-info strong { display: block; color: #fff; font-size: .95rem; }\n  .brewery-info span { opacity: .6; font-size: .82rem; line-height: 1.45; }\n\n  /* Tips */\n  .tips-box {\n    background: linear-gradient(135deg, #0f3460, #1a1a2e);\n    border-radius: 12px;\n    padding: 22px;\n    margin-bottom: 36px;\n  }\n\n  .tips-box h3 {\n    font-family: 'Bebas Neue', sans-serif;\n    color: #e94560;\n    letter-spacing: 2px;\n    margin-bottom: 10px;\n    font-size: 1.2rem;\n  }\n\n  .tips-box ul { list-style: none; padding: 0; }\n\n  .tips-box li {\n    opacity: .75;\n    font-size: .88rem;\n    line-height: 1.6;\n    margin-bottom: 4px;\n    padding-left: 18px;\n    position: relative;\n  }\n\n  .tips-box li::before {\n    content: '▸';\n    color: #e94560;\n    position: absolute;\n    left: 0;\n  }\n\n  /* Rating bar */\n  .rating-bar-container { margin-top: 8px; }\n  .rating-label { font-size: .72rem; opacity: .5; display: flex; justify-content: space-between; }\n  .bar-bg { height: 6px; background: #0f3460; border-radius: 3px; margin-top: 3px; overflow: hidden; }\n  .bar-fill { height: 100%; border-radius: 3px; transition: width .5s ease; }\n\n  /* Footer */\n  footer { text-align: center; padding: 24px; opacity: .35; font-size: .78rem; background: #16213e; }\n</style>\n</head>\n<body>\n\n<header>\n  <h1>🍺 THREE NATIONS BEER GUIDE</h1>\n  <p>Pick a country. Drink something interesting.</p>\n</header>\n\n<div class=\"flags-row\">\n  <button class=\"flag-btn active\" onclick=\"showNation('belgium')\">🇧🇪 Belgium</button>\n  <button class=\"flag-btn\" onclick=\"showNation('japan')\">🇯🇵 Japan</button>\n  <button class=\"flag-btn\" onclick=\"showNation('mexico')\">🇲🇽 Mexico</button>\n</div>\n\n<div class=\"content-area\">\n\n<!-- ==================== BELGIUM ==================== -->\n<div id=\"belgium\" class=\"nation-section active\">\n  <h2 class=\"section-title\">BELGIUM 🇧🇪 — Liquid Cathedrals</h2>\n  <p class=\"section-subtitle\">800+ breweries. Trappist monks brewing since the Middle Ages. Beer here is religion.</p>\n\n  <h2 class=\"section-head\">Styles to Chase</h2>\n  <div class=\"style-grid\">\n    <div class=\"style-card\">\n      <h3>Saison / Farmhouse Ale</h3>\n      <p>Barnyard funk, peppery spice, bone-dry finish. Born in Wallonia — brewed through winter for summer drinking. The OG craft beer.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Hoppy / Dry</span><span>8/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:80%;background:#f5a623;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Belgian Strong Dark (Quadruple)</h3>\n      <p>Dark fruit, caramel, 9-11% ABV. Sippable like a fine cognac. Chimay Réserve is the grandfather of this style.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Rich / Boozy</span><span>9/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:90%;background:#e94560;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Gueuze / Lambic</h3>\n      <p>Spontaneously fermented with wild yeast. Aged in barrels for years, then blended like wine. Sour, funky, complex as hell.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Sour / Funky</span><span>10/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:95%;background:#e94560;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Belgian Pale Ale (Belgic)</h3>\n      <p>The underrated cousin. Caramel malt, subtle spice, 4-5%. Less known than Trappist stuff but criminally good.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Malt / Balanced</span><span>7/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:70%;background:#f5a623;\"></div></div></div>\n    </div>\n  </div>\n\n  <h2 class=\"section-head\">Breweries You Need to Know</h2>\n  <ul class=\"brewery-list\">\n    <li><span class=\"brewery-emoji\">⛪</span><div class=\"brewery-info\"><strong>Chimay (Scourmont Abbey)</strong><span>The original Trappist. Blue = Grande Réserve (Quadruple). Gold = White (Première). Red = Reserve (Dubbel).</span></div></li>\n    <li><span class=\"brewery-emoji\">🏔️</span><div class=\"brewery-info\"><strong>Rochefort (6, 8, 10)</strong><span>The #10 is arguably the best Belgian Strong Dark in existence. Dense chocolate, raisin, alcohol warmth that hugs you.</span></div></li>\n    <li><span class=\"brewery-emoji\">🍒</span><div class=\"brewery-info\"><strong>Cantillon (Brussels)</strong><span>The Lambic temple. Open tastings on Saturdays — walk in with €10 and drink your way through 25+ beers.</span></div></li>\n    <li><span class=\"brewery-emoji\">🍺</span><div class=\"brewery-info\"><strong>Duvel Moortgat (Puurs)</strong><span>The Duvel itself is a masterclass — deceptively strong at 8.5%, dry-hopped, golden perfection.</span></div></li>\n    <li><span class=\"brewery-emoji\">🌿</span><div class=\"brewery-info\"><strong>Brouwerij 't IJ (Amsterdam-ish)</span><span>Dutch windmill brewery pumping out killer Belgian-style ales. Pilsner and Oud Bruin are standouts.</span></div></li>\n  </ul>\n\n  <h2 class=\"section-head\">Pro Tips</h2>\n  <div class=\"tips-box\">\n    <h3>How to Drink Like a Belgier</h3>\n    <ul>\n      <li>Serve Saison at cellar temp (10-14°C), not ice cold — warmth releases the aromatics</li>\n      <li>Lambic needs no glassware pretension — just clean and wide enough for aroma</li>\n      <li>The \"Belgian pour\" matters: swirl, then pour hard to create a thick head that traps volatiles</li>\n      <li>If you see \"bière de garde\" on a menu in Belgium, grab it — French-influenced lager from the north</li>\n      <li>Cantillon Saturday tastings sell out fast — go before noon or risk disappointment</li>\n    </ul>\n  </div>\n</div>\n\n<!-- ==================== JAPAN ==================== -->\n<div id=\"japan\" class=\"nation-section\">\n  <h2 class=\"section-title\">JAPAN 🇯🇵 — Precision in a Can</h2>\n  <p class=\"section-subtitle\">From ultra-clean Asahi Super Dry to wild craft sours. Japan's beer scene is discipline meets experimentation.</p>\n\n  <h2 class=\"section-head\">Styles to Chase</h2>\n  <div class=\"style-grid\">\n    <div class=\"style-card\">\n      <h3>Rice Lager (Japanese Style)</h3>\n      <p>Crisp, clean, refreshing. Rice adjunct creates a lighter body than European lagers. Asahi Super Dry is the king of dry finish.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Crushable</span><span>8/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:80%;background:#4fc3f7;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Happoshu (Low-Malt)</h3>\n      <p>Tax-optimized brews using hops + non-malt adjuncts. Surprisingly good — Suntory The Premium and Asahi Dry Yell are top-tier.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Crisp / Value</span><span>7/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:70%;background:#4fc3f7;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>IPA (Japanese Craft)</h3>\n      <p>Hoppy but refined. Japanese brewers use hop varieties like Saaz and domestic hops for floral, citrusy profiles that are approachable.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Fragrant / Balanced</span><span>8/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:75%;background:#4fc3f7;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Sake-Beer / Yuzu Sour</h3>\n      <p>Craft brewers experimenting with sake yeast, yuzu citrus, and rice. Uniquely Japanese — nothing else makes this.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Novelty / Fun</span><span>9/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:85%;background:#4fc3f7;\"></div></div></div>\n    </div>\n  </div>\n\n  <h2 class=\"section-head\">Breweries You Need to Know</h2>\n  <ul class=\"brewery-list\">\n    <li><span class=\"brewery-emoji\">🏔️</span><div class=\"brewery-info\"><strong>Sapporo Brewery (Sakae, Sapporo)</strong><span>The historic flagship. The Sakae Malt Museum has a tasting room and the beer is noticeably better than canned.</span></div></li>\n    <li><span class=\"brewery-emoji\">🍻</span><div class=\"brewery-info\"><strong>Hokkaido Brewing (Niseko)</strong><span>Premium lagers brewed with Hokkaido spring water. The \"Premium\" line is a masterclass in clean lager.</span></div></li>\n    <li><span class=\"brewery-emoji\">🌸</span><div class=\"brewery-info\"><strong>Tokyo Beer Company (Tokyo)</strong><span>Craft brewery in Koto ward. Try their IPA and seasonal sake-beer hybrids — very Instagrammable taproom.</span></div></li>\n    <li><span class=\"brewery-emoji\">🍶</span><div class=\"brewery-info\"><strong>Suntory (The Premium Malt's)</strong><span>The gold standard for Japanese premium lager. Brewed with Miyama spring water and 6-day cold conditioning.</span></div></li>\n    <li><span class=\"brewery-emoji\">🎌</span><div class=\"brewery-info\"><strong>Kirin (Nagano Brewery)</strong><span>The Nagano facility is a pilgrimage for lager lovers. Kirin Ichiban uses only the first run of wort — cleaner, smoother.</span></div></li>\n  </ul>\n\n  <h2 class=\"section-head\">Pro Tips</h2>\n  <div class=\"tips-box\">\n    <h3>How to Drink Like a Nihonjin</h3>\n    <ul>\n      <li>\"Kanpai!\" (乾杯!) — no waiting for the toast, just drink. It's polite.</li>\n      <li>Pour your own beer at izakaya tables unless someone pours for you first</li>\n      <li>Izakaya hopping (\"hashiri\") is a real tradition — start with lager, move to happoshu, end with highball</li>\n      <li>Craft beer bars in Shimokitazawa (Tokyo) are the place — look for taps listing Japanese craft breweries</li>\n      <li>The \"beer garden\" (ビアガーデン) season is summer — open-air drinking festivals at every brewery</li>\n    </ul>\n  </div>\n</div>\n\n<!-- ==================== MEXICO ==================== -->\n<div id=\"mexico\" class=\"nation-section\">\n  <h2 class=\"section-title\">MÉXICO 🇲🇽 — Beyond the Corona Shot</h2>\n  <p class=\"section-subtitle\">A craft beer revolution from Oaxaca to CDMX. Mezcal meets IPA, agave in everything, and flavors that slap.</p>\n\n  <h2 class=\"section-head\">Styles to Chase</h2>\n  <div class=\"style-grid\">\n    <div class=\"style-card\">\n      <h3>Mezcal-Infused Beer</h3>\n      <p>Holy shit this is wild. Smoky mezcal spirit blended into hoppy bases. Oaxaca's specialty — smoky, agave-sweet, complex.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Smoky / Unique</span><span>9/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:85%;background:#ff6b35;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Palo de Mayo / Fruit Sour</h3>\n      <p>Fermented with tropical fruit, aged in barrels. Oaxaca's craft scene is putting this style on the world map.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Sour / Fruity</span><span>8/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:75%;background:#ff6b35;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Mexican Pilsner (Craft)</h3>\n      <p>The upgrade from Modelo/Cerveza. Crisp, clean, but with better malt character and hop presence than the big brands.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Crisp / Clean</span><span>7/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:65%;background:#ff6b35;\"></div></div></div>\n    </div>\n    <div class=\"style-card\">\n      <h3>Chili / Habanero IPA</h3>\n      <p>Mexican craft brewers love heat. IPA + habanero or chiltepe creates a firework of flavors that's addictive.</p>\n      <div class=\"rating-bar-container\"><span class=\"rating-label\"><span>Spicy / Hoppy</span><span>9/10</span></span><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:80%;background:#ff6b35;\"></div></div></div>\n    </div>\n  </div>\n\n  <h2 class=\"section-head\">Breweries You Need to Know</h2>\n  <ul class=\"brewery-list\">\n    <li><span class=\"brewery-emoji\">🌶️</span><div class=\"brewery-info\"><strong>Achihualo (Oaxaca)</strong><span>The Oaxaca craft beer pioneers. Mezcal beers, habanero IPAs — they put Mexico on the world craft map.</span></div></li>\n    <li><span class=\"brewery-emoji\">🏜️</span><div class=\"brewery-info\"><strong>Cervecería de Muertos (CDMX)</strong><span>\"Beer of the Dead\" — Day of the Dead themed beers. Incredible seasonal releases, beautiful can art.</span></div></li>\n    <li><span class=\"brewery-emoji\">🐍</span><div class=\"brewery-info\"><strong>Brouwería Infierno (CDMX)</strong><span>\"Hell Brewery\" — fiery IPAs and Mexican-style stouts. Their \"Chamoy Sour\" is a cult favorite.</span></div></li>\n    <li><span class=\"brewery-emoji\">🌵</span><div class=\"brewery-info\"><strong>Cervecería Minus (Monterrey)</strong><span>Northern Mexico's finest. Clean lagers and bold IPAs — the desert terroir shows in every pour.</span></div></li>\n    <li><span class=\"brewery-emoji\">🎨</span><div class=\"brewery-info\"><strong>Cervecería La Cumbre (CDMX)</strong><span>Artisanal brewery with a focus on traditional Mexican ingredients: chocolate, vanilla, cacao nibs.</span></div></li>\n  </ul>\n\n  <h2 class=\"section-head\">Pro Tips</h2>\n  <div class=\"tips-box\">\n    <h3>How to Drink Like a Mexicano</h3>\n    <ul>\n      <li>\"¡Por tu casa!\" — the traditional Mexican toast (literally \"for your house\")</li>\n      <li>Order from the back of the bar at cantinas for better beer selection than tourists get</li>\n      <li>Cervecerías in CDMX's Roma/Condesa neighborhoods are world-class but under-visited by foreigners</li>\n      <li>Add a lime wedge to craft Mexican lagers — it transforms them (not just a shot trick)</li>\n      <li>Oaxaca is the beer capital of Mexico for craft. Go specifically for this.</li>\n    </ul>\n  </div>\n</div>\n\n</div>\n\n<footer>Built by JARVIS · Drink responsibly, drink interestingly 🍺</footer>\n\n<script>\nfunction showNation(nation) {\n  document.querySelectorAll('.nation-section').forEach(s => s.classList.remove('active'));\n  document.getElementById(nation).classList.add('active');\n  document.querySelectorAll('.flag-btn').forEach(b => b.classList.remove('active'));\n  event.target.classList.add('active');\n\n  // Animate bars on show\n  const section = document.getElementById(nation);\n  section.querySelectorAll('.bar-fill').forEach(bar => {\n    bar.style.width = '0%';\n    setTimeout(() => { bar.style.width = bar.style.width; }, 50);\n  });\n}\n\n// Initial animation trigger\ndocument.addEventListener('DOMContentLoaded', () => {\n  document.querySelectorAll('#belgium .bar-fill').forEach(bar => {\n    const w = bar.style.width;\n    bar.style.width = '0%';\n    setTimeout(() => { bar.style.width = w; }, 300);\n  });\n});\n</script>\n\n</body>\n</html>\n"},"status":"ok","ms":136}
