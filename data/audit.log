{"t":"2026-07-27T04:46:18.638Z","tool":"edit_workbench_file","args":{"path":"/workspace/picture_viewer.html","old_string":"async function clearAll() {\n  if (allImages.length === 0 || !confirm(`Delete all ${allImages.length} images?`)) return;\n  await clearAllImages();\n  toast('All images cleared.', 'success');\n  await loadGallery();\n}","new_string":"async function clearAll() {\n  if (db && db.objectStoreNames.contains(STORE) && allImages.length > 0) {\n    if (!confirm(`Delete all ${allImages.length} images?`)) return;\n  } else {\n    toast('No images to delete.', 'error');\n    return;\n  }\n  await clearAllImages();\n  toast('All images cleared.', 'success');\n  await loadGallery();\n}"},"status":"ok","ms":133}
