{"t":"2026-07-28T04:18:03.346Z","tool":"run_shell","args":{"command":"sqlite3 mbm.db <<'SQL'\n-- ============================================\n-- STEP 5: FINANCIALS SETUP - Summit Digital Agency LLC (business_id = 2)\n-- ============================================\n\n-- A. Banking Accounts\nINSERT INTO business_banking_accounts (business_id, institution, website_url, phone, account_label, account_number, routing_number, account_type, notes) VALUES\n(2, 'Mercury', 'https://mercury.com', '+1 (844) 509-6734', 'Business Checking — Primary Operations', '****4821', NULL, 'Checking', 'Primary operating account for client payments and vendor payouts'),\n(2, 'Mercury', 'https://mercury.com', '+1 (844) 509-6734', 'Business Savings — Reserve Fund', '****7293', NULL, 'Savings', 'Emergency reserve: 3 months operating expenses (~$45K)'),\n(2, 'Amex Business Platinum', 'https://amex.com', '+1 (800) 528-4465', 'Business Credit Card — Primary Expenses', '****7901', NULL, 'Credit Card', '$250K limit for ad spend and software subscriptions');\n\n-- B. Budget Entries for 2026\nINSERT INTO budget_entries (business_id, year, type_key, category, planned_cents, notes) VALUES\n(2, 2026, 'revenue', 'Faceless YouTube Packages', 4800000, 'Target: ~15 clients at avg $3K/mo retainer'),\n(2, 2026, 'revenue', 'TikTok/Shorts Packages', 2400000, 'Target: ~8 clients at avg $2.5K/mo retainer'),\n(2, 2026, 'revenue', 'Podcast Repurposing', 1200000, 'Target: ~5 clients at avg $2K/mo retainer'),\n(2, 2026, 'expense', 'Freelance Editors & Scriptwriters', 3600000, '~7 freelancers @ avg $40K/yr allocated cost'),\n(2, 2026, 'expense', 'Software & Tools (SaaS)', 180000, 'Notion, Pictory, OpusClip, ChatGPT Plus team, Canva Pro, etc.'),\n(2, 2026, 'expense', 'Ad Spend / Client Media Budget', 960000, '~$4K/mo for paid client campaigns (pass-through)'),\n(2, 2026, 'expense', 'Legal & Accounting', 15000, 'LLC compliance, quarterly taxes, CPA retainer'),\n(2, 2026, 'expense', 'Insurance (E&O + Cyber)', 4800, 'Professional liability and cyber coverage'),\n(2, 2026, 'expense', 'Domain & Hosting Infrastructure', 3600, 'Website, email, CRM hosting'),\n(2, 2026, 'expense', 'Marketing (Agency Self-Marketing)', 180000, 'LinkedIn ads, content marketing for lead gen');\n\n-- C. Recurring Invoices — Retainer Clients\nINSERT INTO recurring_invoices (business_id, customer_name, amount_cents, tax_cents, frequency, interval_count, next_run_date, notes) VALUES\n(2, 'NovaMind AI', 350000, NULL, 'monthly', 1, '2026-08-15', 'Faceless YouTube Automation — Full Package (script + edit + publish). Tier: Premium ($3.5K/mo)'),\n(2, 'FitFuel Nutrition', 499900, NULL, 'monthly', 1, '2026-08-15', 'YouTube Shorts Faceless Series — Daily uploads. Tier: Enterprise ($4.999/mo)'),\n(2, 'TechVault Reviews', 250000, NULL, 'monthly', 1, '2026-08-15', 'TikTok + YouTube Shorts Product Reviews. Tier: Standard ($2.5K/mo)'),\n(2, 'Zenith Wealth Partners', 300000, NULL, 'monthly', 1, '2026-09-01', 'Faceless Finance Channel — Weekly videos. Tier: Premium ($3K/mo)'),\n(2, 'Lumina Skincare', 450000, NULL, 'monthly', 1, '2026-08-20', 'TikTok + IG Reels Faceless Beauty Content. Tier: Enterprise ($4.5K/mo)'),\n(2, 'CloudSync Solutions', 200000, NULL, 'monthly', 1, '2026-09-01', 'Podcast Repurposing — Weekly clips to shorts/Reels/TikTok. Tier: Standard ($2K/mo)');\n\n-- D. Initial Capital Contribution (owner investment on formation date)\nINSERT INTO ledger_transactions (business_id, txn_date, txn_year, txn_type, counterparty, amount_cents, notes) VALUES\n(2, '2025-03-15', 2025, 'capital_contribution', 'Marcus Chen — Owner Investment', 2500000, 'Initial capital: $25K for LLC formation, domain registration, first month software stack'),\n(2, '2025-04-01', 2025, 'software_expense', 'Namecheap (domains)', -3600, '.com + .co domains — annual renewal'),\n(2, '2025-04-01', 2025, 'software_expense', 'Google Workspace (hello@summitdigitalagency.com)', -14400, 'First month business email setup ($14.40/mo)'),\n(2, '2025-06-01', 2025, 'legal_fee', 'Delaware LLC Filing Fee', -8950, 'Certificate of Formation + registered agent first year'),\n\n-- First client payment received (NovaMind AI — first month)\n(2, '2025-07-01', 2025, 'client_payment', 'NovaMind AI — Invoice #SDA-2025-001', 350000, 'First client revenue: Faceless YouTube Automation retainer'),\n\n-- Ongoing expenses\n(2, '2025-07-01', 2025, 'software_expense', 'Pictory.ai (team plan)', -48000, 'AI video generation tool — monthly subscription'),\n(2, '2025-07-01', 2025, 'freelance_payment', 'J. Rivera — Scriptwriter', -60000, 'Monthly retainer for NovaMind AI scripts (4 videos)'),\n(2, '2025-08-15', 2025, 'client_payment', 'NovaMind AI — Invoice #SDA-2025-002', 350000, 'Month 2 retainer payment'),\n(2, '2025-09-01', 2025, 'insurance_premium', 'Hiscox E&O Policy — Annual Prepaid', -48000, 'Professional liability insurance annual premium');\n\n-- More client payments and expenses through end of year\n(2, '2025-09-15', 2025, 'client_payment', 'NovaMind AI — Invoice #SDA-2025-003', 350000, 'Month 4 retainer payment'),\n(2, '2025-10-01', 2025, 'freelance_payment', 'S. Patel — Video Editor (NovaMind)', -80000, 'Editing for NovaMind AI YouTube channel'),\n(2, '2025-10-15', 2025, 'client_payment', 'FitFuel Nutrition — Invoice #SDA-2025-004', 499900, 'First payment from FitFuel (Enterprise tier)'),\n\n-- Q4 expenses\n(2, '2025-10-01', 2025, 'software_expense', 'ChatGPT Team Plan', -36000, 'Monthly team subscription'),\n(2, '2025-10-01', 2025, 'software_expense', 'Canva Pro (team)', -9600, 'Design tool for thumbnails and graphics'),\n(2, '2025-11-01', 2025, 'freelance_payment', 'M. Okonkwo — Scriptwriter (FitFuel)', -75000, 'Monthly retainer for FitFuel daily shorts scripts'),\n\n-- Year-end client payments\n(2, '2025-11-15', 2025, 'client_payment', 'NovaMind AI — Invoice #SDA-2025-004', 350000, 'Month 5 retainer'),\n(2, '2025-11-15', 2025, 'client_payment', 'FitFuel Nutrition — Invoice #SDA-2025-005', 499900, 'Second FitFuel payment');\n\n-- E. One-off invoices for setup work\nINSERT INTO invoices (business_id, invoice_number, customer_name, issue_date, due_date, status, subtotal_cents, total_cents) VALUES\n(2, 'SDA-SETUP-001', 'NovaMind AI', '2025-06-30', '2025-07-30', 'paid', 50000, 50000),\n(2, 'SDA-SETUP-002', 'FitFuel Nutrition', '2025-08-10', '2025-09-10', 'paid', 75000, 75000);\n\n-- F. Invoice line items for setup invoices\nINSERT INTO invoice_line_items (invoice_id, sort_order, description, quantity, unit_price_cents, total_cents) VALUES\n(1, 1, 'Channel Strategy & Content Audit — NovaMind AI', 1, 35000, 35000),\n(1, 2, 'First Month Script Pack (4 videos)', 4, 3750, 15000),\n(2, 1, 'Brand Voice Guide & Content Calendar Setup', 1, 40000, 40000),\n(2, 2, 'First Month Script Pack (30 daily shorts)', 30, 833, 25000);\n\nSQL\necho \"Financials setup complete. Exit code: $?\""},"status":"ok","ms":144}
