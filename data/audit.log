{"t":"2026-07-26T18:20:39.552Z","tool":"write_workbench_file","args":{"path":"/workspace/test_doom.py","content":"\"\"\"Playwright test for DOOM raycasting game — verify canvas renders, no JS errors.\"\"\"\nimport sys\nfrom playwright.sync_api import sync_playwright\n\ndef run_test():\n    results = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context(viewport={\"width\": 1024, \"height\": 768})\n        \n        page = context.new_page()\n        console_messages = []\n        \n        def on_console(msg):\n            try:\n                msg_type = str(msg.type()) if callable(msg.type) else str(getattr(msg, 'type', ''))\n                msg_text = str(msg.text()) if callable(msg.text) else str(getattr(msg, 'text', ''))\n                console_messages.append({\"type\": msg_type, \"text\": msg_text})\n            except Exception:\n                try:\n                    console_messages.append({\"type\": \"unknown\", \"text\": str(msg)})\n                except Exception:\n                    pass\n        \n        page.on(\"console\", on_console)\n        \n        try:\n            print(\"[TEST] Loading game at http://localhost:9101...\")\n            page.goto(\"http://localhost:9101/\", timeout=30000)\n            \n            import time\n            time.sleep(2)\n            \n            # Check console messages for JS errors\n            print(f\"[TEST] Checking {len(console_messages)} console message(s)...\")\n            js_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n            \n            if js_errors:\n                results.append(f\"FAIL — {len(js_errors)} JS error(s) found:\")\n                for e in js_errors[:5]:  # limit output\n                    results.append(f\"  Error: {str(e['text'])[:200]}\")\n            else:\n                results.append(\"PASS — No JavaScript errors in console.\")\n            \n            # Check canvas exists and has dimensions\n            print(\"[TEST] Checking canvas element...\")\n            canvas = page.query_selector(\"canvas\")\n            if not canvas:\n                results.append(\"FAIL — No <canvas> element found on the page.\")\n            else:\n                bbox = canvas.bounding_box()\n                width, height = bbox.get(\"width\", 0), bbox.get(\"height\", 0)\n                \n                # Also check actual canvas attributes\n                canvas_info = page.evaluate(\"\"\"() => {\n                    const c = document.querySelector('canvas');\n                    return { w: c?.width, h: c?.height };\n                }\"\"\")\n                print(f\"[TEST] Canvas bbox: {width}x{height}, attrs: width={canvas_info.get('w')}, height={canvas_info.get('h')}\")\n                \n                if (width > 0 and height > 0) or (canvas_info.get('w', 0) > 0):\n                    results.append(f\"PASS — Canvas exists with valid dimensions.\")\n                    \n                    # Check canvas has rendered content by sampling center pixels\n                    print(\"[TEST] Sampling canvas pixel data...\")\n                    try:\n                        pixel_check = page.evaluate(\"\"\"() => {\n                            const c = document.querySelector('canvas');\n                            if (!c || !c.width) return null;\n                            const ctx = c.getContext('2d');\n                            // Sample center column at various y positions (ceiling, mid, floor)\n                            const cx = Math.floor(c.width / 2);\n                            const h = c.height;\n                            try {\n                                const ceiling = ctx.getImageData(cx, Math.max(0, Math.floor(h/8)), 1, 1).data.slice();\n                                const horizon = ctx.getImageData(cx, Math.floor(h/2), 1, 1).data.slice();\n                                const floor = ctx.getImageData(cx, Math.min(c.height-1, Math.floor(7*h/8)), 1, 1).data.slice();\n                                return { ceiling: ceiling, horizon: horizon, floor: floor };\n                            } catch(e) { return 'error'; }\n                        }\"\"\")\n                        \n                        if pixel_check and isinstance(pixel_check, dict):\n                            print(f\"[TEST] Ceiling (center-top): R={pixel_check['ceiling'][0]}, G={pixel_check['ceiling'][1]}, B={pixel_check['ceiling'][2]}\")\n                            print(f\"[TEST] Horizon: R={pixel_check['horizon'][0]}, G={pixel_check['horizon'][1]}, B={pixel_check['horizon'][2]}\")\n                            print(f\"[TEST] Floor (center-bottom): R={pixel_check['floor'][0]}, G={pixel_check['floor'][1]}, B={pixel_check['floor'][2]}\")\n                            \n                            # Ceiling should be sky color, floor ground/wall color — they must differ significantly\n                            diff_cf = sum(abs(a - b) for a, b in zip(pixel_check['ceiling'][:3], pixel_check['floor'][:3]))\n                            if diff_cf > 50:\n                                results.append(f\"PASS — Ceiling and floor render with distinct colors (diff={diff_cf}).\")\n                            else:\n                                results.append(f\"WARN — Ceiling vs Floor differ by only {diff_cf}. Game may not be rendering correctly.\")\n                            \n                            # Check that at least some pixels are non-zero\n                            all_pixels = []\n                            for k in ['ceiling', 'horizon', 'floor']:\n                                if isinstance(pixel_check[k], list):\n                                    all_pixels.extend(pixel_check[k])\n                            has_content = any(v > 0 for v in all_pixels)\n                            if has_content:\n                                results.append(\"PASS — Canvas contains rendered pixel data.\")\n                            else:\n                                results.append(\"WARN — All sampled pixels are zero/black.\")\n                        elif isinstance(pixel_check, str):\n                            results.append(f\"FAIL — Pixel sampling error: {pixel_check}\")\n                    except Exception as e:\n                        results.append(f\"WARN — Could not sample canvas pixels: {e}\")\n                else:\n                    results.append(f\"FAIL — Canvas has zero or negative dimensions.\")\n            \n            # Test keyboard input and verify game responds without JS errors\n            print(\"[TEST] Testing keyboard interaction (W key)...\")\n            page.keyboard.press(\"KeyW\")\n            time.sleep(0.5)\n            \n            # Check for new console errors after input\n            post_input_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n            if len(post_input_errors) > len(js_errors):\n                results.append(f\"WARN — New JS error(s) appeared after keypress: {post_input_errors[-1]}\")\n            else:\n                results.append(\"PASS — Keyboard input (W) processed without new JS errors.\")\n            \n            # Test shooting\n            print(\"[TEST] Testing shoot action...\")\n            page.keyboard.press(\"Space\")\n            time.sleep(0.5)\n            post_shoot_errors = [m for m in console_messages if \"error\" in str(m.get(\"type\", \"\")).lower()]\n            new_after_shoot = len(post_shoot_errors) - len(js_errors)\n            if new_after_shoot > 0:\n                results.append(f\"WARN — {new_after_shoot} JS error(s) after shooting:\")\n                for e in post_shoot_errors[-3:]:\n                    results.append(f\"  Error: {str(e['text'])[:200]}\")\n            else:\n                results.append(\"PASS — Shooting (Space) processed without new JS errors.\")\n            \n        except Exception as e:\n            import traceback\n            tb = traceback.format_exc()\n            print(f\"[TEST] Exception during test:\\n{tb}\")\n            results.append(f\"FAIL — Test exception: {e}\")\n        \n        finally:\n            browser.close()\n    \n    # Print summary\n    print(\"\\n=== TEST RESULTS ===\")\n    for r in results:\n        print(r)\n    \n    failures = [r for r in results if r.startswith(\"FAIL\")]\n    warnings = [r for r in results if r.startswith(\"WARN\")]\n    passes = [r for r in results if r.startswith(\"PASS\")]\n    \n    print(f\"\\nSummary: {len(passes)} PASS, {len(warnings)} WARN, {len(failures)} FAIL\")\n    return 0 if not failures else 1\n\nif __name__ == \"__main__\":\n    sys.exit(run_test())\n"},"status":"ok","ms":144}
