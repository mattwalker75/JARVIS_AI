{"t":"2026-07-28T07:27:59.507Z","tool":"write_workbench_file","args":{"path":"/workspace/populate_summit.py","content":"#!/usr/bin/env python3\n\"\"\"Populate Summit Digital Agency LLC with realistic data across all sections.\"\"\"\n\nimport sqlite3\nimport json\nfrom datetime import datetime, timedelta\nimport random\n\nDB_PATH = \"/workspace/mbm.db\"\nBUSINESS_ID = 2  # Summit Digital Agency LLC\nNOW = \"2026-07-28 10:00:00\"\n\ndef db():\n    return sqlite3.connect(DB_PATH)\n\ndef insert(table, columns, values):\n    cols = \", \".join(columns)\n    placeholders = \", \".join([\"?\"] * len(values))\n    sql = f\"INSERT INTO {table} ({cols}) VALUES ({placeholders})\"\n    with db() as conn:\n        conn.execute(sql, values)\n        conn.commit()\n\ndef insert_many(table, columns, rows):\n    placeholders = \", \".join([\"?\"] * len(columns))\n    sql = f\"INSERT INTO {table} ({', '.join(columns)}) VALUES ({placeholders})\"\n    with db() as conn:\n        conn.executemany(sql, rows)\n        conn.commit()\n\nprint(\"=== POPULATING SUMMIT DIGITAL AGENCY LLC ===\\n\")\n\n# ============================================\n# 1. BUSINESS INFO (company details)\n# ============================================\nprint(\"[1/9] Business Info...\")\n\ninsert_many(\n    \"business_company\",\n    [\"business_id\", \"legal_name\", \"dba_name\", \"ein\", \"founded_date\", \n     \"industry\", \"description\"],\n    [(BUSINESS_ID, \"Summit Digital Agency LLC\", None, \"84-1234567\", \n      datetime.now().strftime(\"%Y-%m-%d\"), \"Digital Media & Content Marketing\",\n      \"Faceless content agency specializing in YouTube automation, TikTok growth,\\nand AI-generated video content. We build profitable digital assets\\nwithout showing faces on camera.\")],\n)\n\ninsert_many(\n    \"business_owners\",\n    [\"business_id\", \"owner_name\", \"ownership_percent\"],\n    [(BUSINESS_ID, \"Jarvis (Owner/Operator)\", 100)],\n)\n\ninsert_many(\n    \"business_addresses\",\n    [\"business_id\", \"address_line1\", \"city\", \"state\", \"zip_code\", \"country\", \"type\"],\n    [\n        (BUSINESS_ID, \"742 Evergreen Terrace, Apt 3B\", \"Portland\", \"OR\", \"97205\", \"US\", \"operating\"),\n        (BUSINESS_ID, \"1200 SW 5th Ave, Ste 800\", \"Portland\", \"OR\", \"97204\", \"US\", \"mailing\"),\n    ],\n)\n\ninsert_many(\n    \"business_phones\",\n    [\"business_id\", \"phone_number\", \"type\"],\n    [(BUSINESS_ID, \"+1 (503) 555-0187\", \"primary\")],\n)\n\ninsert_many(\n    \"business_emails\",\n    [\"business_id\", \"email_address\", \"type\"],\n    [\n        (BUSINESS_ID, \"hello@summitdigital.agency\", \"primary\"),\n        (BUSINESS_ID, \"billing@summitdigital.agency\", \"accounting\"),\n    ],\n)\n\ninsert_many(\n    \"business_social_links\",\n    [\"business_id\", \"platform_name\", \"url\"],\n    [\n        (BUSINESS_ID, \"YouTube\", \"https://youtube.com/@SummitDigitalAgency\"),\n        (BUSINESS_ID, \"TikTok\", \"https://tiktok.com/@summitdigital.agency\"),\n        (BUSINESS_ID, \"Instagram\", \"https://instagram.com/summit.digital.agency\"),\n    ],\n)\n\ninsert_many(\n    \"business_domains\",\n    [\"business_id\", \"domain_name\"],\n    [(BUSINESS_ID, \"summitdigital.agency\")],\n)\n\nprint(\"  ✓ Company profile complete\\n\")\n\n# ============================================\n# 2. PRODUCTS / SERVICES CATALOG\n# ============================================\nprint(\"[2/9] Products & Services...\")\n\nservices = [\n    (\"YouTube Automation Package\", \"faceless_youtube\", \n     \"$1,499/mo\", True, \"Full-service YouTube channel management: scriptwriting,\\nvoiceover (AI), editing, thumbnails, SEO optimization. 8 videos/month.\"),\n    \n    (\"TikTok Growth Bundle\", \"tiktok_growth\",\n     \"$899/mo\", True, \"15 short-form TikToks per month with trending audio integration,\\nhook optimization, and growth analytics reporting.\"),\n     \n    (\"AI Video Production (One-Time)\", \"ai_video_oneoff\",\n     \"$497/video\", False, \"Single faceless video: research → script → AI voiceover → editing.\\nPerfect for product launches or one-time campaigns.\"),\n    \n    (\"Content Repurposing Suite\", \"content_repurpose\",\n     \"$599/mo\", True, \"Turn 1 long-form piece into 30+ short clips across YouTube Shorts,\\nTikTok, Instagram Reels, and LinkedIn carousels.\"),\n     \n    (\"Niche Research & Launch\", \"niche_launch\",\n     \"$2,497 one-time\", False, \"Deep niche analysis: competition mapping, keyword research, content\\ncalendar (3 months), channel setup, first 10 videos produced.\"),\n    \n    (\"Podcast-to-Video Repurpose\", \"podcast_video\",\n     \"$699/mo\", True, \"Convert podcast episodes into YouTube video format with AI-generated\\nB-roll, captions, and highlight clips for social media.\")\n]\n\ninsert_many(\n    \"business_products_services\",\n    [\"business_id\", \"name\", \"sku\", \"price_amount_cents\", \"is_recurring\", \"description\"],\n    [(BUSINESS_ID, s[0], s[1], int(s[2].replace(\"$\",\"\").replace(\",\")+\"00\" if \"/\" in s[2] else \n       (s[2].split(\"/\")[0].replace(\"$\",\"\").replace(\",\")+\"\" if \"$\" in s[2] and \"/\" not in s[2] else\n        s[2].replace(\"$\",\"\").replace(\",\"))), True, s[5]) for i,s in enumerate(services)]]\n\n# Fix prices properly\nwith db() as conn:\n    # Clear and re-insert with correct pricing\n    conn.execute(\"DELETE FROM business_products_services WHERE business_id = ?\", (BUSINESS_ID,))\n    \n    products_data = [\n        (\"YouTube Automation Package\", \"YT-AUTO-01\", 149900, True, \n         \"Full-service YouTube channel management: scriptwriting, voiceover (AI), editing,\\nthumbnails, SEO optimization. 8 videos/month.\"),\n        \n        (\"TikTok Growth Bundle\", \"TT-GROWTH-02\", 89900, True,\n         \"15 short-form TikToks per month with trending audio integration,\\nhook optimization, and growth analytics reporting.\"),\n         \n        (\"AI Video Production (One-Time)\", \"VID-AI-03\", 49700, False,\n         \"Single faceless video: research → script → AI voiceover → editing.\\nPerfect for product launches or one-time campaigns.\"),\n        \n        (\"Content Repurposing Suite\", \"REPURPOSE-04\", 59900, True,\n         \"Turn 1 long-form piece into 30+ short clips across YouTube Shorts,\\nTikTok, Instagram Reels, and LinkedIn carousels.\"),\n         \n        (\"Niche Research & Launch\", \"NICHE-LAUNCH-05\", 249700, False,\n         \"Deep niche analysis: competition mapping, keyword research, content\\ncalendar (3 months), channel setup, first 10 videos produced.\"),\n        \n        (\"Podcast-to-Video Repurpose\", \"PODCAST-VID-06\", 69900, True,\n         \"Convert podcast episodes into YouTube video format with AI-generated\\nB-roll, captions, and highlight clips for social media.\")\n    ]\n    \n    conn.executemany(\n        \"INSERT INTO business_products_services (business_id, name, sku, price_amount_cents, is_recurring, description) VALUES (?, ?, ?, ?, ?, ?)\",\n        [(BUSINESS_ID, p[0], p[1], p[2], p[3], p[4]) for p in products_data]\n    )\n\nprint(\"  ✓ Services catalog populated (6 services)\\n\")\n\n# ============================================\n# 3. CONTACTS DIRECTORY\n# ============================================\nprint(\"[3/9] Contacts...\")\n\ncontacts = [\n    # Clients\n    (\"Marcus Chen\", \"marcus@techflow.io\", \"+1-408-555-0123\", \"client\", \n     \"TechFlow Solutions - SaaS startup. Monthly YouTube automation client.\", \"Portland, OR\"),\n     \n    (\"Sarah Williams\", \"sarah@brightpath.health\", None, \"client\",\n     \"BrightPath Health - Wellness brand. TikTok growth + content repurposing.\\nContract renews Oct 2026.\", \"Austin, TX\"),\n    \n    (\"David Park\", \"david@cryptoview.news\", \"+1-512-555-0456\", \"client\",\n     \"CryptoView News - Crypto media outlet. Podcast-to-video repurposing.\\nAlso needs niche research for new channel.\", \"San Francisco, CA\"),\n    \n    (\"Elena Rodriguez\", None, \"+1-305-555-0789\", \"lead\",\n     \"Potential client from Instagram DM. Interested in YouTube automation\\nfor her cooking channel. Follow up after portfolio review.\", \"Miami, FL\"),\n     \n    # Freelancers / Contractors\n    (\"Alex Kim\", \"alex@freelance.ai\", \"+1-646-555-0321\", \"contractor\",\n     \"AI voiceover artist. Specializes in natural-sounding narration.\\nRate: $75/hr for premium quality.\", \"New York, NY\"),\n    \n    (\"Jordan Taylor\", None, \"+1-917-555-0654\", \"contractor\",\n     \"Thumbnail designer - Canva specialist. Fast turnaround (24hrs).\\n$30/thumbnail bulk rate.\", \"Chicago, IL\"),\n    \n    # Tools / Vendors\n    (\"Pictory AI\", None, None, \"vendor\",\n     \"AI video generation tool. $19/mo for creator plan.\\nUsed for B-roll and scene generation.\", \"\"),\n     \n    (\"ElevenLabs\", None, None, \"vendor\",\n     \"Premium AI voiceover platform. Pro plan: $22/mo.\\nPrimary voiceover provider for faceless content.\", \"\"),\n    \n    (\"Canva Pro\", None, None, \"vendor\",\n     \"Design tool for thumbnails, social graphics, presentations.\\n$13/mo per seat (we have 2 seats).\", \"\"),\n     \n    (\"TubeBuddy\", None, None, \"vendor\",\n     \"YouTube SEO optimization and analytics. Business plan: $49/mo.\", \"\"),\n    \n    # Platforms / Partnerships\n    (\"AdSense Support\", None, None, \"platform\",\n     \"Google AdSense for monetized YouTube channels.\\nSummit's main channel hit 10K subs milestone in June 2026.\", \"\")\n]\n\ninsert_many(\n    \"contacts\",\n    [\"business_id\", \"first_name\", \"last_name\", \"email_address\", \"phone_number\", \n     \"category\", \"notes\"],\n    [(BUSINESS_ID, c[0].split()[0], c[0].split()[-1], c[2] if len(c) > 2 else None,\n      c[3] if len(c) > 3 else None, c[4], c[5]) for c in contacts[:6]] +\n    [(BUSINESS_ID, \"Pictory AI\", \"\", None, None, \"vendor\", contacts[6][1]),\n     (BUSINESS_ID, \"ElevenLabs\", \"\", None, None, \"vendor\", contacts[7][1]),\n     (BUSINESS_ID, \"Canva Pro\", \"\", None, None, \"vendor\", contacts[8][1]),\n     (BUSINESS_ID, \"TubeBuddy\", \"\", None, None, \"platform\", contacts[9][1]),\n     (BUSINESS_ID, \"AdSense Support\", \"\", None, None, \"platform\", \"\")]\n)\n\n# Fix the contact insertions properly\nwith db() as conn:\n    conn.execute(\"DELETE FROM contacts WHERE business_id = ?\", (BUSINESS_ID,))\n    \n    # Properly parse names and fill fields\n    raw_contacts = [\n        (\"Marcus Chen\", \"marcus@techflow.io\", \"+1-408-555-0123\", \"client\", \n         \"TechFlow Solutions - SaaS startup. Monthly YouTube automation client.\", \"Portland, OR\"),\n        \n        (\"Sarah Williams\", \"sarah@brightpath.health\", None, \"client\",\n         \"BrightPath Health - Wellness brand. TikTok growth + content repurposing.\\nContract renews Oct 2026.\", \"Austin, TX\"),\n         \n        (\"David Park\", \"david@cryptoview.news\", \"+1-512-555-0456\", \"client\",\n         \"CryptoView News - Crypto media outlet. Podcast-to-video repurposing.\\nAlso needs niche research for new channel.\", \"San Francisco, CA\"),\n         \n        (\"Elena Rodriguez\", None, \"+1-305-555-0789\", \"lead\",\n         \"Potential client from Instagram DM. Interested in YouTube automation\\nfor her cooking channel. Follow up after portfolio review.\", \"Miami, FL\"),\n        \n        (\"Alex Kim\", \"alex@freelance.ai\", \"+1-646-555-0321\", \"contractor\",\n         \"AI voiceover artist. Specializes in natural-sounding narration.\\nRate: $75/hr for premium quality.\", \"New York, NY\"),\n        \n        (\"Jordan Taylor\", None, \"+1-917-555-0654\", \"contractor\",\n         \"Thumbnail designer - Canva specialist. Fast turnaround (24hrs).\\n$30/thumbnail bulk rate.\", \"Chicago, IL\")\n    ]\n    \n    for name, email, phone, cat, notes, location in raw_contacts:\n        first = name.split()[0] if name else \"\"\n        last = name.split()[-1] if name and len(name.split()) > 1 else \"\"\n        conn.execute(\n            \"INSERT INTO contacts (business_id, first_name, last_name, email_address, phone_number, category, notes) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n            (BUSINESS_ID, first, last, email or \"\", phone or \"\", cat, f\"{notes}\\n{location}\")\n        )\n\nprint(\"  ✓ Contacts directory populated\\n\")\n\n# ============================================\n# 4. DOCUMENTS SECTION  \n# ============================================\nprint(\"[4/9] Documents...\")\n\ndocuments = [\n    (\"Business Plan - Q3 2026\", \"business_plan_q3_2026.md\", \n     f\"\"\"# Summit Digital Agency LLC — Business Plan Q3 2026\n\n## Executive Summary\nSummit Digital Agency is a faceless content agency generating revenue through\\nYouTube automation, TikTok growth management, and AI video production services.\n\n### Revenue Targets (Q3)\n- YouTube Automation clients: $4,500/mo recurring  \n- TikTok Growth Bundle: $1,800/mo recurring  \n- One-time projects: ~$2,000/month average  \n\n### Key Initiatives\n1. Launch 2 new niche channels by August 2026\n2. Hire first VA (part-time) for thumbnail design and scheduling\n3. Implement client portal using Notion template\n\n## Financial Projections\n- Monthly recurring revenue target: $8,500+  \n- Gross margin: ~72% (primarily AI tool costs + contractor fees)\n- Break-even achieved June 2026 at $4,200/mo MRR\"\"\"),\n     \n    (\"Client Contract Template\", \"client_contract_template.md\",\n     f\"\"\"# Client Service Agreement\n\n**Effective Date:** {datetime.now().strftime(\"%B %d, %Y\")}  \n**Service Provider:** Summit Digital Agency LLC (EIN: 84-1234567)  \n\n## Services Provided\n{services[0][0]} at ${services[0][2]} per month\n\n## Payment Terms\nNet 15 from invoice date. Late fee of 1.5% per month on overdue balances.\n\n## Deliverables\n- {services[0][4].split('.')[0] if '.' in services[0][4] else '8 videos/month'} monthly  \n- Weekly progress reports every Friday by 5 PM PST  \n- Monthly analytics review call (30 min)  \n\n## Termination\nEither party may terminate with 30 days written notice. Outstanding invoices\\ndue upon termination.\"\"\"),\n\n    (\"Content Calendar Template\", \"content_calendar_template.md\",\n     f\"\"\"# Content Production Calendar — {datetime.now().strftime(\"%B %Y\")}\n\n| Week | Channel | Topic | Status | Due Date |\n|------|---------|-------|--------|----------|\n| W1   | SummitTech | AI Tools Review 2026 | DONE | Jul 5 |\n| W1   | SummitFinance | Crypto Market Outlook Q3 | IN PROGRESS | Jul 7 |  \n| W2   | SummitHealth | Wellness Trends for Summer | PLANNED | Jul 14 |\n| W2   | SummitTech | Best Budget Laptops Under $800 | RESEARCHING | Jul 16 |\n\n## Production Workflow\n1. Research & Script (Day 1-3)  \n2. AI Voiceover Generation (Day 4)  \n3. Video Editing + B-roll (Day 5-7)  \n4. Thumbnail Design (Day 8)  \n5. SEO Optimization + Upload (Day 9)\"\"\"),\n\n    (\"Annual Tax Summary 2025\", \"tax_summary_2025.md\",\n     f\"\"\"# Summit Digital Agency LLC — 2025 Annual Tax Summary\n\n## Income\n- YouTube AdSense: $18,432.67  \n- Client Services Revenue: $52,891.00  \n- One-time Video Projects: $8,940.00  \n\n**Total Gross Revenue: ${79,263.67:,}**\n\n## Deductions\n- Software & Tools (ElevenLabs, Pictory, Canva, TubeBuddy): $1,584.00  \n- Contractor Fees (Alex Kim voiceover, Jordan Taylor thumbnails): $12,450.00  \n- Home Office Deduction: ${360 * 12 / 4:,} (25% of rent)  \n- Internet & Phone Allocation: ${98 + 75 / 2 * 12:,}  \n- Equipment Depreciation (MacBook Pro, Rode mic): $2,800.00  \n\n**Total Deductions: ${17,634.00:,}**\n\n## Net Profit: ${61,629.67:,}\n*Estimated self-employment tax: ~${8,500:.2f}*\"\"\"),\n    \n    (\"Brand Style Guide\", \"brand_style_guide.md\",\n     f\"\"\"# Summit Digital Agency — Brand Guidelines\n\n## Visual Identity  \n**Primary Colors:** Navy (#1a365d), Gold accent (#d4af37)  \n**Typography:** Inter (headings), System sans-serif (body)  \n\n## Voice & Tone\n- Professional but approachable  \n- Confident without being salesy  \n- Data-driven storytelling preferred over hype  \n\n## Thumbnail Formula\n- High contrast background + bold text overlay (max 5 words)  \n- Subject/face in right third of frame  \n- Yellow/gold accent color for CTA elements  \n- Consistent branding: small Summit logo bottom-left corner\"\"\"),\n\n    (\"Meeting Notes — Team Sync\", \"meeting_notes_team_sync.md\",\n     f\"\"\"# Weekly Team Sync — {datetime.now().strftime(\"%B %d, %Y\")}\n\n## Attendees: Jarvis (Owner), Alex Kim (VO), Jordan Taylor (Design)\n\n### Action Items from Last Week  \n- [x] Deliver 4 videos for TechFlow channel ✅  \n- [ ] Complete thumbnail batch for CryptoView (due Friday) ⏳\n- [ ] Test new ElevenLabs voice model \"Marcus\" — Jarvis to review by EOD  \n\n### This Week's Priorities  \n1. Launch SummitFinance second channel (topic: personal finance basics)  \n2. Prepare portfolio deck for Elena Rodriguez follow-up call  \n3. Review Q2 analytics and prepare client reports  \n\n## Notes\n- TechFlow client requested 2 additional videos this month (+$500)  \n- Jordan's turnaround time improved to 18hrs avg — consider raising rate\\n  from $30 → $40/thumbnail starting next quarter\"\"\")\n]\n\ninsert_many(\n    \"documents\",\n    [\"business_id\", \"name\", \"file_path\", \"content_type\"],\n    [(BUSINESS_ID, d[0], f\"/workspace/mbm_data/documents/{d[1]}\", \n      \"text/markdown\") for d in documents]\n)\n\n# Write actual document files to disk (for the mirror filesystem)\nimport os\ndoc_dir = \"/workspace/Summit_Digital_Agency_LLC/Documents\"\nos.makedirs(doc_dir, exist_ok=True)\n\nfor name, filename, content in documents:\n    filepath = os.path.join(doc_dir, filename)\n    with open(filepath, \"w\") as f:\n        f.write(content)\n    \nprint(\"  ✓ Documents section populated (6 files)\\n\")\n\n# ============================================\n# 5. NOTES SECTION  \n# ============================================\nprint(\"[5/9] Notes...\")\n\nnotes = [\n    (\"Ideas — New Channel Concepts\", \"channel_ideas.md\", \n     f\"\"\"## Emerging Niche Ideas for Q4 2026\n\n1. **AI News Digest** — Daily AI breakthroughs summarized in 3-min videos  \n   - Competition: Low (most channels are >5 min)  \n   - Monetization potential: High (tech sponsors)  \n\n2. **Mystery/Storytelling Channel** — True crime, unsolved mysteries  \n   - Evergreen content with high watch time  \n   - Voiceover needs deeper/dramatic tone (ElevenLabs \"Narrator\"?)\n\n3. **Finance for Gen Z** — Budgeting, investing basics in simple terms\n   - Growing niche but underserved on YouTube Shorts format  \n\n## Research Needed: CPM rates by niche\n- Tech niches typically $8-$15 CPM  \n- Finance can reach $20+ CPM with right audience\"\"\"),\n\n    (\"Client Meeting Prep — Sarah Williams\", \"prep_sarah_williams.md\",\n     f\"\"\"# Pre-Meeting Notes for Oct 2026 Contract Renewal (BrightPath Health)\n\n## What's Working  \n- TikTok engagement up 340% since March launch ✅  \n- Client loves the wellness tips series (avg. 15K views/video)  \n\n## Expansion Opportunities  \n- YouTube Shorts version of top TikToks → potential AdSense revenue share\n- Instagram Reels expansion (currently only posting to TikTok + YT)\n- Podcast pilot: \"Wellness in Minutes\" — repurpose into video content\n\n## Pricing Discussion Points\n- Current rate ($899/mo for 15 TikToks)  \n- Proposed bundle: $1,200/mo for 15 TT + 8 Shorts + 4 IG Reels  \n- Add-on: Monthly analytics report (+$150/mo)\n\n## Key Question to Ask\n\"Are you interested in launching a YouTube channel alongside TikTok?\"\\nThis could unlock AdSense revenue and give us leverage for higher pricing.\"\"\"),\n\n    (\"Quick Thoughts — AI Tools Update\", \"ai_tools_update.md\",\n     f\"\"\"# New AI Tool Watchlist (Updated {datetime.now().strftime(\"%B %d, %Y\")})\n\n## Testing This Week  \n- **HeyGen** — Avatar-based videos. $29/mo for 10 mins/month.\\n  Good for talking-head style without filming  \n\n- **Runway ML Gen-3** — Text-to-video generation at higher quality\\n  than Pictory. Free tier available, Pro: $15/mo  \n\n## Considering Next Month  \n- **Midjourney v7** (if released) — AI image gen for thumbnails/stock footage\n- **Descript Overdub** — Edit video by editing transcript text\n\n## Cost-Benefit Analysis\nCurrent monthly tool spend: ~$93/mo\\nPotential increase with new tools: +$44/mo → $137/mo total\\nROI check needed before committing to Runway ML.\"\"\"),\n\n    (\"Goals & Milestones\", \"goals_milestones.md\",\n     f\"\"\"# Summit Digital Agency — Goals for 2026\n\n## Q3 (Jul-Sep)  \n- [x] Hit $5K MRR ✅ (achieved July)  \n- [ ] Launch second YouTube channel (SummitFinance)  \n- [ ] Hire part-time VA ($8/hr, 10hrs/week)  \n\n## Q4 (Oct-Dec)  \n- [ ] Reach $10K MRR target  \n- [ ] Build client portal (Notion or custom web app)  \n- [ ] Publish case study: \"How we grew @TechFlowYT to 50K subs in 6 months\"\n\n## Long-term Vision  \n- Transition from solo operator → small team of 3-4 by end of 2027\n- Build portfolio of owned channels generating passive AdSense income\\n  (target: $3K/mo passive by Q1 2028)\"\"\"),\n\n    (\"Quick Reference — Vendor Contacts\", \"vendor_contacts.md\",\n     f\"\"\"# Vendor Quick Reference\n\n| Tool | Contact/Support | Plan Cost | Renewal Date |\\n|------|-----------------|-----------|-------------|\\n| ElevenLabs | support@elevenlabs.io | $22/mo | Aug 15, 2026 |\\n| Pictory AI | help@pictory.ai | $19/mo | Auto-renew Jul 30 |\\n| Canva Pro | support@canva.com | $13/mo/seat | Annual: Jan 1 |\\n| TubeBuddy | hello@tubebuddy.com | $49/mo | Monthly, cancel anytime |\\n| Adobe Creative Cloud | creativecloud@adobe.com | $54.99/mo | Annual: Mar 2027 |\n\n## Notes  \n- ElevenLabs annual plan = ~$18/mo (saves $6/mo) — consider switching Aug renewal\n- Canva team seat for Jordan Taylor ($13 extra/month) worth it? → YES if she does >5 designs/week\"\"\")\n]\n\ninsert_many(\n    \"documents\",  # Notes are stored as documents in this app's schema  \n    [\"business_id\", \"name\", \"file_path\", \"content_type\"],\n    [(BUSINESS_ID, n[0], f\"/workspace/mbm_data/notes/{n[1]}\", \n      \"text/markdown\") for n in notes]\n)\n\n# Write note files to disk\nnote_dir = \"/workspace/Summit_Digital_Agency_LLC/Notes\"\nos.makedirs(note_dir, exist_ok=True)\n\nfor name, filename, content in notes:\n    filepath = os.path.join(note_dir, filename)\n    with open(filepath, \"w\") as f:\n        f.write(content)\n\nprint(\"  ✓ Notes section populated (5 notes)\\n\")\n\n# ============================================\n# 6. FINANCIALS — Budget & Recurring Items  \n# ============================================\nprint(\"[6/9] Financials...\")\n\nwith db() as conn:\n    # Monthly budget entries\n    budget_items = [\n        (\"Revenue - YouTube Automation\", \"income\", 149900, None),\n        (\"Revenue - TikTok Growth Bundle\", \"income\", 89900, None),\n        (\"Revenue - Content Repurposing\", \"income\", 59900, None),\n        (\"ElevenLabs Subscription\", \"expense\", 2200, \"monthly\"),\n        (\"Pictory AI Subscription\", \"expense\", 1900, \"monthly\"),\n        (\"Canva Pro (2 seats)\", \"expense\", 2600, \"monthly\"),\n        (\"TubeBuddy Business\", \"expense\", 4900, \"monthly\"),\n        (\"Alex Kim Voiceover (~8hrs/mo)\", \"expense\", 6000, \"monthly\"),\n        (\"Jordan Taylor Thumbnails (15/mo)\", \"expense\", 4500, \"monthly\"),\n    ]\n    \n    conn.executemany(\n        \"\"\"INSERT INTO budget_entries \n           (business_id, category_name, amount_type, amount_cents, frequency) \n           VALUES (?, ?, ?, ?, ?)\"\"\",\n        [(BUSINESS_ID, item[0], item[1], item[2], item[3]) for item in budget_items]\n    )\n\nprint(\"  ✓ Budget entries created\\n\")\n\n# ============================================\n# 7. BOOKMARKS (saved websites)  \n# ============================================\nprint(\"[7/9] Bookmarks...\")\n\nbookmarks = [\n    (\"Summit's Main YouTube Channel\", \"https://youtube.com/@SummitDigitalAgency\", \n     \"Main faceless channel — 10,247 subs. Hit monetization threshold June 2026.\"),\n     \n    (\"TechFlow Client Dashboard\", \"https://app.techflow.io/david/overview\",\n     \"Client portal for TechFlow Solutions analytics and project tracking.\"),\n\n    (\"ElevenLabs Voice Library\", \"https://elevenlabs.io/app/voice-lab\",\n     \"Browse AI voices. Currently using 'Marcus' (Premium) + testing new models.\"),\n     \n    (\"TubeBuddy Keyword Explorer\", \"https://www.tubebuddy.com/explore\",\n     \"SEO keyword research for YouTube videos. Check before every upload.\"),\n\n    (\"Pictory Dashboard\", \"https://app.pictory.ai/dashboard\",\n     \"AI video generation tool — used for B-roll and scene creation.\"),\n     \n    (\"Canva Design Templates\", \"https://www.canva.com/templates/\",\n     \"Thumbnail templates, social media graphics, presentation decks.\"),\n     \n    (\"CryptoView News Channel\", \"https://youtube.com/@CryptoViewNews\",\n     \"David Park's crypto channel — our podcast-to-video client. 3,891 subs.\"),\n\n    (\"Google Analytics (Summit)\", \"https://analytics.google.com/\",\n     \"Track website traffic for summitdigital.agency landing page.\")\n]\n\ninsert_many(\n    \"bookmarks\",\n    [\"business_id\", \"title\", \"url\"],\n    [(BUSINESS_ID, b[0], b[1]) for b in bookmarks]\n)\n\nprint(\"  ✓ Bookmarks saved (8 URLs)\\n\")\n\n# ============================================\n# 8. LOGINS / SECRETS VAULT  \n# ============================================\nprint(\"[8/9] Logins & Secrets...\")\n\nlogins = [\n    (\"Google AdSense\", \"https://adsense.google.com/\", \n     \"summitdigital.agency@gmail.com\", \"SummitAgency2026!\", \"\"),\n     \n    (\"YouTube Studio\", \"https://studio.youtube.com/\",\n     \"summitdigital.agency@gmail.com\", \"SummitAgency2026!\", \"Same as AdSense\"),\n\n    (\"ElevenLabs Pro Account\", \"https://elevenlabs.io/app/settings/subscription\",\n     \"billing@summitdigital.agency\", \"Elv1nLab$Pro!2026\", \"AI voiceover — $22/mo plan\"),\n     \n    (\"Pictory AI Creator Plan\", \"https://app.pictory.ai/account/billing\",\n     \"hello@summitdigital.agency\", \"P1ct0ryCr3at!\", \"\"),\n\n    (\"Canva Pro (Owner Seat)\", \"https://www.canva.com/login\",\n     \"jarvis@summitdigital.agency\", \"C4nv4Pr0!2026\", \"\"),\n     \n    (\"TubeBuddy Business Plan\", \"https://www.tubebuddy.com/settings\",\n     \"tubebuddy.summ1t@gmail.com\", \"Tb$umm1t!SEO\"),\n\n    (\"Cloudflare DNS (summitdigital.agency)\", \"https://dash.cloudflare.com/login\",\n     \"admin@summitdigital.agency\", \"Cl0udFlr$ecure!\", \"\"),\n     \n    (\"Notion Workspace\", \"https://www.notion.so/\",\n     \"workspace@summitdigital.agency\", \"N0t10nWrkspc!26\", \"Client portal hosted here\")\n]\n\ninsert_many(\n    \"logins_secrets\",  # Adjust table name if needed — checking...\n    [\"business_id\", \"name\", \"url\", \"username\", \"password\"],\n    [(BUSINESS_ID, l[0], l[1], l[2], l[3]) for l in logins]\n)\n\nprint(\"  ✓ Logins & secrets vault populated (8 entries)\\n\")\n\n# ============================================  \n# 9. PROJECTS / TASK LISTS  \n# ============================================\nprint(\"[9/9] Projects...\")\n\nwith db() as conn:\n    # Create a project for Q3 growth initiative\n    conn.execute(\n        \"\"\"INSERT INTO projects \n           (business_id, name, description, status) VALUES (?, ?, ?, ?)\"\"\",\n        (BUSINESS_ID, \"Q3 2026 Growth Initiative\",\n         \"Launch second YouTube channel (SummitFinance), hire part-time VA,\\nand grow MRR to $8K+ by September.\", \n         \"active\")\n    )\n    \n    project_id = conn.execute(\n        \"SELECT last_insert_rowid()\"\n    ).fetchone()[0]\n\n# Create tasks for the project  \ntasks = [\n    (\"Research and finalize SummitFinance channel niche\", True),\n    (\"Purchase domain summitfinance.com or similar\", False),\n    (\"Design channel branding (banner, logo)\", False),\n    (\"Script first 5 videos for launch week\", False),\n    (\"Set up ElevenLabs narrator voice profile\", False), \n    (\"Create content calendar template for finance niche\", False),\n    (\"Hire part-time VA ($8/hr, 10hrs/week)\", False),\n    (\"Draft job posting and post to Upwork/Freelancer\", False),\n    (\"Build client portal in Notion (for existing clients)\", False),\n]\n\ninsert_many(\n    \"task_lists\",\n    [\"project_id\", \"title\", \"is_completed\"],\n    [(project_id, t[0], t[1]) for t in tasks]\n)\n\nprint(\"  ✓ Project created with task list\\n\")\n\n# ============================================  \n# FINAL SUMMARY  \n# ============================================\nprint(\"=\" * 60)\nprint(\"✅ SUMMIT DIGITAL AGENCY LLC — FULLY POPULATED!\")\nprint(\"=\" * 60)\nprint(f\"\"\"\nBusiness: Summit Digital Agency LLC (ID: {BUSINESS_ID})\n\n📋 Sections populated:\n   • Company profile (addresses, phones, emails, social links, domains)  \n   • Products/Services catalog ({len(products_data)} services with pricing)\n   • Contacts directory (6 contacts across clients, contractors, vendors, platforms)\n   • Documents section (6 markdown files on disk + DB records)\n   • Notes (5 internal notes — ideas, prep work, goals, vendor info)  \n   • Budget entries ({len(budget_items)} income/expense items)\n   • Bookmarks (8 saved URLs across tools and client sites)\n   • Logins & Secrets vault (8 credentials with passwords)\n   • Projects (1 active project: Q3 Growth Initiative with {len(tasks)} tasks)\n\n💰 Monthly Revenue Mix:\n   YouTube Automation: $1,499/mo × 2 clients = ~$3,000\n   TikTok Growth Bundle: $899/mo × 1 client = ~$900  \n   Content Repurposing: $599/mo × 1 client = ~$600\n   \n📊 Monthly Expenses (estimated):\n   AI Tools & Software: ~$2,347/mo total\n   Contractor Fees: ~$10,500/mo (Alex + Jordan)\n\nAll data is live in the app at http://localhost:9102 🚀\"\"\")\n"},"status":"ok","ms":154}
