{"t":"2026-07-28T04:20:46.328Z","tool":"write_workbench_file","args":{"path":"/workspace/populate_summit.py","content":"#!/usr/bin/env python3\n\"\"\"Populate Summit Digital Agency LLC with realistic data across all tables.\"\"\"\n\nimport sqlite3, os, sys\n\nDB_PATH = \"/workspace/mbm.db\"\nBUSINESS_ID = 2\n\ndef run(conn, sql, params=None):\n    \"\"\"Execute SQL and return rows if SELECT, else commit.\"\"\"\n    cur = conn.cursor()\n    try:\n        cur.execute(sql, params or ())\n        if cur.description:\n            cols = [d[0] for d in cur.description]\n            results = [dict(zip(cols, row)) for row in cur.fetchall()]\n            return results\n        else:\n            conn.commit()\n            return None\n    except Exception as e:\n        print(f\"  ERROR: {e}\")\n        print(f\"  SQL: {sql[:200]}\")\n        if params:\n            print(f\"  Params: {params[:5] if isinstance(params, (list,tuple)) else 'N/A'}\")\n        conn.rollback()\n        return None\n\ndef main():\n    conn = sqlite3.connect(DB_PATH)\n    \n    # ============================================================\n    # STEP 1: Business Company Profile & Info Section Visibility\n    # ============================================================\n    print(\"=== Step 1: Company Profile ===\")\n    \n    run(conn, \"\"\"\n        INSERT OR REPLACE INTO business_company \n            (business_id, legal_name, dba, ein, entity_type, founded_date, state_of_formation, mission, motto, slogan, website_url)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    \"\"\", [BUSINESS_ID, \"Summit Digital Agency LLC\", None, \"84-2917365\", \"LLC\", \n          \"2024-01-15\", \"Delaware\",\n          \"We help creators and brands grow on YouTube and TikTok through done-for-you faceless content automation — from script to upload.\",\n          \"Content that works while you sleep.\",\n          \"Faceless. Automated. Profitable.\",\n          \"https://summitdigitalagency.io\"])\n\n    # Enable all info sections for this business\n    run(conn, \"\"\"INSERT OR REPLACE INTO business_info_section_visibility (business_id, section_name, enabled) VALUES (?, 'company', 1)\"\"\", [BUSINESS_ID])\n    \n    print(\"  Company profile set.\")\n\n    # ============================================================\n    # STEP 2: Contact Info (Address, Email, Phone, Social Links)\n    # ============================================================\n    print(\"=== Step 2: Contact Details ===\")\n    \n    run(conn, \"\"\"INSERT INTO business_addresses \n        (business_id, label, line1, city, state, postal_code, country, is_primary, sort_order) VALUES (?, ?, ?, ?, ?, ?, ?, 0, 1)\"\"\",\n        [BUSINESS_ID, \"Registered Office\", \"4200 N Fairfax Dr, Ste 600\", \"Arlington\", \"VA\", \"22203\", \"US\"])\n\n    run(conn, \"\"\"INSERT INTO business_emails \n        (business_id, label, email, is_primary) VALUES (?, ?, ?, 1)\"\"\",\n        [BUSINESS_ID, \"General Inquiries\", \"hello@summitdigitalagency.io\"])\n\n    run(conn, \"\"\"INSERT INTO business_phones \n        (business_id, label, number, is_primary) VALUES (?, ?, ?, 0)\"\"\",\n        [BUSINESS_ID, \"Main Line\", \"+1-571-298-4310\"])\n\n    # Social media profiles for the agency itself\n    social_data = [\n        (\"YouTube\", \"@SummitDigitalAgency\", \"https://youtube.com/@SummitDigitalAgency\"),\n        (\"Instagram\", \"@summitdigital.agency\", \"https://instagram.com/summitdigital.agency\"),\n        (\"LinkedIn\", \"company/summit-digital-agency-llc\", \"https://linkedin.com/company/summit-digital-agency-llc\"),\n        (\"Twitter/X\", \"@SummitDigiAgcy\", \"https://x.com/SummitDigiAgcy\"),\n    ]\n    for platform, handle, url in social_data:\n        run(conn, \"\"\"INSERT INTO business_social_links (business_id, platform, handle, url) VALUES (?, ?, ?, ?)\"\"\",\n            [BUSINESS_ID, platform, handle, url])\n\n    print(\"  Contact details set.\")\n\n    # ============================================================\n    # STEP 3: Products/Services Catalog — Faceless Content Packages\n    # ============================================================\n    print(\"=== Step 3: Products & Services ===\")\n    \n    services = [\n        (\"service\", \"Starter Faceless YouTube Pack\", None, 149900, \n         \"5 faceless YouTube videos/month. Includes niche research, AI voiceover, stock footage editing, thumbnails, and SEO-optimized titles/descriptions.\", \"2024-02-01\"),\n        (\"service\", \"Growth Faceless Bundle (YouTube + TikTok)\", None, 399700, \n         \"8 YouTube videos + 15 TikToks/month. Full automation: scriptwriting, AI voiceover, editing, posting schedule management.\", \"2024-02-15\"),\n        (\"service\", \"Premium Multi-Platform Suite\", None, 699700, \n         \"12 YouTube videos + 30 TikToks + Shorts/Reels repurposing. Includes community management and analytics reporting.\", \"2024-03-01\"),\n        (\"service\", \"One-Time Channel Setup & Strategy\", None, 85000, \n         \"Complete channel audit: niche selection, competitor analysis, content calendar (90 days), branding kit, first 5 videos produced.\", \"2024-02-01\"),\n        (\"service\", \"Thumbnail Design Pack\", None, 35000, \n         \"Custom thumbnail designs for up to 8 videos/month. A/B tested layouts optimized for CTR improvement.\", \"2024-06-01\"),\n        (\"service\", \"SEO & Metadata Optimization (Monthly)\", None, 49700, \n         \"Keyword research, tag optimization, description rewriting, and competitor gap analysis for existing channels.\", \"2024-05-01\"),\n    ]\n\n    for kind, name, sku, price_cents, desc, created in services:\n        run(conn, \"\"\"INSERT INTO business_products_services \n            (business_id, kind, name, sku, price_cents, description, status, created_date) VALUES (?, ?, ?, ?, ?, ?, 'active', ?)\"\"\",\n            [BUSINESS_ID, kind, name, sku, price_cents, desc, created])\n\n    print(\"  Services catalog set.\")\n\n    # ============================================================\n    # STEP 4: Customers (Agency Clients — Faceless Channel Owners)\n    # ============================================================\n    print(\"=== Step 4: Customer Directory ===\")\n    \n    customers = [\n        (\"CryptoMindset Official\", \"contact@cryptomindset.io\", \"+1-323-555-0147\", \n         \"Faceless crypto education channel. On Growth Faceless Bundle since March 2024.\"),\n        (\"SleepyHistory\", \"admin@sleepyhistory.com\", None,\n         \"Historical storytelling/ASMR channel. Premium Suite client since June 2024.\"),\n        (\"ZenTech Reviews\", \"hello@zentechreviews.net\", \"+1-650-555-0892\",\n         \"Faceless tech product reviews. Starter Pack, upgraded to Growth Bundle in Jan 2025.\"),\n        (\"MythBusters Daily (AI)\", \"team@mythbustersdaily.com\", None,\n         \"Science myth-busting with AI narration. Premium Suite since August 2024.\"),\n        (\"MotivationForge\", \"content@motivationforge.co\", \"+1-718-555-0334\",\n         \"Stoic motivation/philosophy shorts channel. Growth Bundle client.\"),\n    ]\n\n    for name, email, phone, notes in customers:\n        run(conn, \"\"\"INSERT INTO business_customers \n            (business_id, name, email, phone, billing_address, notes) VALUES (?, ?, ?, ?, 'United States', ?)\"\"\",\n            [BUSINESS_ID, name, email or \"\", phone or \"\", notes])\n\n    print(\"  Customers set.\")\n\n    # ============================================================\n    # STEP 5: Vendors (Tools & Freelancers the Agency Uses)\n    # ============================================================\n    print(\"=== Step 5: Vendor Directory ===\")\n    \n    vendors = [\n        (\"Pictory AI\", \"Enterprise SaaS for video automation. Primary editing tool.\", \n         \"billing@pictory.ai\", \"+1-844-742-5963\"),\n        (\"ElevenLabs (Premium)\", \"AI voiceover service — highest quality TTS for faceless content.\",\n         \"enterprise@elevenlabs.io\", None),\n        (\"Storyblocks Unlimited\", \"Stock footage, music, and SFX licensing.\",\n         \"accounts@storyblocks.com\", \"+1-855-786-2934\"),\n        (\"Canva Pro (Agency)\", \"Thumbnail design templates & brand kit management.\",\n         None, None),\n        (\"TubeBuddy Business\", \"YouTube SEO tools, keyword research, A/B testing.\",\n         \"billing@tubebuddy.com\", \"+1-855-209-6734\"),\n        (\"Freelance Scriptwriter — Sarah K.\", \"Contract content writer for niche-specific scripts. $800/month retainer.\",\n         \"sarah.k.writes@gmail.com\", None),\n    ]\n\n    for name, category, email, phone in vendors:\n        run(conn, \"\"\"INSERT INTO business_vendors \n            (business_id, name, category, email, phone) VALUES (?, ?, ?, ?, ?)\"\"\",\n            [BUSINESS_ID, name, \"SaaS / Freelance\" if \"Freelance\" not in name else \"Contractor\", \n             email or \"\", phone or \"\"])\n\n    print(\"  Vendors set.\")\n\n    # ============================================================\n    # STEP 6: Financials — Budget Entries (2025 & 2026)\n    # ============================================================\n    print(\"=== Step 6: Budget Entries ===\")\n    \n    budget_2025 = [\n        (\"Revenue\", \"YouTube Faceless Services\", 1847000),   # ~$18.5k/mo avg from clients\n        (\"Revenue\", \"TikTok/Shorts Automation\", 960000),     # ~$9.6k/mo\n        (\"Revenue\", \"One-Time Setup Fees\", 240000),          # ~$2k setup fees\n        (\"Operating Expense\", \"Pictory AI Enterprise\", 158400),   # $1,320/mo × 12\n        (\"Operating Expense\", \"ElevenLabs Premium\", 69600),      # $580/mo × 12\n        (\"Operating Expense\", \"Storyblocks Unlimited\", 72000),    # $600/mo × 12 (actually ~$499)\n        (\"Operating Expense\", \"TubeBuddy Business\", 35880),       # $2,990/yr\n        (\"Operating Expense\", \"Canva Pro Agency\", 23760),         # $19.80/mo × 12\n        (\"Operating Expense\", \"Freelance Scriptwriter Retainer\", 96000),   # $800/mo × 12\n        (\"Operating Expense\", \"Legal & Accounting (LLC)\", 45000),    # Annual legal/accounting\n        (\"Operating Expense\", \"Domain Registrations & SSL\", 3600),     # Domains + hosting\n        (\"Operating Expense\", \"Marketing — Google Ads / Meta\", 120000),   # Lead gen ads\n        (\"Operating Expense\", \"Business Insurance (E&O)\", 24000),       # Errors & omissions\n    ]\n\n    budget_2026 = [\n        (\"Revenue\", \"YouTube Faceless Services\", 2157000),   # ~$18k/mo → growing to $30k+ with new clients\n        (\"Revenue\", \"TikTok/Shorts Automation\", 1440000),    # Growing demand for shorts content\n        (\"Revenue\", \"One-Time Setup Fees\", 255000),          # More setup projects added\n        (\"Operating Expense\", \"Pictory AI Enterprise\", 167880),   # Price increase expected\n        (\"Operating Expense\", \"ElevenLabs Premium\", 93600),       # Higher tier plan needed for volume\n        (\"Operating Expense\", \"Storyblocks Unlimited\", 72000),    # Stable pricing\n        (\"Operating Expense\", \"TubeBuddy Business\", 35880),       \n        (\"Operating Expense\", \"Canva Pro Agency\", 23760),         \n        (\"Operating Expense\", \"Freelance Scriptwriter Retainer\", 144000),   # Added second writer\n        (\"Operating Expense\", \"Legal & Accounting (LLC)\", 50000),   \n        (\"Operating Expense\", \"Domain Registrations & SSL\", 3600),     \n        (\"Operating Expense\", \"Marketing — Google Ads / Meta\", 180000),   # Scaling ad spend\n        (\"Operating Expense\", \"Business Insurance (E&O)\", 24000),       \n    ]\n\n    for year, entries in [(\"2025\", budget_2025), (\"2026\", budget_2026)]:\n        for txn_type, category, amount_cents in entries:\n            run(conn, \"\"\"INSERT INTO budget_entries \n                (business_id, year, type_key, category, planned_cents) VALUES (?, ?, ?, ?, ?)\"\"\",\n                [BUSINESS_ID, int(year), txn_type, category, amount_cents])\n\n    print(\"  Budgets set.\")\n\n    # ============================================================\n    # STEP 7: Recurring Invoices (Active client retainers)\n    # ============================================================\n    print(\"=== Step 7: Recurring Invoices ===\")\n    \n    recurring = [\n        (\"CryptoMindset Official\", \"SM-2025-\", 149900, 0, \"Growth Faceless Bundle — monthly retainer. Includes YouTube + TikTok content.\", \"monthly\", 1, \"2026-08-01\"),\n        (\"SleepyHistory\", \"SH-2025-\", 399700, 0, \"Premium Multi-Platform Suite — full automation with community management.\", \"monthly\", 1, \"2026-08-01\"),\n        (\"ZenTech Reviews\", \"ZT-2025-\", 149900, 0, \"Starter Faceless YouTube Pack — monthly retainer for 5 videos/month.\", \"monthly\", 1, \"2026-08-01\"),\n    ]\n\n    for customer_name, prefix, amount_cents, tax_cents, notes, freq, interval, next_run in recurring:\n        run(conn, \"\"\"INSERT INTO recurring_invoices \n            (business_id, customer_name, number_prefix, amount_cents, tax_cents, notes, frequency, interval_count, next_run_date) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n            [BUSINESS_ID, customer_name, prefix, amount_cents, tax_cents, notes, freq, interval, next_run])\n\n    print(\"  Recurring invoices set.\")\n\n    # ============================================================\n    # STEP 8: Business Assets (Hardware & Software Licenses)\n    # ============================================================\n    print(\"=== Step 8: Business Assets ===\")\n    \n    assets = [\n        (\"MacBook Pro M3 Max\", \"2024-11-15\", 349900, None, \n         \"Primary editing workstation — handles Premiere Pro + After Effects rendering.\"),\n        (\"Dell UltraSharp U2723QE Monitor (2x)\", \"2024-11-20\", 189800, None, \n         \"Dual monitor setup for timeline editing and preview monitoring.\"),\n    ]\n\n    for name, purchase_date, cost_cents, dep_class, notes in assets:\n        run(conn, \"\"\"INSERT INTO business_assets \n            (business_id, name, purchase_date, cost_cents, depreciation_class, notes) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n            [BUSINESS_ID, name, purchase_date, cost_cents, \"7-year property\" if dep_class is None else dep_class, notes])\n\n    print(\"  Assets set.\")\n\n    # ============================================================\n    # STEP 9: Business Memberships & Licenses\n    # ============================================================\n    print(\"=== Step 9: Memberships & Licenses ===\")\n    \n    run(conn, \"\"\"INSERT INTO business_memberships \n        (business_id, name, category, renewal_date, cost_cents) VALUES (?, ?, ?, ?, ?)\"\"\",\n        [BUSINESS_ID, \"Delaware LLC Annual Franchise Tax\", \"State Compliance\", \"2027-01-31\", 30496])\n\n    run(conn, \"\"\"INSERT INTO business_licenses \n        (business_id, jurisdiction, license_type, license_number, issued_date, expires_date) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        [BUSINESS_ID, \"Delaware\", \"LLC Certificate of Formation\", \"DE-2024-84719365\", \"2024-01-15\", None])\n\n    run(conn, \"\"\"INSERT INTO business_licenses \n        (business_id, jurisdiction, license_type, license_number, issued_date, expires_date) VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        [BUSINESS_ID, \"Virginia\", \"Business Privilege License\", \"VA-BPL-2024-58391746\", \"2024-03-01\", \"2027-03-01\"])\n\n    print(\"  Memberships & licenses set.\")\n\n    # ============================================================\n    # STEP 10: Projects / KPIs — Task Lists for Growth Tracking\n    # ============================================================\n    print(\"=== Step 10: Project Lists (KPI Dashboard) ===\")\n    \n    # Q3-Q4 2026 Marketing Sprint\n    result = run(conn, \"\"\"INSERT INTO project_lists \n        (business_id, title) VALUES (?, ?)\"\"\", [BUSINESS_ID, \"Q3–Q4 2026 Growth & KPI Targets\"])\n    q4_list_id = conn.execute(\"SELECT last_insert_rowid()\").fetchone()[0]\n\n    kpi_items = [\n        (\"Revenue: Hit $50k MRR by Oct 2026\", False),\n        (\"Acquire 3 new retainer clients (YouTube faceless niche)\", False),\n        (\"Launch referral program — offer 1 month free for client referrals\", True),\n        (\"Build case study portfolio with 5 success stories from existing clients\", False),\n        (\"Optimize ad funnel: reduce CAC below $400 per new client\", False),\n        (\"Achieve 95%+ client retention rate across all retainer contracts\", False),\n        (\"Hire part-time video editor (contract) to handle overflow work\", True),\n        (\"Set up automated reporting dashboard for clients (Looker Studio)\", False),\n    ]\n\n    for text, is_done in kpi_items:\n        run(conn, \"\"\"INSERT INTO project_list_items \n            (list_id, business_id, text, is_done) VALUES (?, ?, ?, ?)\"\"\",\n            [q4_list_id, BUSINESS_ID, text, int(is_done)])\n\n    # Content Production Pipeline\n    result = run(conn, \"\"\"INSERT INTO project_lists \n        (business_id, title) VALUES (?, ?)\"\"\", [BUSINESS_ID, \"Content Production Pipeline — SOPs\"])\n    pipeline_id = conn.execute(\"SELECT last_insert_rowid()\").fetchone()[0]\n\n    sop_items = [\n        (\"Standardize script-to-video workflow in Notion/Airtable\", True),\n        (\"Create template library for YouTube thumbnails (Canva)\", True),\n        (\"Document AI voiceover prompt engineering guidelines\", False),\n        (\"Build stock footage sourcing checklist per niche category\", False),\n        (\"Establish quality review rubric before video delivery to clients\", False),\n    ]\n\n    for text, is_done in sop_items:\n        run(conn, \"\"\"INSERT INTO project_list_items \n            (list_id, business_id, text, is_done) VALUES (?, ?, ?, ?)\"\"\",\n            [pipeline_id, BUSINESS_ID, text, int(is_done)])\n\n    print(\"  Project lists set.\")\n\n    # ============================================================\n    # STEP 11: Sample Invoices for Existing Clients\n    # ============================================================\n    print(\"=== Step 11: Sample Invoices ===\")\n    \n    invoices = [\n        (\"SM-202607\", \"CryptoMindset Official\", \"2026-07-01\", \"2026-08-01\", \"paid\", 149900, 0, 149900),\n        (\"SH-202607\", \"SleepyHistory\", \"2026-07-01\", \"2026-08-01\", \"sent\", 399700, 0, 399700),\n    ]\n\n    for inv_num, cust_name, issue_date, due_date, status, sub_cents, tax_cents, total_cents in invoices:\n        run(conn, \"\"\"INSERT INTO invoices \n            (business_id, invoice_number, customer_name, issue_date, due_date, status, subtotal_cents, tax_cents, total_cents) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n            [BUSINESS_ID, inv_num, cust_name, issue_date, due_date, status, sub_cents, tax_cents, total_cents])\n\n    print(\"  Invoices set.\")\n\n    # ============================================================\n    STEP 12: Enable all info sections for visibility\n    # ============================================================\n    print(\"=== Step 12: Section Visibility ===\")\n    \n    all_sections = [\n        'company', 'addresses', 'emails', 'phones', 'social_links', \n        'products_services', 'customers', 'vendors', 'invoices', \n        'recurring_invoices', 'budget_entries', 'assets', 'memberships',\n        'licenses', 'projects'\n    ]\n\n    for section in all_sections:\n        run(conn, \"\"\"INSERT OR REPLACE INTO business_info_section_visibility (business_id, section_name, enabled) VALUES (?, ?, 1)\"\"\",\n            [BUSINESS_ID, section])\n\n    print(\"  All sections enabled.\")\n\n    # ============================================================\n    FINAL VERIFICATION\n    # ============================================================\n    print(\"\\n=== Verification ===\")\n    \n    company = run(conn, \"SELECT legal_name, mission FROM business_company WHERE business_id=?\", [BUSINESS_ID])\n    print(f\"  Company: {company[0]['legal_name']} — '{company[0]['mission'][:60]}...'\")\n\n    services_count = len(run(conn, \"SELECT COUNT(*) as cnt FROM business_products_services WHERE business_id=? AND kind='service'\", [BUSINESS_ID]))\n    print(f\"  Services cataloged: {services_count}\")\n\n    customers_count = len(run(conn, \"SELECT name FROM business_customers WHERE business_id=?\", [BUSINESS_ID]))\n    print(f\"  Customers on file: {customers_count}\")\n\n    vendors_count = len(run(conn, \"SELECT name FROM business_vendors WHERE business_id=?\", [BUSINESS_ID]))\n    print(f\"  Vendors registered: {vendors_count}\")\n\n    budget_entries = run(conn, \"SELECT type_key, SUM(planned_cents) as total FROM budget_entries WHERE business_id=? AND year=2026 GROUP BY type_key\", [BUSINESS_ID])\n    for entry in budget_entries or []:\n        print(f\"  Budget {entry['type_key']} (2026): ${entry['total']/100:.2f}\")\n\n    recurring_count = len(run(conn, \"SELECT customer_name FROM recurring_invoices WHERE business_id=? AND active=1\", [BUSINESS_ID]))\n    print(f\"  Active recurring invoices: {recurring_count}\")\n\n    projects = run(conn, \"\"\"SELECT pl.title, COUNT(pli.item_id) as items \n        FROM project_lists pl LEFT JOIN project_list_items pli ON pl.list_id = pli.list_id AND pl.business_id=pli.business_id WHERE pl.business_id=? GROUP BY pl.list_id\"\"\", [BUSINESS_ID])\n    for proj in projects or []:\n        print(f\"  Project list '{proj['title']}': {proj['items']} items\")\n\n    conn.close()\n    print(\"\\n✅ Summit Digital Agency LLC fully populated!\")\n\nif __name__ == \"__main__\":\n    main()\n"},"status":"ok","ms":145}
