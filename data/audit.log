{"t":"2026-07-26T00:35:06.559Z","tool":"write_workbench_file","args":{"path":"/workspace/doom/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Hell Runner - Doom-like Web Game</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #111; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; font-family: monospace; color: #ccc; user-select: none; }\n#game-container { position: relative; width: 800px; height: 600px; border: 2px solid #333; background: #000; image-rendering: pixelated; cursor: crosshair; overflow: hidden; }\ncanvas.game-canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; position: absolute; top: 0; left: 0; z-index: 1; }\n#hud { position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background: linear-gradient(to top, #2a1a1a, #4a2a2a); border-top: 3px solid #666; display: flex; align-items: center; justify-content: space-around; padding: 5px; z-index: 10; }\n.hud-item { text-align: center; font-size: 18px; color: #ff0; text-shadow: 2px 2px #000; }\n.hud-label { font-size: 11px; color: #aaa; margin-bottom: 2px; }\n#health-val, #armor-val, #ammo-val, #score-val { font-size: 36px; text-shadow: 0 0 8px rgba(255,0,0,0.5); }\n#message-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none; justify-content: center; align-items: center; background: rgba(0,0,0,0.7); z-index: 20; font-size: 36px; color: #f44; text-shadow: 0 0 20px red; flex-direction: column; }\n#message-overlay button { margin-top: 20px; padding: 15px 40px; font-size: 24px; background: #8b0000; color: #fff; border: 2px solid #ff4444; cursor: pointer; font-family: monospace; letter-spacing: 3px; }\n#message-overlay button:hover { background: #cc0000; box-shadow: 0 0 20px rgba(255,0,0,0.5); }\n#minimap-canvas { position: absolute; top: 10px; right: 10px; border: 2px solid #555; z-index: 3; pointer-events: none; image-rendering: pixelated; width: 160px; height: 160px; }\n#damage-flash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,0,0,0); pointer-events: none; z-index: 4; transition: background 0.1s ease-out; }\n#crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: rgba(255,100,100,0.7); font-size: 30px; z-index: 4; pointer-events: none; }\n#weapon-display { position: absolute; bottom: 90px; right: 30px; font-size: 16px; color: #ffaa00; z-index: 2; text-align: center; pointer-events: none; }\n#start-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: linear-gradient(180deg, #1a0000, #330000); z-index: 25; }\n#start-screen h1 { font-size: 72px; color: #cc0000; text-shadow: 0 0 40px red, 0 0 80px darkred; margin-bottom: 20px; letter-spacing: 8px; animation: pulse 2s infinite; }\n#start-screen p { font-size: 16px; color: #aaa; margin: 5px; text-align: center; line-height: 1.6; }\n@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }\n#start-btn { margin-top: 30px; padding: 15px 40px; font-size: 28px; background: #8b0000; color: #fff; border: 2px solid #ff4444; cursor: pointer; font-family: monospace; letter-spacing: 3px; transition: all 0.2s; }\n#start-btn:hover { background: #cc0000; box-shadow: 0 0 20px rgba(255,0,0,0.5); transform: scale(1.05); }\n</style>\n</head>\n<body>\n\n<div id=\"game-container\">\n<canvas class=\"game-canvas\" id=\"screen\" width=\"320\" height=\"240\"></canvas>\n<canvas id=\"minimap-canvas\" width=\"160\" height=\"160\"></canvas>\n<div id=\"crosshair\">+</div>\n<div id=\"damage-flash\"></div>\n<div id=\"weapon-display\"></div>\n\n<div id=\"hud\">\n  <div class=\"hud-item\"><div class=\"hud-label\">HEALTH</div><span id=\"health-val\" style=\"color:#ff4444;\">100%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">ARMOR</div><span id=\"armor-val\" style=\"color:#4488ff;\">25%</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">AMMO</div><span id=\"ammo-val\" style=\"color:#ffaa00;\">50</span></div>\n  <div class=\"hud-item\"><div class=\"hud-label\">KILLS</div><span id=\"score-val\" style=\"color:#44ff44;\">0/10</span></div>\n</div>\n\n<div id=\"message-overlay\"></div>\n<div id=\"start-screen\">\n<h1>HELL RUNNER</h1>\n<p>WASD - Move | Mouse - Look Around<br>Click - Shoot | R - Change Weapon</p>\n<p>Kill all 10 demons to escape Hell!</p>\n<button id=\"start-btn\" onclick=\"window.startGame()\">ENTER HELL</button>\n</div>\n\n<script>\n// ============================================================\n// HELL RUNNER - A Doom-like Raycasting FPS Game\n// ============================================================\n\nconst canvas = document.getElementById('screen');\nconst ctx = canvas.getContext('2d', { willReadFrequently: true });\nconst miniCanvas = document.getElementById('minimap-canvas');\nconst miniCtx = miniCanvas.getContext('2d');\n\n// ---- MAP DEFINITION ----\nconst mapData = [\n\"####################\",\n\"#..................#\",\n\"#.T..............T.#\",\n\"#.......##.........#\",\n\"#.......#..........#\",\n\"#...##..#.T........#\",\n\"#...#...#..........#\",\n\"#...#...###....T...#\",\n\"#...........#######.\",\n\".T...............#..\",\n\"#####.####.....#....\",\n\"#....#.#...T...#....\",\n\"#....#.#.......#....\",\n\"#....#.##.T..##.....\",\n\"#..........#........\",\n\"#..T.........T......\",\n\"####################\"\n];\n\nconst MAP_H = mapData.length;\nlet wallMap = []; // 2D array: true=wall, false=floor\nlet torches = []; // [{x, y}] world positions of light sources\n\nfunction parseMap() {\n    wallMap = [];\n    torches = [];\n    for (let row = 0; row < MAP_H; row++) {\n        if (!wallMap[row]) wallMap[row] = [];\n        const line = mapData[row];\n        for (let col = 0; col < line.length; col++) {\n            let ch = line[col];\n            if (ch === '#' || ch === 'T') {\n                wallMap[row][col] = true;\n                if (ch === 'T') torches.push({ x: col + 0.5, y: row + 0.5 });\n            } else {\n                wallMap[row][col] = false;\n            }\n        }\n    }\n}\n\n// ---- GAME STATE ----\nlet gameState = 'menu'; // menu | playing | won | lost\nlet player = {};\nlet entities = [];\nlet particles = [];\nlet keys = {};\nlet mouseDown = false;\nlet shootCooldown = 0;\nlet weaponIndex = 1;\nconst weapons = [\n    { name: \"FIST\", ammoType: null, damage: 25, cooldown: 30, spread: 0 },\n    { name: \"PISTOL\", ammoType: \"pistol\", damage: 35, cooldown: 18, spread: 0.04 },\n    { name: \"SHOTGUN\", ammoType: \"shotgun\", damage: 20, cooldown: 40, spread: 0.12, pellets: 6 }\n];\n\nfunction resetGame() {\n    player = { x: 3.5, y: 3.5, angle: Math.PI / 2, health: 100, armor: 25, ammo: { pistol: 40, shotgun: 8 }, kills: 0 };\n    entities = [];\n    particles = [];\n\n    // Spawn enemies at various floor locations\n    const enemyPositions = [\n        { x: 7.5, y: 13.5, type: 'imp' },\n        { x: 12.5, y: 6.5, type: 'demon' },\n        { x: 4.5, y: 8.5, type: 'zombie' },\n        { x: 9.5, y: 3.5, type: 'imp' },\n        { x: 15.5, y: 2.5, type: 'demon' },\n        { x: 6.5, y: 10.5, type: 'zombie' },\n        { x: 13.5, y: 9.5, type: 'imp' },\n        { x: 2.5, y: 14.5, type: 'demon' },\n        { x: 10.5, y: 14.5, type: 'zombie' },\n        { x: 7.5, y: 6.5, type: 'imp' }\n    ];\n\n    enemyPositions.forEach(ep => {\n        entities.push({\n            x: ep.x, y: ep.y, type: ep.type, health: ep.type === 'demon' ? 100 : (ep.type === 'zombie' ? 50 : 60),\n            speed: ep.type === 'imp' ? 0.02 : (ep.type === 'demon' ? 0.03 : 0.015), damage: ep.type === 'demon' ? 20 : (ep.type === 'zombie' ? 8 : 12),\n            alive: true, attackCooldown: 60, hitFlash: 0, lastSeenTime: -999\n        });\n    });\n\n    // Spawn pickups\n    const pickupPositions = [\n        { x: 5.5, y: 7.5, type: 'health' },\n        { x: 14.5, y: 12.5, type: 'ammo_pistol' },\n        { x: 3.5, y: 15.5, type: 'armor' }\n    ];\n\n    pickupPositions.forEach(pp => {\n        entities.push({ x: pp.x, y: pp.y, type: pp.type, alive: true });\n    });\n\n    shootCooldown = 0;\n}\n\n// ---- START GAME ----\nwindow.startGame = function() {\n    document.getElementById('start-screen').style.display = 'none';\n    resetGame();\n    gameState = 'playing';\n    try { canvas.requestPointerLock && canvas.requestPointerLock(); } catch(e) {}\n};\n\ndocument.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });\ndocument.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\ncanvas.addEventListener('mousedown', () => { if (gameState === 'playing') mouseDown = true; });\ncanvas.addEventListener('mouseup', () => { mouseDown = false; });\n\n// ---- RAYCASTING ENGINE ----\nconst FOV = Math.PI / 3; // 60 degrees field of view\n\nfunction castRay(angle) {\n    let sinA = Math.sin(angle);\n    let cosA = Math.cos(angle);\n\n    let mapX = Math.floor(player.x);\n    let mapY = Math.floor(player.y);\n\n    let deltaDistX = Math.abs(1 / (cosA || 0.0001));\n    let deltaDistY = Math.abs(1 / (sinA || 0.0001));\n\n    let stepX, stepY;\n    let sideDistX, sideDistY;\n\n    if (cosA < 0) { stepX = -1; sideDistX = ((player.x) - mapX) * deltaDistX; }\n    else { stepX = 1; sideDistX = (mapX + 1.0 - player.x) * deltaDistX; }\n\n    if (sinA < 0) { stepY = -1; sideDistY = ((player.y) - mapY) * deltaDistY; }\n    else { stepY = 1; sideDistY = (mapY + 1.0 - player.y) * deltaDistY; }\n\n    let hit = false, side = 0;\n    while (!hit && mapX >= 0 && mapX < MAP_W && mapY >= 0 && mapY < MAP_H) {\n        if (sideDistX < sideDistY) {\n            sideDistX += deltaDistX;\n            mapX += stepX;\n            side = 0;\n        } else {\n            sideDistY += deltaDistY;\n            mapY += stepY;\n            side = 1;\n        }\n\n        if (mapX >= 0 && mapX < MAP_W && mapY >= 0 && mapY < MAP_H) {\n            if (wallMap[mapY] && wallMap[mapY][mapX]) hit = true;\n        } else break;\n    }\n\n    let perpDist, wallPos;\n    if (side === 0) {\n        perpDist = ((player.x) - mapX + (1 - stepX) / 2) / (cosA || 0.0001);\n        wallPos = ((player.y) - mapY + (1 - stepY) / 2) / (sinA || 0.0001);\n    } else {\n        perpDist = ((player.y) - mapY + (1 - stepY) / 2) / (sinA || 0.0001);\n        wallPos = 1.0 - (((player.x) - mapX + (1 - stepX) / 2) / (cosA || 0.0001));\n    }\n\n    return { perpDist: Math.max(perpDist, 0.01), side, wallX: wallPos };\n}\n\nfunction getLightAt(x, y) {\n    let light = 0;\n    for (let t of torches) {\n        let dx = x - t.x;\n        let dy = y - t.y;\n        let distSq = dx * dx + dy * dy;\n        if (distSq < 16 && distSq > 0.01) light += Math.max(0, 25 / Math.sqrt(distSq));\n    }\n    return Math.min(light, 30);\n}\n\n// ---- RENDERING ----\nfunction render() {\n    // Clear canvas to black first\n    ctx.fillStyle = '#000';\n    ctx.fillRect(0, 0, 320, 240);\n\n    for (let x = 0; x < 320; x++) {\n        let rayAngle = player.angle - FOV / 2 + (x / 320) * FOV;\n        let result = castRay(rayAngle);\n\n        if (!result.hit || result.perpDist > 15) continue;\n\n        // Calculate wall height on screen\n        let perpDistCorrected = result.perpDist * Math.cos(rayAngle - player.angle);\n        let lineHeight = (3.0 / perpDistCorrected) * 240;\n        if (lineHeight <= 0 || isNaN(lineHeight)) continue;\n\n        // Wall brightness based on distance and light sources\n        let wallXWorld = player.x + result.perpDist * Math.cos(rayAngle);\n        let wallYWorld = player.y + result.perpDist * Math.sin(rayAngle);\n        let lighting = getLightAt(wallXWorld, wallYWorld) / 30;\n\n        // Distance fog (darken far walls)\n        let distanceFog = Math.max(0.15, 1 - result.perpDist / 8);\n        lighting *= distanceFog;\n\n        if (result.side === 1) lighting *= 0.7;\n\n        // Wall color: dark gray with slight red tint (hell walls)\n        let baseR = Math.floor(90 * lighting);\n        let baseG = Math.floor(85 * lighting);\n        let baseB = Math.floor(100 * lighting);\n\n        // Draw wall section\n        for (let y = 0; y < lineHeight / 2 && y < 240; y++) {\n            ctx.fillStyle = `rgb(${baseR},${baseG},${baseB})`;\n            ctx.fillRect(x, y, 1, 1);\n\n            // Floor below wall - darker version with lighting\n            let floorY = Math.floor(240 - lineHeight / 2) + y;\n            if (floorY < 240 && floorY >= 0) {\n                let fLighting = getLightAt(wallXWorld, wallYWorld) / 30 * distanceFog;\n                ctx.fillStyle = `rgb(${Math.floor(baseR/2)},${Math.floor(40*fLighting)},${Math.floor(60*fLighting)})`;\n                ctx.fillRect(x, floorY, 1, 1);\n\n                // Ceiling above wall - even darker version with lighting\n                let ceilY = Math.max(0, y) + Math.min(lineHeight / 2, lineHeight / 2);\n                if (ceilY < 240 && ceilY >= 0) {\n                    ctx.fillStyle = `rgb(${Math.floor(baseR/3)},${Math.floor(50*fLighting*0.7)},${Math.floor(80*fLighting*0.7)})`;\n                    ctx.fillRect(x, ceilY, 1, 1);\n                }\n            }\n        }\n\n        // Draw floor below wall (if not already drawn)\n        let ceilingTop = Math.floor(240 - lineHeight / 2);\n        if (ceilingTop < 120 && ceilingTop >= 0) {\n            for (let y = ceilingTop; y < 120; y++) {\n                let floorDist = result.perpDist * (y - 120) / 120 + 0.5;\n                if (floorDist > 0 && !isNaN(floorDist)) {\n                    let fLighting = getLightAt(\n                        player.x + Math.cos(rayAngle) * floorDist,\n                        player.y + Math.sin(rayAngle) * floorDist\n                    ) / 30;\n\n                    // Distance fog on floor too\n                    let fdFog = Math.max(0.1, 1 - floorDist / 8);\n                    fLighting *= fdFog;\n\n                    ctx.fillStyle = `rgb(${Math.floor(baseR >> 1)},${Math.floor(40*fLighting*3)},${Math.floor(60*fLighting*3)})`;\n                    ctx.fillRect(x, y, 1, 1);\n                }\n            }\n\n            // Draw ceiling above wall (if not already drawn)\n            let ceilStart = Math.max(0, 120 - lineHeight / 4);\n            for (let y = ceilStart; y < ceilingTop && y >= 0; y++) {\n                let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n                if (!isNaN(ceilDist)) {\n                    let cLighting = getLightAt(\n                        player.x + Math.cos(rayAngle) * ceilDist,\n                        player.y + Math.sin(rayAngle) * ceilDist\n                    ) / 30;\n\n                    // Distance fog on ceiling too\n                    let cdFog = Math.max(0.1, 1 - ceilDist / 8);\n                    cLighting *= cdFog;\n\n                    ctx.fillStyle = `rgb(${Math.floor(baseR >> 2)},${Math.floor(50*cLighting*3)},${Math.floor(80*cLighting*3)})`;\n                    ctx.fillRect(x, y, 1, 1);\n                } else {\n                    // Pitch black ceiling where no wall is visible yet (above)\n                    for (let cy = Math.max(0, ceilStart); cy < ceilingTop && cy >= 0; cy++) {\n                        ctx.fillStyle = `rgb(5,8,12)`;\n                        ctx.fillRect(x, cy, 1, 1);\n                    }\n                }\n            }\n\n            // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n            for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n                let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n                if (!isNaN(ceilDist)) continue; // Already drawn above\n\n                ctx.fillStyle = `rgb(5,8,12)`;\n                ctx.fillRect(x, y, 1, 1);\n            }\n        } else {\n            // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n            for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n                ctx.fillStyle = `rgb(5,8,12)`;\n                ctx.fillRect(x, y, 1, 1);\n            }\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n\n        // Pitch black ceiling where no wall is visible yet (above) - if not drawn above\n        for (let y = Math.max(0, ceilStart); y < ceilingTop && y >= 0; y++) {\n            let ceilDist = result.perpDist * (120 - y) / 120 + 0.5;\n            if (!isNaN(ceilDist)) continue; // Already drawn above\n\n            ctx.fillStyle = `rgb(5,8,12)`;\n            ctx.fillRect(x, y, 1, 1);\n        }\n"},"status":"ok","ms":133}
