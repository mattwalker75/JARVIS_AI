{"t":"2026-07-28T12:53:31.481Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, json, sys\n\ndb = \"/workspace/mbm.db\"\nconn = sqlite3.connect(db)\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nBID = 2  # Summit Digital Agency LLC\n\nprint(\"=\" * 70)\nprint(\"SUMMIT DIGITAL AGENCY LLC — FULL DATA VERIFICATION\")\nprint(f\"Business ID: {BID}\")\nprint(\"=\" * 70)\n\n# ── 1. Business Profile ────────────────────────────────\nprint(\"\\n[1] BUSINESS PROFILE (businesses table)\")\nrows = cur.execute(\"SELECT id, name, business_type, status FROM businesses WHERE id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  ✓ Name: {r['name']}\")\n        print(f\"  Type: {r['business_type']} | Status: {r['status']}\")\nelse:\n    print(\"  ✗ NOT FOUND\")\n\n# ── 2. Company Details (EIN, address) ────────────────\nprint(\"\\n[2] COMPANY DETAILS / LEGAL INFO\")\nrows = cur.execute(\"SELECT * FROM business_company WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  Legal Name: {d.get('legal_name','?')}\")\n        print(f\"  Industry: {d.get('industry','?')}\")\n        print(f\"  EIN: {d.get('ein','?')}\")\n        print(f\"  State of Inc.: {d.get('state_of_incorporation','?')}\")\nelse:\n    print(\"  ✗ NOT FOUND (business_company)\")\n\n# ── 3. Business Owners / Team ────────────────────────\nprint(\"\\n[3] BUSINESS OWNERS\")\nrows = cur.execute(\"SELECT * FROM business_owners WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  Owner: {d.get('owner_name','?')} | Role: {d.get('role','?')}\")\nelse:\n    print(\"  ✗ NOT FOUND (business_owners)\")\n\n# ── 4. Business Addresses / Phones / Emails ──────────\nprint(\"\\n[4] BUSINESS CONTACT INFO\")\naddr = cur.execute(\"SELECT * FROM business_addresses WHERE business_id=?\", (BID,)).fetchall()\nif addr:\n    for r in addr:\n        print(f\"  Address: {dict(r)}\")\n\nphones = cur.execute(\"SELECT * FROM business_phones WHERE business_id=?\", (BID,)).fetchall()\nif phones:\n    for r in phones:\n        d = dict(r)\n        print(f\"  Phone: {d.get('phone_number','?')} ({d.get('type','')})\")\n\nemails = cur.execute(\"SELECT * FROM business_emails WHERE business_id=?\", (BID,)).fetchall()\nif emails:\n    for r in emails:\n        d = dict(r)\n        print(f\"  Email: {d.get('email_address','?')} ({d.get('type','')})\")\n\n# ── 5. Contacts directory ────────────────────────────\nprint(\"\\n[5] CONTACTS DIRECTORY (contacts table)\")\nrows = cur.execute(\"\"\"SELECT c.id, c.first_name, c.last_name, c.email1, c.phone1, \n                      cat.name as category FROM contacts c \n                      LEFT JOIN contact_categories cat ON c.category_id=cat.id \n                      WHERE c.business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        name = f\"{d['first_name']} {d['last_name']}\".strip()\n        print(f\"  [{r['id']}] {name} | Email: {d.get('email1','?')} | Phone: {d.get('phone1','?')}\")\n\n# Count by type via business_customers / business_vendors / contacts table\ncust = cur.execute(\"SELECT COUNT(*) as c FROM business_customers WHERE business_id=?\", (BID,)).fetchone()\nvend = cur.execute(\"SELECT COUNT(*) as c FROM business_vendors WHERE business_id=?\", (BID,)).fetchone()\nprint(f\"\\n  Customers: {cust[0]} | Vendors: {vend[0]}\")\n\n# ── 6. Products/Services catalog ─────────────────────\nprint(\"\\n[6] PRODUCTS / SERVICES CATALOG\")\nrows = cur.execute(\"SELECT id, name, description FROM business_products_services WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('name','?')} — {str(r.get('description',''))[:100]}\")\nelse:\n    print(\"  ✗ NOT FOUND\")\n\n# ── 7. Financials - Recurring Invoices ───────────────\nprint(\"\\n[7] RECURRING INVOICES (Active)\")\nrows = cur.execute(\"\"\"SELECT ri.id, c.first_name||' '||c.last_name as client, \n                      ri.amount, ri.frequency, ri.status, ri.next_due_date \n                      FROM recurring_invoices ri\n                      JOIN contacts c ON ri.customer_id=c.id WHERE ri.business_id=? AND ri.is_active=1\"\"\", (BID,)).fetchall()\nif rows:\n    total = 0.0\n    for r in rows:\n        d = dict(r)\n        print(f\"  Invoice #{d['id']} → {d.get('client','?')}: ${float(d['amount']):,.2f}/{d.get('frequency','')} (next due: {d.get('next_due_date','')})\")\n        total += float(d['amount'])\n    print(f\"\\n  TOTAL ACTIVE RETAINERS: ${total:,.2f}/mo equivalent\")\nelse:\n    # Try invoices table instead\n    rows = cur.execute(\"\"\"SELECT i.id, c.first_name||' '||c.last_name as client, \n                          i.amount_total, i.status FROM invoices i\n                          JOIN contacts c ON i.customer_id=c.id WHERE i.business_id=? AND i.status='active'\"\"\", (BID,)).fetchall()\n    if rows:\n        total = 0.0\n        for r in rows:\n            d = dict(r)\n            print(f\"  Invoice #{d['id']} → {d.get('client','?')}: ${float(d.get('amount_total',0)):,.2f} ({d.get('status','')})\")\n            total += float(d.get('amount_total',0))\n        print(f\"\\n  TOTAL ACTIVE INVOICES: ${total:,.2f}\")\n\n# Budget entries\nbudget = cur.execute(\"SELECT COUNT(*) as c FROM budget_entries WHERE business_id=?\", (BID,)).fetchone()\nprint(f\"  Budget entries: {budget[0]}\")\n\n# ── 8. Documents/Notes ───────────────────────────────\nprint(\"\\n[8] DOCUMENTS / NOTES\")\nrows = cur.execute(\"SELECT id, title FROM documents WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('title','?')}\")\n\n# Also check notes table\nnotes_rows = cur.execute(\"SELECT id, title FROM notes WHERE business_id=?\", (BID,)).fetchall()\nprint(f\"\\n  Notes entries for this business: {len(notes_rows)}\")\nfor r in notes_rows:\n    print(f\"  [{r['id']}] {r.get('title','?')}\")\n\n# ── 9. Projects/KPIs ────────────────────────────────\nprint(\"\\n[9] PROJECTS (project_lists)\")\nrows = cur.execute(\"SELECT id, name, status FROM project_lists WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r['id']}] {r.get('name','?')} — Status: {r.get('status','?')}\")\n\n# ── 10. Business Assets / Other info ────────────────\nprint(\"\\n[10] BUSINESS ASSETS (domain, software licenses)\")\ndomains = cur.execute(\"SELECT * FROM business_domains WHERE business_id=?\", (BID,)).fetchall()\nif domains:\n    for r in domains:\n        print(f\"  Domain: {dict(r)}\")\n\nlicenses = cur.execute(\"SELECT id, name FROM business_software_licenses WHERE business_id=? LIMIT 10\", (BID,)).fetchall()\nif licenses:\n    for r in licenses:\n        print(f\"  Software License: {r.get('name','?')}\")\n\n# ── Summary Counts ────────────────────────────────\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SUMMARY COUNTS FOR business_id=2:\")\ntables_to_check = [\n    'contacts', 'business_customers', 'business_vendors', \n    'business_products_services', 'recurring_invoices', 'invoices',\n    'budget_entries', 'documents', 'notes', 'project_lists',\n    'business_company', 'business_owners', 'business_addresses'\n]\n\nfor t in tables_to_check:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {t} WHERE business_id=?\", (BID,)).fetchone()\n        status_str = f\"{cnt[0]}\" if cnt else \"ERR\"\n        print(f\"  ✓ {t}: {status_str}\")\n    except Exception as e:\n        print(f\"  ✗ {t}: ERROR ({e})\")\n\nconn.close()\nprint(\"\\n✅ VERIFICATION COMPLETE\\n\")\nPYEOF","timeout_s":30},"status":"ok","ms":136}
{"t":"2026-07-28T12:53:36.382Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check schema of key tables\ntables = ['businesses', 'business_company', 'business_owners', 'contacts', \n          'recurring_invoices', 'invoices', 'budget_entries', 'documents']\n\nfor t in tables:\n    try:\n        cols = cur.execute(f\"PRAGMA table_info({t})\").fetchall()\n        print(f\"\\n=== {t} ===\")\n        for c in cols[:15]:  # first 15 columns\n            print(f\"  col_id={c[0]} name='{c[1]}' type={c[2]} notnull={c[3]} default={c[4]} pk={c[5]}\")\n    except Exception as e:\n        print(f\"\\n=== {t} === ERROR: {e}\")\n\nconn.close()\nPYEOF","timeout_s":10},"status":"ok","ms":142}
{"t":"2026-07-28T12:54:01.474Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, json, sys\n\ndb = \"/workspace/mbm.db\"\nconn = sqlite3.connect(db)\ncur = conn.cursor()\nBID = 2\n\nprint(\"=\" * 70)\nprint(\"SUMMIT DIGITAL AGENCY LLC — FULL DATA VERIFICATION\")\nprint(f\"Business ID: {BID}\")\nprint(\"=\" * 70)\n\n# ── 1. Business Profile ────────────────────────\nprint(\"\\n[1] BUSINESS PROFILE (businesses table)\")\nrows = cur.execute(\"SELECT business_id, name, slug, dir_name, type FROM businesses WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  ✓ Name: {d['name']}\")\n        print(f\"  Slug: {d.get('slug','?')} | Dir: {d.get('dir_name','?')}\")\nelse:\n    print(\"  ✗ NOT FOUND\")\n\n# ── 2. Company Details (EIN, address) ────────\nprint(\"\\n[2] COMPANY DETAILS / LEGAL INFO\")\nrows = cur.execute(\"\"\"SELECT legal_name, dba, ein, entity_type, founded_date, \n                      state_of_formation, mission, motto, slogan, website_url\n                      FROM business_company WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  Legal Name: {d.get('legal_name','?')}\")\n        print(f\"  DBA: {d.get('dba','') or '(none)'}\")\n        print(f\"  EIN: {d.get('ein','?')}\")\n        print(f\"  Entity Type: {d.get('entity_type','?')}\")\n        print(f\"  State of Formation: {d.get('state_of_formation','?')}\")\n        print(f\"  Founded Date: {d.get('founded_date','') or '(none)'}\")\n        print(f\"  Mission: {str(d.get('mission',''))[:100]}...\")\n        if d.get('motto'):\n            print(f\"  Motto: {d['motto']}\")\n        if d.get('slogan'):\n            print(f\"  Slogan: {d['slogan']}\")\n        if d.get('website_url'):\n            print(f\"  Website: {d['website_url']}\")\nelse:\n    print(\"  ✗ NOT FOUND (business_company)\")\n\n# ── 3. Business Owners / Team ────────────────\nprint(\"\\n[3] BUSINESS OWNERS\")\nrows = cur.execute(\"\"\"SELECT owner_id, name, role, relationship, ownership, \n                      is_board_member, date_joined, email, phone FROM business_owners WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  Owner #{d['owner_id']}: {d.get('name','?')} | Role: {d.get('role','?')}\")\n        if d.get('relationship'):\n            print(f\"    Relationship: {d['relationship']} | Ownership: {d.get('ownership','') or 'N/A'}\")\n        if d.get('email'):\n            print(f\"    Email: {d['email']}\")\n\n# ── 4. Business Addresses / Phones / Emails ────────\nprint(\"\\n[4] BUSINESS CONTACT INFO (business_addresses)\")\nrows = cur.execute(\"\"\"SELECT address_line1, city, state_province, postal_code, country FROM business_addresses WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  Address: {d.get('address_line1','') or ''}, {d.get('city','')}\")\n\n# ── 5. Contacts directory ────────────────\nprint(\"\\n[5] CONTACTS DIRECTORY (contacts table)\")\nrows = cur.execute(\"\"\"SELECT contact_id, name, business_name, phone, email FROM contacts WHERE business_id=? ORDER BY name\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  [{r['contact_id']}] {d.get('name','?')} | Phone: {d.get('phone','') or '(none)'}\")\n\nprint(f\"\\n  Total contacts for this business: {len(rows)}\")\n\n# ── 6. Products/Services catalog ────────\nprint(\"\\n[6] PRODUCTS / SERVICES CATALOG (business_products_services)\")\nrows = cur.execute(\"\"\"SELECT product_id, name, description FROM business_products_services WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  [{r['product_id']}] {d.get('name','?')}\")\n\n# ── 7. Financials - Recurring Invoices ────────\nprint(\"\\n[7] RECURRING INVOICES (Active)\")\nrows = cur.execute(\"\"\"SELECT recurring_invoice_id, customer_name, amount_cents, frequency, \n                      interval_count, next_run_date FROM recurring_invoices WHERE business_id=? AND active=1\"\"\", (BID,)).fetchall()\nif rows:\n    total_cents = 0\n    for r in rows:\n        d = dict(r)\n        amt = float(d['amount_cents']) / 100.0\n        print(f\"  RI #{d['recurring_invoice_id']} → {d.get('customer_name','?')}: ${amt:,.2f}/{d.get('frequency','')} (next run: {d.get('next_run_date','')})\")\n        total_cents += d['amount_cents']\n    print(f\"\\n  TOTAL ACTIVE RETAINERS: ${total_cents/100.0:,.2f}/mo equivalent\")\n\n# ── 8. Budget entries ────────\nprint(\"\\n[8] BUDGET ENTRIES (budget_entries)\")\nrows = cur.execute(\"\"\"SELECT budget_entry_id, year, type_key, category, planned_cents FROM budget_entries WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows[:15]:  # first 15 only\n        d = dict(r)\n        amt = float(d['planned_cents']) / 100.0\n        print(f\"  [{r['budget_entry_id']}] {d.get('type_key','?')} | Category: {d.get('category','') or 'N/A'} | Planned: ${amt:,.2f}\")\n    if len(rows) > 15:\n        print(f\"\\n  ... and {len(rows)-15} more budget entries\")\n\n# ── 9. Documents/Notes ────────\nprint(\"\\n[9] DOCUMENTS (documents table)\")\nrows = cur.execute(\"\"\"SELECT document_id, category, title FROM documents WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  [{r['document_id']}] Category: {d.get('category','?')} | Title: {d.get('title','') or '(no title)'}\")\n\n# ── 10. Projects (project_lists) ────────\nprint(\"\\n[10] PROJECTS (project_lists)\")\nrows = cur.execute(\"\"\"SELECT project_list_id, name, status FROM project_lists WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        d = dict(r)\n        print(f\"  [{r['project_list_id']}] {d.get('name','?')} — Status: {d.get('status','?')}\")\n\n# ── Summary Counts ────────\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SUMMARY COUNTS FOR business_id=2:\")\ntables_to_check = [\n    'contacts', 'business_customers', 'business_vendors', \n    'business_products_services', 'recurring_invoices', 'invoices',\n    'budget_entries', 'documents', 'notes', 'project_lists'\n]\n\nfor t in tables_to_check:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {t} WHERE business_id=?\", (BID,)).fetchone()\n        print(f\"  ✓ {t}: {cnt[0]}\")\n    except Exception as e:\n        print(f\"  ✗ {t}: ERROR ({e})\")\n\nconn.close()\nprint(\"\\n✅ VERIFICATION COMPLETE\\n\")\nPYEOF","timeout_s":30},"status":"ok","ms":141}
{"t":"2026-07-28T12:54:06.356Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check what's in businesses table for bid 2\nrows = cur.execute(\"SELECT * FROM businesses WHERE business_id=2\").fetchall()\nprint(f\"businesses rows: {len(rows)}\")\nfor r in rows:\n    print(r)\n\n# Also check all bids in the table\nbids = cur.execute(\"SELECT DISTINCT business_id FROM businesses\").fetchall()\nprint(f\"\\nAll business_ids: {[r[0] for r in bids]}\")\n\nconn.close()\nPYEOF","timeout_s":10},"status":"ok","ms":144}
{"t":"2026-07-28T12:54:27.676Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, sys\n\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\nBID = 2\n\nprint(\"=\" * 70)\nprint(\"SUMMIT DIGITAL AGENCY LLC — FULL DATA VERIFICATION\")\nprint(f\"Business ID: {BID}\")\nprint(\"=\" * 70)\n\n# ── 1. Business Profile ────────\nprint(\"\\n[1] BUSINESS PROFILE (businesses table)\")\nrows = cur.execute(\"SELECT business_id, name, slug, dir_name, type FROM businesses WHERE business_id=?\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  ✓ Name: {r[1]}\")\n        print(f\"  Slug: {r[2]} | Dir: {r[3]}\")\nelse:\n    print(\"  ✗ NOT FOUND\")\n\n# ── 2. Company Details (EIN, address) ────────\nprint(\"\\n[2] COMPANY DETAILS / LEGAL INFO\")\nrows = cur.execute(\"\"\"SELECT legal_name, dba, ein, entity_type, founded_date, \n                      state_of_formation, mission, motto, slogan, website_url\n                      FROM business_company WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  Legal Name: {r[0]}\")\n        print(f\"  DBA: {r[1] or '(none)'}\")\n        print(f\"  EIN: {r[2]}\")\n        print(f\"  Entity Type: {r[3]}\")\n        print(f\"  State of Formation: {r[5]}\")\n        print(f\"  Founded Date: {r[4] or '(none)'}\")\n        if r[6]:\n            print(f\"  Mission: {str(r[6])[:120]}...\")\n        if r[7]:\n            print(f\"  Motto: {r[7]}\")\n        if r[8]:\n            print(f\"  Slogan: {r[8]}\")\n        if r[9]:\n            print(f\"  Website: {r[9]}\")\nelse:\n    print(\"  ✗ NOT FOUND (business_company)\")\n\n# ── 3. Business Owners / Team ────────\nprint(\"\\n[3] BUSINESS OWNERS\")\nrows = cur.execute(\"\"\"SELECT owner_id, name, role, relationship, ownership, \n                      is_board_member, date_joined, email, phone FROM business_owners WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  Owner #{r[0]}: {r[1]} | Role: {r[2] or '(no role)'}\")\n        if r[3]:\n            print(f\"    Relationship: {r[3]} | Ownership: {r[4] or 'N/A'}\")\n        if r[7]:\n            print(f\"    Email: {r[7]}\")\n\n# ── 5. Contacts directory ────────\nprint(\"\\n[5] CONTACTS DIRECTORY (contacts table)\")\nrows = cur.execute(\"\"\"SELECT contact_id, name, business_name, phone, email FROM contacts WHERE business_id=? ORDER BY name\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]} | Phone: {r[3] or '(none)'}\")\n\nprint(f\"\\n  Total contacts: {len(rows)}\")\n\n# ── 6. Products/Services catalog ────────\nprint(\"\\n[6] PRODUCTS / SERVICES CATALOG (business_products_services)\")\nrows = cur.execute(\"\"\"SELECT product_id, name, description FROM business_products_services WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]}\")\n\n# ── 7. Financials - Recurring Invoices ────────\nprint(\"\\n[7] RECURRING INVOICES (Active)\")\nrows = cur.execute(\"\"\"SELECT recurring_invoice_id, customer_name, amount_cents, frequency, \n                      interval_count, next_run_date FROM recurring_invoices WHERE business_id=? AND active=1\"\"\", (BID,)).fetchall()\nif rows:\n    total_cents = 0\n    for r in rows:\n        amt = float(r[2]) / 100.0\n        print(f\"  RI #{r[0]} → {r[1]}: ${amt:,.2f}/{r[3]} (next run: {r[5]})\")\n        total_cents += r[2]\n    print(f\"\\n  TOTAL ACTIVE RETAINERS: ${total_cents/100.0:,.2f}/mo equivalent\")\n\n# ── 8. Budget entries ────────\nprint(\"\\n[8] BUDGET ENTRIES (budget_entries)\")\nrows = cur.execute(\"\"\"SELECT budget_entry_id, year, type_key, category, planned_cents FROM budget_entries WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows[:15]:\n        amt = float(r[4]) / 100.0\n        print(f\"  [{r[0]}] {r[2]} | Category: {r[3] or 'N/A'} | Planned: ${amt:,.2f}\")\n    if len(rows) > 15:\n        print(f\"\\n  ... and {len(rows)-15} more budget entries\")\n\n# ── 9. Documents (documents table) ────────\nprint(\"\\n[9] DOCUMENTS (documents table)\")\nrows = cur.execute(\"\"\"SELECT document_id, category, title FROM documents WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] Category: {r[1]} | Title: {r[2] or '(no title)'}\")\n\n# ── 10. Projects (project_lists) ────────\nprint(\"\\n[10] PROJECTS (project_lists)\")\nrows = cur.execute(\"\"\"SELECT project_list_id, name, status FROM project_lists WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]} — Status: {r[2]}\")\n\n# ── Summary Counts ────────\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SUMMARY COUNTS FOR business_id=2:\")\ntables_to_check = [\n    'contacts', 'business_customers', 'business_vendors', \n    'business_products_services', 'recurring_invoices', 'invoices',\n    'budget_entries', 'documents', 'notes', 'project_lists'\n]\n\nfor t in tables_to_check:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {t} WHERE business_id=?\", (BID,)).fetchone()\n        print(f\"  ✓ {t}: {cnt[0]}\")\n    except Exception as e:\n        print(f\"  ✗ {t}: ERROR ({e})\")\n\nconn.close()\nprint(\"\\n✅ VERIFICATION COMPLETE\\n\")\nPYEOF","timeout_s":30},"status":"ok","ms":136}
{"t":"2026-07-28T12:54:35.766Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check all contacts (no filter) to see what's there\nprint(\"=== ALL CONTACTS ===\")\nrows = cur.execute(\"SELECT contact_id, business_id, name FROM contacts LIMIT 20\").fetchall()\nfor r in rows:\n    print(f\"  [{r[0]}] bid={r[1]} | {r[2]}\")\n\n# Check if any contacts have business_id=2 or NULL\nprint(\"\\n=== CONTACTS BY BUSINESS_ID ===\")\nrows = cur.execute(\"SELECT DISTINCT business_id, COUNT(*) as c FROM contacts GROUP BY business_id\").fetchall()\nfor r in rows:\n    print(f\"  bid={r[0]}: {r[1]} contacts\")\n\n# Check products table schema and data\nprint(\"\\n=== BUSINESS_PRODUCTS_SERVICES SCHEMA ===\")\ncols = cur.execute(\"PRAGMA table_info(business_products_services)\").fetchall()\nfor c in cols[:20]:\n    print(f\"  col_id={c[0]} name='{c[1]}' type={c[2]} pk={c[5]}\")\n\nprint(\"\\n=== BUSINESS_PRODUCTS_SERVICES DATA ===\")\nrows = cur.execute(\"SELECT * FROM business_products_services WHERE business_id=2\").fetchall()\nfor r in rows:\n    print(f\"  {r}\")\n\n# Also check all products regardless of bid\nall_prod = cur.execute(\"SELECT COUNT(*) as c FROM business_products_services\").fetchone()\nprint(f\"\\nTotal product/service records: {all_prod[0]}\")\n\nconn.close()\nPYEOF","timeout_s":15},"status":"ok","ms":148}
{"t":"2026-07-28T12:54:45.403Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check if there's a separate contacts mechanism - maybe business_customers or business_vendors tables have data\nprint(\"=== BUSINESS_CUSTOMERS ===\")\nrows = cur.execute(\"\"\"SELECT customer_id, name, email1, phone1 FROM business_customers WHERE business_id=2\"\"\").fetchall()\nfor r in rows:\n    print(f\"  [{r[0]}] {r[1]} | Email: {r[2]} | Phone: {r[3]}\")\n\nprint(\"\\n=== BUSINESS_VENDORS ===\")\nrows = cur.execute(\"\"\"SELECT vendor_id, name, email_address, phone_number FROM business_vendors WHERE business_id=2\"\"\").fetchall()\nfor r in rows:\n    print(f\"  [{r[0]}] {r[1]} | Email: {r[2]} | Phone: {r[3]}\")\n\n# Check if there's a separate 'contacts' table that stores team members differently\nprint(\"\\n=== ALL TABLES WITH NAME CONTAINING 'contact' ===\")\ntables = cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name LIKE '%contact%'\").fetchall()\nfor t in tables:\n    print(f\"  {t[0]}\")\n\n# Check business_social_links for team members\nprint(\"\\n=== BUSINESS_SOCIAL_LINKS ===\")\nrows = cur.execute(\"SELECT * FROM business_social_links WHERE business_id=2 LIMIT 5\").fetchall()\nfor r in rows:\n    print(f\"  {r}\")\n\nconn.close()\nPYEOF","timeout_s":10},"status":"ok","ms":131}
{"t":"2026-07-28T12:54:52.084Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, json\n\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check business_customers schema and data\nprint(\"=== BUSINESS_CUSTOMERS SCHEMA ===\")\ncols = cur.execute(\"PRAGMA table_info(business_customers)\").fetchall()\nfor c in cols:\n    print(f\"  {c}\")\n\nprint(\"\\n=== BUSINESS_CUSTOMERS DATA (bid=2) ===\")\nrows = cur.execute(\"\"\"SELECT * FROM business_customers WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows[:5]:\n        print(f\"  {r}\")\nelse:\n    print(\"  No customer records found\")\n\nprint(\"\\n=== BUSINESS_VENDORS SCHEMA ===\")\ncols = cur.execute(\"PRAGMA table_info(business_vendors)\").fetchall()\nfor c in cols:\n    print(f\"  {c}\")\n\nprint(\"\\n=== BUSINESS_VENDORS DATA (bid=2) ===\")\nrows = cur.execute(\"\"\"SELECT * FROM business_vendors WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows[:5]:\n        print(f\"  {r}\")\nelse:\n    print(\"  No vendor records found\")\n\n# Check if contacts table has any data at all\nprint(\"\\n=== CONTACTS TABLE (any bid) ===\")\nrows = cur.execute(\"\"\"SELECT COUNT(*) FROM contacts\"\"\").fetchone()\nprint(f\"  Total rows in contacts: {rows[0]}\")\n\nconn.close()\nPYEOF","timeout_s":15},"status":"ok","ms":146}
{"t":"2026-07-28T12:55:18.582Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\n\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\nBID = 2\n\nprint(\"=\" * 70)\nprint(\"SUMMIT DIGITAL AGENCY LLC — FINAL VERIFICATION REPORT\")\nprint(f\"Business ID: {BID}\")\nprint(\"=\" * 70)\n\n# ── 1. Business Profile ────────\nprint(\"\\n[1] BUSINESS PROFILE (businesses table)\")\nr = cur.execute(\"SELECT business_id, name, slug, dir_name FROM businesses WHERE business_id=?\", (BID,)).fetchone()\nif r:\n    print(f\"  ✓ Name: {r[1]}\")\n    print(f\"  Slug: {r[2]} | Dir: {r[3]}\")\n\n# ── 2. Company Details ────────\nprint(\"\\n[2] COMPANY DETAILS (business_company)\")\ncols = cur.execute(\"\"\"SELECT legal_name, dba, ein, entity_type, founded_date, \n                      state_of_formation, mission, motto, slogan, website_url\n                      FROM business_company WHERE business_id=?\"\"\", (BID,)).fetchone()\nif cols:\n    print(f\"  Legal Name: {cols[0]}\")\n    print(f\"  DBA: {cols[1] or '(none)'}\")\n    print(f\"  EIN: {cols[2]}\")\n    print(f\"  Entity Type: {cols[3]}\")\n    print(f\"  State of Formation: {cols[5]}\")\n    print(f\"  Founded Date: {cols[4] or '(none)'}\")\n    if cols[6]:\n        print(f\"  Mission: {str(cols[6])[:120]}...\")\n    if cols[7]:\n        print(f\"  Motto: {cols[7]}\")\n    if cols[8]:\n        print(f\"  Slogan: {cols[8]}\")\n    if cols[9]:\n        print(f\"  Website: {cols[9]}\")\n\n# ── 3. Business Owners ────────\nprint(\"\\n[3] BUSINESS OWNERS (business_owners)\")\nrows = cur.execute(\"\"\"SELECT owner_id, name, role, relationship, ownership, email FROM business_owners WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  Owner #{r[0]}: {r[1]} | Role: {r[2] or '(no role)'}\")\n        if r[3]:\n            print(f\"    Relationship: {r[3]} | Ownership: {r[4] or 'N/A'}\")\n        if r[5]:\n            print(f\"    Email: {r[5]}\")\n\n# ── 4. Customers (Clients) ────────\nprint(\"\\n[4] CUSTOMERS / CLIENTS (business_customers)\")\nrows = cur.execute(\"\"\"SELECT customer_id, name, email, phone FROM business_customers WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]} | Email: {r[2] or '(none)'}\")\n\n# ── 5. Vendors ────────\nprint(\"\\n[5] VENDORS (business_vendors)\")\nrows = cur.execute(\"\"\"SELECT vendor_id, name, category, email FROM business_vendors WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]} | Category: {r[2]}\")\n\n# ── 6. Products/Services catalog ────────\nprint(\"\\n[6] PRODUCTS / SERVICES (business_products_services)\")\nrows = cur.execute(\"\"\"SELECT item_id, name, price_cents FROM business_products_services WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows[:10]:  # first 10 only\n        amt = float(r[2]) / 100.0\n        print(f\"  [{r[0]}] {r[1]} — ${amt:,.2f}\")\n    if len(rows) > 10:\n        print(f\"\\n  ... and {len(rows)-10} more products/services\")\n\n# ── 7. Recurring Invoices ────────\nprint(\"\\n[7] RECURRING INVOICES (recurring_invoices)\")\nrows = cur.execute(\"\"\"SELECT recurring_invoice_id, customer_name, amount_cents, frequency, active FROM recurring_invoices WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    total_active_cents = 0\n    for r in rows[:15]:  # first 15 only\n        amt = float(r[2]) / 100.0\n        active_str = \"ACTIVE\" if r[4] else \"INACTIVE\"\n        print(f\"  RI #{r[0]} → {r[1]}: ${amt:,.2f}/{r[3]} [{active_str}]\")\n        if r[4]:\n            total_active_cents += r[2]\n    if len(rows) > 15:\n        print(f\"\\n  ... and {len(rows)-15} more recurring invoices\")\n    print(f\"  TOTAL ACTIVE RETAINERS: ${total_active_cents/100.0:,.2f}/mo equivalent\")\n\n# ── 8. Budget entries ────────\nprint(\"\\n[8] BUDGET ENTRIES (budget_entries)\")\nrows = cur.execute(\"\"\"SELECT budget_entry_id, year, type_key, category, planned_cents FROM budget_entries WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows[:15]:  # first 15 only\n        amt = float(r[4]) / 100.0\n        print(f\"  [{r[0]}] {r[2]} | Category: {r[3] or 'N/A'} | Planned: ${amt:,.2f}\")\n    if len(rows) > 15:\n        print(f\"\\n  ... and {len(rows)-15} more budget entries\")\n\n# ── 9. Documents (documents table) ────────\nprint(\"\\n[9] DOCUMENTS (documents table)\")\nrows = cur.execute(\"\"\"SELECT document_id, category, title FROM documents WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] Category: {r[1]} | Title: {r[2] or '(no title)'}\")\n\n# ── 10. Projects (project_lists) ────────\nprint(\"\\n[10] PROJECTS (project_lists)\")\nrows = cur.execute(\"\"\"SELECT project_list_id, name, status FROM project_lists WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]} — Status: {r[2]}\")\n\n# ── Summary Counts ────────\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SUMMARY COUNTS FOR business_id=2:\")\ntables_to_check = [\n    'business_customers', 'business_vendors', \n    'business_products_services', 'recurring_invoices', 'invoices',\n    'budget_entries', 'documents', 'notes', 'project_lists'\n]\n\nfor t in tables_to_check:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {t} WHERE business_id=?\", (BID,)).fetchone()\n        print(f\"  ✓ {t}: {cnt[0]}\")\n    except Exception as e:\n        print(f\"  ✗ {t}: ERROR ({e})\")\n\nconn.close()\nprint(\"\\n✅ VERIFICATION COMPLETE\\n\")\nPYEOF","timeout_s":30},"status":"ok","ms":136}
{"t":"2026-07-28T12:55:31.318Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\n\n# Check project_lists schema and data for bid 2\nprint(\"=== PROJECT_LISTS SCHEMA ===\")\ncols = cur.execute(\"PRAGMA table_info(project_lists)\").fetchall()\nfor c in cols:\n    print(f\"  {c}\")\n\nprint(\"\\n=== PROJECT_LISTS DATA (bid=2) ===\")\nrows = cur.execute(\"\"\"SELECT * FROM project_lists WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows[:10]:\n        print(f\"  Row: {r[0]} | name={r[3] if len(r)>3 else 'N/A'} | status={r[4] if len(r)>4 else 'N/A'}\")\n\n# Check documents table more carefully - maybe they're stored differently\nprint(\"\\n=== DOCUMENTS TABLE (any bid=2) ===\")\nrows = cur.execute(\"\"\"SELECT document_id, category, title FROM documents WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] Cat:{r[1]} | Title:{r[2]}\")\nelse:\n    # Check if docs are stored somewhere else - maybe under file_path or original_filename\n    all_docs = cur.execute(\"SELECT COUNT(*) FROM documents\").fetchone()\n    print(f\"Total docs in DB: {all_docs[0]}\")\n\n# Maybe they're in the Summit_Digital_Agency_LLC folder on disk?\nimport os\ndoc_dir = \"/workspace/Summit_Digital_Agency_LLC/data_store/documents\"\nif os.path.exists(doc_dir):\n    files = os.listdir(doc_dir)\n    print(f\"\\nFiles in documents dir: {files}\")\n\n# Check notes table too\nprint(\"\\n=== NOTES TABLE (bid=2) ===\")\nrows = cur.execute(\"\"\"SELECT * FROM notes WHERE business_id=2\"\"\").fetchall()\nif rows:\n    for r in rows[:5]:\n        print(f\"  Row: {r[0]} | title={r[1] if len(r)>1 else 'N/A'}\")\n\n# Check what's actually on disk under Summit_Digital_Agency_LLC\nprint(\"\\n=== DISK FILES ===\")\nfor root, dirs, files in os.walk(\"/workspace/Summit_Digital_Agency_LLC\"):\n    level = root.replace(\"/workspace/Summit_Digital_Agency_LLC\", \"\").count(os.sep)\n    indent = '  ' * level\n    print(f\"{indent}{os.path.basename(root)}/\")\n    subindent = '  ' * (level + 1)\n    for file in files[:5]:\n        print(f\"{subindent}{file}\")\n\nconn.close()\nPYEOF","timeout_s":10},"status":"ok","ms":142}
{"t":"2026-07-28T12:55:42.247Z","tool":"run_shell","args":{"command":"cd /workspace && python3 << 'PYEOF'\nimport sqlite3, os\n\nconn = sqlite3.connect(\"mbm.db\")\ncur = conn.cursor()\nBID = 2\n\n# ── Projects (correct column names) ────────\nprint(\"[10] PROJECTS (project_lists)\")\nrows = cur.execute(\"\"\"SELECT list_id, title FROM project_lists WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows:\n        print(f\"  [{r[0]}] {r[1]}\")\n\n# ── Notes details ────────\nprint(\"\\n[9b] NOTES TABLE DETAILS\")\nrows = cur.execute(\"\"\"SELECT * FROM notes WHERE business_id=?\"\"\", (BID,)).fetchall()\nif rows:\n    for r in rows[:5]:\n        print(f\"  Note ID {r[0]}: title={r[1]}, category={r[2] if len(r)>2 else 'N/A'}\")\n\n# ── Documents on disk ────────\nprint(\"\\n[9a] DOCUMENTS ON DISK (Summit_Digital_Agency_LLC)\")\ndoc_dir = \"/workspace/Summit_Digital_Agency_LLC\"\nfor root, dirs, files in os.walk(doc_dir):\n    level = root.replace(doc_dir, \"\").count(os.sep)\n    indent = '  ' * level\n    print(f\"{indent}{os.path.basename(root)}/\")\n    subindent = '  ' * (level + 1)\n    for file in sorted(files):\n        fpath = os.path.join(root, file)\n        size = os.path.getsize(fpath) if os.path.isfile(fpath) else '?'\n        print(f\"{subindent}{file} ({size:,} bytes)\")\n\n# ── Final Summary Counts (corrected table names) ────────\nprint(\"\\n\" + \"=\" * 70)\nprint(\"FINAL SUMMARY COUNTS FOR business_id=2:\")\ntables_to_check = [\n    'business_customers', 'business_vendors', \n    'business_products_services', 'recurring_invoices', 'invoices',\n    'budget_entries', 'notes', 'project_lists'\n]\n\nfor t in tables_to_check:\n    try:\n        cnt = cur.execute(f\"SELECT COUNT(*) as c FROM {t} WHERE business_id=?\", (BID,)).fetchone()\n        print(f\"  ✓ {t}: {cnt[0]}\")\n    except Exception as e:\n        print(f\"  ✗ {t}: ERROR ({e})\")\n\n# Also count documents on disk\ndoc_count = sum(len(files) for _, _, files in os.walk(doc_dir))\nprint(f\"\\n  Documents (on disk): {doc_count}\")\n\nconn.close()\nPYEOF","timeout_s":15},"status":"ok","ms":143}
